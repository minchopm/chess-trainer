    "play.abandonReason": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لعبتما %lld نقلة. المغادرة الآن تعني الخسارة، ولن تُسجَّل المباراة."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لعبتما %lld نقلة. المغادرة الآن تعني الخسارة، ولن تُسجَّل المباراة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Напред сте с %lld хода. Ако излезете сега, губите партията и тя няма да бъде записана."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি %lld চাল এগিয়েছেন। এখন বেরিয়ে গেলে খেলা হারবেন এবং এটি রেকর্ড হবে না।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি %lld চাল এগিয়েছেন। এখন বেরিয়ে গেলে খেলা হারবেন এবং এটি রেকর্ড হবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Portes %lld jugades. Si surts ara, perds la partida i no es registrarà."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jste %lld tahů v partii. Odejít teď znamená prohru a partie se nezapíše."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I er %lld træk inde. Går du nu, taber du partiet, og det bliver ikke registreret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr seid %lld Züge weit. Wer jetzt geht, verliert die Partie, und sie wird nicht gewertet."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr seid %lld Züge weit. Wer jetzt geht, verliert die Partie, und sie wird nicht gewertet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είστε στην %lld κίνηση. Αν φύγεις τώρα χάνεις την παρτίδα και δεν θα καταγραφεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are %lld moves in. Leaving now loses the game and it will not be recorded."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You are %lld moves in. Leaving now loses the game and it will not be recorded."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "You are %lld moves in. Leaving now loses the game and it will not be recorded."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You are %lld moves in. Leaving now loses the game and it will not be recorded."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You are %lld moves in. Leaving now loses the game and it will not be recorded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleváis %lld jugadas. Si sales ahora pierdes la partida y no se registrará."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleváis %lld jugadas. Si sales ahora pierdes la partida y no se registrará."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Llevas %lld jugadas. Si sales ahora, pierdes la partida y no se registrará."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Peliä on pelattu %lld siirtoa. Jos poistut nyt, häviät pelin eikä sitä kirjata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous en êtes à %lld coups. Partir maintenant, c'est perdre la partie, et elle ne sera pas enregistrée."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous en êtes à %lld coups. Partir maintenant, c'est perdre la partie, et elle ne sera pas enregistrée."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous en êtes à %lld coups. Partir maintenant, c'est perdre la partie, et elle ne sera pas enregistrée."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે %lld ચાલ આગળ છો. હમણાં બહાર નીકળશો તો રમત હારી જશો અને તે નોંધાશે નહીં."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે %lld ચાલ આગળ છો. હમણાં બહાર નીકળશો તો રમત હારી જશો અને તે નોંધાશે નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שיחקתם %lld מהלכים. יציאה עכשיו פירושה הפסד, והמשחק לא יירשם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld चालें हो चुकी हैं। अभी निकले तो बाज़ी हार जाएँगे, और यह दर्ज नहीं होगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na potezu si %lld. Ako sada izađeš, gubiš partiju i neće biti zabilježena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lépésnél tartotok. Ha most kilépsz, elveszíted a játszmát, és nem kerül rögzítésre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah %lld langkah berjalan. Keluar sekarang berarti kalah, dan partai tidak akan dicatat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Siete a %lld mosse. Uscire adesso significa perdere la partita, e non verrà registrata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに %lld 手進んでいます。ここで離れると負けになり、対局は記録されません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сіз %lld жүрістесіз. Қазір шығу ойында жеңіліске әкеледі және ол тіркелмейді."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು %lld ನಡೆಗಳನ್ನು ಆಡಿದ್ದೀರಿ. ಈಗ ಹೊರಟರೆ ಆಟ ಸೋಲಾಗುತ್ತದೆ ಮತ್ತು ಅದು ದಾಖಲೆಯಾಗುವುದಿಲ್ಲ."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು %lld ನಡೆಗಳನ್ನು ಆಡಿದ್ದೀರಿ. ಈಗ ಹೊರಟರೆ ಆಟ ಸೋಲಾಗುತ್ತದೆ ಮತ್ತು ಅದು ದಾಖಲೆಯಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld수까지 진행했습니다. 지금 나가면 패배이고 대국은 기록되지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ %lld നീക്കങ്ങൾ കഴിഞ്ഞിരിക്കുന്നു. ഇപ്പോൾ പുറത്ത് പോകുന്നത് കളി തോൽവിയായി കണക്കാക്കും, അത് രേഖപ്പെടുത്തില്ല."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ %lld നീക്കങ്ങൾ കഴിഞ്ഞിരിക്കുന്നു. ഇപ്പോൾ പുറത്ത് പോകുന്നത് കളി തോൽവിയായി കണക്കാക്കും, അത് രേഖപ്പെടുത്തില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही %lld चाली पुढे आहात. आत्ता बाहेर पडल्यास सामना हराल आणि तो नोंदवला जाणार नाही."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही %lld चाली पुढे आहात. आत्ता बाहेर पडल्यास सामना हराल आणि तो नोंदवला जाणार नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah %lld langkah berlalu. Keluar sekarang bermakna kalah, dan perlawanan tidak akan direkodkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dere er %lld trekk inne. Går du nå, taper du partiet, og det blir ikke registrert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jullie zijn %lld zetten ver. Nu weggaan betekent verlies, en de partij wordt niet opgeslagen."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Jullie zijn %lld zetten ver. Nu weggaan betekent verlies, en de partij wordt niet opgeslagen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Dere er %lld trekk inne. Går du nå, taper du partiet, og det blir ikke registrert."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ %lldଟି ଚାଳ ଖେଳିସାରିଛନ୍ତି। ଏବେ ବାହାରିଲେ ଖେଳ ହାରିଯିବେ ଏବଂ ଏହା ରେକର୍ଡ୍ ହେବ ନାହିଁ।"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ %lldଟି ଚାଳ ଖେଳିସାରିଛନ୍ତି। ଏବେ ବାହାରିଲେ ଖେଳ ହାରିଯିବେ ଏବଂ ଏହା ରେକର୍ଡ୍ ହେବ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ %lld ਚਾਲਾਂ ਕਰ ਚੁੱਕੇ ਹੋ। ਹੁਣ ਨਿਕਲਣ ਨਾਲ ਖੇਡ ਹਾਰ ਜਾਵੇਗੀ ਅਤੇ ਇਹ ਦਰਜ ਨਹੀਂ ਹੋਵੇਗੀ।"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ %lld ਚਾਲਾਂ ਕਰ ਚੁੱਕੇ ਹੋ। ਹੁਣ ਨਿਕਲਣ ਨਾਲ ਖੇਡ ਹਾਰ ਜਾਵੇਗੀ ਅਤੇ ਇਹ ਦਰਜ ਨਹੀਂ ਹੋਵੇਗੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteście po %lld posunięciach. Wyjście teraz to przegrana, a partia nie zostanie zapisana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocês estão no lance %lld. Sair agora é perder a partida, e ela não será registrada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocês estão no lance %lld. Sair agora é perder a partida, e ela não será registrada."
          }
        },
        "pt-PT": {
