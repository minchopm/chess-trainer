        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diófakészlethez saját tábla is tartozik: egy keretes juhar tábla az asztalon, lámpafényben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Set kenari dilengkapi dengan papan miliknya sendiri: papan maple berbingkai di atas meja, di bawah lampu."
