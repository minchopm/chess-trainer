        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La pendule tourne encore. Partir maintenant arrête la série et garde le score acquis."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "La pendule tourne encore. Partir maintenant arrête la série et garde le score acquis."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઘડિયાળ હજી ચાલે છે. હમણાં બહાર નીકળશો તો રન બંધ થઈ જશે અને અત્યાર સુધીનો સ્કોર સાચવાઈ રહેશે."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ઘડિયાળ હજી ચાલે છે. હમણાં બહાર નીકળશો તો રન બંધ થઈ જશે અને અત્યાર સુધીનો સ્કોર સાચવાઈ રહેશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השעון עדיין רץ. יציאה עכשיו מסיימת את הסבב ושומרת את הניקוד עד כה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घड़ी अब भी चल रही है। अभी निकले तो दौर ख़त्म हो जाएगा और अब तक का स्कोर रह जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat još uvijek radi. Odlazak sada završava pokušaj i zadržava dosadašnji rezultat."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az óra még megy. Ha most kilépsz, a kör lezárul, és megmarad az eddigi eredmény."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam masih berjalan. Keluar sekarang mengakhiri sesi dan menyimpan skor sejauh ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'orologio sta ancora andando. Uscire adesso chiude la serie e tiene il punteggio fatto finora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計はまだ動いています。ここで離れるとラッシュは終了し、いまの成績が残ります。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сағат әлі жүріп тұр. Қазір шығу сериялық ойынды аяқтайды да, әзірге жиналған ұпайды сақтайды."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗಡಿಯಾರ ಇನ್ನೂ ಓಡುತ್ತಿದೆ. ಈಗ ಹೊರಟರೆ ರನ್ ಮುಕ್ತಾಯವಾಗುತ್ತದೆ ಮತ್ತು ಈವರೆಗೆ ಪಡೆದ ಅಂಕ ಉಳಿಯುತ್ತದೆ."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗಡಿಯಾರ ಇನ್ನೂ ಓಡುತ್ತಿದೆ. ಈಗ ಹೊರಟರೆ ರನ್ ಮುಕ್ತಾಯವಾಗುತ್ತದೆ ಮತ್ತು ಈವರೆಗೆ ಪಡೆದ ಅಂಕ ಉಳಿಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계가 아직 돌고 있습니다. 지금 나가면 러시가 끝나고 지금까지의 점수가 남습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്ലോക്ക് ഇപ്പോഴും ഓടുകയാണ്. ഇപ്പോൾ പുറത്തുകടക്കുന്നത് ശ്രമം അവസാനിപ്പിക്കുകയും ഇതുവരെ ലഭിച്ച സ്കോർ നിലനിർത്തുകയും ചെയ്യും."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്ലോക്ക് ഇപ്പോഴും ഓടുകയാണ്. ഇപ്പോൾ പുറത്തുകടക്കുന്നത് ശ്രമം അവസാനിപ്പിക്കുകയും ഇതുവരെ ലഭിച്ച സ്കോർ നിലനിർത്തുകയും ചെയ്യും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "घड्याळ अजून सुरू आहे. आत्ता बाहेर पडल्यास सध्याची धाव थांबेल आणि आतापर्यंतचा गुण राहील."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "घड्याळ अजून सुरू आहे. आत्ता बाहेर पडल्यास सध्याची धाव थांबेल आणि आतापर्यंतचा गुण राहील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam masih berjalan. Keluar sekarang menamatkan pusingan dan menyimpan markah setakat ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klokka går fortsatt. Går du nå, avsluttes runden og poengsummen så langt beholdes."
          }
        },
        "nl": {
          "stringUnit": {
