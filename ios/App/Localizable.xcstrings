    "store.supportBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn مفتوح المصدر، بلا إعلانات ولا حساب ولا تتبّع. يرفع Pro الحدود اليومية عن التدريب، ويموّل العمل الذي يُبقي التطبيق مستمرًا."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn مفتوح المصدر، بلا إعلانات ولا حساب ولا تتبّع. يرفع Pro الحدود اليومية عن التدريب، ويموّل العمل الذي يُبقي التطبيق مستمرًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn е с отворен код, без реклами, без акаунт и без проследяване. Pro маха дневните ограничения в тренировките и плаща за работата, която поддържа приложението."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn ওপেন সোর্স, এখানে কোনো বিজ্ঞাপন নেই, কোনো অ্যাকাউন্ট লাগে না, আর কোনো ট্র্যাকিংও নেই। Pro-তে দৈনিক প্রশিক্ষণের সীমা তুলে দেওয়া হয় এবং অ্যাপটি চালু রাখার কাজের খরচ জোগানো হয়।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn ওপেন সোর্স, এখানে কোনো বিজ্ঞাপন নেই, কোনো অ্যাকাউন্ট লাগে না, আর কোনো ট্র্যাকিংও নেই। Pro-তে দৈনিক প্রশিক্ষণের সীমা তুলে দেওয়া হয় এবং অ্যাপটি চালু রাখার কাজের খরচ জোগানো হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn és de codi obert, sense anuncis, sense compte i sense seguiment. Pro elimina els límits diaris de l'entrenament i paga la feina que manté l'app en marxa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn má otevřený zdrojový kód, žádné reklamy, žádný účet a žádné sledování. Pro ruší denní limity tréninku a platí práci, díky které aplikace dál žije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn er open source, uden reklamer, uden konto og uden sporing. Pro fjerner de daglige grænser for træningen og betaler for arbejdet, der holder appen i gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn ist Open Source, ohne Werbung, ohne Konto und ohne Tracking. Pro hebt die täglichen Grenzen des Trainings auf und bezahlt die Arbeit, die die App am Laufen hält."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn ist Open Source, ohne Werbung, ohne Konto und ohne Tracking. Pro hebt die täglichen Grenzen des Trainings auf und bezahlt die Arbeit, die die App am Laufen hält."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Brass Pawn είναι ανοιχτού κώδικα, χωρίς διαφημίσεις, χωρίς λογαριασμό και χωρίς παρακολούθηση. Το Pro καταργεί τα ημερήσια όρια της προπόνησης και πληρώνει τη δουλειά που κρατά την εφαρμογή ζωντανή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn is open source, with no ads, no account and no tracking. Pro takes the daily limits off the training and pays for the work that keeps the app going."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn is open source, with no ads, no account and no tracking. Pro takes the daily limits off the training and pays for the work that keeps the app going."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn is open source, with no ads, no account and no tracking. Pro takes the daily limits off the training and pays for the work that keeps the app going."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn is open source, with no ads, no account and no tracking. Pro takes the daily limits off the training and pays for the work that keeps the app going."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn is open source, with no ads, no account and no tracking. Pro takes the daily limits off the training and pays for the work that keeps the app going."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn es de código abierto, sin anuncios, sin cuenta y sin rastreo. Pro quita los límites diarios del entrenamiento y paga el trabajo que mantiene viva la app."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn es de código abierto, sin anuncios, sin cuenta y sin rastreo. Pro quita los límites diarios del entrenamiento y paga el trabajo que mantiene viva la app."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn es de código abierto, sin anuncios, sin cuenta y sin rastreo. Pro quita los límites diarios del entrenamiento y paga el trabajo que mantiene viva la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn on avointa lähdekoodia – ei mainoksia, ei tiliä eikä seurantaa. Pro poistaa harjoittelun päivärajat ja maksaa työn, joka pitää sovelluksen käynnissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn est open source, sans publicité, sans compte et sans pistage. Pro lève les limites quotidiennes de l’entraînement et finance le travail qui fait vivre l’app."
          }
        },
        "fr-CA": {
