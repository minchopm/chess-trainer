    "online.aRealOpponentOverGame": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "خصم حقيقي عبر Game Center، مع ساعة. بلا تلميحات، بلا محرّك، وبلا تراجع عن النقلات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skutečný soupeř přes Game Center, na hodiny. Bez nápověd, bez enginu, bez braní tahů zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En rigtig modstander via Game Center, på ur. Ingen hints, ingen motor, ingen fortrydelser."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein echter Gegner über Game Center, mit Uhr. Keine Tipps, keine Engine, keine Zugrücknahme."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πραγματικός αντίπαλος μέσω Game Center, με ρολόι. Χωρίς υποδείξεις, χωρίς μηχανή, χωρίς πάρσιμο κινήσεων πίσω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A real opponent over Game Center, on the clock. No hints, no engine, no take-backs."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "A real opponent over Game Center, on the clock. No hints, no engine, no take-backs."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A real opponent over Game Center, on the clock. No hints, no engine, no take-backs."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rival de verdad a través de Game Center, con reloj. Sin pistas, sin motor, sin deshacer jugadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oikea vastustaja Game Centerin kautta, kello käynnissä. Ei vihjeitä, ei moottoria, ei siirtojen perumista."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vrai adversaire via Game Center, à la pendule. Pas d'indice, pas de moteur, pas de retour en arrière."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vrai adversaire via Game Center, à la pendule. Pas d'indice, pas de moteur, pas de retour en arrière."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יריב אמיתי דרך Game Center, עם שעון. בלי רמזים, בלי מנוע, בלי לקחת מהלכים בחזרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center के ज़रिए असली प्रतिद्वंद्वी, घड़ी के साथ। कोई संकेत नहीं, कोई इंजन नहीं, चाल वापस लेना नहीं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Valódi ellenfél a Game Centeren keresztül, órával. Nincs tipp, nincs motor, nincs visszalépés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lawan sungguhan lewat Game Center, dengan jam. Tanpa petunjuk, tanpa mesin, tanpa menarik langkah kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un avversario vero tramite Game Center, con l'orologio. Nessun suggerimento, nessun motore, nessuna mossa ritirata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center を通じた生身の相手と、持ち時間つきで対局します。ヒントなし、エンジンなし、待ったなし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center로 만나는 진짜 상대, 시계까지. 힌트도, 엔진도, 무르기도 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lawan sebenar melalui Game Center, dengan jam. Tiada petunjuk, tiada enjin, tiada tarik balik langkah."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Een echte tegenstander via Game Center, met klok. Geen hints, geen engine, geen zetten terugnemen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "En ekte motstander via Game Center, på klokke. Ingen hint, ingen motor, ingen angrede trekk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żywy przeciwnik przez Game Center, z zegarem. Bez podpowiedzi, bez silnika, bez cofania posunięć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um adversário de verdade pelo Game Center, no relógio. Sem dicas, sem motor, sem voltar lances."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un adversar real prin Game Center, cu ceas. Fără indicii, fără motor, fără mutări luate înapoi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Живой соперник через Game Center, с часами. Без подсказок, без движка, без взятия ходов назад."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En riktig motståndare via Game Center, med klocka. Inga tips, ingen motor, inga återtagna drag."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คู่แข่งตัวจริงผ่าน Game Center พร้อมนาฬิกา ไม่มีคำใบ้ ไม่มีเอนจิน ไม่มีการขอเดินใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center üzerinden gerçek bir rakip, saatle. İpucu yok, motor yok, hamle geri alma yok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đối thủ thật qua Game Center, có đồng hồ. Không gợi ý, không máy, không đi lại nước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Game Center 与真人对弈，带计时。没有提示，没有引擎，不能悔棋。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 Game Center 與真人對弈，附計時。沒有提示，沒有引擎，不能悔棋。"
          }
        }
      }
    },
