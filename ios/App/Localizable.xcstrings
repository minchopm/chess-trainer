    "endgame.afterThatMove": {
      "extractionState": "manual",
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach diesem Zug %@. Spiel ruhig weiter oder starte neu und versuche den richtigen Plan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After that move %@. Play on if you like, or restart and try the correct plan."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "After that move %@. Play on if you like, or restart and try the correct plan."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "After that move %@. Play on if you like, or restart and try the correct plan."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de esa jugada %@. Sigue jugando si quieres, o reinicia e intenta el plan correcto."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Après ce coup %@. Continuez si vous voulez, ou recommencez et essayez le bon plan."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Après ce coup %@. Continuez si vous voulez, ou recommencez et essayez le bon plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo quella mossa %@. Continua pure, oppure ricomincia e prova il piano giusto."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Na die zet %@. Speel gerust door, of begin opnieuw en probeer het juiste plan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po tym posunięciu %@. Możesz grać dalej albo zacząć od nowa i spróbować właściwego planu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois desse lance %@. Continue se quiser, ou recomece e tente o plano certo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После этого хода %@. Можете играть дальше или начать заново и попробовать верный план."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hamleden sonra %@. İstersen devam et, ya da baştan başlayıp doğru planı dene."
          }
        }
      }
