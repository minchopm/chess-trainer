    "settings.engine.recklessSummary": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "خصم مختلف له ذوقه الخاص في الأوضاع. لا يملك أداة لتحديد القوة، لذا يلعب بكامل قوته فقط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jiný soupeř s vlastním vkusem na pozice. Nemá omezovač síly, takže hraje jen na plnou sílu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En anden modstander med sin egen smag for stillinger. Den har ingen styrkebegrænsning og spiller derfor kun på fuld styrke."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Gegner mit eigenem Stellungsgeschmack. Sie hat keine Stärkebegrenzung und spielt daher nur in voller Stärke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας διαφορετικός αντίπαλος με δικό του γούστο στις θέσεις. Δεν έχει περιοριστή ισχύος, οπότε παίζει μόνο με πλήρη δύναμη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A different opponent with its own taste in positions. It has no strength limiter, so it plays at full strength only."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "A different opponent with its own taste in positions. It has no strength limiter, so it plays at full strength only."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A different opponent with its own taste in positions. It has no strength limiter, so it plays at full strength only."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rival distinto, con su propio gusto por las posiciones. No tiene limitador de fuerza, así que juega solo a plena potencia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toisenlainen vastustaja, jolla on oma makunsa asemista. Siinä ei ole voimakkuusrajoitinta, joten se pelaa vain täydellä voimalla."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un adversaire différent, avec son propre goût pour les positions. Il n'a aucun limiteur de force et joue donc uniquement à pleine puissance."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Un adversaire différent, avec son propre goût pour les positions. Il n'a aucun limiteur de force et joue donc uniquement à pleine puissance."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יריב אחר, עם טעם משלו בעמדות. אין לו מגביל עוצמה, ולכן הוא משחק רק בעוצמה מלאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक अलग प्रतिद्वंद्वी, जिसकी स्थितियों में अपनी पसंद है। इसमें ताक़त सीमित करने की सुविधा नहीं है, इसलिए यह केवल पूरी ताक़त से खेलता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Másfajta ellenfél, saját ízléssel az állások iránt. Nincs erősségkorlátozója, ezért csak teljes erővel játszik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lawan yang berbeda, dengan selera posisinya sendiri. Tidak punya pembatas kekuatan, jadi hanya bermain dengan kekuatan penuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un avversario diverso, con un proprio gusto per le posizioni. Non ha un limitatore di forza, quindi gioca solo a piena potenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "局面の好みが異なる、もう一人の対戦相手です。強さを制限する機能がないため、常に全力で指します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "국면 취향이 다른 또 하나의 상대입니다. 기력 제한 기능이 없어 항상 최대 기력으로만 둡니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lawan yang berbeza, dengan citarasanya sendiri terhadap kedudukan. Ia tiada pembatas kekuatan, jadi ia bermain pada kekuatan penuh sahaja."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere tegenstander, met een eigen smaak in stellingen. Hij heeft geen sterktebegrenzing en speelt dus alleen op volle kracht."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "En annen motstander med sin egen smak for stillinger. Den har ingen styrkebegrensning og spiller derfor bare på full styrke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inny przeciwnik, z własnym gustem do pozycji. Nie ma ogranicznika siły, więc gra wyłącznie z pełną siłą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um adversário diferente, com gosto próprio para as posições. Não tem limitador de força, então joga apenas em força total."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un adversar diferit, cu propriul gust pentru poziții. Nu are limitator de forță, așa că joacă doar la putere maximă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другой соперник со своим вкусом к позициям. У него нет ограничителя силы, поэтому он играет только в полную силу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En annan motståndare med egen smak för ställningar. Den har ingen styrkebegränsning och spelar därför bara på full styrka."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คู่ต่อสู้อีกแบบหนึ่งที่มีรสนิยมในตำแหน่งของตัวเอง ไม่มีตัวจำกัดความแข็งแกร่ง จึงเล่นเต็มกำลังเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozisyonlara kendi zevkiyle bakan farklı bir rakip. Güç sınırlayıcısı yok, bu yüzden yalnızca tam güçte oynar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một đối thủ khác, với gu thế trận riêng. Nó không có bộ giới hạn sức mạnh, nên chỉ chơi ở sức mạnh tối đa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一种对手，对局面有自己的偏好。它没有棋力限制功能，因此只以全力下棋。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一種對手，對局面有自己的偏好。它沒有棋力限制功能，因此只以全力下棋。"
          }
        }
      }
    },
