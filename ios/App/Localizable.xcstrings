    "play.theEnginePlaysAtThe": {
      "extractionState": "manual",
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Engine spielt in der Stärke, die du wählst. Der Trainer bewertet jeden deiner Züge, während du spielst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine plays at the strength you choose. Coaching grades each of your moves as you make it."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine plays at the strength you choose. Coaching grades each of your moves as you make it."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine plays at the strength you choose. Coaching grades each of your moves as you make it."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor juega con la fuerza que elijas. El entrenador valora cada una de tus jugadas mientras juegas."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur joue à la force que vous choisissez. L'entraîneur note chacun de vos coups au fil de la partie."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur joue à la force que vous choisissez. L'entraîneur note chacun de vos coups au fil de la partie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore gioca alla forza che scegli. L'allenatore valuta ogni tua mossa mentre giochi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O motor joga na força que você escolher. O treinador avalia cada lance seu enquanto você joga."
