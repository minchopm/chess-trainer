    "rush.theClockIsStillGoing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الساعة ما زالت تعمل. المغادرة الآن تنهي الجولة وتحتفظ بالنتيجة حتى الآن."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "الساعة ما زالت تعمل. المغادرة الآن تنهي الجولة وتحتفظ بالنتيجة حتى الآن."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Часовникът все още тиктака. Ако излезеш сега, серията приключва и запазва досегашния резултат."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্লক এখনও চলছে। এখন বেরিয়ে গেলে রান শেষ হয়ে যাবে, তবে এতক্ষণ পর্যন্ত পাওয়া স্কোর থেকে যাবে।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্লক এখনও চলছে। এখন বেরিয়ে গেলে রান শেষ হয়ে যাবে, তবে এতক্ষণ পর্যন্ত পাওয়া স্কোর থেকে যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El rellotge encara corre. Si en sortiu ara, acabareu la sessió i es conservarà la puntuació fins ara."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodiny stále běží. Odchod teď sérii ukončí a uloží dosavadní skóre."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uret kører stadig. Går du nu, slutter runden, og scoren indtil nu bliver gemt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr läuft noch. Wer jetzt geht, beendet den Lauf und behält den bisherigen Punktestand."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr läuft noch. Wer jetzt geht, beendet den Lauf und behält den bisherigen Punktestand."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ρολόι τρέχει ακόμη. Αν φύγεις τώρα, ο γύρος τελειώνει και κρατάς το σκορ μέχρι εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clock is still going. Leaving now ends the run and keeps the score so far."
          }
        },
        "en-AU": {
