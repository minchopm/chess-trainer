    "photo.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "صوّر اللوح كاملاً بحوافه داخل الإطار. أياً كانت النتيجة ستُفتح في المحرر لتصححها — الصورة تخطئ في بضعة مربعات حتى في أفضل حالاتها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyfoťte šachovnici celou, i s okraji v záběru. Cokoli z toho vyjde, otevře se v editoru k opravě — fotka se i v nejlepším případě splete v několika polích."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografér hele brættet med kanterne inden for rammen. Hvad der end kommer ud, åbnes i editoren, så du kan rette det — et foto tager fejl på et par felter selv når det går bedst."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiere das ganze Brett, mit den Rändern im Bild. Was dabei herauskommt, öffnet sich zum Korrigieren im Editor — ein Foto liegt selbst im besten Fall bei ein paar Feldern daneben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φωτογράφισε ολόκληρη τη σκακιέρα, με τις άκρες μέσα στο κάδρο. Ό,τι προκύψει ανοίγει στον επεξεργαστή για διόρθωση — μια φωτογραφία κάνει λάθος σε λίγα τετράγωνα ακόμη και στην καλύτερη περίπτωση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph the whole board with its edges in frame. Whatever comes out opens in the editor for you to correct — a photograph gets a few squares wrong even at its best."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph the whole board with its edges in frame. Whatever comes out opens in the editor for you to correct — a photograph gets a few squares wrong even at its best."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph the whole board with its edges in frame. Whatever comes out opens in the editor for you to correct — a photograph gets a few squares wrong even at its best."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografía el tablero entero, con los bordes dentro del encuadre. Lo que salga se abrirá en el editor para que lo corrijas: una foto se equivoca en algunas casillas incluso en el mejor de los casos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valokuvaa koko lauta reunoineen. Mitä tahansa siitä tuleekin, se avautuu editoriin korjattavaksi — kuva erehtyy muutaman ruudun kohdalla parhaimmillaankin."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Photographiez l’échiquier en entier, bords compris. Le résultat s’ouvre dans l’éditeur pour correction — une photo se trompe sur quelques cases même dans le meilleur des cas."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Photographiez l’échiquier en entier, bords compris. Le résultat s’ouvre dans l’éditeur pour correction — une photo se trompe sur quelques cases même dans le meilleur des cas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צלמו את הלוח כולו, עם הקצוות בתוך הפריים. מה שיצא ייפתח בעורך לתיקון — תמונה טועה בכמה משבצות גם במקרה הטוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरे बोर्ड की फ़ोटो लें, किनारे भी फ़्रेम में रखें। जो भी निकले वह संपादक में खुलेगा ताकि आप सुधार सकें — फ़ोटो सबसे अच्छी स्थिति में भी कुछ खाने ग़लत पढ़ती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fényképezd le az egész táblát, a széleivel együtt. Ami kijön, a szerkesztőben nyílik meg javításra — egy fotó a legjobb esetben is elront néhány mezőt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto seluruh papan, termasuk tepinya. Apa pun hasilnya akan dibuka di editor untuk kamu perbaiki — sebuah foto salah beberapa petak bahkan dalam kondisi terbaik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografa tutta la scacchiera, bordi compresi. Qualunque cosa ne esca si apre nell’editor perché tu la corregga: una foto sbaglia qualche casa anche nel migliore dei casi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "盤全体を、縁まで画面に入れて撮影してください。読み取った結果は編集画面で開くので直せます — 写真は最良の場合でも数マスを取り違えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보드 전체를 가장자리까지 넣어 촬영하세요. 결과는 편집기에서 열려 고칠 수 있습니다 — 사진은 아무리 잘 되어도 몇 칸은 틀립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambil foto seluruh papan, termasuk tepinya. Apa pun hasilnya akan dibuka dalam editor untuk anda betulkan — sebuah foto tersilap beberapa petak walaupun dalam keadaan terbaik."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografeer het hele bord, met de randen in beeld. Wat eruit komt, opent in de editor zodat je het kunt corrigeren — een foto zit er zelfs op zijn best een paar velden naast."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografer hele brettet, med kantene innenfor bildet. Hva som enn kommer ut, åpnes i editoren så du kan rette det — et foto bommer på et par felter selv på sitt beste."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sfotografuj całą szachownicę, z krawędziami w kadrze. Cokolwiek z tego wyjdzie, otworzy się w edytorze do poprawienia — zdjęcie myli się na kilku polach nawet w najlepszym razie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografe o tabuleiro inteiro, com as bordas dentro do enquadramento. O que sair abre no editor para você corrigir — uma foto erra algumas casas mesmo no melhor dos casos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiază toată tabla, cu marginile în cadru. Orice ar ieși se deschide în editor ca să corectezi — o fotografie greșește câteva pătrate chiar și în cel mai bun caz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сфотографируйте доску целиком, чтобы её края попали в кадр. Что бы ни получилось, оно откроется в редакторе для правки — снимок ошибается на нескольких полях даже в лучшем случае."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografera hela brädet, med kanterna inom bild. Vad som än kommer ut öppnas i editorn så att du kan rätta det — ett foto missar ett par rutor även när det går som bäst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ่ายภาพกระดานทั้งกระดาน ให้ขอบอยู่ในเฟรมด้วย ผลที่ได้จะเปิดในตัวแก้ไขให้คุณแก้ — ภาพถ่ายอ่านผิดอยู่สองสามช่องแม้ในกรณีที่ดีที่สุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahtanın tamamını, kenarları kadraja girecek şekilde çek. Ne çıkarsa düzeltmen için düzenleyicide açılır — bir fotoğraf en iyi durumda bile birkaç kareyi yanlış okur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chụp toàn bộ bàn cờ, kể cả các cạnh. Kết quả sẽ mở trong trình chỉnh sửa để bạn sửa — một tấm ảnh vẫn sai vài ô ngay cả khi tốt nhất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把整个棋盘连同边缘一起拍进画面。读出的结果会在编辑器中打开供你修正 — 照片即便在最好的情况下也会错上几格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把整個棋盤連同邊緣一起拍進畫面。讀出的結果會在編輯器中開啟供你修正 — 照片即便在最好的情況下也會錯上幾格。"
          }
        }
      }
    },
