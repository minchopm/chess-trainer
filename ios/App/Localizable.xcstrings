        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez une partie ou une position de départ, ou jouez simplement."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez une partie ou une position de départ, ou jouez simplement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדביקו משחק או עמדה להתחיל ממנה, או פשוט שחקו מהלכים."
