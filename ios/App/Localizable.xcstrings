    "play.abandonReason": {
      "extractionState": "manual",
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr seid %lld Züge weit. Wer jetzt geht, verliert die Partie, und sie wird nicht gewertet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are %lld moves in. Leaving now loses the game and it will not be recorded."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "You are %lld moves in. Leaving now loses the game and it will not be recorded."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You are %lld moves in. Leaving now loses the game and it will not be recorded."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleváis %lld jugadas. Si sales ahora pierdes la partida y no se registrará."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous en êtes à %lld coups. Partir maintenant, c'est perdre la partie, et elle ne sera pas enregistrée."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous en êtes à %lld coups. Partir maintenant, c'est perdre la partie, et elle ne sera pas enregistrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Siete a %lld mosse. Uscire adesso significa perdere la partita, e non verrà registrata."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Jullie zijn %lld zetten ver. Nu weggaan betekent verlies, en de partij wordt niet opgeslagen."
          }
        },
