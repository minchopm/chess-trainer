    "clip.invitationKept": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدعوة محفوظة. ثبّت التطبيق وستجدها بانتظارك."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "الدعوة محفوظة. ثبّت التطبيق وستجدها بانتظارك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Поканата е запазена. Инсталирайте приложението и тя ще ви чака."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমন্ত্রণটি সংরক্ষিত আছে। অ্যাপটি ইনস্টল করলে এটি অপেক্ষায় থাকবে।"
