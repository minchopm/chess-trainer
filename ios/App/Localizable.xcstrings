        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाज़ी सहेज ली गई है। Brass Pawn इंस्टॉल करें और यह इसी पर खुलेगा — 3D बोर्ड पर इसे दोबारा देखने और निर्णायक चाल से इंजन के ख़िलाफ़ आगे खेलने के लिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partija je spremljena. Instalirajte Brass Pawn i otvorit će se na njoj — za ponavljanje na 3D ploči i za nastavak igre od ključnog poteza protiv računala."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A játszma megmarad. Telepítsd a Brass Pawnt, és ezzel nyílik meg — visszajátszhatod 3D-s táblán, és a kulcslépéstől folytathatod a motor ellen."
          }
        },
        "id": {
