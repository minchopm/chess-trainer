    "settings.engine.stockfishSummary": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "أقوى محرك موجود، والوحيد هنا القادر على اللعب بتصنيف محدد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejsilnější engine, jaký existuje, a jediný zdejší, který umí hrát na zadané Elo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den stærkeste motor der findes, og den eneste her der kan spille på en bestemt rating."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die stärkste Engine überhaupt, und die einzige hier, die auf eine bestimmte Wertung heruntergestuft spielen kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ισχυρότερη μηχανή που υπάρχει, και η μόνη εδώ που μπορεί να παίξει σε συγκεκριμένο βαθμολογικό επίπεδο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The strongest engine there is, and the only one here that can play down to a rating."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The strongest engine there is, and the only one here that can play down to a rating."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The strongest engine there is, and the only one here that can play down to a rating."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor más fuerte que existe, y el único aquí que puede jugar a un Elo concreto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahvin moottori mitä on, ja ainoa täällä joka osaa pelata tietyllä ratingilla."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur le plus fort qui soit, et le seul ici capable de jouer à un niveau Elo donné."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur le plus fort qui soit, et le seul ici capable de jouer à un niveau Elo donné."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המנוע החזק ביותר שקיים, והיחיד כאן שיודע לשחק לפי דירוג נתון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूद सबसे मज़बूत इंजन, और यहाँ का इकलौता इंजन जो किसी तय रेटिंग पर खेल सकता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A létező legerősebb motor, és itt az egyetlen, amely adott Élő-pontszámon tud játszani."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesin terkuat yang ada, dan satu-satunya di sini yang bisa bermain pada rating tertentu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore più forte che esista, e l'unico qui capace di giocare a un Elo prestabilito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現存する最強のエンジンであり、ここで唯一、指定したレーティングまで手加減して指せるエンジンです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현존하는 가장 강한 엔진이며, 여기서 유일하게 지정한 레이팅에 맞춰 둘 수 있는 엔진입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjin terkuat yang ada, dan satu-satunya di sini yang boleh bermain pada penarafan tertentu."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De sterkste engine die er is, en de enige hier die op een bepaalde rating kan spelen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Den sterkeste motoren som finnes, og den eneste her som kan spille på en bestemt rating."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najsilniejszy silnik, jaki istnieje, i jedyny tutaj, który potrafi grać na zadanym poziomie rankingowym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O motor mais forte que existe, e o único aqui capaz de jogar em um rating definido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel mai puternic motor existent și singurul de aici care poate juca la un rating anume."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самый сильный движок из существующих и единственный здесь, который умеет играть на заданный рейтинг."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den starkaste motorn som finns, och den enda här som kan spela på en bestämd rating."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอนจินที่แข็งแกร่งที่สุดเท่าที่มี และเป็นตัวเดียวที่นี่ที่เล่นตามระดับเรตติงที่กำหนดได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Var olan en güçlü motor ve burada belirli bir puan seviyesinde oynayabilen tek motor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Engine mạnh nhất hiện có, và là engine duy nhất ở đây có thể chơi ở một mức Elo định sẵn."
          }
        },
