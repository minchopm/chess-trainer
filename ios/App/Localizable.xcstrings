    "play.engineHasNoLadder": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ يلعب بكامل قوته — لا يملك أداة لتحديد التصنيف. غيّر المحرك من الإعدادات للعب ضد خصم بتصنيف محدد."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ يلعب بكامل قوته — لا يملك أداة لتحديد التصنيف. غيّر المحرك من الإعدادات للعب ضد خصم بتصنيف محدد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ играе на пълна сила — няма ограничение на рейтинга. Сменете двигателя в Настройки, за да играете срещу съперник с рейтинг."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ পূর্ণ শক্তিতে খেলছে — এর কোনো রেটিং সীমা নেই। রেটেড প্রতিপক্ষের বিরুদ্ধে খেলতে Settings-এ ইঞ্জিন বদলান।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ পূর্ণ শক্তিতে খেলছে — এর কোনো রেটিং সীমা নেই। রেটেড প্রতিপক্ষের বিরুদ্ধে খেলতে Settings-এ ইঞ্জিন বদলান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ juga a ple rendiment — no té limitador de nivell. Canvia l’engine a Configuració per jugar contra un rival amb ELO."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hraje na plnou sílu – nemá omezovač Ela. Chcete-li hrát proti soupeři se zadaným Elem, změňte engine v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ spiller på fuld styrke – den har ingen ratingbegrænsning. Skift motor i Indstillinger for at møde en ratet modstander."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ spielt in voller Stärke – es gibt keine Stärkebegrenzung. Wechseln Sie die Engine in den Einstellungen, um gegen einen gewerteten Gegner zu spielen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ spielt in voller Stärke – es gibt keine Stärkebegrenzung. Wechseln Sie die Engine in den Einstellungen, um gegen einen gewerteten Gegner zu spielen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η %@ παίζει με πλήρη δύναμη — δεν έχει περιοριστή βαθμολογίας. Αλλάξτε μηχανή στις Ρυθμίσεις για να παίξετε με αντίπαλο συγκεκριμένης βαθμολογίας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ plays at full strength — it has no rating limiter. Change the engine in Settings to play a rated opponent."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ plays at full strength — it has no rating limiter. Change the engine in Settings to play a rated opponent."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ plays at full strength — it has no rating limiter. Change the engine in Settings to play a rated opponent."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ plays at full strength — it has no rating limiter. Change the engine in Settings to play a rated opponent."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ plays at full strength — it has no rating limiter. Change the engine in Settings to play a rated opponent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ juega a plena potencia: no tiene limitador de nivel. Cambia el motor en Ajustes para jugar contra un rival con Elo."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ juega a plena potencia: no tiene limitador de nivel. Cambia el motor en Ajustes para jugar contra un rival con Elo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ juega a toda su fuerza — no tiene limitador de Elo. Cambia el motor en Configuración para jugar contra un oponente con Elo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pelaa täydellä voimalla – siinä ei ole rating-rajoitinta. Vaihda moottoria asetuksissa, jos haluat pelata ratingiltaan määriteltyä vastustajaa vastaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ joue à pleine puissance : il n'a pas de limiteur de niveau. Changez de moteur dans les Réglages pour affronter un adversaire classé."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ joue à pleine puissance : il n'a pas de limiteur de niveau. Changez de moteur dans les Réglages pour affronter un adversaire classé."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ joue à pleine puissance : il n'a pas de limiteur de niveau. Changez de moteur dans les Réglages pour affronter un adversaire classé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ પૂરી શક્તિથી રમે છે — તેમાં કોઈ રેટિંગ મર્યાદા નથી. રેટેડ પ્રતિસ્પર્ધી સામે રમવા માટે Settings માં એન્જિન બદલો."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ પૂરી શક્તિથી રમે છે — તેમાં કોઈ રેટિંગ મર્યાદા નથી. રેટેડ પ્રતિસ્પર્ધી સામે રમવા માટે Settings માં એન્જિન બદલો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ משחק בעוצמה מלאה — אין לו מגביל דירוג. החליפו מנוע בהגדרות כדי לשחק מול יריב מדורג."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पूरी ताक़त से खेलता है — इसमें रेटिंग सीमित करने की सुविधा नहीं है। रेटिंग वाले प्रतिद्वंद्वी से खेलने के लिए सेटिंग्स में इंजन बदलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ igra punom snagom — nema ograničenje rejtinga. U Postavkama promijenite engine kako biste igrali protiv protivnika s rejtingom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ teljes erővel játszik – nincs pontszámkorlátozója. Váltson motort a Beállításokban, ha adott erősségű ellenfél ellen szeretne játszani."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bermain dengan kekuatan penuh — tidak ada pembatas rating. Ganti mesin di Pengaturan untuk melawan lawan berperingkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gioca a piena potenza: non ha un limitatore di livello. Cambia motore nelle Impostazioni per affrontare un avversario con Elo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は全力で指します。レーティング制限の機能がありません。レーティングを指定した相手と対局するには、設定でエンジンを切り替えてください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ толық күшпен ойнайды — онда рейтинг шектеуі жоқ. Рейтингті қарсыласқа қарсы ойнау үшін Қондырмаларда қозғалтқышты өзгертіңіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಸಂಪೂರ್ಣ ಶಕ್ತಿಯಲ್ಲಿ ಆಡುತ್ತದೆ — ಅದಕ್ಕೆ ಯಾವುದೇ ರೇಟಿಂಗ್ ಮಿತಿ ಇಲ್ಲ. ರೇಟೆಡ್ ಎದುರಾಳಿಯೊಂದಿಗೆ ಆಡಲು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಎಂಜಿನ್ ಅನ್ನು ಬದಲಾಯಿಸಿ."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಸಂಪೂರ್ಣ ಶಕ್ತಿಯಲ್ಲಿ ಆಡುತ್ತದೆ — ಅದಕ್ಕೆ ಯಾವುದೇ ರೇಟಿಂಗ್ ಮಿತಿ ಇಲ್ಲ. ರೇಟೆಡ್ ಎದುರಾಳಿಯೊಂದಿಗೆ ಆಡಲು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಎಂಜಿನ್ ಅನ್ನು ಬದಲಾಯಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 은(는) 최대 기력으로 둡니다. 레이팅 제한 기능이 없습니다. 레이팅이 정해진 상대와 두려면 설정에서 엔진을 바꾸세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ പൂർണ്ണ ശക്തിയിലാണ് കളിക്കുന്നത് — അതിന് റേറ്റിംഗ് പരിമിതി ഇല്ല. റേറ്റുചെയ്ത എതിരാളനെതിരെ കളിക്കാനായി Settings-ൽ എഞ്ചിൻ മാറ്റുക."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ പൂർണ്ണ ശക്തിയിലാണ് കളിക്കുന്നത് — അതിന് റേറ്റിംഗ് പരിമിതി ഇല്ല. റേറ്റുചെയ്ത എതിരാളനെതിരെ കളിക്കാനായി Settings-ൽ എഞ്ചിൻ മാറ്റുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पूर्ण शक्तीने खेळतो — त्यावर रेटिंग मर्यादा नाही. रेटेड प्रतिस्पर्ध्याविरुद्ध खेळण्यासाठी सेटिंग्जमध्ये एंजिन बदला."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पूर्ण शक्तीने खेळतो — त्यावर रेटिंग मर्यादा नाही. रेटेड प्रतिस्पर्ध्याविरुद्ध खेळण्यासाठी सेटिंग्जमध्ये एंजिन बदला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bermain pada kekuatan penuh — ia tiada pembatas penarafan. Tukar enjin dalam Tetapan untuk bermain menentang lawan bertaraf."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ spiller på full styrke – den har ingen ratingbegrensning. Bytt motor i Innstillinger for å møte en ratet motstander."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ speelt op volle kracht — er is geen ratingbegrenzing. Wissel van engine in Instellingen om tegen een gewaardeerde tegenstander te spelen."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ speelt op volle kracht — er is geen ratingbegrenzing. Wissel van engine in Instellingen om tegen een gewaardeerde tegenstander te spelen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ spiller på full styrke – den har ingen ratingbegrensning. Bytt motor i Innstillinger for å møte en ratet motstander."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ସମ୍ପୂର୍ଣ୍ଣ ଶକ୍ତିରେ ଖେଳେ — ଏହାର କୌଣସି ରେଟିଂ ସୀମା ନାହିଁ। ରେଟେଡ୍ ପ୍ରତିଦ୍ୱନ୍ଦୀ ବିରୁଦ୍ଧରେ ଖେଳିବାକୁ Settingsରେ ଇଞ୍ଜିନ୍ ପରିବର୍ତ୍ତନ କରନ୍ତୁ।"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ସମ୍ପୂର୍ଣ୍ଣ ଶକ୍ତିରେ ଖେଳେ — ଏହାର କୌଣସି ରେଟିଂ ସୀମା ନାହିଁ। ରେଟେଡ୍ ପ୍ରତିଦ୍ୱନ୍ଦୀ ବିରୁଦ୍ଧରେ ଖେଳିବାକୁ Settingsରେ ଇଞ୍ଜିନ୍ ପରିବର୍ତ୍ତନ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਪੂਰੀ ਤਾਕਤ ਨਾਲ ਖੇਡਦਾ ਹੈ — ਇਸ ਉੱਤੇ ਕੋਈ ਰੇਟਿੰਗ ਸੀਮਾ ਨਹੀਂ। ਰੇਟ ਕੀਤੇ ਵਿਰੋਧੀ ਨਾਲ ਖੇਡਣ ਲਈ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਇੰਜਨ ਬਦਲੋ।"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਪੂਰੀ ਤਾਕਤ ਨਾਲ ਖੇਡਦਾ ਹੈ — ਇਸ ਉੱਤੇ ਕੋਈ ਰੇਟਿੰਗ ਸੀਮਾ ਨਹੀਂ। ਰੇਟ ਕੀਤੇ ਵਿਰੋਧੀ ਨਾਲ ਖੇਡਣ ਲਈ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਇੰਜਨ ਬਦਲੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gra z pełną siłą — nie ma ogranicznika rankingu. Zmień silnik w Ustawieniach, aby zagrać z przeciwnikiem o określonym rankingu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ joga em força total: não tem limitador de nível. Troque o motor nos Ajustes para enfrentar um adversário com rating."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ joga em força total: não tem limitador de nível. Troque o motor nos Ajustes para enfrentar um adversário com rating."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ joga à força total — não tem limitador de rating. Muda o motor nas Definições para jogares contra um adversário com rating."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ joacă la putere maximă – nu are limitator de rating. Schimbă motorul în Setări pentru a juca împotriva unui adversar cu rating."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ играет в полную силу — у него нет ограничителя рейтинга. Смените движок в настройках, чтобы играть с соперником заданного рейтинга."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hrá na plný výkon — nemá obmedzovač hodnotenia. Ak chcete hrať súpera s ratingom, zmeňte engine v Nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ igra s polno močjo — nima omejitve Elo. V Nastavitvah spremenite pogon, če želite igrati proti rangiranemu nasprotniku."
          }
        },
        "sl-SI": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ igra s polno močjo — nima omejitve Elo. V Nastavitvah spremenite pogon, če želite igrati proti rangiranemu nasprotniku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ spelar på full styrka – den har ingen ratingbegränsning. Byt motor i Inställningar för att möta en ratad motståndare."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ முழு வலிமையுடன் விளையாடுகிறது — அதற்கு மதிப்பீட்டு வரம்பு இல்லை. மதிப்பிடப்பட்ட எதிரணியுடன் விளையாட, அமைப்புகளில் எஞ்சினை மாற்றவும்."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ முழு வலிமையுடன் விளையாடுகிறது — அதற்கு மதிப்பீட்டு வரம்பு இல்லை. மதிப்பிடப்பட்ட எதிரணியுடன் விளையாட, அமைப்புகளில் எஞ்சினை மாற்றவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ పూర్తి శక్తితో ఆడుతుంది — దానికి రేటింగ్ పరిమితి లేదు. రేటెడ్ ప్రత్యర్థిని ఆడాలంటే సెట్టింగ్స్‌లో ఇంజిన్‌ను మార్చండి."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ పూర్తి శక్తితో ఆడుతుంది — దానికి రేటింగ్ పరిమితి లేదు. రేటెడ్ ప్రత్యర్థిని ఆడాలంటే సెట్టింగ్స్‌లో ఇంజిన్‌ను మార్చండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ เล่นเต็มกำลัง — ไม่มีตัวจำกัดเรตติง เปลี่ยนเอนจินในการตั้งค่าเพื่อเล่นกับคู่ต่อสู้ที่มีเรตติง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tam güçte oynar — puan sınırlayıcısı yoktur. Puanlı bir rakibe karşı oynamak için Ayarlar'dan motoru değiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ грає на повну силу — у нього немає обмеження рейтингу. Змініть рушій у Налаштуваннях, щоб грати з суперником певного рейтингу"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ پوری طاقت سے کھیلتا ہے — اس پر کوئی ریٹنگ پابندی نہیں۔ ریٹنگ والا حریف کھیلنے کے لیے سیٹنگز میں انجن بدلیں۔"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ پوری طاقت سے کھیلتا ہے — اس پر کوئی ریٹنگ پابندی نہیں۔ ریٹنگ والا حریف کھیلنے کے لیے سیٹنگز میں انجن بدلیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chơi ở sức mạnh tối đa — nó không có bộ giới hạn Elo. Hãy đổi engine trong Cài đặt để chơi với đối thủ có Elo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 以全力下棋——它没有等级分限制功能。若要与有等级分的对手下棋，请在设置中更换引擎。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 以全力下棋——它沒有等級分限制功能。若要與有等級分的對手下棋，請在設定中更換引擎。"
          }
        }
      }
    },
