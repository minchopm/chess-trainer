        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બોર્ડની કિનારીઓ ફ્રેમમાં આવે એવી રીતે આખું બોર્ડ ફોટોગ્રાફ કરો. જે બહાર આવે તે તમને સુધારવા માટે એડિટરમાં ખુલે છે — ફોટો એની શ્રેષ્ઠ સ્થિતિમાં પણ થોડાં ચોરસ ખોટાં વાંચે છે."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "બોર્ડની કિનારીઓ ફ્રેમમાં આવે એવી રીતે આખું બોર્ડ ફોટોગ્રાફ કરો. જે બહાર આવે તે તમને સુધારવા માટે એડિટરમાં ખુલે છે — ફોટો એની શ્રેષ્ઠ સ્થિતિમાં પણ થોડાં ચોરસ ખોટાં વાંચે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צלמו את הלוח כולו, עם הקצוות בתוך הפריים. מה שיצא ייפתח בעורך לתיקון — תמונה טועה בכמה משבצות גם במקרה הטוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरे बोर्ड की फ़ोटो लें, किनारे भी फ़्रेम में रखें। जो भी निकले वह संपादक में खुलेगा ताकि आप सुधार सकें — फ़ोटो सबसे अच्छी स्थिति में भी कुछ खाने ग़लत पढ़ती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiraj cijelu ploču tako da joj rubovi budu u kadru. Što god ispadne, otvara se u uređivaču da to ispraviš — fotografija i u najboljem slučaju promaši nekoliko polja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fényképezd le az egész táblát, a széleivel együtt. Ami kijön, a szerkesztőben nyílik meg javításra — egy fotó a legjobb esetben is elront néhány mezőt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto seluruh papan, termasuk tepinya. Apa pun hasilnya akan dibuka di editor untuk kamu perbaiki — sebuah foto salah beberapa petak bahkan dalam kondisi terbaik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografa tutta la scacchiera, bordi compresi. Qualunque cosa ne esca si apre nell’editor perché tu la corregga: una foto sbaglia qualche casa anche nel migliore dei casi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "盤全体を、縁まで画面に入れて撮影してください。読み取った結果は編集画面で開くので直せます — 写真は最良の場合でも数マスを取り違えます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тақтаны шеттерімен бірге толық түсіріңіз. Шыққан нәтиже түзету үшін редакторда ашылады — фото ең жақсысының өзінде бірнеше шаршыны қате таниды."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬೋರ್ಡ್‌ನ ಅಂಚುಗಳು ಫ್ರೇಮ್‌ನಲ್ಲಿ ಕಾಣುವಂತೆ ಸಂಪೂರ್ಣ ಬೋರ್ಡ್‌ನ ಫೋಟೋ ತೆಗೆದುಕೊಳ್ಳಿ. ಏನು ಬಂದರೂ ಅದನ್ನು ತಿದ್ದುಪಡಿ ಮಾಡಲು ಅದು ಎಡಿಟರ್‌ನಲ್ಲಿ ತೆರೆಯುತ್ತದೆ — ಫೋಟೋ ಅತ್ಯುತ್ತಮವಾಗಿದ್ದರೂ ಕೆಲವು ಚೌಕಗಳನ್ನು ತಪ್ಪಾಗಿ ಓದಬಹುದು."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬೋರ್ಡ್‌ನ ಅಂಚುಗಳು ಫ್ರೇಮ್‌ನಲ್ಲಿ ಕಾಣುವಂತೆ ಸಂಪೂರ್ಣ ಬೋರ್ಡ್‌ನ ಫೋಟೋ ತೆಗೆದುಕೊಳ್ಳಿ. ಏನು ಬಂದರೂ ಅದನ್ನು ತಿದ್ದುಪಡಿ ಮಾಡಲು ಅದು ಎಡಿಟರ್‌ನಲ್ಲಿ ತೆರೆಯುತ್ತದೆ — ಫೋಟೋ ಅತ್ಯುತ್ತಮವಾಗಿದ್ದರೂ ಕೆಲವು ಚೌಕಗಳನ್ನು ತಪ್ಪಾಗಿ ಓದಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보드 전체를 가장자리까지 넣어 촬영하세요. 결과는 편집기에서 열려 고칠 수 있습니다 — 사진은 아무리 잘 되어도 몇 칸은 틀립니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബോർഡിന്റെ അതിരുകളും ഫ്രെയിമിൽ ഉൾപ്പെടുത്തി മുഴുവൻ ബോർഡിന്റെയും ഫോട്ടോ എടുക്കുക. പുറത്തുവരുന്നതെന്തും നിങ്ങൾ തിരുത്താനായി എഡിറ്ററിൽ തുറക്കും — ഫോട്ടോയ്ക്ക് ഏറ്റവും നല്ല സാഹചര്യത്തിലും കുറച്ച് ചതുരങ്ങൾ തെറ്റിയേക്കാം."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ബോർഡിന്റെ അതിരുകളും ഫ്രെയിമിൽ ഉൾപ്പെടുത്തി മുഴുവൻ ബോർഡിന്റെയും ഫോട്ടോ എടുക്കുക. പുറത്തുവരുന്നതെന്തും നിങ്ങൾ തിരുത്താനായി എഡിറ്ററിൽ തുറക്കും — ഫോട്ടോയ്ക്ക് ഏറ്റവും നല്ല സാഹചര്യത്തിലും കുറച്ച് ചതുരങ്ങൾ തെറ്റിയേക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कडा फ्रेममध्ये येतील अशा प्रकारे संपूर्ण पटाचा फोटो काढा. जे काही बाहेर येईल ते तुम्ही दुरुस्त करण्यासाठी एडिटरमध्ये उघडते — फोटो उत्तम असला तरी तो काही चौकोन चुकवू शकतो."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "कडा फ्रेममध्ये येतील अशा प्रकारे संपूर्ण पटाचा फोटो काढा. जे काही बाहेर येईल ते तुम्ही दुरुस्त करण्यासाठी एडिटरमध्ये उघडते — फोटो उत्तम असला तरी तो काही चौकोन चुकवू शकतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambil foto seluruh papan, termasuk tepinya. Apa pun hasilnya akan dibuka dalam editor untuk anda betulkan — sebuah foto tersilap beberapa petak walaupun dalam keadaan terbaik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografer hele brettet, med kantene innenfor bildet. Hva som enn kommer ut, åpnes i editoren så du kan rette det — et foto bommer på et par felter selv på sitt beste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografeer het hele bord, met de randen in beeld. Wat eruit komt, opent in de editor zodat je het kunt corrigeren — een foto zit er zelfs op zijn best een paar velden naast."
          }
        },
        "nl-NL": {
