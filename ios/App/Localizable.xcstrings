    "store.freeForever": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اللعب يبقى مجانًا — أمام المحرّك وأمام الناس، بلا حدود وبلا إعلانات. ما يفتحه Pro هو التدريب."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "اللعب يبقى مجانًا — أمام المحرّك وأمام الناس، بلا حدود وبلا إعلانات. ما يفتحه Pro هو التدريب."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Игрането остава безплатно — срещу машината и срещу хора, без ограничение и без реклами. Pro отключва тренировките."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "খেলা বিনা খরচে থাকে — ইঞ্জিনের বিপক্ষে আর মানুষের বিপক্ষে, কোনো সীমা ছাড়া আর বিজ্ঞাপন ছাড়া। Pro যা খুলে দেয়, তা হলো প্রশিক্ষণ।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "খেলা বিনা খরচে থাকে — ইঞ্জিনের বিপক্ষে আর মানুষের বিপক্ষে, কোনো সীমা ছাড়া আর বিজ্ঞাপন ছাড়া। Pro যা খুলে দেয়, তা হলো প্রশিক্ষণ।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Jugar continua sent gratuït — contra el motor i contra persones, sense límit i sense anuncis. El que desbloqueja Pro és l’entrenament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hraní zůstává zdarma — proti enginu i proti lidem, bez omezení a bez reklam. Pro odemyká trénink."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At spille er stadig gratis — mod motoren og mod mennesker, uden grænser og uden reklamer. Det Pro låser op for, er træningen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielen bleibt kostenlos — gegen die Engine wie gegen Menschen, ohne Grenze und ohne Werbung. Pro schaltet das Training frei."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielen bleibt kostenlos — gegen die Engine wie gegen Menschen, ohne Grenze und ohne Werbung. Pro schaltet das Training frei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το παιχνίδι μένει δωρεάν — απέναντι στη μηχανή και απέναντι σε ανθρώπους, χωρίς όριο και χωρίς διαφημίσεις. Αυτό που ξεκλειδώνει το Pro είναι η προπόνηση."
          }
        },
        "en": {
          "stringUnit": {
