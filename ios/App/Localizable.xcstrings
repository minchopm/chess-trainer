    "store.renewalTerms": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتجدّد الخطة الشهرية كل شهر حتى تُلغيها. يمكنك الإلغاء في أي وقت من الإعدادات › حساب Apple › الاشتراكات، قبل يوم واحد على الأقل من التجديد. الفتح لمرة واحدة دفعة واحدة ولا يتجدّد أبدًا."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تتجدّد الخطة الشهرية كل شهر حتى تُلغيها. يمكنك الإلغاء في أي وقت من الإعدادات › حساب Apple › الاشتراكات، قبل يوم واحد على الأقل من التجديد. الفتح لمرة واحدة دفعة واحدة ولا يتجدّد أبدًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Месечният план се подновява всеки месец, докато не го отмените. Можете да го отмените по всяко време в Settings › Apple Account › Subscriptions, поне ден преди да се поднови. Еднократното отключване е еднократно плащане и не се подновява."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাসিক প্ল্যান আপনি বাতিল না করা পর্যন্ত প্রতি মাসে নবায়ন হয়। Settings › Apple Account › Subscriptions-এ গিয়ে, এটি নবায়ন হওয়ার অন্তত এক দিন আগে যেকোনো সময় বাতিল করতে পারেন। এককালীন আনলক একবারের পেমেন্ট, এবং এটি কখনও নবায়ন হয় না।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "মাসিক প্ল্যান আপনি বাতিল না করা পর্যন্ত প্রতি মাসে নবায়ন হয়। Settings › Apple Account › Subscriptions-এ গিয়ে, এটি নবায়ন হওয়ার অন্তত এক দিন আগে যেকোনো সময় বাতিল করতে পারেন। এককালীন আনলক একবারের পেমেন্ট, এবং এটি কখনও নবায়ন হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El pla mensual es renova cada mes fins que el cancel·leu. Podeu cancel·lar-lo en qualsevol moment a Configuració › Apple Account › Subscripcions, almenys un dia abans que es renovi. El desbloqueig únic és un únic pagament i no es renova mai."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měsíční plán se obnovuje každý měsíc, dokud ho nezrušíš. Zrušit můžeš kdykoli v Nastavení › Účet Apple › Předplatná, nejpozději den před obnovením. Jednorázové odemčení je jediná platba a nikdy se neobnovuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Månedsabonnementet fornyes hver måned, indtil du opsiger det. Du kan opsige når som helst i Indstillinger › Apple-konto › Abonnementer, senest en dag før fornyelsen. Engangskøbet er en enkelt betaling og fornyes aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Monatsabo verlängert sich jeden Monat, bis du kündigst. Kündigen kannst du jederzeit unter Einstellungen › Apple-Account › Abonnements, spätestens einen Tag vor der Verlängerung. Die einmalige Freischaltung ist eine einzelne Zahlung und verlängert sich nie."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Monatsabo verlängert sich jeden Monat, bis du kündigst. Kündigen kannst du jederzeit unter Einstellungen › Apple-Account › Abonnements, spätestens einen Tag vor der Verlängerung. Die einmalige Freischaltung ist eine einzelne Zahlung und verlängert sich nie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μηνιαία συνδρομή ανανεώνεται κάθε μήνα μέχρι να την ακυρώσεις. Μπορείς να ακυρώσεις οποτεδήποτε από Ρυθμίσεις › Λογαριασμός Apple › Συνδρομές, τουλάχιστον μία μέρα πριν την ανανέωση. Το εφάπαξ ξεκλείδωμα είναι μία πληρωμή και δεν ανανεώνεται ποτέ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The monthly plan renews each month until you cancel it. Cancel any time in Settings › Apple Account › Subscriptions, at least a day before it renews. The one-off unlock is a single payment and never renews."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The monthly plan renews each month until you cancel it. Cancel any time in Settings › Apple Account › Subscriptions, at least a day before it renews. The one-off unlock is a single payment and never renews."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The monthly plan renews each month until you cancel it. Cancel any time in Settings › Apple Account › Subscriptions, at least a day before it renews. The one-off unlock is a single payment and never renews."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The monthly plan renews each month until you cancel it. Cancel any time in Settings › Apple Account › Subscriptions, at least a day before it renews. The one-off unlock is a single payment and never renews."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The monthly plan renews each month until you cancel it. Cancel any time in Settings › Apple Account › Subscriptions, at least a day before it renews. The one-off unlock is a single payment and never renews."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan mensual se renueva cada mes hasta que lo canceles. Puedes cancelarlo cuando quieras en Ajustes › Cuenta de Apple › Suscripciones, al menos un día antes de la renovación. El pago único es un solo cobro y nunca se renueva."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan mensual se renueva cada mes hasta que lo canceles. Puedes cancelarlo cuando quieras en Ajustes › Cuenta de Apple › Suscripciones, al menos un día antes de la renovación. El pago único es un solo cobro y nunca se renueva."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan mensual se renueva cada mes hasta que lo canceles. Cancélalo cuando quieras en Configuración › Apple Account › Suscripciones, al menos un día antes de que se renueve. El desbloqueo único es un pago único y nunca se renueva."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuukausitilaus uusiutuu joka kuukausi, kunnes peruutat sen. Voit peruuttaa milloin tahansa: Asetukset › Apple-tili › Tilaukset, viimeistään vuorokautta ennen uusiutumista. Kertaosto on yksi maksu eikä uusiudu koskaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abonnement mensuel se renouvelle chaque mois jusqu'à résiliation. Vous pouvez résilier à tout moment dans Réglages › Compte Apple › Abonnements, au moins un jour avant le renouvellement. L'achat unique est un paiement unique et ne se renouvelle jamais."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abonnement mensuel se renouvelle chaque mois jusqu'à résiliation. Vous pouvez résilier à tout moment dans Réglages › Compte Apple › Abonnements, au moins un jour avant le renouvellement. L'achat unique est un paiement unique et ne se renouvelle jamais."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abonnement mensuel se renouvelle chaque mois jusqu'à résiliation. Vous pouvez résilier à tout moment dans Réglages › Compte Apple › Abonnements, au moins un jour avant le renouvellement. L'achat unique est un paiement unique et ne se renouvelle jamais."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "માસિક પ્લાન તમે રદ કરો ત્યાં સુધી દર મહિને નવીકરણ થાય છે. Settings › Apple Account › Subscriptions માં, તે નવીકરણ થાય તે પહેલાં ઓછામાં ઓછો એક દિવસ રાખીને કોઈપણ સમયે રદ કરો. એકમાત્ર અનલૉક એક જ ચુકવણી છે અને ક્યારેય નવીકરણ થતું નથી."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "માસિક પ્લાન તમે રદ કરો ત્યાં સુધી દર મહિને નવીકરણ થાય છે. Settings › Apple Account › Subscriptions માં, તે નવીકરણ થાય તે પહેલાં ઓછામાં ઓછો એક દિવસ રાખીને કોઈપણ સમયે રદ કરો. એકમાત્ર અનલૉક એક જ ચુકવણી છે અને ક્યારેય નવીકરણ થતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התוכנית החודשית מתחדשת מדי חודש עד שתבטל. אפשר לבטל בכל עת בהגדרות › חשבון Apple › מינויים, לפחות יום לפני החידוש. הרכישה החד-פעמית היא תשלום יחיד ולעולם אינה מתחדשת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मासिक योजना हर महीने तब तक नवीनीकृत होती है जब तक आप रद्द न करें। सेटिंग्स › Apple खाता › सदस्यताएँ में कभी भी, नवीनीकरण से कम से कम एक दिन पहले रद्द किया जा सकता है। एक बार का भुगतान सिर्फ़ एक ही भुगतान है और कभी नवीनीकृत नहीं होता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mjesečni plan obnavlja se svaki mjesec dok ga ne otkažete. Otkažite bilo kada u Postavke › Apple Account › Pretplate, najmanje jedan dan prije obnove. Trajno otključavanje jednokratna je uplata i nikad se ne obnavlja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A havi csomag minden hónapban megújul, amíg le nem mondod. Bármikor lemondhatod a Beállítások › Apple-fiók › Előfizetések menüben, legkésőbb egy nappal a megújulás előtt. Az egyszeri feloldás egyetlen fizetés, és soha nem újul meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket bulanan diperpanjang tiap bulan sampai kamu batalkan. Batalkan kapan saja di Pengaturan › Akun Apple › Langganan, paling lambat sehari sebelum perpanjangan. Pembukaan sekali bayar adalah pembayaran tunggal dan tidak pernah diperpanjang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano mensile si rinnova ogni mese finché non lo disdici. Puoi disdire quando vuoi in Impostazioni › Account Apple › Abbonamenti, almeno un giorno prima del rinnovo. Lo sblocco una tantum è un pagamento singolo e non si rinnova mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月額プランは解約するまで毎月自動更新されます。解約は「設定 › Apple アカウント › サブスクリプション」から、更新日の 1 日前までにいつでも行えます。買い切りは一度きりの支払いで、更新はありません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айлық жоспар сіз тоқтатқанға дейін әр ай сайын жаңарады. Кез келген уақытта Settings › Apple Account › Subscriptions бөлімінде, жаңарғанына кемі бір күн қалғанда тоқтатыңыз. Бір реттік ашу — бір ғана төлем, ешқашан жаңармайды."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಾಸಿಕ ಯೋಜನೆ ನೀವು ರದ್ದುಪಡಿಸುವ ತನಕ ಪ್ರತಿ ತಿಂಗಳು ನವೀಕರಿಸುತ್ತದೆ. Settings › Apple Account › Subscriptions ನಲ್ಲಿ, ಅದು ನವೀಕರಿಸುವುದಕ್ಕೆ ಕನಿಷ್ಠ ಒಂದು ದಿನ ಮೊದಲು ಯಾವಾಗ ಬೇಕಾದರೂ ರದ್ದುಪಡಿಸಬಹುದು. ಒಮ್ಮೆ ಮಾತ್ರ ಅನ್ಲಾಕ್ ಒಂದು ಏಕಕಾಲಿಕ ಪಾವತಿ; ಅದು ಎಂದಿಗೂ ನವೀಕರಿಸುವುದಿಲ್ಲ."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಾಸಿಕ ಯೋಜನೆ ನೀವು ರದ್ದುಪಡಿಸುವ ತನಕ ಪ್ರತಿ ತಿಂಗಳು ನವೀಕರಿಸುತ್ತದೆ. Settings › Apple Account › Subscriptions ನಲ್ಲಿ, ಅದು ನವೀಕರಿಸುವುದಕ್ಕೆ ಕನಿಷ್ಠ ಒಂದು ದಿನ ಮೊದಲು ಯಾವಾಗ ಬೇಕಾದರೂ ರದ್ದುಪಡಿಸಬಹುದು. ಒಮ್ಮೆ ಮಾತ್ರ ಅನ್ಲಾಕ್ ಒಂದು ಏಕಕಾಲಿಕ ಪಾವತಿ; ಅದು ಎಂದಿಗೂ ನವೀಕರಿಸುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월간 요금제는 해지할 때까지 매달 자동으로 갱신됩니다. 설정 › Apple 계정 › 구독에서 갱신 하루 전까지 언제든 해지할 수 있습니다. 한 번만 결제하는 잠금 해제는 단일 결제이며 갱신되지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മാസപദ്ധതി നിങ്ങൾ റദ്ദാക്കുന്നതുവരെ ഓരോ മാസവും പുതുക്കപ്പെടും. അത് പുതുക്കുന്നതിന് കുറഞ്ഞത് ഒരു ദിവസം മുൻപ്, Settings › Apple Account › Subscriptions-ൽ ഏത് സമയത്തും റദ്ദാക്കാം. ഒറ്റത്തവണ തുറക്കൽ ഒറ്റ പേയ്മെന്റാണ്, അത് ഒരിക്കലും പുതുക്കില്ല."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "മാസപദ്ധതി നിങ്ങൾ റദ്ദാക്കുന്നതുവരെ ഓരോ മാസവും പുതുക്കപ്പെടും. അത് പുതുക്കുന്നതിന് കുറഞ്ഞത് ഒരു ദിവസം മുൻപ്, Settings › Apple Account › Subscriptions-ൽ ഏത് സമയത്തും റദ്ദാക്കാം. ഒറ്റത്തവണ തുറക്കൽ ഒറ്റ പേയ്മെന്റാണ്, അത് ഒരിക്കലും പുതുക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मासिक योजना तुम्ही रद्द करेपर्यंत दर महिन्याला नूतनीकरण होते. Settings › Apple Account › Subscriptions मध्ये, ती नूतनीकरण होण्याच्या किमान एक दिवस आधी कधीही रद्द करा. एकदाच अनलॉक हे एकच पेमेंट आहे आणि कधीच नूतनीकरण होत नाही."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "मासिक योजना तुम्ही रद्द करेपर्यंत दर महिन्याला नूतनीकरण होते. Settings › Apple Account › Subscriptions मध्ये, ती नूतनीकरण होण्याच्या किमान एक दिवस आधी कधीही रद्द करा. एकदाच अनलॉक हे एकच पेमेंट आहे आणि कधीच नूतनीकरण होत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelan bulanan diperbaharui setiap bulan sehingga anda membatalkannya. Batalkan bila-bila masa di Tetapan › Akaun Apple › Langganan, sekurang-kurangnya sehari sebelum pembaharuan. Pembukaan sekali bayar ialah bayaran tunggal dan tidak pernah diperbaharui."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Månedsplanen fornyes hver måned til du sier den opp. Du kan si opp når som helst i Innstillinger › Apple-konto › Abonnementer, senest en dag før fornyelsen. Engangskjøpet er én betaling og fornyes aldri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het maandabonnement verlengt elke maand tot je opzegt. Opzeggen kan altijd via Instellingen › Apple-account › Abonnementen, uiterlijk een dag voor de verlenging. De eenmalige ontgrendeling is één betaling en verlengt nooit."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Het maandabonnement verlengt elke maand tot je opzegt. Opzeggen kan altijd via Instellingen › Apple-account › Abonnementen, uiterlijk een dag voor de verlenging. De eenmalige ontgrendeling is één betaling en verlengt nooit."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Månedsplanen fornyes hver måned til du sier den opp. Du kan si opp når som helst i Innstillinger › Apple-konto › Abonnementer, senest en dag før fornyelsen. Engangskjøpet er én betaling og fornyes aldri."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ମାସିକ ପ୍ଲାନ୍ ଆପଣ ବାତିଲ୍ କରିବା ପର୍ଯ୍ୟନ୍ତ ପ୍ରତିମାସ ପୁନର୍ନବୀକରଣ ହୁଏ। Settings › Apple Account › Subscriptions ଭିତରେ ଯେକୌଣସି ସମୟରେ ବାତିଲ୍ କରନ୍ତୁ, ପୁନର୍ନବୀକରଣ ହେବାର କମ୍‌ରେ କମ୍‌ ଗୋଟିଏ ଦିନ ପୂର୍ବରୁ। ଏକମାତ୍ର ଅନଲକ୍ ହେଉଛି ଗୋଟିଏ ଥରର ପେମେଣ୍ଟ ଏବଂ କେବେ ପୁନର୍ନବୀକରଣ ହୁଏ ନାହିଁ।"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ମାସିକ ପ୍ଲାନ୍ ଆପଣ ବାତିଲ୍ କରିବା ପର୍ଯ୍ୟନ୍ତ ପ୍ରତିମାସ ପୁନର୍ନବୀକରଣ ହୁଏ। Settings › Apple Account › Subscriptions ଭିତରେ ଯେକୌଣସି ସମୟରେ ବାତିଲ୍ କରନ୍ତୁ, ପୁନର୍ନବୀକରଣ ହେବାର କମ୍‌ରେ କମ୍‌ ଗୋଟିଏ ଦିନ ପୂର୍ବରୁ। ଏକମାତ୍ର ଅନଲକ୍ ହେଉଛି ଗୋଟିଏ ଥରର ପେମେଣ୍ଟ ଏବଂ କେବେ ପୁନର୍ନବୀକରଣ ହୁଏ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਹੀਨਾਵਾਰ ਪਲਾਨ ਹਰ ਮਹੀਨੇ ਰੀਨਿਊ ਹੁੰਦਾ ਹੈ, ਜਦ ਤੱਕ ਤੁਸੀਂ ਇਸਨੂੰ ਰੱਦ ਨਾ ਕਰੋ। ਰੱਦ ਕਰਨ ਲਈ ਕਿਸੇ ਵੀ ਵੇਲੇ Settings › Apple Account › Subscriptions ਵਿੱਚ ਜਾਓ, ਰੀਨਿਊ ਹੋਣ ਤੋਂ ਘੱਟੋ-ਘੱਟ ਇੱਕ ਦਿਨ ਪਹਿਲਾਂ। ਇੱਕ ਵਾਰ ਵਾਲਾ ਅਨਲੌਕ ਇੱਕ ਹੀ ਭੁਗਤਾਨ ਹੈ ਅਤੇ ਕਦੇ ਰੀਨਿਊ ਨਹੀਂ ਹੁੰਦਾ।"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਹੀਨਾਵਾਰ ਪਲਾਨ ਹਰ ਮਹੀਨੇ ਰੀਨਿਊ ਹੁੰਦਾ ਹੈ, ਜਦ ਤੱਕ ਤੁਸੀਂ ਇਸਨੂੰ ਰੱਦ ਨਾ ਕਰੋ। ਰੱਦ ਕਰਨ ਲਈ ਕਿਸੇ ਵੀ ਵੇਲੇ Settings › Apple Account › Subscriptions ਵਿੱਚ ਜਾਓ, ਰੀਨਿਊ ਹੋਣ ਤੋਂ ਘੱਟੋ-ਘੱਟ ਇੱਕ ਦਿਨ ਪਹਿਲਾਂ। ਇੱਕ ਵਾਰ ਵਾਲਾ ਅਨਲੌਕ ਇੱਕ ਹੀ ਭੁਗਤਾਨ ਹੈ ਅਤੇ ਕਦੇ ਰੀਨਿਊ ਨਹੀਂ ਹੁੰਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan miesięczny odnawia się co miesiąc, dopóki go nie anulujesz. Anulować możesz w Ustawieniach › Konto Apple › Subskrypcje, najpóźniej dzień przed odnowieniem. Jednorazowe odblokowanie to pojedyncza płatność, która nigdy się nie odnawia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano mensal renova todo mês até você cancelar. Dá para cancelar quando quiser em Ajustes › Conta Apple › Assinaturas, pelo menos um dia antes da renovação. A compra única é um pagamento só e nunca renova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano mensal renova todo mês até você cancelar. Dá para cancelar quando quiser em Ajustes › Conta Apple › Assinaturas, pelo menos um dia antes da renovação. A compra única é um pagamento só e nunca renova."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano mensal renova-se todos os meses até o cancelar. Cancele em qualquer altura em Definições › Apple Account › Subscrições, pelo menos um dia antes de renovar. O desbloqueio único é um pagamento único e nunca se renova."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Planul lunar se reînnoiește în fiecare lună până îl anulezi. Poți anula oricând din Setări › Cont Apple › Abonamente, cu cel puțin o zi înainte de reînnoire. Deblocarea unică este o singură plată și nu se reînnoiește niciodată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ежемесячная подписка продлевается каждый месяц, пока вы её не отмените. Отменить можно в любой момент: Настройки › Аккаунт Apple › Подписки, не позднее чем за сутки до продления. Разовая покупка — единственный платёж, она не продлевается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesačný plán sa obnovuje každý mesiac, kým ho nezrušíte. Zrušiť ho môžete kedykoľvek v Nastavenia › Apple Account › Predplatné, najmenej deň pred jeho obnovením. Jednorazové odomknutie je jednorazová platba a nikdy sa neobnovuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesečni načrt se vsak mesec samodejno obnovi, dokler ga ne prekličete. Prekličete ga lahko kadar koli v Nastavitve › Apple Account › Naročnine, vsaj en dan pred obnovitvijo. Enkratna odklenitev je enkraten nakup in se nikoli ne obnovi."
          }
        },
        "sl-SI": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesečni načrt se vsak mesec samodejno obnovi, dokler ga ne prekličete. Prekličete ga lahko kadar koli v Nastavitve › Apple Account › Naročnine, vsaj en dan pred obnovitvijo. Enkratna odklenitev je enkraten nakup in se nikoli ne obnovi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Månadsplanen förnyas varje månad tills du säger upp den. Du kan säga upp när som helst i Inställningar › Apple-konto › Prenumerationer, senast en dag före förnyelsen. Engångsköpet är en enda betalning och förnyas aldrig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மாதாந்திர திட்டம், நீங்கள் ரத்து செய்யும் வரை ஒவ்வொரு மாதமும் புதுப்பிக்கப்படும். Settings › Apple Account › Subscriptions-இல், அது புதுப்பிக்கப்படுவதற்கு குறைந்தது ஒரு நாள் முன்பு எப்போது வேண்டுமானாலும் ரத்து செய்யலாம். ஒருமுறை திறப்பு என்பது ஒரே கட்டணம்; அது ஒருபோதும் புதுப்பிக்கப்படாது."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "மாதாந்திர திட்டம், நீங்கள் ரத்து செய்யும் வரை ஒவ்வொரு மாதமும் புதுப்பிக்கப்படும். Settings › Apple Account › Subscriptions-இல், அது புதுப்பிக்கப்படுவதற்கு குறைந்தது ஒரு நாள் முன்பு எப்போது வேண்டுமானாலும் ரத்து செய்யலாம். ஒருமுறை திறப்பு என்பது ஒரே கட்டணம்; அது ஒருபோதும் புதுப்பிக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మాసిక ప్లాన్ మీరు రద్దు చేసే వరకు ప్రతి నెలా పునరుద్ధరించబడుతుంది. రద్దు చేయాలంటే Settings › Apple Account › Subscriptionsలో, అది పునరుద్ధరించబడే కనీసం ఒక రోజు ముందు ఎప్పుడైనా చేయండి. ఒకసారి చెల్లించి అన్‌లాక్ చేసే ఆప్షన్ ఒక్కసారే చెల్లింపు, అది ఎప్పటికీ పునరుద్ధరించబడదు."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "మాసిక ప్లాన్ మీరు రద్దు చేసే వరకు ప్రతి నెలా పునరుద్ధరించబడుతుంది. రద్దు చేయాలంటే Settings › Apple Account › Subscriptionsలో, అది పునరుద్ధరించబడే కనీసం ఒక రోజు ముందు ఎప్పుడైనా చేయండి. ఒకసారి చెల్లించి అన్‌లాక్ చేసే ఆప్షన్ ఒక్కసారే చెల్లింపు, అది ఎప్పటికీ పునరుద్ధరించబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แผนรายเดือนจะต่ออายุทุกเดือนจนกว่าคุณจะยกเลิก ยกเลิกได้ทุกเมื่อที่ การตั้งค่า › บัญชี Apple › การสมัครใช้บริการ อย่างช้าหนึ่งวันก่อนต่ออายุ ส่วนการปลดล็อกครั้งเดียวเป็นการจ่ายครั้งเดียวและไม่ต่ออายุ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aylık plan, iptal edene kadar her ay yenilenir. Ayarlar › Apple Hesabı › Abonelikler bölümünden, yenilemeden en az bir gün önce dilediğin zaman iptal edebilirsin. Tek seferlik açma tek bir ödemedir ve asla yenilenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місячний план поновлюється щомісяця, доки ви не скасуєте його. Скасувати можна будь-коли в Settings › Apple Account › Subscriptions, щонайменше за день до поновлення. Одноразове розблокування — це разовий платіж, і воно ніколи не поновлюється."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ماہانہ منصوبہ ہر ماہ تب تک تجدید ہوتا ہے جب تک آپ اسے منسوخ نہ کریں۔ Settings › Apple Account › Subscriptions میں کسی بھی وقت منسوخ کریں، تجدید سے کم از کم ایک دن پہلے۔ ایک بار والا ان لاک ایک ہی ادائیگی ہے اور کبھی تجدید نہیں ہوتا۔"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "ماہانہ منصوبہ ہر ماہ تب تک تجدید ہوتا ہے جب تک آپ اسے منسوخ نہ کریں۔ Settings › Apple Account › Subscriptions میں کسی بھی وقت منسوخ کریں، تجدید سے کم از کم ایک دن پہلے۔ ایک بار والا ان لاک ایک ہی ادائیگی ہے اور کبھی تجدید نہیں ہوتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói tháng tự gia hạn hằng tháng cho đến khi bạn hủy. Có thể hủy bất cứ lúc nào trong Cài đặt › Tài khoản Apple › Đăng ký, chậm nhất một ngày trước khi gia hạn. Gói mua một lần chỉ thanh toán một lần và không bao giờ gia hạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "月度方案在你取消前每月自动续订。可随时在「设置 › Apple 账户 › 订阅」中取消，最迟在续订前一天。一次买断只付一次，永不续订。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "月方案在你取消前每月自動續訂。可隨時在「設定 › Apple 帳號 › 訂閱項目」中取消，最遲在續訂前一天。一次買斷只付一次，永不續訂。"
          }
        }
      }
    },
    "store.renewalTermsPlans": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتجدّد الخطتان الشهرية والسنوية تلقائيًا في نهاية كل فترة حتى تُلغيها. يمكنك الإلغاء في أي وقت من الإعدادات › حساب Apple › الاشتراكات، قبل يوم واحد على الأقل من موعد التجديد. الفتح لمرة واحدة دفعة واحدة ولا يتجدّد أبدًا."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تتجدّد الخطتان الشهرية والسنوية تلقائيًا في نهاية كل فترة حتى تُلغيها. يمكنك الإلغاء في أي وقت من الإعدادات › حساب Apple › الاشتراكات، قبل يوم واحد على الأقل من موعد التجديد. الفتح لمرة واحدة دفعة واحدة ولا يتجدّد أبدًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Месечният и годишният план се подновяват автоматично в края на всеки период, докато не ги отмените. Можете да ги отмените по всяко време в Settings › Apple Account › Subscriptions, поне ден преди датата на подновяване. Еднократното отключване е еднократно плащане и не се подновява."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাসিক ও বার্ষিক প্ল্যান আপনি বাতিল না করা পর্যন্ত প্রতিটি মেয়াদের শেষে স্বয়ংক্রিয়ভাবে নবায়ন হয়। Settings › Apple Account › Subscriptions-এ গিয়ে, নবায়নের তারিখের অন্তত এক দিন আগে যেকোনো সময় বাতিল করতে পারেন। এককালীন আনলক একবারের পেমেন্ট, এবং এটি কখনও নবায়ন হয় না।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "মাসিক ও বার্ষিক প্ল্যান আপনি বাতিল না করা পর্যন্ত প্রতিটি মেয়াদের শেষে স্বয়ংক্রিয়ভাবে নবায়ন হয়। Settings › Apple Account › Subscriptions-এ গিয়ে, নবায়নের তারিখের অন্তত এক দিন আগে যেকোনো সময় বাতিল করতে পারেন। এককালীন আনলক একবারের পেমেন্ট, এবং এটি কখনও নবায়ন হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els plans mensual i anual es renoven automàticament al final de cada període fins que els cancel·leu. Podeu cancel·lar-los en qualsevol moment a Configuració › Apple Account › Subscripcions, almenys un dia abans de la data de renovació. El desbloqueig únic és un únic pagament i no es renova mai."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měsíční a roční plán se automaticky obnovují na konci každého období, dokud je nezrušíš. Zrušit můžeš kdykoli v Nastavení › Účet Apple › Předplatná, nejpozději den před obnovením. Jednorázové odemčení je jediná platba a nikdy se neobnovuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Måneds- og årsabonnementet fornyes automatisk ved udgangen af hver periode, indtil du opsiger dem. Du kan opsige når som helst i Indstillinger › Apple-konto › Abonnementer, senest en dag før fornyelsen. Engangskøbet er en enkelt betaling og fornyes aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Monats- und Jahresabo verlängern sich am Ende jedes Zeitraums automatisch, bis du kündigst. Kündigen kannst du jederzeit unter Einstellungen › Apple-Account › Abonnements, spätestens einen Tag vor der Verlängerung. Die einmalige Freischaltung ist eine einzelne Zahlung und verlängert sich nie."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Monats- und Jahresabo verlängern sich am Ende jedes Zeitraums automatisch, bis du kündigst. Kündigen kannst du jederzeit unter Einstellungen › Apple-Account › Abonnements, spätestens einen Tag vor der Verlängerung. Die einmalige Freischaltung ist eine einzelne Zahlung und verlängert sich nie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μηνιαία και η ετήσια συνδρομή ανανεώνονται αυτόματα στο τέλος κάθε περιόδου μέχρι να τις ακυρώσεις. Μπορείς να ακυρώσεις οποτεδήποτε από Ρυθμίσεις › Λογαριασμός Apple › Συνδρομές, τουλάχιστον μία μέρα πριν την ανανέωση. Το εφάπαξ ξεκλείδωμα είναι μία πληρωμή και δεν ανανεώνεται ποτέ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The monthly and yearly plans renew automatically at the end of each period until you cancel them. Cancel any time in Settings › Apple Account › Subscriptions, at least a day before the renewal date. The one-off unlock is a single payment and never renews."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The monthly and yearly plans renew automatically at the end of each period until you cancel them. Cancel any time in Settings › Apple Account › Subscriptions, at least a day before the renewal date. The one-off unlock is a single payment and never renews."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The monthly and yearly plans renew automatically at the end of each period until you cancel them. Cancel any time in Settings › Apple Account › Subscriptions, at least a day before the renewal date. The one-off unlock is a single payment and never renews."
          }
        },
