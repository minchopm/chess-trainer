          "stringUnit": {
            "state": "translated",
            "value": "એ ચાલ પછી %@. ઇચ્છો તો આગળ રમો, અથવા ફરી શરૂ કરીને યોગ્ય યોજના અજમાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחרי המהלך הזה %@. אפשר להמשיך לשחק, או להתחיל מחדש ולנסות את התוכנית הנכונה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस चाल के बाद %@। चाहें तो खेलते रहें, या फिर से शुरू करके सही योजना आज़माएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakon tog poteza %@. Nastavite ako želite ili ponovno pokrenite i isprobajte ispravan plan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "E lépés után %@. Játszhatsz tovább, vagy kezdd elölről, és próbáld a helyes tervet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah langkah itu %@. Silakan lanjut, atau ulang dari awal dan coba rencana yang benar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo quella mossa %@. Continua pure, oppure ricomincia e prova il piano giusto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その手のあと、%@。そのまま続けても、最初からやり直して正しい方針を試しても構いません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы жүрістен кейін %@. Қаласаңыз ойынды жалғастырыңыз немесе қайта бастап, дұрыс жоспарды көріңіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ ನಡೆ %@ ನಂತರ. ಇಷ್ಟವಿದ್ದರೆ ಮುಂದುವರಿಸಿ, ಅಥವಾ ಮರುಪ್ರಾರಂಭಿಸಿ ಸರಿಯಾದ ಯೋಜನೆಯನ್ನು ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ ನಡೆ %@ ನಂತರ. ಇಷ್ಟವಿದ್ದರೆ ಮುಂದುವರಿಸಿ, ಅಥವಾ ಮರುಪ್ರಾರಂಭಿಸಿ ಸರಿಯಾದ ಯೋಜನೆಯನ್ನು ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 수 이후 %@. 계속 두어도 되고, 처음부터 다시 시작해 올바른 계획을 시도해도 됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആ നീക്കത്തിന് ശേഷം %@. ഇഷ്ടമുള്ളെങ്കിൽ കളി തുടരാം, അല്ലെങ്കിൽ പുനരാരംഭിച്ച് ശരിയായ പദ്ധതി പരീക്ഷിക്കാം."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ആ നീക്കത്തിന് ശേഷം %@. ഇഷ്ടമുള്ളെങ്കിൽ കളി തുടരാം, അല്ലെങ്കിൽ പുനരാരംഭിച്ച് ശരിയായ പദ്ധതി പരീക്ഷിക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "त्या चालीनंतर %@. हवे असल्यास पुढे खेळा, किंवा पुन्हा सुरू करून योग्य योजना वापरा."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "त्या चालीनंतर %@. हवे असल्यास पुढे खेळा, किंवा पुन्हा सुरू करून योग्य योजना वापरा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selepas langkah itu %@. Teruskan jika mahu, atau mula semula dan cuba rancangan yang betul."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etter det trekket %@. Spill videre om du vil, eller start på nytt og prøv riktig plan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na die zet %@. Speel gerust door, of begin opnieuw en probeer het juiste plan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Na die zet %@. Speel gerust door, of begin opnieuw en probeer het juiste plan."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Etter det trekket %@. Spill videre om du vil, eller start på nytt og prøv riktig plan."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସେହି ଚାଳ %@ ପରେ। ଚାହିଲେ ଖେଳ ଚାଲୁ ରଖନ୍ତୁ, କିମ୍ବା ପୁନରାରମ୍ଭ କରି ସଠିକ୍ ପ୍ରୟୋଜନା ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ସେହି ଚାଳ %@ ପରେ। ଚାହିଲେ ଖେଳ ଚାଲୁ ରଖନ୍ତୁ, କିମ୍ବା ପୁନରାରମ୍ଭ କରି ସଠିକ୍ ପ୍ରୟୋଜନା ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਸ ਚਾਲ %@ ਤੋਂ ਬਾਅਦ। ਜੇ ਚਾਹੋ ਤਾਂ ਖੇਡ ਜਾਰੀ ਰੱਖੋ, ਜਾਂ ਮੁੜ ਸ਼ੁਰੂ ਕਰਕੇ ਸਹੀ ਯੋਜਨਾ ਅਜ਼ਮਾਓ।"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਸ ਚਾਲ %@ ਤੋਂ ਬਾਅਦ। ਜੇ ਚਾਹੋ ਤਾਂ ਖੇਡ ਜਾਰੀ ਰੱਖੋ, ਜਾਂ ਮੁੜ ਸ਼ੁਰੂ ਕਰਕੇ ਸਹੀ ਯੋਜਨਾ ਅਜ਼ਮਾਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po tym posunięciu %@. Możesz grać dalej albo zacząć od nowa i spróbować właściwego planu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois desse lance %@. Continue se quiser, ou recomece e tente o plano certo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois desse lance %@. Continue se quiser, ou recomece e tente o plano certo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois desse lance %@. Continue se quiser, ou recomece e tente o plano correto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După acea mutare %@. Poți continua, sau o iei de la capăt și încerci planul corect."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После этого хода %@. Можете играть дальше или начать заново и попробовать верный план."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po tomto ťahu %@. Môžeš hrať ďalej, ak chceš, alebo začni odznova a skús správny plán."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po tej potezi %@. Nadaljujte, če želite, ali pa začnite znova in poskusite s pravilnim načrtom."
          }
        },
        "sl-SI": {
          "stringUnit": {
            "state": "translated",
            "value": "Po tej potezi %@. Nadaljujte, če želite, ali pa začnite znova in poskusite s pravilnim načrtom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter det draget %@. Spela vidare om du vill, eller börja om och pröva rätt plan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அந்த நகர்வு %@க்கு பின். விருப்பமெனில் தொடர்ந்து விளையாடலாம், அல்லது மீண்டும் தொடங்கி சரியான திட்டத்தை முயற்சிக்கலாம்."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "அந்த நகர்வு %@க்கு பின். விருப்பமெனில் தொடர்ந்து விளையாடலாம், அல்லது மீண்டும் தொடங்கி சரியான திட்டத்தை முயற்சிக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆ నడక %@ తర్వాత. ఇష్టమైతే ఆట కొనసాగించండి, లేదా పునఃప్రారంభించి సరైన ప్రణాళికను ప్రయత్నించండి."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆ నడక %@ తర్వాత. ఇష్టమైతే ఆట కొనసాగించండి, లేదా పునఃప్రారంభించి సరైన ప్రణాళికను ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังจากตานั้น %@ จะเล่นต่อก็ได้ หรือเริ่มใหม่แล้วลองแผนที่ถูกต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hamleden sonra %@. İstersen devam et, ya da baştan başlayıp doğru planı dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після цього ходу %@. Можете продовжити, якщо хочете, або почати заново й спробувати правильний план."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس چال %@ کے بعد۔ چاہیں تو کھیل جاری رکھیں، یا دوبارہ شروع کر کے درست منصوبہ آزمائیں۔"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "اس چال %@ کے بعد۔ چاہیں تو کھیل جاری رکھیں، یا دوبارہ شروع کر کے درست منصوبہ آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau nước đó %@. Bạn có thể chơi tiếp, hoặc bắt đầu lại và thử phương án đúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "走了这步之后，%@。你可以继续下，也可以重来并尝试正确的方案。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "走了這步之後，%@。你可以繼續下，也可以重來並嘗試正確的方案。"
          }
        }
      }
    },
