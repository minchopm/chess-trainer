        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Načteno %lld tahů, pak konec u „%@“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indlæste %lld træk og stoppede så ved “%@”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Züge eingelesen, dann Halt bei „%@“."
          }
