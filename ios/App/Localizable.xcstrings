        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿದಿನ ಉಚಿತವಾಗಿ: %lld Rush ರನ್‌ಗಳು, Tactics ಮಿತಿಯಿಂದ ಪ್ರತ್ಯೇಕ. ಇವೆರಡೂ ಸ್ಥಳೀಯ ಸಮಯ ಬೆಳಗ್ಗೆ 9:00ಕ್ಕೆ ಮರುಹೊಂದಿಕೆಯಾಗುತ್ತವೆ. AI ವಿರುದ್ಧ ಅಥವಾ ಮತ್ತೊಬ್ಬರೊಂದಿಗೆ ಆಡುವುದು ಅಸೀಮಿತವಾಗಿಯೇ ಇರುತ್ತದೆ."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
