        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એક લિંક મોકલો. જે કોઈ તેને ખોલે, તે તરત જ થોડાં tactics રમી શકે છે, app હોય કે ન હોય, અને આમંત્રણ અહીં તેમના માટે રાહ જુએ છે."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "એક લિંક મોકલો. જે કોઈ તેને ખોલે, તે તરત જ થોડાં tactics રમી શકે છે, app હોય કે ન હોય, અને આમંત્રણ અહીં તેમના માટે રાહ જુએ છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שלחו קישור. מי שיפתח אותו יוכל לפתור כמה תרגילים מיד, עם האפליקציה או בלעדיה, וההזמנה תחכה לו כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक लिंक भेजें। जो इसे खोलेगा वह तुरंत कुछ टैक्टिक्स खेल सकता है — ऐप के साथ या बिना — और आमंत्रण यहाँ उसकी प्रतीक्षा करेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošalji poveznicu. Tko je otvori može odmah igrati nekoliko taktičkih zadataka, s aplikacijom ili bez nje, a pozivnica ga ovdje čeka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Küldjön egy linket. Aki megnyitja, azonnal játszhat néhány taktikát, apppal vagy anélkül, a meghívó pedig itt várja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirim tautan. Siapa pun yang membukanya bisa langsung memainkan beberapa taktik, dengan atau tanpa aplikasi, dan undangannya menunggu di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Manda un link. Chi lo apre può giocare subito qualche tattica, con o senza l’app, e l’invito lo aspetta qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクを送ります。開いた人はアプリの有無にかかわらずすぐに戦術問題を解け、招待はここで待っています。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сілтеме жіберіңіз. Оны ашқан адам бірден бірнеше тактика ойнай алады — қолданбамен де, онсыз да. Шақыру осы жерде оны күтеді."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಒಂದು ಲಿಂಕ್ ಕಳುಹಿಸಿ. ಅದನ್ನು ತೆರೆಯುವವರು ಆ್ಯಪ್ ಇದ್ದರೂ ಇಲ್ಲದಿದ್ದರೂ ಕೂಡಲೇ ಕೆಲವು tactical ಗಳು ಆಡಬಹುದು, ಮತ್ತು ಆಮಂತ್ರಣ ಇಲ್ಲಿ ಅವರಿಗಾಗಿ ಕಾಯುತ್ತದೆ."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಒಂದು ಲಿಂಕ್ ಕಳುಹಿಸಿ. ಅದನ್ನು ತೆರೆಯುವವರು ಆ್ಯಪ್ ಇದ್ದರೂ ಇಲ್ಲದಿದ್ದರೂ ಕೂಡಲೇ ಕೆಲವು tactical ಗಳು ಆಡಬಹುದು, ಮತ್ತು ಆಮಂತ್ರಣ ಇಲ್ಲಿ ಅವರಿಗಾಗಿ ಕಾಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크를 보내세요. 받은 사람은 앱이 없어도 바로 전술 몇 개를 풀 수 있고, 초대는 여기서 기다립니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ലിങ്ക് അയയ്ക്കുക. അത് തുറക്കുന്നവർക്ക് ആപ്പ് ഉണ്ടാകട്ടെയോ ഇല്ലയോ, ഉടൻ തന്നെ കുറച്ച് tactics കളിക്കാം; ക്ഷണം ഇവിടെ അവർക്ക് കാത്തിരിക്കും."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ലിങ്ക് അയയ്ക്കുക. അത് തുറക്കുന്നവർക്ക് ആപ്പ് ഉണ്ടാകട്ടെയോ ഇല്ലയോ, ഉടൻ തന്നെ കുറച്ച് tactics കളിക്കാം; ക്ഷണം ഇവിടെ അവർക്ക് കാത്തിരിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक लिंक पाठवा. ती उघडणाऱ्याला अ‍ॅप असो वा नसो, काही tactics लगेच खेळता येतील, आणि ही आमंत्रण इथेच त्याची वाट पाहत राहील."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "एक लिंक पाठवा. ती उघडणाऱ्याला अ‍ॅप असो वा नसो, काही tactics लगेच खेळता येतील, आणि ही आमंत्रण इथेच त्याची वाट पाहत राहील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hantar pautan. Sesiapa yang membukanya boleh terus bermain beberapa taktik, dengan atau tanpa apl, dan jemputan menunggu mereka di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Send en lenke. Den som åpner den, kan spille et par taktikkoppgaver med en gang, med eller uten appen, og invitasjonen venter på dem her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuur een link. Wie hem opent, kan meteen een paar tactieken spelen, met of zonder de app, en de uitnodiging wacht hier op ze."
