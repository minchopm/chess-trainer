    "online.servicePlayersNote": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Псевдонимите и рейтингите се пазят от собствената игрална услуга на Brass Pawn — една и съща за iPhone, iPad, Mac и Android. „Онлайн сега“ значи, че приложението е на екрана им."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicknames and ratings are kept by Brass Pawn's own game service, the same for iPhone, iPad, Mac and Android. Online now means the app is on their screen."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
