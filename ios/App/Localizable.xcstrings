      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجاناً كل يوم: %lld جولات Rush، منفصلة عن حصة التكتيك. كلاهما يُعاد ضبطه الساعة 9:00 صباحاً بالتوقيت المحلي. اللعب ضد الحاسوب أو ضد شخص آخر يبقى بلا حدود."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "مجاناً كل يوم: %lld جولات Rush، منفصلة عن حصة التكتيك. كلاهما يُعاد ضبطه الساعة 9:00 صباحاً بالتوقيت المحلي. اللعب ضد الحاسوب أو ضد شخص آخر يبقى بلا حدود."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всеки ден безплатно: %lld Rush опита, отделно от лимита за Тактики. И двата се нулират в 9:00 ч. местно време. Играта срещу AI или друг човек остава неограничена."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিদিন বিনামূল্যে: %lld টি Rush রান, Tactics-এর সীমা থেকে আলাদা। দুটোই স্থানীয় সময় সকাল ৯:০০টায় রিসেট হয়। AI বা অন্য মানুষের বিরুদ্ধে খেলা সীমাহীন।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিদিন বিনামূল্যে: %lld টি Rush রান, Tactics-এর সীমা থেকে আলাদা। দুটোই স্থানীয় সময় সকাল ৯:০০টায় রিসেট হয়। AI বা অন্য মানুষের বিরুদ্ধে খেলা সীমাহীন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
