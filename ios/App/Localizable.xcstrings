    "play.theEnginePlaysAtThe": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يلعب المحرّك بالقوة التي تختارها. ويقيّم المدرّب كل نقلة من نقلاتك أثناء اللعب."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Engine hraje v síle, kterou zvolíš. Kouč hodnotí každý tvůj tah průběžně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Motoren spiller i den styrke, du vælger. Træneren bedømmer hvert af dine træk undervejs."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Engine spielt in der Stärke, die du wählst. Der Trainer bewertet jeden deiner Züge, während du spielst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μηχανή παίζει στην ισχύ που διαλέγεις. Ο προπονητής βαθμολογεί κάθε σου κίνηση καθώς παίζεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine plays at the strength you choose. Coaching grades each of your moves as you make it."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine plays at the strength you choose. Coaching grades each of your moves as you make it."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine plays at the strength you choose. Coaching grades each of your moves as you make it."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor juega con la fuerza que elijas. El entrenador valora cada una de tus jugadas mientras juegas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moottori pelaa valitsemallasi vahvuudella. Valmentaja arvioi jokaisen siirtosi pelin aikana."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur joue à la force que vous choisissez. L'entraîneur note chacun de vos coups au fil de la partie."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur joue à la force que vous choisissez. L'entraîneur note chacun de vos coups au fil de la partie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המנוע משחק בעוצמה שתבחר. המאמן נותן ציון לכל מהלך שלך תוך כדי המשחק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंजन उसी ताक़त पर खेलता है जो आप चुनते हैं। कोच खेलते-खेलते आपकी हर चाल को आँकता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A motor az általad választott erővel játszik. Az edző menet közben osztályozza minden lépésedet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesin bermain pada kekuatan yang kamu pilih. Pelatih menilai setiap langkahmu sambil jalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore gioca alla forza che scegli. L'allenatore valuta ogni tua mossa mentre giochi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンジンは選んだ強さで指します。コーチは指すたびに一手ずつ評価します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엔진은 당신이 고른 강도로 둡니다. 코치는 당신이 둘 때마다 한 수씩 평가합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjin bermain pada kekuatan yang anda pilih. Jurulatih menilai setiap langkah anda sambil bermain."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De engine speelt op de sterkte die je kiest. De coach beoordeelt elke zet terwijl je speelt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Motoren spiller i styrken du velger. Treneren gir karakter til hvert av trekkene dine underveis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Silnik gra z siłą, którą wybierzesz. Trener ocenia każde twoje posunięcie na bieżąco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O motor joga na força que você escolher. O treinador avalia cada lance seu enquanto você joga."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Motorul joacă la puterea pe care o alegi. Antrenorul îți notează fiecare mutare pe parcurs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Движок играет в выбранную вами силу. Тренер оценивает каждый ваш ход по ходу партии."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Motorn spelar i den styrka du väljer. Tränaren betygsätter vart och ett av dina drag medan du spelar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอนจินเล่นตามระดับที่คุณเลือก โค้ชให้คะแนนทุกตาเดินของคุณระหว่างเล่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Motor senin seçtiğin güçte oynar. Koç, sen oynadıkça her hamleni not verir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chơi ở mức bạn chọn. Huấn luyện viên chấm từng nước đi của bạn ngay trong ván."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引擎按你选择的棋力下棋。教练会在你每走一步时给出评价。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "引擎依你選擇的棋力下棋。教練會在你每走一步時給出評價。"
          }
        }
      }
    },
    "play.theQueueWasDroppedThe": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "أُلغيت سلسلة النقلات — نقلة المحرّك جعلتها مستحيلة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fronta tahů byla zrušena — tah enginu ji znemožnil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Trækrækken blev droppet — motorens træk gjorde den umulig."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zugfolge wurde verworfen — der Zug der Engine hat sie unmöglich gemacht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σειρά κινήσεων ακυρώθηκε — η κίνηση της μηχανής την έκανε αδύνατη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The queue was dropped — the engine's move made it impossible."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The queue was dropped — the engine's move made it impossible."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The queue was dropped — the engine's move made it impossible."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La secuencia se ha descartado: la jugada del motor la ha hecho imposible."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirtojono hylättiin — moottorin siirto teki siitä mahdottoman."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La séquence a été abandonnée : le coup du moteur l'a rendue impossible."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "La séquence a été abandonnée : le coup du moteur l'a rendue impossible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רצף המהלכים בוטל — המהלך של המנוע הפך אותו לבלתי אפשרי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालों की कतार रद्द हो गई — इंजन की चाल ने उसे असंभव बना दिया।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lépéssor törlődött — a motor lépése lehetetlenné tette."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrean langkah dibatalkan — langkah mesin membuatnya mustahil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sequenza è stata annullata: la mossa del motore l'ha resa impossibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予約した手順は取り消されました — エンジンの手で不可能になりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예약한 수순이 취소되었습니다 — 엔진의 수가 불가능하게 만들었습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Barisan langkah dibatalkan — langkah enjin menjadikannya mustahil."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De reeks is vervallen — de zet van de engine maakte hem onmogelijk."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Trekkrekken ble forkastet — motorens trekk gjorde den umulig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolejka posunięć została odrzucona — ruch silnika ją uniemożliwił."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sequência foi descartada: o lance do motor tornou-a impossível."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șirul de mutări a fost anulat — mutarea motorului l-a făcut imposibil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очередь ходов сброшена — ход движка сделал её невозможной."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dragkön slopades — motorns drag gjorde den omöjlig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คิวตาเดินถูกยกเลิก — ตาของเอนจินทำให้เป็นไปไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıra iptal edildi — motorun hamlesi onu imkânsız kıldı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuỗi nước đã bị hủy — nước của máy khiến nó không thể thực hiện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预设着法已取消 — 引擎的一步让它无法成立。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設著法已取消 — 引擎的一步讓它無法成立。"
          }
        }
      }
    },
