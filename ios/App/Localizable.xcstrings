    "board.unreadable": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُقرأ هذا كمباراة أو وضعية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tohle se nepodařilo přečíst jako partii ani pozici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kunne ikke læses som et parti eller en stilling."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ließ sich weder als Partie noch als Stellung lesen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό δεν διαβάστηκε ως παρτίδα ή θέση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That did not read as a game or a position."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "That did not read as a game or a position."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "That did not read as a game or a position."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso no se pudo leer como partida ni como posición."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä ei voitu lukea peliksi eikä asemaksi."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela n’a pu être lu ni comme partie ni comme position."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela n’a pu être lu ni comme partie ni comme position."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הצלחנו לקרוא את זה כמשחק או כעמדה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे गेम या पोज़िशन के रूप में नहीं पढ़ा जा सका।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt nem sikerült játszmaként vagy állásként értelmezni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu tidak terbaca sebagai permainan atau posisi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggerlo come partita o posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "棋譜としても局面としても読み取れませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기보나 포지션으로 읽을 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu tidak dapat dibaca sebagai permainan atau kedudukan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kon niet als partij of stelling worden gelezen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kunne ikke leses som et parti eller en stilling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się tego odczytać jako partii ani pozycji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler isso como partida ou posição."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a putut citi ca partidă sau poziție."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не читается ни как партия, ни как позиция."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att läsa som ett parti eller en ställning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านข้อความนี้เป็นเกมหรือตำแหน่งไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, oyun veya konum olarak okunamadı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đọc được nội dung này thành ván cờ hay thế cờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将其读取为棋谱或局面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法將其讀取為棋譜或局面。"
          }
        }
      }
    },
    "clip.fourteenThousandMore": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يضمّ Brass Pawn أربعة عشر ألفًا غيرها، مختارة ممّا تجده صعبًا لا بالقرعة — ومحرّكًا يخبرك بقيمة النقلة الأقوى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn jich má dalších čtrnáct tisíc, vybíraných podle toho, co vám dělá potíže, ne náhodně — a motor, který řekne, co silnější tah stál za."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn har fjorten tusinde mere, valgt ud fra det, du har svært ved, ikke tilfældigt — og en motor, der fortæller, hvad det stærkere træk var værd."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn hat vierzehntausend weitere, ausgewählt nach dem, was Ihnen schwerfällt, nicht zufällig — und eine Engine, die sagt, was der stärkere Zug wert war."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Brass Pawn έχει άλλα δεκατέσσερις χιλιάδες, επιλεγμένα από όσα δυσκολεύεστε και όχι στην τύχη — και μια μηχανή που λέει πόσο άξιζε η δυνατότερη κίνηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn has fourteen thousand more, chosen from what you have been finding hard rather than at random — and an engine that tells you what the stronger move was worth."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn has fourteen thousand more, chosen from what you have been finding hard rather than at random — and an engine that tells you what the stronger move was worth."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn has fourteen thousand more, chosen from what you have been finding hard rather than at random — and an engine that tells you what the stronger move was worth."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn tiene catorce mil más, elegidos entre lo que te cuesta y no al azar — y un motor que dice cuánto valía la jugada más fuerte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawnissa on neljätoista tuhatta lisää, valittuna siitä mikä on tuntunut vaikealta eikä sattumanvaraisesti — ja moottori, joka kertoo mitä vahvempi siirto oli arvoltaan."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn en compte quatorze mille autres, choisis selon ce qui vous résiste plutôt qu’au hasard — et un moteur qui dit ce que valait le meilleur coup."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn en compte quatorze mille autres, choisis selon ce qui vous résiste plutôt qu’au hasard — et un moteur qui dit ce que valait le meilleur coup."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ל‑Brass Pawn יש עוד ארבעה‑עשר אלף, נבחרים לפי מה שקשה לך ולא באקראי — ומנוע שאומר כמה היה שווה המהלך החזק יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn में चौदह हज़ार और हैं, जो बेतरतीब नहीं बल्कि आपकी कठिनाइयों से चुने जाते हैं — और एक इंजन जो बताता है कि बेहतर चाल कितनी क़ीमती थी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Brass Pawnban további tizennégyezer van, abból válogatva, ami nehezen megy, nem véletlenszerűen — és egy motor, amely megmondja, mit ért az erősebb lépés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn punya empat belas ribu lagi, dipilih dari apa yang terasa sulit bagi Anda, bukan secara acak — dan mesin yang memberi tahu nilai langkah yang lebih kuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn ne ha altri quattordicimila, scelti tra ciò che trovi difficile e non a caso — e un motore che dice quanto valeva la mossa migliore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn にはさらに 14,000 問。無作為ではなく、あなたが苦手にしてきたものから選ばれます。より強い手が何点だったかを教えるエンジンつき。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn에는 14,000문제가 더 있습니다. 무작위가 아니라 어려워한 것에서 고릅니다 — 그리고 더 강한 수의 가치를 알려주는 엔진이 함께합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn ada empat belas ribu lagi, dipilih daripada apa yang anda dapati sukar dan bukan secara rawak — serta enjin yang memberitahu nilai langkah yang lebih kuat."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn heeft er nog veertienduizend, gekozen op wat je lastig vindt in plaats van willekeurig — en een engine die zegt wat de sterkere zet waard was."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn har fjorten tusen til, valgt ut fra det du synes er vanskelig og ikke tilfeldig — og en motor som sier hva det sterkere trekket var verdt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn ma jeszcze czternaście tysięcy, wybieranych z tego, co sprawia Ci trudność, a nie losowo — i silnik, który mówi, ile wart był mocniejszy ruch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Brass Pawn tem mais catorze mil, escolhidos pelo que você tem achado difícil e não ao acaso — e um motor que diz quanto valia o lance mais forte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn mai are paisprezece mii, alese din ce ți se pare greu, nu la întâmplare — și un motor care spune cât a valorat mutarea mai bună."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Brass Pawn их ещё четырнадцать тысяч — выбранных по тому, что даётся вам трудно, а не наугад, и движок, который говорит, чего стоил более сильный ход."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn har fjortontusen till, valda utifrån vad du tycker är svårt och inte slumpmässigt — och en motor som säger vad det starkare draget var värt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn มีอีกหนึ่งหมื่นสี่พันข้อ คัดจากสิ่งที่คุณทำได้ยาก ไม่ใช่สุ่ม — พร้อมเอนจินที่บอกว่าตาเดินที่ดีกว่ามีค่าเท่าใด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn’da on dört bin tane daha var; rastgele değil, zorlandığınız yerlerden seçilir — ve daha güçlü hamlenin kaç ettiğini söyleyen bir motor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn còn mười bốn nghìn bài nữa, chọn theo những gì bạn thấy khó chứ không ngẫu nhiên — cùng một engine cho biết nước đi mạnh hơn đáng giá bao nhiêu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn 还有一万四千道，按你觉得难的来挑，而非随机 —— 并有引擎告诉你更强的一手值多少。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn 還有一萬四千道，按你覺得難的來挑，而非隨機 —— 並有引擎告訴你更強的一手值多少。"
          }
        }
      }
    },
