    "today.supportLine": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قصص «اليوم» مجانية وبلا إعلانات. إن أعجبتك، يمكنك دعم Brass Pawn."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "قصص «اليوم» مجانية وبلا إعلانات. إن أعجبتك، يمكنك دعم Brass Pawn."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Историите в Today са безплатни и без реклами. Ако ви харесват, можете да подкрепите Brass Pawn."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Today-র গল্পগুলো বিনামূল্যে এবং বিজ্ঞাপনহীন। যদি ভালো লাগে, Brass Pawn-কে সমর্থন করতে পারেন।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "Today-র গল্পগুলো বিনামূল্যে এবং বিজ্ঞাপনহীন। যদি ভালো লাগে, Brass Pawn-কে সমর্থন করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les històries d’avui són gratuïtes i no tenen anuncis. Si us agraden, podeu donar suport a Brass Pawn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příběhy v sekci Dnes jsou zdarma a bez reklam. Pokud se ti líbí, můžeš Brass Pawn podpořit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Historierne i I dag er gratis og uden reklamer. Hvis du kan lide dem, kan du støtte Brass Pawn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geschichten in „Heute“ sind kostenlos und werbefrei. Wenn sie dir gefallen, kannst du Brass Pawn unterstützen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geschichten in „Heute“ sind kostenlos und werbefrei. Wenn sie dir gefallen, kannst du Brass Pawn unterstützen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ιστορίες στο «Σήμερα» είναι δωρεάν και χωρίς διαφημίσεις. Αν σου αρέσουν, μπορείς να στηρίξεις το Brass Pawn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stories in Today are free and have no ads. If you enjoy them, you can support Brass Pawn."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The stories in Today are free and have no ads. If you enjoy them, you can support Brass Pawn."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The stories in Today are free and have no ads. If you enjoy them, you can support Brass Pawn."
          }
        },
        "en-GB": {
