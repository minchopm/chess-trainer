        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏଠାରେ ଏକ ଶକ୍ତିଶାଳୀ ଚାଳ ଅଛି। ସବୁଠାରୁ ବାଧ୍ୟତାମୂଳକ ବିକଳ୍ପଗୁଡ଼ିକୁ ପ୍ରଥମେ ଦେଖନ୍ତୁ — ଶାହ, ଧରା, ଧମକ।"
