    "about.privacyApart": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "باستثناء اللعب عبر الإنترنت، لا يجمع التطبيق شيئًا ولا يرسل عنك شيئًا. الشيء الوحيد الذي ينزّله هو الموجز اليومي عند فتح «اليوم». تصنيفات التدريب والسجل محفوظة على هذا الجهاز فقط، وحذف التطبيق يحذفها."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "باستثناء اللعب عبر الإنترنت، لا يجمع التطبيق شيئًا ولا يرسل عنك شيئًا. الشيء الوحيد الذي ينزّله هو الموجز اليومي عند فتح «اليوم». تصنيفات التدريب والسجل محفوظة على هذا الجهاز فقط، وحذف التطبيق يحذفها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Освен онлайн игра, приложението не събира и не изпраща нищо за вас. Единственото, което изтегля, е дневният поток, когато отворите „Днес“. Вашите тренировъчни рейтинги и история се съхраняват само на това устройство, а при изтриване на приложението се изтриват и те."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনলাইন খেলা ছাড়া, অ্যাপটি আপনার সম্পর্কে কিছুই সংগ্রহ করে না এবং কিছুই পাঠায় না। আপনি «আজ» খুললে এটি শুধু দৈনিক ফিডটি ডাউনলোড করে। আপনার প্রশিক্ষণ রেটিং ও ইতিহাস শুধু এই ডিভাইসেই সংরক্ষিত থাকে, আর অ্যাপটি মুছে ফেললে সেগুলিও মুছে যায়।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "অনলাইন খেলা ছাড়া, অ্যাপটি আপনার সম্পর্কে কিছুই সংগ্রহ করে না এবং কিছুই পাঠায় না। আপনি «আজ» খুললে এটি শুধু দৈনিক ফিডটি ডাউনলোড করে। আপনার প্রশিক্ষণ রেটিং ও ইতিহাস শুধু এই ডিভাইসেই সংরক্ষিত থাকে, আর অ্যাপটি মুছে ফেললে সেগুলিও মুছে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A part del joc en línia, l’app no recull ni envia res sobre tu. L’única cosa que descarrega és el fil diari, quan obres «Avui». Les teves puntuacions d’entrenament i l’historial només s’emmagatzemen en aquest dispositiu, i en suprimir l’app també se suprimeixen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kromě online hry aplikace nic nesbírá a nic o tobě neposílá. Jediné, co stahuje, je denní přehled, když otevřeš Dnes. Tréninkové ratingy a historie jsou uložené jen v tomto zařízení a smazáním aplikace se smažou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ud over onlinespil indsamler appen intet og sender intet om dig. Det eneste, den henter, er det daglige feed, når du åbner I dag. Dine træningsratings og din historik gemmes kun på denne enhed, og sletter du appen, slettes de."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgesehen vom Online-Spiel erhebt die App nichts und sendet nichts über dich. Das Einzige, was sie herunterlädt, ist der tägliche Feed, wenn du Heute öffnest. Deine Trainingswertungen und dein Verlauf werden nur auf diesem Gerät gespeichert, und wer die App löscht, löscht sie mit."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgesehen vom Online-Spiel erhebt die App nichts und sendet nichts über dich. Das Einzige, was sie herunterlädt, ist der tägliche Feed, wenn du Heute öffnest. Deine Trainingswertungen und dein Verlauf werden nur auf diesem Gerät gespeichert, und wer die App löscht, löscht sie mit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πέρα από το διαδικτυακό παιχνίδι, η εφαρμογή δεν συλλέγει τίποτα και δεν στέλνει τίποτα για εσένα. Το μόνο που κατεβάζει είναι η ημερήσια ροή, όταν ανοίγεις το Σήμερα. Οι βαθμολογίες προπόνησης και το ιστορικό σου μένουν μόνο σε αυτή τη συσκευή, και η διαγραφή της εφαρμογής τα διαγράφει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apart from online play, the app collects nothing and sends nothing about you. The one thing it downloads is the daily feed, when you open Today. Your training ratings and history are stored only on this device, and deleting the app deletes them."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Apart from online play, the app collects nothing and sends nothing about you. The one thing it downloads is the daily feed, when you open Today. Your training ratings and history are stored only on this device, and deleting the app deletes them."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Apart from online play, the app collects nothing and sends nothing about you. The one thing it downloads is the daily feed, when you open Today. Your training ratings and history are stored only on this device, and deleting the app deletes them."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apart from online play, the app collects nothing and sends nothing about you. The one thing it downloads is the daily feed, when you open Today. Your training ratings and history are stored only on this device, and deleting the app deletes them."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Apart from online play, the app collects nothing and sends nothing about you. The one thing it downloads is the daily feed, when you open Today. Your training ratings and history are stored only on this device, and deleting the app deletes them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparte del juego en línea, la app no recoge nada ni envía nada sobre ti. Lo único que descarga es el feed diario, al abrir Hoy. Tus valoraciones de entrenamiento y tu historial se guardan solo en este dispositivo, y borrar la app los borra."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparte del juego en línea, la app no recoge nada ni envía nada sobre ti. Lo único que descarga es el feed diario, al abrir Hoy. Tus valoraciones de entrenamiento y tu historial se guardan solo en este dispositivo, y borrar la app los borra."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparte de jugar en línea, la app no recopila ni envía nada sobre ti. Lo único que descarga es el feed diario, cuando abres «Hoy». Tus calificaciones y tu historial de entrenamiento se guardan solo en este dispositivo, y al borrar la app también se borran."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkkopelaamista lukuun ottamatta sovellus ei kerää mitään eikä lähetä sinusta mitään. Ainoa, mitä se lataa, on päivän syöte, kun avaat Tänään. Harjoitusratingisi ja historiasi tallentuvat vain tähän laitteeseen, ja sovelluksen poistaminen poistaa ne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En dehors du jeu en ligne, l’app ne collecte rien et n’envoie rien vous concernant. La seule chose qu’elle télécharge est le fil du jour, quand vous ouvrez Aujourd'hui. Vos classements d’entraînement et votre historique restent sur cet appareil, et supprimer l’app les supprime."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "En dehors du jeu en ligne, l’app ne collecte rien et n’envoie rien vous concernant. La seule chose qu’elle télécharge est le fil du jour, quand vous ouvrez Aujourd'hui. Vos classements d’entraînement et votre historique restent sur cet appareil, et supprimer l’app les supprime."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "En dehors du jeu en ligne, l’app ne collecte rien et n’envoie rien vous concernant. La seule chose qu’elle télécharge est le fil du jour, quand vous ouvrez Aujourd'hui. Vos classements d’entraînement et votre historique restent sur cet appareil, et supprimer l’app les supprime."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઓનલાઇન રમતમાં સિવાય, આ app તમારા વિશે કંઈ જ એકત્ર કરતું નથી અને કંઈ જ મોકલતું નથી. તમે «આજે» ખોલો ત્યારે તે માત્ર દૈનિક feed ડાઉનલોડ કરે છે. તમારી તાલીમ ratings અને history ફક્ત આ ઉપકરણ પર જ સંગ્રહિત થાય છે, અને app કાઢી નાખવાથી તે પણ કાઢી નાખાય છે."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ઓનલાઇન રમતમાં સિવાય, આ app તમારા વિશે કંઈ જ એકત્ર કરતું નથી અને કંઈ જ મોકલતું નથી. તમે «આજે» ખોલો ત્યારે તે માત્ર દૈનિક feed ડાઉનલોડ કરે છે. તમારી તાલીમ ratings અને history ફક્ત આ ઉપકરણ પર જ સંગ્રહિત થાય છે, અને app કાઢી નાખવાથી તે પણ કાઢી નાખાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מלבד משחק מקוון, האפליקציה לא אוספת דבר ולא שולחת דבר עליך. הדבר היחיד שהיא מורידה הוא הפיד היומי, בפתיחת היום. דירוגי האימון וההיסטוריה נשמרים רק במכשיר הזה, ומחיקת האפליקציה מוחקת אותם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑनलाइन खेल के अलावा, ऐप कुछ इकट्ठा नहीं करता और आपके बारे में कुछ नहीं भेजता। यह केवल दैनिक फ़ीड डाउनलोड करता है, जब आप आज खोलते हैं। आपकी ट्रेनिंग रेटिंग और इतिहास सिर्फ़ इसी डिवाइस पर रहते हैं, और ऐप हटाने पर वे भी हट जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Osim online igre, aplikacija ne prikuplja ništa i ništa ne šalje o vama. Jedino što preuzima jest dnevni sadržaj kada otvorite «Danas». Vaši trenažni rejting i povijest pohranjeni su samo na ovom uređaju, a brisanjem aplikacije brišu se i oni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az online játékon kívül az alkalmazás semmit nem gyűjt, és semmit nem küld rólad. Egyedül a napi hírfolyamot tölti le, amikor megnyitod a Ma lapot. Az edzés-értékszámaid és az előzményeid csak ezen az eszközön vannak, és az alkalmazás törlése törli őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selain permainan daring, aplikasi ini tidak mengumpulkan apa pun dan tidak mengirim apa pun tentangmu. Satu-satunya yang diunduh adalah umpan harian, saat kamu membuka Hari ini. Rating latihan dan riwayatmu hanya tersimpan di perangkat ini, dan menghapus aplikasi akan menghapusnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A parte il gioco online, l'app non raccoglie nulla e non invia nulla su di te. L'unica cosa che scarica è il feed quotidiano, quando apri Oggi. I tuoi punteggi di allenamento e la cronologia restano solo su questo dispositivo, e cancellare l'app li cancella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンライン対局を除き、アプリは何も収集せず、あなたについて何も送信しません。ダウンロードするのは「今日」を開いたときのデイリーフィードだけです。トレーニングのレーティングと履歴はこのデバイスにのみ保存され、アプリを削除すると消えます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Онлайн ойнаудан бөлек, қолданба сіз туралы ештеңе жинамайды және ештеңе жібермейді. Ол жүктейтін жалғыз нәрсе — сіз «Бүгін» ашқан кезде күнделікті жаңалықтар ағыны. Сіздің жаттығу рейтингтері мен тарихыңыз тек осы құрылғыда сақталады, ал қолданбаны жойсаңыз, олар да жойылады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆನ್‌ಲೈನ್ ಆಟದ ಹೊರತು, ಆಪ್ ನಿಮ್ಮ ಬಗ್ಗೆ ಏನನ್ನೂ ಸಂಗ್ರಹಿಸುವುದಿಲ್ಲ ಮತ್ತು ಏನನ್ನೂ ಕಳುಹಿಸುವುದಿಲ್ಲ. ನೀವು «ಇಂದು» ಅನ್ನು ತೆರೆಯುವಾಗ, ಅದು ಡೌನ್‌ಲೋಡ್ ಮಾಡುವ ಏಕೈಕ ವಿಷಯ ದೈನಂದಿನ ಫೀಡ್. ನಿಮ್ಮ ತರಬೇತಿ ರೇಟಿಂಗ್‌ಗಳು ಮತ್ತು ಇತಿಹಾಸವು ಕೇವಲ ಈ ಸಾಧನದಲ್ಲೇ ಸಂಗ್ರಹವಾಗುತ್ತವೆ, ಮತ್ತು ಆಪ್ ಅನ್ನು ಅಳಿಸಿದರೆ ಅವುಗಳೂ ಅಳಿದುಹೋಗುತ್ತವೆ."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆನ್‌ಲೈನ್ ಆಟದ ಹೊರತು, ಆಪ್ ನಿಮ್ಮ ಬಗ್ಗೆ ಏನನ್ನೂ ಸಂಗ್ರಹಿಸುವುದಿಲ್ಲ ಮತ್ತು ಏನನ್ನೂ ಕಳುಹಿಸುವುದಿಲ್ಲ. ನೀವು «ಇಂದು» ಅನ್ನು ತೆರೆಯುವಾಗ, ಅದು ಡೌನ್‌ಲೋಡ್ ಮಾಡುವ ಏಕೈಕ ವಿಷಯ ದೈನಂದಿನ ಫೀಡ್. ನಿಮ್ಮ ತರಬೇತಿ ರೇಟಿಂಗ್‌ಗಳು ಮತ್ತು ಇತಿಹಾಸವು ಕೇವಲ ಈ ಸಾಧನದಲ್ಲೇ ಸಂಗ್ರಹವಾಗುತ್ತವೆ, ಮತ್ತು ಆಪ್ ಅನ್ನು ಅಳಿಸಿದರೆ ಅವುಗಳೂ ಅಳಿದುಹೋಗುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온라인 대국을 제외하면 앱은 아무것도 수집하지 않고 당신에 관해 아무것도 보내지 않습니다. 다운로드하는 것은 '오늘'을 열 때의 일일 피드뿐입니다. 훈련 레이팅과 기록은 이 기기에만 저장되며, 앱을 삭제하면 함께 삭제됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓൺലൈൻ കളി ഒഴികെ, ആപ്പ് നിങ്ങളെക്കുറിച്ച് ഒന്നും ശേഖരിക്കുകയോ ഒന്നും അയയ്ക്കുകയോ ചെയ്യുന്നില്ല. നിങ്ങൾ «ഇന്ന്» തുറക്കുമ്പോൾ അത് ഡൗൺലോഡ് ചെയ്യുന്ന ഏക കാര്യം ദിനസാരി ഫീഡാണ്. നിങ്ങളുടെ പരിശീലന റേറ്റിംഗുകളും ചരിത്രവും ഈ ഉപകരണത്തിൽ മാത്രം സൂക്ഷിക്കപ്പെടുന്നു, ആപ്പ് ഇല്ലാതാക്കിയാൽ അവയും ഇല്ലാതാകും."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓൺലൈൻ കളി ഒഴികെ, ആപ്പ് നിങ്ങളെക്കുറിച്ച് ഒന്നും ശേഖരിക്കുകയോ ഒന്നും അയയ്ക്കുകയോ ചെയ്യുന്നില്ല. നിങ്ങൾ «ഇന്ന്» തുറക്കുമ്പോൾ അത് ഡൗൺലോഡ് ചെയ്യുന്ന ഏക കാര്യം ദിനസാരി ഫീഡാണ്. നിങ്ങളുടെ പരിശീലന റേറ്റിംഗുകളും ചരിത്രവും ഈ ഉപകരണത്തിൽ മാത്രം സൂക്ഷിക്കപ്പെടുന്നു, ആപ്പ് ഇല്ലാതാക്കിയാൽ അവയും ഇല്ലാതാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑनलाइन खेळाशिवाय, हे अॅप तुमच्याबद्दल काहीही गोळा करत नाही आणि काहीही पाठवत नाही. तुम्ही «आज» उघडता तेव्हा ते फक्त दैनिक फीड डाउनलोड करते. तुमचे प्रशिक्षण रेटिंग्ज आणि इतिहास फक्त या डिव्हाइसवरच साठवले जातात, आणि अॅप हटवल्यावर तेही हटतात."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑनलाइन खेळाशिवाय, हे अॅप तुमच्याबद्दल काहीही गोळा करत नाही आणि काहीही पाठवत नाही. तुम्ही «आज» उघडता तेव्हा ते फक्त दैनिक फीड डाउनलोड करते. तुमचे प्रशिक्षण रेटिंग्ज आणि इतिहास फक्त या डिव्हाइसवरच साठवले जातात, आणि अॅप हटवल्यावर तेही हटतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selain permainan dalam talian, aplikasi ini tidak mengumpul apa-apa dan tidak menghantar apa-apa tentang anda. Satu-satunya yang dimuat turun ialah suapan harian, apabila anda membuka Hari ini. Rating latihan dan sejarah anda hanya disimpan pada peranti ini, dan memadam aplikasi memadamnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utenom onlinespill samler ikke appen inn noe og sender ikke noe om deg. Det eneste den laster ned, er den daglige strømmen, når du åpner I dag. Treningsratingene og historikken din lagres bare på denne enheten, og sletter du appen, slettes de."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Buiten online spelen verzamelt de app niets en stuurt ze niets over jou. Het enige wat ze downloadt is de dagelijkse feed, als je Vandaag opent. Je trainingsratings en geschiedenis staan alleen op dit apparaat, en wie de app verwijdert, verwijdert ze."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Buiten online spelen verzamelt de app niets en stuurt ze niets over jou. Het enige wat ze downloadt is de dagelijkse feed, als je Vandaag opent. Je trainingsratings en geschiedenis staan alleen op dit apparaat, en wie de app verwijdert, verwijdert ze."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Utenom onlinespill samler ikke appen inn noe og sender ikke noe om deg. Det eneste den laster ned, er den daglige strømmen, når du åpner I dag. Treningsratingene og historikken din lagres bare på denne enheten, og sletter du appen, slettes de."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଅନଲାଇନ୍ ଖେଳ ବ୍ୟତୀତ, ଆପ୍‌ଟି ଆପଣ ସମ୍ବନ୍ଧୀୟ କିଛି ମଧ୍ୟ ସଂଗ୍ରହ କରେନାହିଁ ଏବଂ କିଛି ମଧ୍ୟ ପଠାଏନାହିଁ। ଏହା ଯେଉଁ ଏକମାତ୍ର ବସ୍ତୁ ଡାଉନଲୋଡ୍ କରେ, ସେହେଲା ଦୈନିକ ଫିଡ୍, ଯେତେବେଳେ ଆପଣ «ଆଜି» ଖୋଲନ୍ତି। ଆପଣଙ୍କର ଟ୍ରେନିଂ ରେଟିଂ ଏବଂ ଇତିହାସ କେବଳ ଏହି ଡିଭାଇସ୍‌ରେ ସଂରକ୍ଷିତ ରହେ, ଏବଂ ଆପ୍‌ଟି ଡିଲିଟ୍ କଲେ ସେଗୁଡ଼ିକ ମଧ୍ୟ ଡିଲିଟ୍ ହୋଇଯାଏ।"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ଅନଲାଇନ୍ ଖେଳ ବ୍ୟତୀତ, ଆପ୍‌ଟି ଆପଣ ସମ୍ବନ୍ଧୀୟ କିଛି ମଧ୍ୟ ସଂଗ୍ରହ କରେନାହିଁ ଏବଂ କିଛି ମଧ୍ୟ ପଠାଏନାହିଁ। ଏହା ଯେଉଁ ଏକମାତ୍ର ବସ୍ତୁ ଡାଉନଲୋଡ୍ କରେ, ସେହେଲା ଦୈନିକ ଫିଡ୍, ଯେତେବେଳେ ଆପଣ «ଆଜି» ଖୋଲନ୍ତି। ଆପଣଙ୍କର ଟ୍ରେନିଂ ରେଟିଂ ଏବଂ ଇତିହାସ କେବଳ ଏହି ଡିଭାଇସ୍‌ରେ ସଂରକ୍ଷିତ ରହେ, ଏବଂ ଆପ୍‌ଟି ଡିଲିଟ୍ କଲେ ସେଗୁଡ଼ିକ ମଧ୍ୟ ଡିଲିଟ୍ ହୋଇଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਨਲਾਈਨ ਖੇਡ ਤੋਂ ਇਲਾਵਾ, ਇਹ ਐਪ ਤੁਹਾਡੇ ਬਾਰੇ ਨਾ ਕੁਝ ਇਕੱਠਾ ਕਰਦੀ ਹੈ ਅਤੇ ਨਾ ਹੀ ਕੁਝ ਭੇਜਦੀ ਹੈ। ਇਹ ਸਿਰਫ਼ ਇੱਕੀ ਚੀਜ਼ ਡਾਊਨਲੋਡ ਕਰਦੀ ਹੈ: ਰੋਜ਼ਾਨਾ ਫੀਡ, ਜਦੋਂ ਤੁਸੀਂ «ਅੱਜ» ਖੋਲ੍ਹਦੇ ਹੋ। ਤੁਹਾਡੀਆਂ ਟ੍ਰੇਨਿੰਗ ਰੇਟਿੰਗਾਂ ਅਤੇ ਇਤਿਹਾਸ ਕੇਵਲ ਇਸ ਡਿਵਾਈਸ 'ਤੇ ਸਟੋਰ ਹੁੰਦੇ ਹਨ, ਅਤੇ ਐਪ ਮਿਟਾਉਣ ਨਾਲ ਉਹ ਵੀ ਮਿਟ ਜਾਂਦੇ ਹਨ।"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਨਲਾਈਨ ਖੇਡ ਤੋਂ ਇਲਾਵਾ, ਇਹ ਐਪ ਤੁਹਾਡੇ ਬਾਰੇ ਨਾ ਕੁਝ ਇਕੱਠਾ ਕਰਦੀ ਹੈ ਅਤੇ ਨਾ ਹੀ ਕੁਝ ਭੇਜਦੀ ਹੈ। ਇਹ ਸਿਰਫ਼ ਇੱਕੀ ਚੀਜ਼ ਡਾਊਨਲੋਡ ਕਰਦੀ ਹੈ: ਰੋਜ਼ਾਨਾ ਫੀਡ, ਜਦੋਂ ਤੁਸੀਂ «ਅੱਜ» ਖੋਲ੍ਹਦੇ ਹੋ। ਤੁਹਾਡੀਆਂ ਟ੍ਰੇਨਿੰਗ ਰੇਟਿੰਗਾਂ ਅਤੇ ਇਤਿਹਾਸ ਕੇਵਲ ਇਸ ਡਿਵਾਈਸ 'ਤੇ ਸਟੋਰ ਹੁੰਦੇ ਹਨ, ਅਤੇ ਐਪ ਮਿਟਾਉਣ ਨਾਲ ਉਹ ਵੀ ਮਿਟ ਜਾਂਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poza grą online aplikacja niczego nie zbiera i niczego o tobie nie wysyła. Jedyne, co pobiera, to codzienny kanał, gdy otwierasz Dziś. Rankingi treningowe i historia są przechowywane tylko na tym urządzeniu, a usunięcie aplikacji je usuwa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fora o jogo on-line, o app não coleta nada e não envia nada sobre você. A única coisa que ele baixa é o feed diário, quando você abre Hoje. Seus ratings de treino e seu histórico ficam só neste aparelho, e apagar o app apaga tudo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fora o jogo on-line, o app não coleta nada e não envia nada sobre você. A única coisa que ele baixa é o feed diário, quando você abre Hoje. Seus ratings de treino e seu histórico ficam só neste aparelho, e apagar o app apaga tudo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fora do jogo online, a app não recolhe nem envia nada sobre si. A única coisa que descarrega é a atualização diária, quando abre «Hoje». As suas classificações e o seu histórico de treino são guardados apenas neste dispositivo, e ao eliminar a app também são apagados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În afară de jocul online, aplicația nu colectează nimic și nu trimite nimic despre tine. Singurul lucru pe care îl descarcă este fluxul zilnic, când deschizi Azi. Ratingurile de antrenament și istoricul sunt păstrate doar pe acest dispozitiv, iar ștergerea aplicației le șterge."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кроме онлайн-игры, приложение ничего не собирает и ничего о вас не отправляет. Единственное, что оно загружает, — ежедневная лента, когда вы открываете «Сегодня». Тренировочные рейтинги и история хранятся только на этом устройстве, и удаление приложения удаляет их."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Okrem online hrania aplikácia nezhromažďuje o vás nič a nič o vás neodosiela. Jediné, čo sťahuje, je denný obsah, keď otvoríte „Dnes“. Vaše tréningové hodnotenia a história sa ukladajú iba v tomto zariadení a ich odstránením sa odstránia aj pri odinštalovaní aplikácie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Razen spletne igre aplikacija ne zbira ničesar in o vas ne pošilja ničesar. Edina stvar, ki jo prenese, je dnevni vir, ko odprete »Danes«. Vaše ocene vadbe in zgodovina so shranjeni samo na tej napravi, z izbrisom aplikacije pa se izbrišejo tudi ti podatki."
          }
        },
        "sl-SI": {
          "stringUnit": {
            "state": "translated",
            "value": "Razen spletne igre aplikacija ne zbira ničesar in o vas ne pošilja ničesar. Edina stvar, ki jo prenese, je dnevni vir, ko odprete »Danes«. Vaše ocene vadbe in zgodovina so shranjeni samo na tej napravi, z izbrisom aplikacije pa se izbrišejo tudi ti podatki."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utöver onlinespel samlar appen inte in något och skickar inget om dig. Det enda den laddar ner är det dagliga flödet, när du öppnar I dag. Dina träningsratingar och din historik sparas bara på den här enheten, och tar du bort appen försvinner de."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆன்லைன் விளையாட்டைத் தவிர, இந்த பயன்பாடு உங்களைப் பற்றி எதையும் சேகரிக்கவும் இல்லை; எதையும் அனுப்பவும் இல்லை. நீங்கள் «இன்று» திறக்கும் போது, இது பதிவிறக்குவது தினசரி ஊட்டம் மட்டுமே. உங்கள் பயிற்சி மதிப்பீடுகள் மற்றும் வரலாறு இந்த சாதனத்தில் மட்டுமே சேமிக்கப்படுகின்றன; பயன்பாட்டை நீக்கினால் அவையும் நீக்கப்படும்."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆன்லைன் விளையாட்டைத் தவிர, இந்த பயன்பாடு உங்களைப் பற்றி எதையும் சேகரிக்கவும் இல்லை; எதையும் அனுப்பவும் இல்லை. நீங்கள் «இன்று» திறக்கும் போது, இது பதிவிறக்குவது தினசரி ஊட்டம் மட்டுமே. உங்கள் பயிற்சி மதிப்பீடுகள் மற்றும் வரலாறு இந்த சாதனத்தில் மட்டுமே சேமிக்கப்படுகின்றன; பயன்பாட்டை நீக்கினால் அவையும் நீக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆన్‌లైన్ ఆట తప్ప, ఈ యాప్ మీ గురించి ఏదీ సేకరించదు, ఏదీ పంపించదు. మీరు «నేడు» తెరిచినప్పుడు ఇది డౌన్‌లోడ్ చేసేది రోజువారీ ఫీడ్ మాత్రమే. మీ శిక్షణ రేటింగ్‌లు మరియు చరిత్ర ఈ పరికరంలో మాత్రమే నిల్వ ఉంటాయి; యాప్‌ను తొలగిస్తే అవి కూడా తొలగిపోతాయి."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆన్‌లైన్ ఆట తప్ప, ఈ యాప్ మీ గురించి ఏదీ సేకరించదు, ఏదీ పంపించదు. మీరు «నేడు» తెరిచినప్పుడు ఇది డౌన్‌లోడ్ చేసేది రోజువారీ ఫీడ్ మాత్రమే. మీ శిక్షణ రేటింగ్‌లు మరియు చరిత్ర ఈ పరికరంలో మాత్రమే నిల్వ ఉంటాయి; యాప్‌ను తొలగిస్తే అవి కూడా తొలగిపోతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นอกจากการเล่นออนไลน์ แอปไม่เก็บและไม่ส่งข้อมูลใดเกี่ยวกับคุณ สิ่งเดียวที่ดาวน์โหลดคือฟีดประจำวันเมื่อคุณเปิดวันนี้ เรตติ้งการฝึกและประวัติเก็บไว้บนอุปกรณ์นี้เท่านั้น และการลบแอปจะลบข้อมูลเหล่านั้นด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimiçi oyun dışında uygulama hiçbir şey toplamaz ve senin hakkında hiçbir şey göndermez. İndirdiği tek şey, Bugün'ü açtığında günlük akıştır. Antrenman puanların ve geçmişin yalnızca bu cihazda tutulur; uygulamayı silmek onları da siler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Окрім гри онлайн, додаток нічого не збирає й нічого про вас не надсилає. Єдине, що він завантажує, — це щоденну стрічку, коли ви відкриваєте «Сьогодні». Ваші рейтинги тренувань і історія зберігаються лише на цьому пристрої, а після видалення додатка вони теж видаляються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آن لائن کھیل کے علاوہ، یہ ایپ آپ کے بارے میں نہ کچھ جمع کرتی ہے اور نہ کچھ بھیجتی ہے۔ یہ صرف ایک چیز ڈاؤن لوڈ کرتی ہے: روزانہ فیڈ، جب آپ «آج» کھولتے ہیں۔ آپ کی تربیتی ریٹنگز اور ہسٹری صرف اسی ڈیوائس پر محفوظ رہتی ہیں، اور ایپ حذف کرنے سے وہ بھی حذف ہو جاتی ہیں۔"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "آن لائن کھیل کے علاوہ، یہ ایپ آپ کے بارے میں نہ کچھ جمع کرتی ہے اور نہ کچھ بھیجتی ہے۔ یہ صرف ایک چیز ڈاؤن لوڈ کرتی ہے: روزانہ فیڈ، جب آپ «آج» کھولتے ہیں۔ آپ کی تربیتی ریٹنگز اور ہسٹری صرف اسی ڈیوائس پر محفوظ رہتی ہیں، اور ایپ حذف کرنے سے وہ بھی حذف ہو جاتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngoài chơi trực tuyến, ứng dụng không thu thập gì và không gửi gì về bạn. Thứ duy nhất nó tải xuống là bảng tin hằng ngày, khi bạn mở Hôm nay. Hệ số luyện tập và lịch sử của bạn chỉ được lưu trên thiết bị này, và xóa ứng dụng sẽ xóa chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除在线对局外，应用不收集任何东西，也不发送任何关于你的信息。它唯一下载的是你打开“今天”时的每日动态。你的训练等级分和历史只存储在这台设备上，删除应用即会删除它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除線上對局外，App 不收集任何東西，也不傳送任何關於你的資訊。它唯一下載的是你開啟「今天」時的每日動態。你的訓練等級分和歷史只儲存在這台裝置上，刪除 App 即會刪除它們。"
          }
        }
      }
    },
