    "play.engineHasNoLadder": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ يلعب بكامل قوته — لا يملك أداة لتحديد التصنيف. غيّر المحرك من الإعدادات للعب ضد خصم بتصنيف محدد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hraje na plnou sílu – nemá omezovač Ela. Chcete-li hrát proti soupeři se zadaným Elem, změňte engine v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ spiller på fuld styrke – den har ingen ratingbegrænsning. Skift motor i Indstillinger for at møde en ratet modstander."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ spielt in voller Stärke – es gibt keine Stärkebegrenzung. Wechseln Sie die Engine in den Einstellungen, um gegen einen gewerteten Gegner zu spielen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η %@ παίζει με πλήρη δύναμη — δεν έχει περιοριστή βαθμολογίας. Αλλάξτε μηχανή στις Ρυθμίσεις για να παίξετε με αντίπαλο συγκεκριμένης βαθμολογίας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ plays at full strength — it has no rating limiter. Change the engine in Settings to play a rated opponent."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ plays at full strength — it has no rating limiter. Change the engine in Settings to play a rated opponent."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ plays at full strength — it has no rating limiter. Change the engine in Settings to play a rated opponent."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ juega a plena potencia: no tiene limitador de nivel. Cambia el motor en Ajustes para jugar contra un rival con Elo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pelaa täydellä voimalla – siinä ei ole rating-rajoitinta. Vaihda moottoria asetuksissa, jos haluat pelata ratingiltaan määriteltyä vastustajaa vastaan."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ joue à pleine puissance : il n'a pas de limiteur de niveau. Changez de moteur dans les Réglages pour affronter un adversaire classé."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ joue à pleine puissance : il n'a pas de limiteur de niveau. Changez de moteur dans les Réglages pour affronter un adversaire classé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ משחק בעוצמה מלאה — אין לו מגביל דירוג. החליפו מנוע בהגדרות כדי לשחק מול יריב מדורג."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पूरी ताक़त से खेलता है — इसमें रेटिंग सीमित करने की सुविधा नहीं है। रेटिंग वाले प्रतिद्वंद्वी से खेलने के लिए सेटिंग्स में इंजन बदलें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ teljes erővel játszik – nincs pontszámkorlátozója. Váltson motort a Beállításokban, ha adott erősségű ellenfél ellen szeretne játszani."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bermain dengan kekuatan penuh — tidak ada pembatas rating. Ganti mesin di Pengaturan untuk melawan lawan berperingkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gioca a piena potenza: non ha un limitatore di livello. Cambia motore nelle Impostazioni per affrontare un avversario con Elo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は全力で指します。レーティング制限の機能がありません。レーティングを指定した相手と対局するには、設定でエンジンを切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 은(는) 최대 기력으로 둡니다. 레이팅 제한 기능이 없습니다. 레이팅이 정해진 상대와 두려면 설정에서 엔진을 바꾸세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bermain pada kekuatan penuh — ia tiada pembatas penarafan. Tukar enjin dalam Tetapan untuk bermain menentang lawan bertaraf."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ speelt op volle kracht — er is geen ratingbegrenzing. Wissel van engine in Instellingen om tegen een gewaardeerde tegenstander te spelen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ spiller på full styrke – den har ingen ratingbegrensning. Bytt motor i Innstillinger for å møte en ratet motstander."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gra z pełną siłą — nie ma ogranicznika rankingu. Zmień silnik w Ustawieniach, aby zagrać z przeciwnikiem o określonym rankingu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ joga em força total: não tem limitador de nível. Troque o motor nos Ajustes para enfrentar um adversário com rating."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ joacă la putere maximă – nu are limitator de rating. Schimbă motorul în Setări pentru a juca împotriva unui adversar cu rating."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ играет в полную силу — у него нет ограничителя рейтинга. Смените движок в настройках, чтобы играть с соперником заданного рейтинга."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ spelar på full styrka – den har ingen ratingbegränsning. Byt motor i Inställningar för att möta en ratad motståndare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ เล่นเต็มกำลัง — ไม่มีตัวจำกัดเรตติง เปลี่ยนเอนจินในการตั้งค่าเพื่อเล่นกับคู่ต่อสู้ที่มีเรตติง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tam güçte oynar — puan sınırlayıcısı yoktur. Puanlı bir rakibe karşı oynamak için Ayarlar'dan motoru değiştirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chơi ở sức mạnh tối đa — nó không có bộ giới hạn Elo. Hãy đổi engine trong Cài đặt để chơi với đối thủ có Elo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 以全力下棋——它没有等级分限制功能。若要与有等级分的对手下棋，请在设置中更换引擎。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 以全力下棋——它沒有等級分限制功能。若要與有等級分的對手下棋，請在設定中更換引擎。"
          }
        }
      }
    },
