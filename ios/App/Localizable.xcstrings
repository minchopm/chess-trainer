    "store.changeNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن تغيير الخطة في أي وقت. يبدأ الانتقال بين الشهري والسنوي عند التجديد التالي."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن تغيير الخطة في أي وقت. يبدأ الانتقال بين الشهري والسنوي عند التجديد التالي."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Можете да смените плана си по всяко време. Смяната между месечен и годишен започва при следващото подновяване."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যেকোনো সময় আপনার প্ল্যান বদলাতে পারেন। মাসিক থেকে বার্ষিক, বা উল্টোটা, আপনার পরবর্তী নবায়ন থেকে কার্যকর হবে।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যেকোনো সময় আপনার প্ল্যান বদলাতে পারেন। মাসিক থেকে বার্ষিক, বা উল্টোটা, আপনার পরবর্তী নবায়ন থেকে কার্যকর হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots canviar de pla en qualsevol moment. El canvi entre mensual i anual s'aplica a la propera renovació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plán můžeš kdykoli změnit. Přechod mezi měsíčním a ročním začne při dalším obnovení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan skifte plan når som helst. Et skift mellem månedlig og årlig starter ved næste fornyelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst dein Abo jederzeit wechseln. Ein Wechsel zwischen monatlich und jährlich beginnt mit der nächsten Verlängerung."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst dein Abo jederzeit wechseln. Ein Wechsel zwischen monatlich und jährlich beginnt mit der nächsten Verlängerung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείς να αλλάξεις πρόγραμμα οποιαδήποτε στιγμή. Η αλλαγή ανάμεσα σε μηνιαίο και ετήσιο ξεκινά με την επόμενη ανανέωση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change your plan at any time. A switch between monthly and yearly starts at your next renewal."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change your plan at any time. A switch between monthly and yearly starts at your next renewal."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change your plan at any time. A switch between monthly and yearly starts at your next renewal."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change your plan at any time. A switch between monthly and yearly starts at your next renewal."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change your plan at any time. A switch between monthly and yearly starts at your next renewal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar de plan cuando quieras. El paso entre mensual y anual empieza en tu próxima renovación."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar de plan cuando quieras. El paso entre mensual y anual empieza en tu próxima renovación."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar tu plan en cualquier momento. El cambio entre mensual y anual empieza en tu próxima renovación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit vaihtaa tilausta milloin tahansa. Vaihto kuukausi- ja vuositilauksen välillä alkaa seuraavasta uusimisesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez changer de formule à tout moment. Le passage entre mensuel et annuel prend effet à votre prochain renouvellement."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez changer de formule à tout moment. Le passage entre mensuel et annuel prend effet à votre prochain renouvellement."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez changer de formule à tout moment. Le passage entre mensuel et annuel prend effet à votre prochain renouvellement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે તમારી યોજના કોઈપણ સમયે બદલી શકો છો. માસિક અને વાર્ષિક વચ્ચે બદલાવ તમારી આગામી નવીકરણથી શરૂ થશે."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે તમારી યોજના કોઈપણ સમયે બદલી શકો છો. માસિક અને વાર્ષિક વચ્ચે બદલાવ તમારી આગામી નવીકરણથી શરૂ થશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לשנות תוכנית בכל עת. מעבר בין חודשי לשנתי מתחיל בחידוש הבא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप कभी भी अपनी योजना बदल सकते हैं। मासिक और वार्षिक के बीच बदलाव अगले नवीनीकरण से शुरू होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan možeš promijeniti u bilo kojem trenutku. Promjena između mjesečnog i godišnjeg počinje pri sljedećoj obnovi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármikor válthatsz csomagot. A havi és az éves közötti váltás a következő megújításkor lép életbe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu bisa mengganti paket kapan saja. Perpindahan antara bulanan dan tahunan dimulai pada perpanjangan berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi cambiare piano quando vuoi. Il passaggio tra mensile e annuale parte dal prossimo rinnovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランはいつでも変更できます。月額と年額の切り替えは次回の更新日から適用されます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоспарыңызды кез келген уақытта өзгерте аласыз. Айлықтан жылдыққа не керісінше ауысу келесі жаңартудан бастап күшіне енеді."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ನಿಮ್ಮ ಯೋಜನೆಯನ್ನು ಯಾವಾಗ ಬೇಕಾದರೂ ಬದಲಾಯಿಸಬಹುದು. ಮಾಸಿಕ ಮತ್ತು ವಾರ್ಷಿಕದ ನಡುವಿನ ಬದಲಾವಣೆ ನಿಮ್ಮ ಮುಂದಿನ ನವೀಕರಣದಿಂದ ಆರಂಭವಾಗುತ್ತದೆ."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ನಿಮ್ಮ ಯೋಜನೆಯನ್ನು ಯಾವಾಗ ಬೇಕಾದರೂ ಬದಲಾಯಿಸಬಹುದು. ಮಾಸಿಕ ಮತ್ತು ವಾರ್ಷಿಕದ ನಡುವಿನ ಬದಲಾವಣೆ ನಿಮ್ಮ ಮುಂದಿನ ನವೀಕರಣದಿಂದ ಆರಂಭವಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플랜은 언제든 변경할 수 있습니다. 월간과 연간 사이의 변경은 다음 갱신일부터 적용됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പ്ലാൻ ഏത് സമയത്തും മാറ്റാം. മാസത്തിലെയും വാർഷികത്തിലെയും മാറ്റം നിങ്ങളുടെ അടുത്ത പുതുക്കലിൽ നിന്ന് പ്രാബല്യത്തിൽ വരും."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പ്ലാൻ ഏത് സമയത്തും മാറ്റാം. മാസത്തിലെയും വാർഷികത്തിലെയും മാറ്റം നിങ്ങളുടെ അടുത്ത പുതുക്കലിൽ നിന്ന് പ്രാബല്യത്തിൽ വരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची योजना तुम्ही कधीही बदलू शकता. मासिक आणि वार्षिक यांतील बदल पुढील नूतनीकरणापासून लागू होतो."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची योजना तुम्ही कधीही बदलू शकता. मासिक आणि वार्षिक यांतील बदल पुढील नूतनीकरणापासून लागू होतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh menukar pelan pada bila-bila masa. Pertukaran antara bulanan dan tahunan bermula pada pembaharuan seterusnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan bytte plan når som helst. Et bytte mellom månedlig og årlig starter ved neste fornyelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt je abonnement altijd wijzigen. Een overstap tussen maandelijks en jaarlijks gaat in bij je volgende verlenging."
          }
        },
        "nl-NL": {
          "stringUnit": {
