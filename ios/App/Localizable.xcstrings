    "today.source": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النقلات من البث الرسمي، عبر Lichess. التقييمات من Stockfish. لا ترتبط Brass Pawn بالبطولة ولا باللاعبين."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "النقلات من البث الرسمي، عبر Lichess. التقييمات من Stockfish. لا ترتبط Brass Pawn بالبطولة ولا باللاعبين."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ходовете са от официалния пренос, предавани чрез Lichess. Оценките са от Stockfish. Brass Pawn не е свързан с турнира или с играчите."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lichess-এর মাধ্যমে সম্প্রচারিত অফিসিয়াল সম্প্রচারের চালগুলো। Stockfish-এর মূল্যায়ন। Brass Pawn ইভেন্ট বা খেলোয়াড়দের সঙ্গে যুক্ত নয়।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "Lichess-এর মাধ্যমে সম্প্রচারিত অফিসিয়াল সম্প্রচারের চালগুলো। Stockfish-এর মূল্যায়ন। Brass Pawn ইভেন্ট বা খেলোয়াড়দের সঙ্গে যুক্ত নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Moviments de la transmissió oficial, retransmesa per Lichess. Avaluacions de Stockfish. Brass Pawn no està afiliat amb l'esdeveniment ni amb els jugadors."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahy z oficiálního přenosu, zprostředkované Lichess. Hodnocení od Stockfishe. Brass Pawn není s turnajem ani s hráči nijak spojen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk fra den officielle transmission, videreformidlet af Lichess. Vurderinger fra Stockfish. Brass Pawn er ikke tilknyttet turneringen eller spillerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Züge aus der offiziellen Übertragung, weitergegeben von Lichess. Bewertungen von Stockfish. Brass Pawn steht in keiner Verbindung zum Turnier oder zu den Spielern."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Züge aus der offiziellen Übertragung, weitergegeben von Lichess. Bewertungen von Stockfish. Brass Pawn steht in keiner Verbindung zum Turnier oder zu den Spielern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κινήσεις από την επίσημη μετάδοση, μέσω Lichess. Αξιολογήσεις από το Stockfish. Το Brass Pawn δεν συνδέεται με τη διοργάνωση ή τους παίκτες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves from the official broadcast, relayed by Lichess. Evaluations by Stockfish. Brass Pawn is not affiliated with the event or the players."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves from the official broadcast, relayed by Lichess. Evaluations by Stockfish. Brass Pawn is not affiliated with the event or the players."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves from the official broadcast, relayed by Lichess. Evaluations by Stockfish. Brass Pawn is not affiliated with the event or the players."
          }
        },
        "en-GB": {
