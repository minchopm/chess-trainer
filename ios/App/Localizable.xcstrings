    "progress.onlineRatingIsKeptApart": {
      "extractionState": "manual",
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Online-Wertung wird getrennt von den Trainingswertungen geführt: Sie misst dich an den Menschen, gegen die du spielst, nicht an einer Aufgabensammlung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Online rating is kept apart from the training ratings: it measures you against the people you play, not against a library."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Online rating is kept apart from the training ratings: it measures you against the people you play, not against a library."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Online rating is kept apart from the training ratings: it measures you against the people you play, not against a library."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La valoración en línea se mantiene aparte de las de entrenamiento: te mide frente a las personas con las que juegas, no frente a una colección."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le classement en ligne est tenu à part des classements d'entraînement : il vous mesure face aux joueurs que vous affrontez, pas face à une collection."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le classement en ligne est tenu à part des classements d'entraînement : il vous mesure face aux joueurs que vous affrontez, pas face à une collection."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il punteggio online è tenuto separato da quelli di allenamento: misura te contro le persone con cui giochi, non contro una raccolta."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De onlinerating staat los van de trainingsratings: die meet je tegen de mensen met wie je speelt, niet tegen een verzameling opgaven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ranking online jest trzymany osobno od treningowych: mierzy cię wobec ludzi, z którymi grasz, a nie wobec zbioru zadań."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O rating on-line fica separado dos ratings de treino: ele mede você contra as pessoas com quem joga, não contra uma coleção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Онлайн-рейтинг ведётся отдельно от тренировочных: он измеряет вас против живых соперников, а не против набора задач."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimiçi puan, antrenman puanlarından ayrı tutulur: seni bir soru bankasına değil, karşına çıkan insanlara göre ölçer."
          }
        }
      }
    },
