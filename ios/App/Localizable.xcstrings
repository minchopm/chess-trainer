        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Brass Pawn é de código aberto, sem anúncios, sem conta e sem rastreamento. O Pro remove os limites diários do treino e ajuda a pagar o trabalho que mantém a aplicação em funcionamento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn este open source, fără reclame, fără cont și fără urmărire. Pro ridică limitele zilnice ale antrenamentului și plătește munca ce ține aplicația în viață."
          }
