    "settings.flatNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُقرأ من الأعلى. أسهم وتلميحات وسحب القطعة عبر المربعات."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تُقرأ من الأعلى. أسهم وتلميحات وسحب القطعة عبر المربعات."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разпознава отгоре. Стрелки, подсказки и влачене на фигура през полетата."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উপর থেকে পড়ুন। তীরচিহ্ন, ইঙ্গিত এবং একটি ঘুঁটি ঘরগুলোর ওপর টেনে নেওয়া।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "উপর থেকে পড়ুন। তীরচিহ্ন, ইঙ্গিত এবং একটি ঘুঁটি ঘরগুলোর ওপর টেনে নেওয়া।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegeix-lo des de dalt. Fletxes, pistes i arrossegar una peça per sobre de les caselles."
          }
        },
        "cs": {
          "stringUnit": {
