        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center ಮೂಲಕ ನಿಜವಾದ ಎದುರಾಳಿ, ಗಡಿಯಾರದಲ್ಲಿ. ಸುಳಿವುಗಳಿಲ್ಲ, engine ಇಲ್ಲ, ಹಿಂಪಡೆಯುವಿಕೆಗಳಿಲ್ಲ."
