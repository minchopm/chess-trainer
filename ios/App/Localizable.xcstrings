        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center വഴി യഥാർത്ഥ എതിരാളിയുമായി, സമയനിയന്ത്രണത്തോടെ. സൂചനകളില്ല, എൻജിനില്ല, വീണ്ടും എടുത്ത് കളിക്കാനില്ല."
          }
        },
        "ml-IN": {
          "stringUnit": {
