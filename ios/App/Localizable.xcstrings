        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za darmo każdego dnia: %lld zadań taktycznych. Rush ma własny osobny limit. Oba resetują się o 9:00 czasu lokalnego. Gra przeciwko SI lub innej osobie pozostaje bez ograniczeń."
          }
