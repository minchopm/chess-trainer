    "tactics.tryForcing": {
      "extractionState": "manual",
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier gibt es einen stärkeren Zug. Sieh dir zuerst die forcierenden Möglichkeiten an — Schachs, Schläge, Drohungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is a stronger move here. Look at the most forcing options first — checks, captures, threats."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "There is a stronger move here. Look at the most forcing options first — checks, captures, threats."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "There is a stronger move here. Look at the most forcing options first — checks, captures, threats."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí hay una jugada más fuerte. Mira primero lo más forzado: jaques, capturas, amenazas."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a plus fort ici. Regardez d'abord les coups les plus forçants — échecs, prises, menaces."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a plus fort ici. Regardez d'abord les coups les plus forçants — échecs, prises, menaces."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui c'è una mossa più forte. Guarda prima le opzioni più forzanti: scacchi, catture, minacce."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is hier een sterkere zet. Kijk eerst naar het meest forcerende — schaakjes, slagzetten, dreigingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jest tu silniejsze posunięcie. Najpierw sprawdź to, co wymusza — szachy, bicia, groźby."
