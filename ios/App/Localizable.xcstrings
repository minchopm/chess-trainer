    "play.abandonReason": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لعبتما %lld نقلة. المغادرة الآن تعني الخسارة، ولن تُسجَّل المباراة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jste %lld tahů v partii. Odejít teď znamená prohru a partie se nezapíše."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I er %lld træk inde. Går du nu, taber du partiet, og det bliver ikke registreret."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr seid %lld Züge weit. Wer jetzt geht, verliert die Partie, und sie wird nicht gewertet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είστε στην %lld κίνηση. Αν φύγεις τώρα χάνεις την παρτίδα και δεν θα καταγραφεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are %lld moves in. Leaving now loses the game and it will not be recorded."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "You are %lld moves in. Leaving now loses the game and it will not be recorded."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You are %lld moves in. Leaving now loses the game and it will not be recorded."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleváis %lld jugadas. Si sales ahora pierdes la partida y no se registrará."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Peliä on pelattu %lld siirtoa. Jos poistut nyt, häviät pelin eikä sitä kirjata."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous en êtes à %lld coups. Partir maintenant, c'est perdre la partie, et elle ne sera pas enregistrée."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous en êtes à %lld coups. Partir maintenant, c'est perdre la partie, et elle ne sera pas enregistrée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שיחקתם %lld מהלכים. יציאה עכשיו פירושה הפסד, והמשחק לא יירשם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld चालें हो चुकी हैं। अभी निकले तो बाज़ी हार जाएँगे, और यह दर्ज नहीं होगी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lépésnél tartotok. Ha most kilépsz, elveszíted a játszmát, és nem kerül rögzítésre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah %lld langkah berjalan. Keluar sekarang berarti kalah, dan partai tidak akan dicatat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Siete a %lld mosse. Uscire adesso significa perdere la partita, e non verrà registrata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに %lld 手進んでいます。ここで離れると負けになり、対局は記録されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld수까지 진행했습니다. 지금 나가면 패배이고 대국은 기록되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah %lld langkah berlalu. Keluar sekarang bermakna kalah, dan perlawanan tidak akan direkodkan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Jullie zijn %lld zetten ver. Nu weggaan betekent verlies, en de partij wordt niet opgeslagen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Dere er %lld trekk inne. Går du nå, taper du partiet, og det blir ikke registrert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteście po %lld posunięciach. Wyjście teraz to przegrana, a partia nie zostanie zapisana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocês estão no lance %lld. Sair agora é perder a partida, e ela não será registrada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunteți la %lld mutări. Dacă pleci acum pierzi partida, iar ea nu va fi înregistrată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сыграно ходов: %lld. Выход сейчас — это поражение, и партия не будет засчитана."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni är %lld drag in i partiet. Går du nu förlorar du det, och det registreras inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นมาแล้ว %lld ตา ถ้าออกตอนนี้ถือว่าแพ้ และเกมจะไม่ถูกบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld hamle oynandı. Şimdi çıkmak oyunu kaybetmek demek ve oyun kaydedilmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ván đã đi %lld nước. Rời bây giờ là thua, và ván sẽ không được ghi nhận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经走了 %lld 步。现在离开等于输棋，而且这局不会被记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已經走了 %lld 步。現在離開等於輸棋，而且這局不會被記錄。"
          }
        }
      }
    },
