    "settings.flatNote": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تُقرأ من الأعلى. أسهم وتلميحات وسحب القطعة عبر المربعات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pohled shora. Šipky, nápovědy a tažení figury po polích."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Set oppefra. Pile, hints og træk af en brik hen over felterne."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Von oben gelesen. Pfeile, Hinweise und Ziehen einer Figur über die Felder."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάζεται από ψηλά. Βέλη, υποδείξεις και σύρσιμο κομματιού στα τετράγωνα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read from above. Arrows, hints and dragging a piece across the squares."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Read from above. Arrows, hints and dragging a piece across the squares."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Read from above. Arrows, hints and dragging a piece across the squares."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lee desde arriba. Flechas, pistas y arrastrar una pieza por las casillas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luetaan ylhäältä. Nuolet, vihjeet ja nappulan raahaus ruutujen yli."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vu du dessus. Flèches, indices et glissement d’une pièce sur les cases."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vu du dessus. Flèches, indices et glissement d’une pièce sur les cases."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נקרא מלמעלה. חיצים, רמזים וגרירת כלי על המשבצות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपर से पढ़ें। तीर, संकेत और मोहरे को खानों पर खींचना।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Felülnézet. Nyilak, tippek és a bábu húzása a mezőkön."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibaca dari atas. Panah, petunjuk, dan menyeret bidak melintasi petak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si legge dall’alto. Frecce, suggerimenti e trascinamento dei pezzi sulle caselle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上から読む盤。矢印、ヒント、駒をマスの上でドラッグ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위에서 읽는 판. 화살표와 힌트, 말을 끌어 옮기기."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibaca dari atas. Anak panah, pembayang dan seret buah merentasi petak."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Van bovenaf gelezen. Pijlen, hints en een stuk over de velden slepen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett ovenfra. Piler, hint og å dra en brikke over feltene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widok z góry. Strzałki, podpowiedzi i przeciąganie bierki po polach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lido de cima. Setas, dicas e arrastar a peça pelas casas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citită de sus. Săgeți, indicii și tragerea piesei peste pătrate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вид сверху. Стрелки, подсказки и перетаскивание фигуры по полям."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läses uppifrån. Pilar, tips och att dra en pjäs över rutorna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านจากด้านบน มีลูกศร คำใบ้ และการลากตัวหมากข้ามช่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yukarıdan okunur. Oklar, ipuçları ve taşı kareler üzerinde sürükleme."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhìn từ trên. Mũi tên, gợi ý và kéo quân qua các ô."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "俯视阅读。箭头、提示，以及在格子间拖动棋子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "俯視閱讀。箭頭、提示，以及在格子間拖動棋子。"
          }
        }
      }
    },
