        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تتجدّد الخطة الشهرية كل شهر حتى تُلغيها. يمكنك الإلغاء في أي وقت من الإعدادات › حساب Apple › الاشتراكات، قبل يوم واحد على الأقل من التجديد. الفتح لمرة واحدة دفعة واحدة ولا يتجدّد أبدًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měsíční plán se obnovuje každý měsíc, dokud ho nezrušíš. Zrušit můžeš kdykoli v Nastavení › Účet Apple › Předplatná, nejpozději den před obnovením. Jednorázové odemčení je jediná platba a nikdy se neobnovuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Månedsabonnementet fornyes hver måned, indtil du opsiger det. Du kan opsige når som helst i Indstillinger › Apple-konto › Abonnementer, senest en dag før fornyelsen. Engangskøbet er en enkelt betaling og fornyes aldrig."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Monatsabo verlängert sich jeden Monat, bis du kündigst. Kündigen kannst du jederzeit unter Einstellungen › Apple-Account › Abonnements, spätestens einen Tag vor der Verlängerung. Die einmalige Freischaltung ist eine einzelne Zahlung und verlängert sich nie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μηνιαία συνδρομή ανανεώνεται κάθε μήνα μέχρι να την ακυρώσεις. Μπορείς να ακυρώσεις οποτεδήποτε από Ρυθμίσεις › Λογαριασμός Apple › Συνδρομές, τουλάχιστον μία μέρα πριν την ανανέωση. Το εφάπαξ ξεκλείδωμα είναι μία πληρωμή και δεν ανανεώνεται ποτέ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The monthly plan renews each month until you cancel it. Cancel any time in Settings › Apple Account › Subscriptions, at least a day before it renews. The one-off unlock is a single payment and never renews."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The monthly plan renews each month until you cancel it. Cancel any time in Settings › Apple Account › Subscriptions, at least a day before it renews. The one-off unlock is a single payment and never renews."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The monthly plan renews each month until you cancel it. Cancel any time in Settings › Apple Account › Subscriptions, at least a day before it renews. The one-off unlock is a single payment and never renews."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan mensual se renueva cada mes hasta que lo canceles. Puedes cancelarlo cuando quieras en Ajustes › Cuenta de Apple › Suscripciones, al menos un día antes de la renovación. El pago único es un solo cobro y nunca se renueva."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuukausitilaus uusiutuu joka kuukausi, kunnes peruutat sen. Voit peruuttaa milloin tahansa: Asetukset › Apple-tili › Tilaukset, viimeistään vuorokautta ennen uusiutumista. Kertaosto on yksi maksu eikä uusiudu koskaan."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abonnement mensuel se renouvelle chaque mois jusqu'à résiliation. Vous pouvez résilier à tout moment dans Réglages › Compte Apple › Abonnements, au moins un jour avant le renouvellement. L'achat unique est un paiement unique et ne se renouvelle jamais."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abonnement mensuel se renouvelle chaque mois jusqu'à résiliation. Vous pouvez résilier à tout moment dans Réglages › Compte Apple › Abonnements, au moins un jour avant le renouvellement. L'achat unique est un paiement unique et ne se renouvelle jamais."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התוכנית החודשית מתחדשת מדי חודש עד שתבטל. אפשר לבטל בכל עת בהגדרות › חשבון Apple › מינויים, לפחות יום לפני החידוש. הרכישה החד-פעמית היא תשלום יחיד ולעולם אינה מתחדשת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मासिक योजना हर महीने तब तक नवीनीकृत होती है जब तक आप रद्द न करें। सेटिंग्स › Apple खाता › सदस्यताएँ में कभी भी, नवीनीकरण से कम से कम एक दिन पहले रद्द किया जा सकता है। एक बार का भुगतान सिर्फ़ एक ही भुगतान है और कभी नवीनीकृत नहीं होता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A havi csomag minden hónapban megújul, amíg le nem mondod. Bármikor lemondhatod a Beállítások › Apple-fiók › Előfizetések menüben, legkésőbb egy nappal a megújulás előtt. Az egyszeri feloldás egyetlen fizetés, és soha nem újul meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket bulanan diperpanjang tiap bulan sampai kamu batalkan. Batalkan kapan saja di Pengaturan › Akun Apple › Langganan, paling lambat sehari sebelum perpanjangan. Pembukaan sekali bayar adalah pembayaran tunggal dan tidak pernah diperpanjang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano mensile si rinnova ogni mese finché non lo disdici. Puoi disdire quando vuoi in Impostazioni › Account Apple › Abbonamenti, almeno un giorno prima del rinnovo. Lo sblocco una tantum è un pagamento singolo e non si rinnova mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月額プランは解約するまで毎月自動更新されます。解約は「設定 › Apple アカウント › サブスクリプション」から、更新日の 1 日前までにいつでも行えます。買い切りは一度きりの支払いで、更新はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월간 요금제는 해지할 때까지 매달 자동으로 갱신됩니다. 설정 › Apple 계정 › 구독에서 갱신 하루 전까지 언제든 해지할 수 있습니다. 한 번만 결제하는 잠금 해제는 단일 결제이며 갱신되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelan bulanan diperbaharui setiap bulan sehingga anda membatalkannya. Batalkan bila-bila masa di Tetapan › Akaun Apple › Langganan, sekurang-kurangnya sehari sebelum pembaharuan. Pembukaan sekali bayar ialah bayaran tunggal dan tidak pernah diperbaharui."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Het maandabonnement verlengt elke maand tot je opzegt. Opzeggen kan altijd via Instellingen › Apple-account › Abonnementen, uiterlijk een dag voor de verlenging. De eenmalige ontgrendeling is één betaling en verlengt nooit."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Månedsplanen fornyes hver måned til du sier den opp. Du kan si opp når som helst i Innstillinger › Apple-konto › Abonnementer, senest en dag før fornyelsen. Engangskjøpet er én betaling og fornyes aldri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan miesięczny odnawia się co miesiąc, dopóki go nie anulujesz. Anulować możesz w Ustawieniach › Konto Apple › Subskrypcje, najpóźniej dzień przed odnowieniem. Jednorazowe odblokowanie to pojedyncza płatność, która nigdy się nie odnawia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano mensal renova todo mês até você cancelar. Dá para cancelar quando quiser em Ajustes › Conta Apple › Assinaturas, pelo menos um dia antes da renovação. A compra única é um pagamento só e nunca renova."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Planul lunar se reînnoiește în fiecare lună până îl anulezi. Poți anula oricând din Setări › Cont Apple › Abonamente, cu cel puțin o zi înainte de reînnoire. Deblocarea unică este o singură plată și nu se reînnoiește niciodată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ежемесячная подписка продлевается каждый месяц, пока вы её не отмените. Отменить можно в любой момент: Настройки › Аккаунт Apple › Подписки, не позднее чем за сутки до продления. Разовая покупка — единственный платёж, она не продлевается."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Månadsplanen förnyas varje månad tills du säger upp den. Du kan säga upp när som helst i Inställningar › Apple-konto › Prenumerationer, senast en dag före förnyelsen. Engångsköpet är en enda betalning och förnyas aldrig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แผนรายเดือนจะต่ออายุทุกเดือนจนกว่าคุณจะยกเลิก ยกเลิกได้ทุกเมื่อที่ การตั้งค่า › บัญชี Apple › การสมัครใช้บริการ อย่างช้าหนึ่งวันก่อนต่ออายุ ส่วนการปลดล็อกครั้งเดียวเป็นการจ่ายครั้งเดียวและไม่ต่ออายุ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aylık plan, iptal edene kadar her ay yenilenir. Ayarlar › Apple Hesabı › Abonelikler bölümünden, yenilemeden en az bir gün önce dilediğin zaman iptal edebilirsin. Tek seferlik açma tek bir ödemedir ve asla yenilenmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói tháng tự gia hạn hằng tháng cho đến khi bạn hủy. Có thể hủy bất cứ lúc nào trong Cài đặt › Tài khoản Apple › Đăng ký, chậm nhất một ngày trước khi gia hạn. Gói mua một lần chỉ thanh toán một lần và không bao giờ gia hạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "月度方案在你取消前每月自动续订。可随时在「设置 › Apple 账户 › 订阅」中取消，最迟在续订前一天。一次买断只付一次，永不续订。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "月方案在你取消前每月自動續訂。可隨時在「設定 › Apple 帳號 › 訂閱項目」中取消，最遲在續訂前一天。一次買斷只付一次，永不續訂。"
          }
        }
      }
    },
