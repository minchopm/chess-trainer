    "rush.theClockIsStillGoing": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "الساعة ما زالت تعمل. المغادرة الآن تنهي الجولة وتحتفظ بالنتيجة حتى الآن."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodiny stále běží. Odchod teď sérii ukončí a uloží dosavadní skóre."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uret kører stadig. Går du nu, slutter runden, og scoren indtil nu bliver gemt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr läuft noch. Wer jetzt geht, beendet den Lauf und behält den bisherigen Punktestand."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ρολόι τρέχει ακόμη. Αν φύγεις τώρα, ο γύρος τελειώνει και κρατάς το σκορ μέχρι εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clock is still going. Leaving now ends the run and keeps the score so far."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The clock is still going. Leaving now ends the run and keeps the score so far."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The clock is still going. Leaving now ends the run and keeps the score so far."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El reloj sigue corriendo. Si sales ahora, la serie termina y se guarda la puntuación conseguida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kello käy yhä. Nyt poistuminen päättää kierroksen ja säilyttää tähänastisen tuloksen."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La pendule tourne encore. Partir maintenant arrête la série et garde le score acquis."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "La pendule tourne encore. Partir maintenant arrête la série et garde le score acquis."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השעון עדיין רץ. יציאה עכשיו מסיימת את הסבב ושומרת את הניקוד עד כה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घड़ी अब भी चल रही है। अभी निकले तो दौर ख़त्म हो जाएगा और अब तक का स्कोर रह जाएगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az óra még megy. Ha most kilépsz, a kör lezárul, és megmarad az eddigi eredmény."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam masih berjalan. Keluar sekarang mengakhiri sesi dan menyimpan skor sejauh ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'orologio sta ancora andando. Uscire adesso chiude la serie e tiene il punteggio fatto finora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計はまだ動いています。ここで離れるとラッシュは終了し、いまの成績が残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계가 아직 돌고 있습니다. 지금 나가면 러시가 끝나고 지금까지의 점수가 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam masih berjalan. Keluar sekarang menamatkan pusingan dan menyimpan markah setakat ini."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De klok loopt nog. Nu weggaan beëindigt de ronde en houdt de score tot nu toe."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Klokka går fortsatt. Går du nå, avsluttes runden og poengsummen så langt beholdes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zegar wciąż idzie. Wyjście teraz kończy serię i zachowuje dotychczasowy wynik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio ainda está correndo. Sair agora encerra a série e guarda a pontuação até aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceasul încă merge. Dacă pleci acum, runda se încheie și scorul de până acum rămâne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы ещё идут. Выход сейчас завершит серию и сохранит набранный счёт."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klockan går fortfarande. Går du nu avslutas rundan och poängen så här långt sparas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาฬิกายังเดินอยู่ ออกตอนนี้จะจบรอบและเก็บคะแนนเท่าที่ทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat hâlâ işliyor. Şimdi çıkmak turu bitirir ve şu ana kadarki skoru saklar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng hồ vẫn chạy. Rời bây giờ sẽ kết thúc lượt và giữ lại điểm đã đạt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计时还在走。现在离开会结束这一轮，并保留目前的成绩。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計時還在走。現在離開會結束這一輪，並保留目前的成績。"
          }
        }
      }
    },
