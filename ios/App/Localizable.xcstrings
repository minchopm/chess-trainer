        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово. Новият ви план започва при следващото подновяване."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হয়ে গেছে। আপনার নতুন পরিকল্পনা পরবর্তী নবায়নে শুরু হবে।"
