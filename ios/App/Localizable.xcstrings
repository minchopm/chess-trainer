    "online.clockExplanation": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ لكل لاعب — %@. لا تُقرن إلا بلاعبين اختاروا الوقت نفسه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ na hráče — %@. Spárujeme tě jen s hráči, kteří zvolili stejné tempo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ til hver — %@. Du bliver kun sat sammen med spillere, der valgte samme betænkningstid."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Je %@ — %@. Du wirst nur mit Spielern zusammengebracht, die dieselbe Bedenkzeit gewählt haben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ο καθένας — %@. Θα βρεις μόνο παίκτες που διάλεξαν τον ίδιο χρόνο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ each — %@. You are only paired with players who chose the same clock."
          }
        },
