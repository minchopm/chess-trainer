          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor juega con la fuerza que elijas. El entrenador valora cada una de tus jugadas mientras juegas."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur joue à la force que vous choisissez. L'entraîneur note chacun de vos coups au fil de la partie."
          }
        },
        "fr-FR": {
          "stringUnit": {
