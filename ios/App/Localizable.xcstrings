          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las flechas y los valores de jugada solo se dibujan en el tablero plano."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las flechas y los valores de jugada solo se dibujan en el tablero plano."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las flechas y los valores de las jugadas solo se dibujan en el tablero plano."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuolet ja siirtojen arvot piirretään vain litteälle laudalle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flèches et les valeurs de coups ne sont tracées que sur l’échiquier plat."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flèches et les valeurs de coups ne sont tracées que sur l’échiquier plat."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flèches et les valeurs de coups ne sont tracées que sur l’échiquier plat."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સપાટ બોર્ડ પર જ તીરો અને ચાલના મૂલ્યો દોરવામાં આવે છે."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "સપાટ બોર્ડ પર જ તીરો અને ચાલના મૂલ્યો દોરવામાં આવે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חיצים וערכי מהלכים מצוירים רק על הלוח השטוח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तीर और चाल-मूल्य केवल सपाट बोर्ड पर दिखाए जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Strelice i vrijednosti poteza crtaju se samo na ravnoj ploči."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nyilak és a lépésértékek csak a lapos táblán jelennek meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panah dan nilai langkah hanya digambar di papan datar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le frecce e i valori delle mosse si disegnano solo sulla scacchiera piatta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "矢印と手の評価値は平面盤にのみ描かれます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көрсеткілер мен жүріс мәндері тек жазық тақтада сызылады."
          }
        },
        "kn": {
