            "state": "translated",
            "value": "Wiederhergestellt. Das Training ist freigeschaltet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έγινε επαναφορά. Η προπόνηση είναι ξεκλείδωτη."
          }
        },
        "en": {
