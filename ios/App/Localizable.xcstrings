    "online.friendsHow": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الزر في كل سطر من الترتيب وقائمة اللاعبين يرسل طلب صداقة. بعد قبوله يظهر الاسم هنا وتصبح المباراة على بُعد نقرة. المباريات بين الأصدقاء ودّية ولا تُحتسب في التصنيف."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "الزر في كل سطر من الترتيب وقائمة اللاعبين يرسل طلب صداقة. بعد قبوله يظهر الاسم هنا وتصبح المباراة على بُعد نقرة. المباريات بين الأصدقاء ودّية ولا تُحتسب في التصنيف."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бутонът на всеки ред от списъка с ранговете и на играчите изпраща покана за приятелство. След като бъде приета, името се появява тук и една игра е на едно докосване разстояние. Партиите между приятели са приятелски, не рейтингови."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "র‍্যাঙ্ক তালিকা ও খেলোয়াড়দের প্রতিটি সারির বোতামটি একটি বন্ধুত্বের অনুরোধ পাঠায়। একবার তা গ্রহণ করা হলে, নামটি এখানে দেখা যাবে এবং একটি গেম শুরু করতে মাত্র একবার ট্যাপ করলেই হবে। বন্ধুদের মধ্যে খেলা বন্ধুত্বপূর্ণ গেম, রেটেড নয়।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "র‍্যাঙ্ক তালিকা ও খেলোয়াড়দের প্রতিটি সারির বোতামটি একটি বন্ধুত্বের অনুরোধ পাঠায়। একবার তা গ্রহণ করা হলে, নামটি এখানে দেখা যাবে এবং একটি গেম শুরু করতে মাত্র একবার ট্যাপ করলেই হবে। বন্ধুদের মধ্যে খেলা বন্ধুত্বপূর্ণ গেম, রেটেড নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El botó de cada fila de la llista de classificació i dels jugadors envia una sol·licitud d’amistat. Un cop acceptada, el nom apareix aquí i una partida és a un toc. Les partides entre amics són amistoses, no classificades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tlačítkem v každém řádku žebříčku a seznamu hráčů pošleš žádost o přátelství. Jakmile ji druhý přijme, jméno se objeví tady a partie je na jedno klepnutí. Partie mezi přáteli jsou přátelské a do ratingu se nepočítají."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Knappen på hver række i ranglisten og blandt spillerne sender en venneanmodning. Når den er accepteret, står navnet her, og et parti er et tryk væk. Partier mellem venner er venskabspartier og giver ikke rating."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der Taste in jeder Zeile der Rangliste und der Spielerliste schickst du eine Freundschaftsanfrage. Sobald sie angenommen ist, steht der Name hier, und eine Partie ist nur einen Tipp entfernt. Partien unter Freunden sind Freundschaftspartien und werden nicht gewertet."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der Taste in jeder Zeile der Rangliste und der Spielerliste schickst du eine Freundschaftsanfrage. Sobald sie angenommen ist, steht der Name hier, und eine Partie ist nur einen Tipp entfernt. Partien unter Freunden sind Freundschaftspartien und werden nicht gewertet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κουμπί σε κάθε γραμμή της κατάταξης και της λίστας παικτών στέλνει αίτημα φιλίας. Μόλις γίνει αποδεκτό, το όνομα εμφανίζεται εδώ και μια παρτίδα είναι ένα πάτημα μακριά. Οι παρτίδες μεταξύ φίλων είναι φιλικές και δεν βαθμολογούνται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The button on each row of the rank list and the players sends a friend request. Once it is accepted, the name appears here and a game is a tap away. Games between friends are friendly games, not rated."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The button on each row of the rank list and the players sends a friend request. Once it is accepted, the name appears here and a game is a tap away. Games between friends are friendly games, not rated."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The button on each row of the rank list and the players sends a friend request. Once it is accepted, the name appears here and a game is a tap away. Games between friends are friendly games, not rated."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The button on each row of the rank list and the players sends a friend request. Once it is accepted, the name appears here and a game is a tap away. Games between friends are friendly games, not rated."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The button on each row of the rank list and the players sends a friend request. Once it is accepted, the name appears here and a game is a tap away. Games between friends are friendly games, not rated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón de cada fila de la clasificación y de la lista de jugadores envía una solicitud de amistad. Cuando se acepta, el nombre aparece aquí y una partida está a un toque. Las partidas entre amigos son amistosas y no cuentan para la valoración."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón de cada fila de la clasificación y de la lista de jugadores envía una solicitud de amistad. Cuando se acepta, el nombre aparece aquí y una partida está a un toque. Las partidas entre amigos son amistosas y no cuentan para la valoración."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón en cada fila de la lista de ranking y de jugadores envía una solicitud de amistad. Una vez aceptada, el nombre aparece aquí y una partida está a un toque. Las partidas entre amigos son amistosas, no clasificadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rankingin ja pelaajalistan jokaisen rivin painike lähettää kaveripyynnön. Kun se hyväksytään, nimi näkyy täällä ja peli on napautuksen päässä. Kavereiden väliset pelit ovat ystävyysotteluita, eikä niitä lasketa ratingiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton de chaque ligne du classement et de la liste des joueurs envoie une demande d’ami. Une fois acceptée, le nom apparaît ici et une partie est à un toucher. Les parties entre amis sont amicales et ne sont pas classées."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton de chaque ligne du classement et de la liste des joueurs envoie une demande d’ami. Une fois acceptée, le nom apparaît ici et une partie est à un toucher. Les parties entre amis sont amicales et ne sont pas classées."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton de chaque ligne du classement et de la liste des joueurs envoie une demande d’ami. Une fois acceptée, le nom apparaît ici et une partie est à un toucher. Les parties entre amis sont amicales et ne sont pas classées."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ક્રમ સૂચિ અને ખેલાડીઓની દરેક પંક્તિ પરનો બટન મિત્ર વિનંતી મોકલે છે. તે સ્વીકારાયા પછી, નામ અહીં દેખાશે અને એક ટૅપમાં ગેમ શરૂ થશે. મિત્રોમાંની ગેમ્સ મૈત્રીપૂર્ણ ગેમ્સ છે, રેટેડ નથી."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ક્રમ સૂચિ અને ખેલાડીઓની દરેક પંક્તિ પરનો બટન મિત્ર વિનંતી મોકલે છે. તે સ્વીકારાયા પછી, નામ અહીં દેખાશે અને એક ટૅપમાં ગેમ શરૂ થશે. મિત્રોમાંની ગેમ્સ મૈત્રીપૂર્ણ ગેમ્સ છે, રેટેડ નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכפתור בכל שורה בדירוג וברשימת השחקנים שולח בקשת חברות. אחרי שהבקשה מאושרת, השם מופיע כאן ומשחק נמצא במרחק הקשה אחת. משחקים בין חברים הם משחקי ידידות ואינם מדורגים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रैंक सूची और खिलाड़ियों की सूची की हर पंक्ति का बटन मित्रता अनुरोध भेजता है। स्वीकार होते ही नाम यहाँ दिखता है और बाज़ी बस एक टैप दूर होती है। मित्रों के बीच की बाज़ियाँ दोस्ताना होती हैं, उनकी रेटिंग नहीं होती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumb u svakom retku rang-liste i igrača šalje zahtjev za prijateljstvo. Kad se prihvati, ime se pojavi ovdje i partija je udaljena jednim dodirom. Partije između prijatelja prijateljske su partije, neocjenjivane."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A ranglista és a játékosok listájának minden sorában lévő gomb barátkérést küld. Ha elfogadják, a név itt jelenik meg, és egy játszma csak egy koppintás. A barátok közötti játszmák barátságosak, nem értékeltek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol di setiap baris peringkat dan daftar pemain mengirim permintaan pertemanan. Setelah diterima, namanya muncul di sini dan partai tinggal satu ketukan. Partai antarteman adalah partai persahabatan dan tidak dihitung ratingnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pulsante su ogni riga della classifica e dell’elenco dei giocatori invia una richiesta di amicizia. Una volta accettata, il nome compare qui e una partita è a un tocco. Le partite tra amici sono amichevoli e non valgono punti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランキングとプレイヤー一覧の各行のボタンでフレンドリクエストを送れます。承認されると名前がここに表示され、ワンタップで対局できます。フレンド同士の対局は親善対局で、レーティングには反映されません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рейтинг тізімі мен ойыншылардағы әр жолдың түймесі досқа сұрау жібереді. Ол қабылданған соң, аты осында шығады да, ойынға бір түрту жеткілікті. Достар арасындағы ойындар — достық ойындар, рейтингке саналмайды."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ರ‍್ಯಾಂಕ್ ಪಟ್ಟಿಯ ಮತ್ತು ಆಟಗಾರರ ಪ್ರತಿಯೊಂದು ಸಾಲಿನಲ್ಲಿರುವ ಬಟನ್ ಸ್ನೇಹ ವಿನಂತಿ ಕಳುಹಿಸುತ್ತದೆ. ಅದು ಅಂಗೀಕಾರವಾದ ನಂತರ, ಹೆಸರು ಇಲ್ಲಿ ಕಾಣುತ್ತದೆ ಮತ್ತು ಆಟ ಒಂದು ಟ್ಯಾಪ್ ದೂರದಲ್ಲಿರುತ್ತದೆ. ಸ್ನೇಹಿತರ ನಡುವಿನ ಆಟಗಳು ಸ್ನೇಹಪೂರ್ಣ ಆಟಗಳು, ರೇಟಿಂಗ್ ಇರುವುದಿಲ್ಲ."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ರ‍್ಯಾಂಕ್ ಪಟ್ಟಿಯ ಮತ್ತು ಆಟಗಾರರ ಪ್ರತಿಯೊಂದು ಸಾಲಿನಲ್ಲಿರುವ ಬಟನ್ ಸ್ನೇಹ ವಿನಂತಿ ಕಳುಹಿಸುತ್ತದೆ. ಅದು ಅಂಗೀಕಾರವಾದ ನಂತರ, ಹೆಸರು ಇಲ್ಲಿ ಕಾಣುತ್ತದೆ ಮತ್ತು ಆಟ ಒಂದು ಟ್ಯಾಪ್ ದೂರದಲ್ಲಿರುತ್ತದೆ. ಸ್ನೇಹಿತರ ನಡುವಿನ ಆಟಗಳು ಸ್ನೇಹಪೂರ್ಣ ಆಟಗಳು, ರೇಟಿಂಗ್ ಇರುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "순위와 플레이어 목록의 각 행에 있는 버튼으로 친구 요청을 보냅니다. 수락되면 이름이 여기에 표시되고 한 번의 탭으로 대국할 수 있습니다. 친구 간 대국은 친선 대국이며 레이팅에 반영되지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റാങ്ക് പട്ടികയിലെയും കളിക്കാരുടെയും ഓരോ വരിയിലുമുള്ള ബട്ടൺ ഒരു സുഹൃത്ത് അഭ്യർത്ഥന അയയ്ക്കും. അത് അംഗീകരിച്ചാൽ, പേര് ഇവിടെ പ്രത്യക്ഷപ്പെടും, പിന്നെ ഒരു സ്പർശത്തിൽ തന്നെ കളി തുടങ്ങാം. സുഹൃത്തുക്കൾ തമ്മിലുള്ള കളികൾ സൗഹൃദ കളികളാണ്, റേറ്റഡ് അല്ല."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "റാങ്ക് പട്ടികയിലെയും കളിക്കാരുടെയും ഓരോ വരിയിലുമുള്ള ബട്ടൺ ഒരു സുഹൃത്ത് അഭ്യർത്ഥന അയയ്ക്കും. അത് അംഗീകരിച്ചാൽ, പേര് ഇവിടെ പ്രത്യക്ഷപ്പെടും, പിന്നെ ഒരു സ്പർശത്തിൽ തന്നെ കളി തുടങ്ങാം. സുഹൃത്തുക്കൾ തമ്മിലുള്ള കളികൾ സൗഹൃദ കളികളാണ്, റേറ്റഡ് അല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रेटिंग यादीतील आणि खेळाडूंच्या प्रत्येक ओळीवरील बटण मित्र विनंती पाठवते. ती स्वीकारल्यावर, नाव इथे दिसते आणि खेळ फक्त एका टॅपवर मिळतो. मित्रांमधील सामने मैत्रीपूर्ण असतात, रेटेड नसतात."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "रेटिंग यादीतील आणि खेळाडूंच्या प्रत्येक ओळीवरील बटण मित्र विनंती पाठवते. ती स्वीकारल्यावर, नाव इथे दिसते आणि खेळ फक्त एका टॅपवर मिळतो. मित्रांमधील सामने मैत्रीपूर्ण असतात, रेटेड नसतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Butang pada setiap baris kedudukan dan senarai pemain menghantar permintaan rakan. Setelah diterima, nama itu muncul di sini dan permainan hanya satu ketikan jauhnya. Permainan antara rakan ialah perlawanan persahabatan dan tidak diberi rating."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Knappen på hver rad i ranglisten og blant spillerne sender en venneforespørsel. Når den er godtatt, står navnet her, og et parti er ett trykk unna. Partier mellom venner er vennskapspartier og gir ikke rating."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met de knop op elke rij van de ranglijst en de spelerslijst stuur je een vriendschapsverzoek. Zodra het is geaccepteerd, staat de naam hier en is een partij één tik verwijderd. Partijen tussen vrienden zijn vriendschappelijk en tellen niet voor de rating."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Met de knop op elke rij van de ranglijst en de spelerslijst stuur je een vriendschapsverzoek. Zodra het is geaccepteerd, staat de naam hier en is een partij één tik verwijderd. Partijen tussen vrienden zijn vriendschappelijk en tellen niet voor de rating."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Knappen på hver rad i ranglisten og blant spillerne sender en venneforespørsel. Når den er godtatt, står navnet her, og et parti er ett trykk unna. Partier mellom venner er vennskapspartier og gir ikke rating."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ର୍ୟାଙ୍କ ତାଲିକା ଏବଂ ଖେଳାଳିଙ୍କ ପ୍ରତ୍ୟେକ ସାରିରେ ଥିବା ବଟନ୍ ଏକ ବନ୍ଧୁ ଅନୁରୋଧ ପଠାଏ। ଏହା ଗ୍ରହୀତ ହେଲେ, ନାମଟି ଏଠାରେ ଦେଖାଯିବ ଏବଂ ଗୋଟିଏ ଟ୍ୟାପ୍‌ରେ ଖେଳ ଆରମ୍ଭ ହେବ। ବନ୍ଧୁମାନଙ୍କ ମଧ୍ୟରେ ଖେଳଗୁଡ଼ିକ ସାଧାରଣ ଖେଳ, rated ନୁହେଁ।"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ର୍ୟାଙ୍କ ତାଲିକା ଏବଂ ଖେଳାଳିଙ୍କ ପ୍ରତ୍ୟେକ ସାରିରେ ଥିବା ବଟନ୍ ଏକ ବନ୍ଧୁ ଅନୁରୋଧ ପଠାଏ। ଏହା ଗ୍ରହୀତ ହେଲେ, ନାମଟି ଏଠାରେ ଦେଖାଯିବ ଏବଂ ଗୋଟିଏ ଟ୍ୟାପ୍‌ରେ ଖେଳ ଆରମ୍ଭ ହେବ। ବନ୍ଧୁମାନଙ୍କ ମଧ୍ୟରେ ଖେଳଗୁଡ଼ିକ ସାଧାରଣ ଖେଳ, rated ନୁହେଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰੇਂਕ ਲਿਸਟ ਅਤੇ ਖਿਡਾਰੀਆਂ ਦੀ ਹਰ ਕਤਾਰ ਵਾਲਾ ਬਟਨ ਦੋਸਤ ਨੂੰ ਬੇਨਤੀ ਭੇਜਦਾ ਹੈ। ਜਦੋਂ ਉਹ ਮਨਜ਼ੂਰ ਕਰ ਲੈਂਦੇ ਹਨ, ਨਾਮ ਇੱਥੇ ਦਿਖਾਈ ਦੇਂਦਾ ਹੈ ਅਤੇ ਇੱਕ ਗੇਮ ਸਿਰਫ਼ ਇੱਕ ਟੈਪ ਦੂਰ ਰਹਿ ਜਾਂਦੀ ਹੈ। ਦੋਸਤਾਂ ਵਿਚਕਾਰ ਗੇਮ ਦੋਸਤੀ ਵਾਲੀ ਹੁੰਦੀ ਹੈ, ਰੇਟਿਡ ਨਹੀਂ।"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰੇਂਕ ਲਿਸਟ ਅਤੇ ਖਿਡਾਰੀਆਂ ਦੀ ਹਰ ਕਤਾਰ ਵਾਲਾ ਬਟਨ ਦੋਸਤ ਨੂੰ ਬੇਨਤੀ ਭੇਜਦਾ ਹੈ। ਜਦੋਂ ਉਹ ਮਨਜ਼ੂਰ ਕਰ ਲੈਂਦੇ ਹਨ, ਨਾਮ ਇੱਥੇ ਦਿਖਾਈ ਦੇਂਦਾ ਹੈ ਅਤੇ ਇੱਕ ਗੇਮ ਸਿਰਫ਼ ਇੱਕ ਟੈਪ ਦੂਰ ਰਹਿ ਜਾਂਦੀ ਹੈ। ਦੋਸਤਾਂ ਵਿਚਕਾਰ ਗੇਮ ਦੋਸਤੀ ਵਾਲੀ ਹੁੰਦੀ ਹੈ, ਰੇਟਿਡ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przycisk w każdym wierszu rankingu i listy graczy wysyła zaproszenie do znajomych. Po jego przyjęciu nazwa pojawia się tutaj, a partia jest na jedno dotknięcie. Partie między znajomymi są towarzyskie i nie liczą się do rankingu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O botão em cada linha do ranking e da lista de jogadores envia um pedido de amizade. Quando aceito, o nome aparece aqui e uma partida fica a um toque. Partidas entre amigos são amistosas e não valem rating."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O botão em cada linha do ranking e da lista de jogadores envia um pedido de amizade. Quando aceito, o nome aparece aqui e uma partida fica a um toque. Partidas entre amigos são amistosas e não valem rating."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O botão em cada linha da lista de classificação e dos jogadores envia um pedido de amizade. Assim que for aceite, o nome aparece aqui e uma partida fica a um toque de distância. As partidas entre amigos são amigáveis, não classificadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Butonul de pe fiecare rând din clasament și din lista jucătorilor trimite o cerere de prietenie. După ce e acceptată, numele apare aici și o partidă e la o atingere distanță. Partidele între prieteni sunt amicale și nu contează pentru rating."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопка в каждой строке рейтинг-листа и списка игроков отправляет запрос в друзья. Когда его примут, имя появится здесь, и до партии останется одно касание. Партии между друзьями товарищеские и не влияют на рейтинг."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tlačidlo pri každom riadku v rebríčku a pri hráčoch odošle žiadosť o priateľstvo. Po jej prijatí sa meno zobrazí tu a hra je na jedno ťuknutie. Hry medzi priateľmi sú priateľské hry, nie hodnotené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumb v vsaki vrstici seznama lestvice in igralcev pošlje prošnjo za prijateljstvo. Ko je sprejeta, se tu prikaže ime in na potezi ste z enim tapom. Partije med prijatelji so prijateljske, ne rangirane."
          }
        },
        "sl-SI": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumb v vsaki vrstici seznama lestvice in igralcev pošlje prošnjo za prijateljstvo. Ko je sprejeta, se tu prikaže ime in na potezi ste z enim tapom. Partije med prijatelji so prijateljske, ne rangirane."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Knappen på varje rad i rankinglistan och bland spelarna skickar en vänförfrågan. När den accepteras står namnet här och ett parti är ett tryck bort. Partier mellan vänner är vänskapspartier och ger ingen rating."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தரவரிசைப் பட்டியல் மற்றும் வீரர்கள் பட்டியலின் ஒவ்வொரு வரியிலும் இருக்கும் பொத்தான் நட்பு கோரிக்கையை அனுப்பும். அது ஏற்றுக்கொள்ளப்பட்டதும், பெயர் இங்கே தோன்றும்; ஒரு tap-இல் ஆட்டம் தொடங்கலாம். நண்பர்களுக்கிடையிலான ஆட்டங்கள் நட்பு ஆட்டங்களே; மதிப்பிடப்பட்டவை அல்ல."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "தரவரிசைப் பட்டியல் மற்றும் வீரர்கள் பட்டியலின் ஒவ்வொரு வரியிலும் இருக்கும் பொத்தான் நட்பு கோரிக்கையை அனுப்பும். அது ஏற்றுக்கொள்ளப்பட்டதும், பெயர் இங்கே தோன்றும்; ஒரு tap-இல் ஆட்டம் தொடங்கலாம். நண்பர்களுக்கிடையிலான ஆட்டங்கள் நட்பு ஆட்டங்களே; மதிப்பிடப்பட்டவை அல்ல."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ర్యాంక్ జాబితా మరియు ఆటగాళ్ల ప్రతి వరుసలోని బటన్ స్నేహ అభ్యర్థన పంపుతుంది. అది ఆమోదించబడిన తర్వాత, పేరు ఇక్కడ కనిపిస్తుంది మరియు ఒక ట్యాప్‌తో గేమ్ ప్రారంభించవచ్చు. స్నేహితుల మధ్య గేమ్స్ స్నేహపూర్వక గేమ్స్ మాత్రమే, రేటెడ్ కాదు."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ర్యాంక్ జాబితా మరియు ఆటగాళ్ల ప్రతి వరుసలోని బటన్ స్నేహ అభ్యర్థన పంపుతుంది. అది ఆమోదించబడిన తర్వాత, పేరు ఇక్కడ కనిపిస్తుంది మరియు ఒక ట్యాప్‌తో గేమ్ ప్రారంభించవచ్చు. స్నేహితుల మధ్య గేమ్స్ స్నేహపూర్వక గేమ్స్ మాత్రమే, రేటెడ్ కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่มในแต่ละแถวของอันดับและรายชื่อผู้เล่นใช้ส่งคำขอเป็นเพื่อน เมื่ออีกฝ่ายยอมรับ ชื่อจะแสดงที่นี่และเล่นได้ในแตะเดียว เกมระหว่างเพื่อนเป็นเกมกระชับมิตรและไม่คิดเรตติ้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıralamanın ve oyuncu listesinin her satırındaki düğme arkadaşlık isteği gönderir. İstek kabul edilince isim burada görünür ve bir oyun tek dokunuş uzaklıktadır. Arkadaşlar arasındaki oyunlar dostluk oyunudur ve puana sayılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопка в кожному рядку рейтингу та списку гравців надсилає запит у друзі. Коли його приймуть, ім’я з’явиться тут, і партію можна буде розпочати одним дотиком. Партії між друзями — дружні, не рейтингові."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درجہ بندی کی فہرست اور کھلاڑیوں کی ہر قطار پر بٹن دوست کی درخواست بھیجتا ہے۔ قبول ہونے پر نام یہاں ظاہر ہو جائے گا اور ایک کھیل صرف ایک ٹیپ کی دوری پر ہوگا۔ دوستوں کے درمیان کھیل friendly games ہوتے ہیں، rated نہیں۔"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "درجہ بندی کی فہرست اور کھلاڑیوں کی ہر قطار پر بٹن دوست کی درخواست بھیجتا ہے۔ قبول ہونے پر نام یہاں ظاہر ہو جائے گا اور ایک کھیل صرف ایک ٹیپ کی دوری پر ہوگا۔ دوستوں کے درمیان کھیل friendly games ہوتے ہیں، rated نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nút ở mỗi hàng của bảng xếp hạng và danh sách người chơi gửi lời mời kết bạn. Khi được chấp nhận, tên sẽ hiện ở đây và một ván cờ chỉ cách một lần chạm. Ván giữa bạn bè là ván giao hữu và không tính hệ số."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排行榜和棋手列表每一行的按钮都可以发送好友请求。对方接受后，名字会出现在这里，一点即可对局。好友之间的对局是友谊赛，不计等级分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排行榜和棋手列表每一行的按鈕都可以傳送好友請求。對方接受後，名字會出現在這裡，一點即可對局。好友之間的對局是友誼賽，不計等級分。"
          }
        }
      }
    },
