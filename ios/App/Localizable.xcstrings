        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog steeds niet. Neem een hint, of bekijk de oplossing en bestudeer het idee."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsatt ikke. Ta et hint, eller vis løsningen og studer idéen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wciąż nie to. Weź podpowiedź albo odsłoń rozwiązanie i przeanalizuj ideę."
