          "stringUnit": {
            "state": "translated",
            "value": "Pas de tactique ici. Pesez la structure, l'activité, la sécurité du roi et l'espace."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de tactique ici. Pesez la structure, l'activité, la sécurité du roi et l'espace."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין כאן טקטיקה. שקול מבנה, פעילות, ביטחון המלך ומרחב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ कोई रणनीति नहीं है। प्यादा-ढाँचा, सक्रियता, राजा की सुरक्षा और जगह तौलिए।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt nincs taktika. Mérlegeld a struktúrát, az aktivitást, a király biztonságát és a teret."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada taktik di sini. Timbang struktur, keaktifan, keamanan raja, dan ruang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui non c'è tattica. Pesa struttura, attività, sicurezza del re e spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに戦術はありません。ポーン構造、駒の働き、玉の安全、スペースを比べてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 전술은 없습니다. 폰 구조, 활동성, 킹의 안전, 공간을 견주어 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada taktik di sini. Timbangkan struktur, keaktifan, keselamatan raja dan ruang."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier zit geen tactiek in. Weeg structuur, activiteit, koningsveiligheid en ruimte tegen elkaar af."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Her er det ingen taktikk. Vei struktur, aktivitet, kongesikkerhet og plass mot hverandre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nie ma taktyki. Rozważ strukturę, aktywność, bezpieczeństwo króla i przestrzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui não há tática. Pese estrutura, atividade, segurança do rei e espaço."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aici nu e tactică. Cântărește structura, activitatea, siguranța regelui și spațiul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тактики здесь нет. Взвесьте структуру, активность, безопасность короля и пространство."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Här finns ingen taktik. Väg struktur, aktivitet, kungssäkerhet och utrymme mot varandra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่นี่ไม่มีแทคติก ให้ชั่งโครงสร้างเบี้ย ความคล่องตัว ความปลอดภัยของคิง และพื้นที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada taktik yok. Yapıyı, etkinliği, şah güvenliğini ve alanı tart."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ở đây không có chiến thuật. Hãy cân nhắc cấu trúc tốt, hoạt động quân, an toàn của vua và không gian."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里没有战术。请权衡兵形、活跃度、王的安全和空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡沒有戰術。請權衡兵形、活躍度、王的安全與空間。"
          }
        }
      }
    },
