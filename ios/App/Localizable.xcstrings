          "stringUnit": {
            "state": "translated",
            "value": "폰은 첫 번째나 마지막 랭크에 있을 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bidak tidak boleh berada di barisan pertama atau terakhir."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Een pion kan niet op de eerste of laatste rij staan."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "En bonde kan ikke stå på første eller siste rad."
          }
        },
        "pl": {
