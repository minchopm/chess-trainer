    "board.reviewing": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تستعرض — العب نقلة لتتفرّع من هنا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prohlížíte partii — zahrajte tah a odbočte odsud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ser tilbage — spil et træk for at forgrene herfra."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Rückblick — spiele einen Zug, um hier abzuzweigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανασκόπηση — παίξε μια κίνηση για να διακλαδώσεις από εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking back — play a move to branch from here."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking back — play a move to branch from here."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking back — play a move to branch from here."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás mirando atrás — juega una jugada para ramificar desde aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Selaat taaksepäin — tee siirto haarautuaksesi tästä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Retour en arrière — jouez un coup pour créer une variante ici."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retour en arrière — jouez un coup pour créer une variante ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסתכלים אחורה — שחקו מהלך כדי להסתעף מכאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पीछे देख रहे हैं — यहाँ से नई शाखा के लिए एक चाल चलें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszanézés — lépj egyet, hogy innen ágazz el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Melihat ke belakang — mainkan langkah untuk bercabang dari sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai guardando indietro — gioca una mossa per creare una variante da qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "巻き戻し中 — ここから指すと分岐します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 국면 — 여기서 두면 새 변화로 갈라집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Melihat semula — mainkan langkah untuk bercabang dari sini."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kijkt terug — speel een zet om hier af te takken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ser tilbake — spill et trekk for å forgrene herfra."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeglądasz partię — zagraj ruch, aby rozgałęzić od tego miejsca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Olhando para trás — jogue um lance para ramificar daqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Privești înapoi — fă o mutare pentru a ramifica de aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотр — сделайте ход, чтобы начать отсюда новую линию."
