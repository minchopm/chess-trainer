    "settings.dimensionalCaveat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأسهم وقيم النقلات تُرسم على الرقعة المسطّحة فقط."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "الأسهم وقيم النقلات تُرسم على الرقعة المسطّحة فقط."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Стрелките и стойностите на ходовете се чертаят само върху плоската дъска."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সমতল বোর্ডেই তীরচিহ্ন ও চালের মান দেখানো হয়।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "সমতল বোর্ডেই তীরচিহ্ন ও চালের মান দেখানো হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fletxes i els valors de les jugades només es dibuixen en el tauler pla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šipky a hodnoty tahů se kreslí jen na ploché šachovnici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pile og trækværdier tegnes kun på det flade bræt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pfeile und Zugwerte werden nur auf dem flachen Brett gezeichnet."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Pfeile und Zugwerte werden nur auf dem flachen Brett gezeichnet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα βέλη και οι αξίες κινήσεων σχεδιάζονται μόνο στην επίπεδη σκακιέρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrows and move values are drawn on the flat board only."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrows and move values are drawn on the flat board only."
          }
        },
        "en-CA": {
