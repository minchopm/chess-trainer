        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Táctica, juicio posicional, técnica de finales y juego con entrenador, con el motor funcionando en el propio dispositivo. Sin cuenta, y sin recoger nada, salvo lo que necesita el juego en línea: que estás en línea y los amigos que añadas."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Táctica, juicio posicional, técnica de finales y juego con entrenador, con el motor funcionando en el propio dispositivo. Sin cuenta, y sin recoger nada, salvo lo que necesita el juego en línea: que estás en línea y los amigos que añadas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tácticas, juicio posicional, técnica de finales y juego guiado, con el motor corriendo en el dispositivo. Sin cuenta, y no se recopila nada, aparte de lo que necesita el juego en línea: que estés en línea y los amigos que hagas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taktiikkaa, asema-arviointia, loppupelitekniikkaa ja valmennettua pelaamista, moottori laitteessa itsessään. Ei tiliä, eikä mitään kerätä — paitsi mitä verkkopelaaminen tarvitsee: tieto siitä, että olet paikalla, ja lisäämäsi kaverit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tactique, jugement positionnel, technique des finales et parties commentées, avec le moteur qui tourne sur l’appareil lui-même. Aucun compte, et rien n’est collecté — sauf ce que le jeu en ligne demande : le fait que vous êtes en ligne, et les amis que vous ajoutez."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tactique, jugement positionnel, technique des finales et parties commentées, avec le moteur qui tourne sur l’appareil lui-même. Aucun compte, et rien n’est collecté — sauf ce que le jeu en ligne demande : le fait que vous êtes en ligne, et les amis que vous ajoutez."
          }
        },
        "fr-FR": {
          "stringUnit": {
