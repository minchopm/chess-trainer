    "progress.onlineRatingIsKeptApart": {
      "extractionState": "manual",
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Online-Wertung wird getrennt von den Trainingswertungen geführt: Sie misst dich an den Menschen, gegen die du spielst, nicht an einer Aufgabensammlung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Online rating is kept apart from the training ratings: it measures you against the people you play, not against a library."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Online rating is kept apart from the training ratings: it measures you against the people you play, not against a library."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Online rating is kept apart from the training ratings: it measures you against the people you play, not against a library."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La valoración en línea se mantiene aparte de las de entrenamiento: te mide frente a las personas con las que juegas, no frente a una colección."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le classement en ligne est tenu à part des classements d'entraînement : il vous mesure face aux joueurs que vous affrontez, pas face à une collection."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le classement en ligne est tenu à part des classements d'entraînement : il vous mesure face aux joueurs que vous affrontez, pas face à une collection."
          }
        },
        "it": {
          "stringUnit": {
