          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan ditemukan. Seret pegangan jika ada sudut yang meleset."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scacchiera trovata. Trascina una maniglia se un angolo non ci sta."
