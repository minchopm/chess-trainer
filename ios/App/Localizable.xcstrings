    "about.tacticsPositionalJudgementEndgameTechnique": {
      "extractionState": "manual",
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Taktik, Stellungsbeurteilung, Endspieltechnik und begleitetes Spiel, mit Stockfish direkt auf dem Gerät. Nichts verlässt das Telefon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tactics, positional judgement, endgame technique and coached play, with Stockfish running on the device. Nothing leaves the phone."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tactics, positional judgement, endgame technique and coached play, with Stockfish running on the device. Nothing leaves the phone."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Tactics, positional judgement, endgame technique and coached play, with Stockfish running on the device. Nothing leaves the phone."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Táctica, criterio posicional, técnica de finales y partidas comentadas, con Stockfish funcionando en el dispositivo. Nada sale del teléfono."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tactique, jugement positionnel, technique de finale et parties commentées, avec Stockfish qui tourne sur l'appareil. Rien ne quitte le téléphone."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tactique, jugement positionnel, technique de finale et parties commentées, avec Stockfish qui tourne sur l'appareil. Rien ne quitte le téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tattica, giudizio posizionale, tecnica di finale e partite commentate, con Stockfish che gira sul dispositivo. Niente esce dal telefono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tática, julgamento posicional, técnica de finais e partidas comentadas, com o Stockfish rodando no aparelho. Nada sai do telefone."
          }
        }
      }
    },
    "about.theAppCollectsNothingSends": {
      "extractionState": "manual",
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App sammelt nichts, sendet nichts und stellt keine Netzwerkanfragen. Deine Wertungen und deine Historie liegen nur auf diesem Gerät; wer die App löscht, löscht sie mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app collects nothing, sends nothing and makes no network requests. Your ratings and history are stored only on this device, and deleting the app deletes them."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The app collects nothing, sends nothing and makes no network requests. Your ratings and history are stored only on this device, and deleting the app deletes them."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The app collects nothing, sends nothing and makes no network requests. Your ratings and history are stored only on this device, and deleting the app deletes them."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación no recoge nada, no envía nada y no hace peticiones de red. Tus valoraciones y tu historial se guardan solo en este dispositivo, y se borran al borrar la aplicación."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application ne collecte rien, n'envoie rien et ne fait aucune requête réseau. Vos classements et votre historique restent sur cet appareil, et disparaissent avec l'application."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application ne collecte rien, n'envoie rien et ne fait aucune requête réseau. Vos classements et votre historique restent sur cet appareil, et disparaissent avec l'application."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app non raccoglie nulla, non invia nulla e non fa richieste di rete. I tuoi punteggi e la tua cronologia restano solo su questo dispositivo e si cancellano con l'app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplicativo não coleta nada, não envia nada e não faz requisições de rede. Seus ratings e seu histórico ficam só neste aparelho, e somem junto com o aplicativo."
          }
        }
      }
    },
