          "stringUnit": {
            "state": "translated",
            "value": "تصنيفات الألغاز أعلى بمئات النقاط من تصنيفات البطولات — اعتبرها مقياسًا لتقدّمك أنت."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ratingy úloh bývají o pár set bodů vyšší než turnajové — ber je jako měřítko vlastního pokroku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgaveratings ligger et par hundrede point over turneringsratings — brug dem som mål for din egen fremgang."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgabenwertungen liegen einige hundert Punkte über Turnierwertungen — nimm sie als Maß für deinen eigenen Fortschritt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι βαθμολογίες των ασκήσεων είναι μερικές εκατοντάδες πόντους πάνω από τις αγωνιστικές — πάρ' τες ως μέτρο της δικής σου προόδου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Puzzle ratings run a few hundred points above over-the-board ratings — treat them as a measure of progress against yourself."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Puzzle ratings run a few hundred points above over-the-board ratings — treat them as a measure of progress against yourself."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Puzzle ratings run a few hundred points above over-the-board ratings — treat them as a measure of progress against yourself."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las valoraciones de los ejercicios están unos cientos de puntos por encima de las de torneo: tómalas como medida de tu propio progreso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehtäväratingit ovat muutaman sadan pisteen turnausratingeja korkeammalla — pidä niitä oman edistymisesi mittarina."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les classements de problèmes se situent quelques centaines de points au-dessus des classements de tournoi — prenez-les comme une mesure de votre propre progression."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les classements de problèmes se situent quelques centaines de points au-dessus des classements de tournoi — prenez-les comme une mesure de votre propre progression."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דירוגי תרגילים גבוהים במאות נקודות מדירוגי תחרות — התייחס אליהם כמדד להתקדמות שלך מול עצמך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहेली रेटिंग टूर्नामेंट रेटिंग से कुछ सौ अंक ऊपर रहती है — इसे अपनी प्रगति का पैमाना मानिए।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A feladványértékszámok több száz ponttal a versenyértékszám fölött járnak — tekintsd a saját fejlődésed mércéjének."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rating soal biasanya beberapa ratus poin di atas rating turnamen — anggap sebagai ukuran kemajuanmu sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I punteggi degli esercizi stanno qualche centinaio di punti sopra quelli da torneo: prendili come misura dei tuoi progressi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題のレーティングは大会レーティングより数百点高く出ます。自分自身の伸びを測る目安と考えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제 레이팅은 대회 레이팅보다 수백 점 높게 나옵니다. 자신의 성장 지표로 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rating teka-teki biasanya beberapa ratus mata lebih tinggi daripada rating kejohanan — anggap ia ukuran kemajuan anda sendiri."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Puzzelratings liggen een paar honderd punten boven toernooiratings — zie ze als maat voor je eigen vooruitgang."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppgaveratinger ligger noen hundre poeng over turneringsratinger — se dem som mål på din egen utvikling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rankingi zadań są o kilkaset punktów wyższe od turniejowych — traktuj je jako miarę własnych postępów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ratings de exercícios ficam algumas centenas de pontos acima dos de torneio — trate-os como medida do seu próprio progresso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ratingurile de exerciții sunt cu câteva sute de puncte peste cele de turneu — ia-le ca măsură a propriului progres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рейтинг задач на несколько сотен очков выше турнирного — считайте его мерой собственного прогресса."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppgiftsratingar ligger några hundra poäng över turneringsratingar — se dem som ett mått på din egen utveckling."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรตติ้งแบบฝึกมักสูงกว่าเรตติ้งการแข่งขันหลายร้อยแต้ม ให้ถือเป็นเครื่องวัดความก้าวหน้าของตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Problem puanları turnuva puanlarının birkaç yüz puan üstündedir — onları kendi ilerlemenin ölçüsü say."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hệ số bài tập thường cao hơn hệ số thi đấu vài trăm điểm — hãy xem nó như thước đo tiến bộ của chính bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "习题等级分通常比正式比赛的等级分高出几百分，请把它当作衡量自身进步的尺子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "習題等級分通常比正式比賽的等級分高出幾百分，請把它當作衡量自身進步的尺。"
          }
        }
      }
    },
