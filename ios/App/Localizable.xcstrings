    "photo.foundBoard": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم العثور على اللوح. اسحب أي مقبض إن لم يكن على زاويته."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تم العثور على اللوح. اسحب أي مقبض إن لم يكن على زاويته."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дъската е разпозната. Плъзнете някой от ъглите, ако някой не е върху нея."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বোর্ড পাওয়া গেছে। কোনো কোণ যদি ঠিকমতো বসানো না থাকে, তাহলে হ্যান্ডেল টেনে ঠিক করুন।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "বোর্ড পাওয়া গেছে। কোনো কোণ যদি ঠিকমতো বসানো না থাকে, তাহলে হ্যান্ডেল টেনে ঠিক করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tauler trobat. Arrossega un mànec si alguna cantonada no hi és a sobre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šachovnice nalezena. Přetáhněte úchyt, pokud některý roh nesedí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bræt fundet. Træk et håndtag, hvis et hjørne ikke sidder på det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brett gefunden. Zieh einen Griff, wenn eine Ecke nicht sitzt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Brett gefunden. Zieh einen Griff, wenn eine Ecke nicht sitzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρέθηκε σκακιέρα. Σύρε μια λαβή αν κάποια γωνία δεν είναι πάνω της."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Board found. Drag a handle if any corner is not on it."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Board found. Drag a handle if any corner is not on it."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Board found. Drag a handle if any corner is not on it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Board found. Drag a handle if any corner is not on it."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Board found. Drag a handle if any corner is not on it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tablero encontrado. Arrastra un tirador si alguna esquina no encaja."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tablero encontrado. Arrastra un tirador si alguna esquina no encaja."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tablero encontrado. Arrastra una esquina si alguna no queda dentro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lauta löytyi. Vedä kahvaa, jos jokin kulma ei osu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échiquier trouvé. Faites glisser une poignée si un coin ne tombe pas juste."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Échiquier trouvé. Faites glisser une poignée si un coin ne tombe pas juste."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Échiquier trouvé. Faites glisser une poignée si un coin ne tombe pas juste."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બોર્ડ મળ્યું. જો કોઈ ખૂણો તેના પર ન હોય તો હેન્ડલ ખેંચો."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "બોર્ડ મળ્યું. જો કોઈ ખૂણો તેના પર ન હોય તો હેન્ડલ ખેંચો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הלוח נמצא. גררו ידית אם פינה כלשהי לא עליו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बोर्ड मिल गया। कोई कोना सही न हो तो हैंडल खींचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ploča pronađena. Povucite ručicu ako neki kut nije na njoj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tábla megtalálva. Húzz el egy fogantyút, ha valamelyik sarok nem stimmel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan ditemukan. Seret pegangan jika ada sudut yang meleset."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scacchiera trovata. Trascina una maniglia se un angolo non ci sta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "盤を検出しました。角が合っていなければハンドルをドラッグしてください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тақта табылды. Егер қайсыбір бұрыш дәл үстінде болмаса, тұтқасын сүйреңіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಣೆ ಕಂಡುಬಂದಿದೆ. ಯಾವುದೇ ಮೂಲೆಯಲ್ಲಿ ಇಲ್ಲದಿದ್ದರೆ ಹ್ಯಾಂಡಲ್ ಅನ್ನು ಎಳೆಯಿರಿ."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಣೆ ಕಂಡುಬಂದಿದೆ. ಯಾವುದೇ ಮೂಲೆಯಲ್ಲಿ ಇಲ್ಲದಿದ್ದರೆ ಹ್ಯಾಂಡಲ್ ಅನ್ನು ಎಳೆಯಿರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보드를 찾았습니다. 모서리가 맞지 않으면 핸들을 끌어 주세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബോർഡ് കണ്ടെത്തി. ഏതെങ്കിലും മൂലമോ അതിൽ ഇല്ലെങ്കിൽ ഒരു ഹാൻഡിൽ വലിച്ചുനീക്കുക."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ബോർഡ് കണ്ടെത്തി. ഏതെങ്കിലും മൂലമോ അതിൽ ഇല്ലെങ്കിൽ ഒരു ഹാൻഡിൽ വലിച്ചുനീക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पट सापडला आहे. कोणताही कोपरा त्यावर नसेल तर हँडल ओढा."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "पट सापडला आहे. कोणताही कोपरा त्यावर नसेल तर हँडल ओढा."
          }
        },
        "ms": {
