        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a plus fort ici. Regardez d'abord les coups les plus forçants — échecs, prises, menaces."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અહીં વધુ મજબૂત ચાલ છે. સૌથી જોરદાર વિકલ્પો પહેલાં જુઓ — શાહ, પકડ, ધમકીઓ."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "અહીં વધુ મજબૂત ચાલ છે. સૌથી જોરદાર વિકલ્પો પહેલાં જુઓ — શાહ, પકડ, ધમકીઓ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש כאן מהלך חזק יותר. הסתכל קודם על האפשרויות הכופות — שחים, אכילות, איומים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ इससे मज़बूत चाल है। पहले सबसे बाध्यकारी विकल्प देखिए — शह, कटाई, धमकियाँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje postoji jači potez. Prvo pogledajte najforsiranije mogućnosti — šahovi, uzimanja, prijetnje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Van itt erősebb lépés. Először a legkényszerítőbbeket nézd — sakkok, ütések, fenyegetések."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada langkah yang lebih kuat di sini. Lihat dulu yang paling memaksa — sekak, tangkapan, ancaman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui c'è una mossa più forte. Guarda prima le opzioni più forzanti: scacchi, catture, minacce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにはもっと強い手があります。まず強制力のある手 — 王手、駒取り、脅し — から見てください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұнда одан да күшті жүріс бар. Әуелі ең мәжбүрлейтін нұсқаларды қараңыз — шабуыл, алмасу, қауіп."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಲ್ಲಿ ಇನ್ನೂ ಬಲವಾದ ನಡೆ ಇದೆ. ಮೊದಲು ಅತ್ಯಂತ ಬಲವಂತದ ಆಯ್ಕೆಗಳನ್ನು ನೋಡಿ — ಚೆಕ್‌ಗಳು, ಹಿಡಿತಗಳು, ಬೆದರಿಕೆಗಳು."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಲ್ಲಿ ಇನ್ನೂ ಬಲವಾದ ನಡೆ ಇದೆ. ಮೊದಲು ಅತ್ಯಂತ ಬಲವಂತದ ಆಯ್ಕೆಗಳನ್ನು ನೋಡಿ — ಚೆಕ್‌ಗಳು, ಹಿಡಿತಗಳು, ಬೆದರಿಕೆಗಳು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기 더 강한 수가 있습니다. 강제성이 큰 수부터 보세요 — 체크, 잡기, 위협."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇവിടെ കൂടുതൽ ശക്തമായ ഒരു നീക്കം ഉണ്ട്. ആദ്യം ഏറ്റവും നിർബന്ധിതമായ വഴികൾ നോക്കുക — ചെക്കുകൾ, പിടിത്തങ്ങൾ, ഭീഷണികൾ."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇവിടെ കൂടുതൽ ശക്തമായ ഒരു നീക്കം ഉണ്ട്. ആദ്യം ഏറ്റവും നിർബന്ധിതമായ വഴികൾ നോക്കുക — ചെക്കുകൾ, പിടിത്തങ്ങൾ, ഭീഷണികൾ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इथे अधिक बलवान चाल आहे. सर्वात सक्तीचे पर्याय आधी पाहा — शह, मार, धमक्या."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "इथे अधिक बलवान चाल आहे. सर्वात सक्तीचे पर्याय आधी पाहा — शह, मार, धमक्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada langkah lebih kuat di sini. Lihat dahulu yang paling memaksa — sekak, tangkapan, ancaman."
