        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Klokka går fortsatt. Går du nå, avsluttes runden og poengsummen så langt beholdes."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଘଣ୍ଟି ଚାଲୁ ଅଛି। ଏବେ ଛାଡ଼ିଲେ ରନ୍ ସମାପ୍ତ ହେବ ଏବଂ ଏପର୍ଯ୍ୟନ୍ତର ସ୍କୋର ରହିବ।"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ଘଣ୍ଟି ଚାଲୁ ଅଛି। ଏବେ ଛାଡ଼ିଲେ ରନ୍ ସମାପ୍ତ ହେବ ଏବଂ ଏପର୍ଯ୍ୟନ୍ତର ସ୍କୋର ରହିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਘੜੀ ਹਾਲੇ ਚੱਲ ਰਹੀ ਹੈ। ਹੁਣ ਨਿਕਲਣ ਨਾਲ ਰਨ ਖਤਮ ਹੋ ਜਾਏਗੀ ਅਤੇ ਹੁਣ ਤੱਕ ਦਾ ਸਕੋਰ ਬਚਿਆ ਰਹੇਗਾ।"
          }
        },
        "pa-IN": {
          "stringUnit": {
