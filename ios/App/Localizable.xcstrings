    "rush.theClockIsStillGoing": {
      "extractionState": "manual",
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr läuft noch. Wer jetzt geht, beendet den Lauf und behält den bisherigen Punktestand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clock is still going. Leaving now ends the run and keeps the score so far."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The clock is still going. Leaving now ends the run and keeps the score so far."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The clock is still going. Leaving now ends the run and keeps the score so far."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El reloj sigue corriendo. Si sales ahora, la serie termina y se guarda la puntuación conseguida."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La pendule tourne encore. Partir maintenant arrête la série et garde le score acquis."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "La pendule tourne encore. Partir maintenant arrête la série et garde le score acquis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'orologio sta ancora andando. Uscire adesso chiude la serie e tiene il punteggio fatto finora."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De klok loopt nog. Nu weggaan beëindigt de ronde en houdt de score tot nu toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zegar wciąż idzie. Wyjście teraz kończy serię i zachowuje dotychczasowy wynik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio ainda está correndo. Sair agora encerra a série e guarda a pontuação até aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы ещё идут. Выход сейчас завершит серию и сохранит набранный счёт."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat hâlâ işliyor. Şimdi çıkmak turu bitirir ve şu ana kadarki skoru saklar."
          }
        }
      }
    },
