    "settings.engine.recklessSummary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خصم مختلف له ذوقه الخاص في الأوضاع. لا يملك أداة لتحديد القوة، لذا يلعب بكامل قوته فقط."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "خصم مختلف له ذوقه الخاص في الأوضاع. لا يملك أداة لتحديد القوة، لذا يلعب بكامل قوته فقط."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Различен противник със собствен вкус към позициите. Няма ограничител на силата, така че играе само на пълна сила."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিজস্ব অবস্থান-পছন্দসহ আরেক প্রতিপক্ষ। এর কোনো শক্তি-সীমা নেই, তাই এটি শুধু পূর্ণ শক্তিতেই খেলে।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "নিজস্ব অবস্থান-পছন্দসহ আরেক প্রতিপক্ষ। এর কোনো শক্তি-সীমা নেই, তাই এটি শুধু পূর্ণ শক্তিতেই খেলে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altre oponent amb el seu propi gust per les posicions. No té limitador de força, així que juga només a força màxima."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jiný soupeř s vlastním vkusem na pozice. Nemá omezovač síly, takže hraje jen na plnou sílu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En anden modstander med sin egen smag for stillinger. Den har ingen styrkebegrænsning og spiller derfor kun på fuld styrke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Gegner mit eigenem Stellungsgeschmack. Sie hat keine Stärkebegrenzung und spielt daher nur in voller Stärke."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Gegner mit eigenem Stellungsgeschmack. Sie hat keine Stärkebegrenzung und spielt daher nur in voller Stärke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας διαφορετικός αντίπαλος με δικό του γούστο στις θέσεις. Δεν έχει περιοριστή ισχύος, οπότε παίζει μόνο με πλήρη δύναμη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A different opponent with its own taste in positions. It has no strength limiter, so it plays at full strength only."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "A different opponent with its own taste in positions. It has no strength limiter, so it plays at full strength only."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "A different opponent with its own taste in positions. It has no strength limiter, so it plays at full strength only."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A different opponent with its own taste in positions. It has no strength limiter, so it plays at full strength only."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A different opponent with its own taste in positions. It has no strength limiter, so it plays at full strength only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rival distinto, con su propio gusto por las posiciones. No tiene limitador de fuerza, así que juega solo a plena potencia."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rival distinto, con su propio gusto por las posiciones. No tiene limitador de fuerza, así que juega solo a plena potencia."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Un oponente distinto con su propio gusto en las posiciones. No tiene límite de fuerza, así que juega solo a máxima fuerza."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toisenlainen vastustaja, jolla on oma makunsa asemista. Siinä ei ole voimakkuusrajoitinta, joten se pelaa vain täydellä voimalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un adversaire différent, avec son propre goût pour les positions. Il n'a aucun limiteur de force et joue donc uniquement à pleine puissance."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un adversaire différent, avec son propre goût pour les positions. Il n'a aucun limiteur de force et joue donc uniquement à pleine puissance."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Un adversaire différent, avec son propre goût pour les positions. Il n'a aucun limiteur de force et joue donc uniquement à pleine puissance."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્થિતિઓમાં પોતાની પસંદગી ધરાવતો અલગ પ્રતિસ્પર્ધી. તેમાં શક્તિની મર્યાદા નથી, એટલે તે ફક્ત સંપૂર્ણ શક્તિએ રમે છે."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્થિતિઓમાં પોતાની પસંદગી ધરાવતો અલગ પ્રતિસ્પર્ધી. તેમાં શક્તિની મર્યાદા નથી, એટલે તે ફક્ત સંપૂર્ણ શક્તિએ રમે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יריב אחר, עם טעם משלו בעמדות. אין לו מגביל עוצמה, ולכן הוא משחק רק בעוצמה מלאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक अलग प्रतिद्वंद्वी, जिसकी स्थितियों में अपनी पसंद है। इसमें ताक़त सीमित करने की सुविधा नहीं है, इसलिए यह केवल पूरी ताक़त से खेलता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugi protivnik sa svojim ukusom u pozicijama. Nema ograničenja jačine, pa igra samo punom snagom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Másfajta ellenfél, saját ízléssel az állások iránt. Nincs erősségkorlátozója, ezért csak teljes erővel játszik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lawan yang berbeda, dengan selera posisinya sendiri. Tidak punya pembatas kekuatan, jadi hanya bermain dengan kekuatan penuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un avversario diverso, con un proprio gusto per le posizioni. Non ha un limitatore di forza, quindi gioca solo a piena potenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "局面の好みが異なる、もう一人の対戦相手です。強さを制限する機能がないため、常に全力で指します。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өзінше позицияны ұнататын басқа қарсылас. Шектеуіш күші жоқ, сондықтан ол тек ең жоғары күшінде ойнайды."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಥಿತಿಗಳಲ್ಲಿ ತನ್ನದೇ ಆದ ರುಚಿಯಿರುವ ಬೇರೆ ಎದುರಾಳಿ. ಇದಕ್ಕೆ ಶಕ್ತಿ ಮಿತಿಯಿಲ್ಲ, ಆದ್ದರಿಂದ ಇದು ಪೂರ್ಣ ಶಕ್ತಿಯಲ್ಲಿ ಮಾತ್ರ ಆಡುತ್ತದೆ."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಥಿತಿಗಳಲ್ಲಿ ತನ್ನದೇ ಆದ ರುಚಿಯಿರುವ ಬೇರೆ ಎದುರಾಳಿ. ಇದಕ್ಕೆ ಶಕ್ತಿ ಮಿತಿಯಿಲ್ಲ, ಆದ್ದರಿಂದ ಇದು ಪೂರ್ಣ ಶಕ್ತಿಯಲ್ಲಿ ಮಾತ್ರ ಆಡುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "국면 취향이 다른 또 하나의 상대입니다. 기력 제한 기능이 없어 항상 최대 기력으로만 둡니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്ഥാനങ്ങളിലെ സ്വന്തം ഇഷ്ടങ്ങളുള്ള വേറൊരു എതിരാളി. ശക്തി പരിധിയില്ല; അതിനാൽ പൂർണ്ണ ശക്തിയിലാണ് കളിക്കുന്നത്."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്ഥാനങ്ങളിലെ സ്വന്തം ഇഷ്ടങ്ങളുള്ള വേറൊരു എതിരാളി. ശക്തി പരിധിയില്ല; അതിനാൽ പൂർണ്ണ ശക്തിയിലാണ് കളിക്കുന്നത്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थितींची स्वतःची आवड असलेला वेगळा प्रतिस्पर्धी. यावर ताकद मर्यादा नाही, म्हणून तो फक्त पूर्ण ताकदीने खेळतो."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थितींची स्वतःची आवड असलेला वेगळा प्रतिस्पर्धी. यावर ताकद मर्यादा नाही, म्हणून तो फक्त पूर्ण ताकदीने खेळतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lawan yang berbeza, dengan citarasanya sendiri terhadap kedudukan. Ia tiada pembatas kekuatan, jadi ia bermain pada kekuatan penuh sahaja."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En annen motstander med sin egen smak for stillinger. Den har ingen styrkebegrensning og spiller derfor bare på full styrke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere tegenstander, met een eigen smaak in stellingen. Hij heeft geen sterktebegrenzing en speelt dus alleen op volle kracht."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere tegenstander, met een eigen smaak in stellingen. Hij heeft geen sterktebegrenzing en speelt dus alleen op volle kracht."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "En annen motstander med sin egen smak for stillinger. Den har ingen styrkebegrensning og spiller derfor bare på full styrke."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ନିଜସ୍ୱ ଅଭିରୁଚିଥିବା ଅନ୍ୟ ଏକ ପ୍ରତିଦ୍ବନ୍ଦ୍ବୀ। ଏଥିରେ କୌଣସି ଶକ୍ତି ସୀମାକରଣ ନାହିଁ, ସେହିପାଇଁ ଏହା ପୂର୍ଣ୍ଣ ଶକ୍ତିରେ ଖେଳେ।"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ନିଜସ୍ୱ ଅଭିରୁଚିଥିବା ଅନ୍ୟ ଏକ ପ୍ରତିଦ୍ବନ୍ଦ୍ବୀ। ଏଥିରେ କୌଣସି ଶକ୍ତି ସୀମାକରଣ ନାହିଁ, ସେହିପାଇଁ ଏହା ପୂର୍ଣ୍ଣ ଶକ୍ତିରେ ଖେଳେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਕ ਵੱਖਰਾ ਵਿਰੋਧੀ, ਆਪਣੇ ਹੀ ਸਥਿਤੀ-ਸਵਾਦ ਨਾਲ। ਇਸ ‘ਤੇ ਕੋਈ ਤਾਕਤ ਸੀਮਾ ਨਹੀਂ, ਇਸ ਲਈ ਇਹ ਪੂਰੀ ਤਾਕਤ ਨਾਲ ਹੀ ਖੇਡਦਾ ਹੈ।"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਕ ਵੱਖਰਾ ਵਿਰੋਧੀ, ਆਪਣੇ ਹੀ ਸਥਿਤੀ-ਸਵਾਦ ਨਾਲ। ਇਸ ‘ਤੇ ਕੋਈ ਤਾਕਤ ਸੀਮਾ ਨਹੀਂ, ਇਸ ਲਈ ਇਹ ਪੂਰੀ ਤਾਕਤ ਨਾਲ ਹੀ ਖੇਡਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inny przeciwnik, z własnym gustem do pozycji. Nie ma ogranicznika siły, więc gra wyłącznie z pełną siłą."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um adversário diferente, com gosto próprio para as posições. Não tem limitador de força, então joga apenas em força total."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um adversário diferente, com gosto próprio para as posições. Não tem limitador de força, então joga apenas em força total."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um adversário diferente, com o seu próprio gosto em posições. Não tem limitador de força, por isso joga sempre à força máxima."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un adversar diferit, cu propriul gust pentru poziții. Nu are limitator de forță, așa că joacă doar la putere maximă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другой соперник со своим вкусом к позициям. У него нет ограничителя силы, поэтому он играет только в полную силу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Iný súper s vlastným vkusom v pozíciách. Nemá žiadny limit sily, takže hrá len na plnú silu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drug nasprotnik s svojim okusom za položaje. Nima omejitve moči, zato igra le s polno močjo."
          }
        },
        "sl-SI": {
          "stringUnit": {
            "state": "translated",
            "value": "Drug nasprotnik s svojim okusom za položaje. Nima omejitve moči, zato igra le s polno močjo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En annan motståndare med egen smak för ställningar. Den har ingen styrkebegränsning och spelar därför bara på full styrka."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தனித்த நடையுடைய வேறு ஒரு எதிரணி. இதற்கு வலிமை வரம்பு இல்லை; ஆகவே இது முழு வலிமையில் மட்டுமே விளையாடும்."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "தனித்த நடையுடைய வேறு ஒரு எதிரணி. இதற்கு வலிமை வரம்பு இல்லை; ஆகவே இது முழு வலிமையில் மட்டுமே விளையாடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్థితులపై తనదైన అభిరుచితో ఉన్న మరో ప్రత్యర్థి. దీనికి బలం పరిమితి లేదు, కాబట్టి పూర్తి బలంతో మాత్రమే ఆడుతుంది."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "స్థితులపై తనదైన అభిరుచితో ఉన్న మరో ప్రత్యర్థి. దీనికి బలం పరిమితి లేదు, కాబట్టి పూర్తి బలంతో మాత్రమే ఆడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คู่ต่อสู้อีกแบบหนึ่งที่มีรสนิยมในตำแหน่งของตัวเอง ไม่มีตัวจำกัดความแข็งแกร่ง จึงเล่นเต็มกำลังเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozisyonlara kendi zevkiyle bakan farklı bir rakip. Güç sınırlayıcısı yok, bu yüzden yalnızca tam güçte oynar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інший суперник із власними вподобаннями в позиціях. Обмеження сили немає, тож він грає лише на повну силу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک الگ حریف، اپنی پسند کی پوزیشنوں کے ساتھ۔ اس پر طاقت کی کوئی حد نہیں، اس لیے یہ صرف پوری طاقت سے کھیلتا ہے۔"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک الگ حریف، اپنی پسند کی پوزیشنوں کے ساتھ۔ اس پر طاقت کی کوئی حد نہیں، اس لیے یہ صرف پوری طاقت سے کھیلتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một đối thủ khác, với gu thế trận riêng. Nó không có bộ giới hạn sức mạnh, nên chỉ chơi ở sức mạnh tối đa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一种对手，对局面有自己的偏好。它没有棋力限制功能，因此只以全力下棋。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一種對手，對局面有自己的偏好。它沒有棋力限制功能，因此只以全力下棋。"
          }
        }
      }
    },
