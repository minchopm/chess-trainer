    "editor.wrongSideInCheck": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ تحت الكش، لذا لا يمكن أن يكون الدور على %2$@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je v šachu, takže nemůže být na tahu %2$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ står i skak, så det kan ikke være %2$@ der har trækket."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ steht im Schach, also kann nicht %2$@ am Zug sein."
