        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn je open source, bez reklám, bez účtu a bez sledovania. Pro odstraňuje denné limity tréningu a platí za prácu, ktorá udržiava aplikáciu v chode."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn je odprtokoden, brez oglasov, brez računa in brez sledenja. Pro odstrani dnevne omejitve pri treningu in plača delo, ki ohranja aplikacijo pri življenju."
