        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏଗୁଡ଼ିକର ପ୍ରତ୍ୟେକଟିକୁ ଅଲଗା ଭାବରେ ମୂଲ୍ୟାୟନ କରାଯାଏ। ଘଡ଼ି ଚାଲିଥିବାବେଳେ ସମାଧାନ କରିବା, ସାରା ଅପରାହ୍ନ ସମୟ ସହିତ ସମାଧାନ କରିବାରୁ ଭିନ୍ନ ଦକ୍ଷତା, ଏବଂ ଆପଣ ବାଛିଥିବା strength ଥିବା bot କୁ ହରାଇବା ଆଉ ଗୋଟିଏ ଭିନ୍ନ ମାପ।"
          }
        },
        "or-IN": {
          "stringUnit": {
