    "rush.solveAsManyAsYou": {
      "extractionState": "manual",
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Löse so viele wie möglich, bevor die Zeit abläuft. Die Aufgaben beginnen leicht und werden schwerer. Drei Fehler beenden den Lauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solve as many as you can before the clock runs out. Puzzles start easy and get harder as you go. Three misses ends the run."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Solve as many as you can before the clock runs out. Puzzles start easy and get harder as you go. Three misses ends the run."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Solve as many as you can before the clock runs out. Puzzles start easy and get harder as you go. Three misses ends the run."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuelve todos los que puedas antes de que se acabe el tiempo. Empiezan fáciles y se van complicando. Tres fallos terminan la serie."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Résolvez-en le plus possible avant la fin du temps. Les problèmes commencent faciles et se corsent. Trois ratés arrêtent la série."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Résolvez-en le plus possible avant la fin du temps. Les problèmes commencent faciles et se corsent. Trois ratés arrêtent la série."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risolvine più che puoi prima che scada il tempo. Si parte facili e si sale di difficoltà. Tre errori chiudono la serie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolva o máximo que conseguir antes de o tempo acabar. Os exercícios começam fáceis e vão ficando difíceis. Três erros encerram a série."
          }
        }
      }
    },
