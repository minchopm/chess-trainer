    "online.clockExplanation": {
      "extractionState": "manual",
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Je %@ — %@. Du wirst nur mit Spielern zusammengebracht, die dieselbe Bedenkzeit gewählt haben."
