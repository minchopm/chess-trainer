            "value": "%1$lld চাল পড়া হয়েছে, তারপর “%2$@”-এ থেমে গেছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'han llegit %1$lld jugades i s'ha aturat a “%2$@”."
