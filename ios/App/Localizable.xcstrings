    "settings.engine.stockfishSummary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقوى محرك موجود، والوحيد هنا القادر على اللعب بتصنيف محدد."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "أقوى محرك موجود، والوحيد هنا القادر على اللعب بتصنيف محدد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Най-силният двигател, който съществува, и единственият тук, който може да играе до рейтинг."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবচেয়ে শক্তিশালী ইঞ্জিন, আর এখানকার একমাত্রটি যা রেটিং পর্যন্ত নামিয়ে খেলতে পারে।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "সবচেয়ে শক্তিশালী ইঞ্জিন, আর এখানকার একমাত্রটি যা রেটিং পর্যন্ত নামিয়ে খেলতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordinador més fort que hi ha, i l’únic d’aquí que pot jugar fins a un nivell de puntuació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejsilnější engine, jaký existuje, a jediný zdejší, který umí hrát na zadané Elo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den stærkeste motor der findes, og den eneste her der kan spille på en bestemt rating."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die stärkste Engine überhaupt, und die einzige hier, die auf eine bestimmte Wertung heruntergestuft spielen kann."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die stärkste Engine überhaupt, und die einzige hier, die auf eine bestimmte Wertung heruntergestuft spielen kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ισχυρότερη μηχανή που υπάρχει, και η μόνη εδώ που μπορεί να παίξει σε συγκεκριμένο βαθμολογικό επίπεδο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The strongest engine there is, and the only one here that can play down to a rating."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The strongest engine there is, and the only one here that can play down to a rating."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The strongest engine there is, and the only one here that can play down to a rating."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The strongest engine there is, and the only one here that can play down to a rating."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The strongest engine there is, and the only one here that can play down to a rating."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor más fuerte que existe, y el único aquí que puede jugar a un Elo concreto."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor más fuerte que existe, y el único aquí que puede jugar a un Elo concreto."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor más fuerte que hay, y el único aquí que puede jugar hasta cierto rating."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahvin moottori mitä on, ja ainoa täällä joka osaa pelata tietyllä ratingilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur le plus fort qui soit, et le seul ici capable de jouer à un niveau Elo donné."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur le plus fort qui soit, et le seul ici capable de jouer à un niveau Elo donné."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur le plus fort qui soit, et le seul ici capable de jouer à un niveau Elo donné."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અહીંનો સૌથી શક્તિશાળી એન્જિન, અને એકમાત્ર જે રેટિંગ સુધી રમવા શકે છે."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "અહીંનો સૌથી શક્તિશાળી એન્જિન, અને એકમાત્ર જે રેટિંગ સુધી રમવા શકે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המנוע החזק ביותר שקיים, והיחיד כאן שיודע לשחק לפי דירוג נתון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूद सबसे मज़बूत इंजन, और यहाँ का इकलौता इंजन जो किसी तय रेटिंग पर खेल सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najjače računalo koje postoji i jedino ovdje koje može igrati do određene rejting-vrijednosti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A létező legerősebb motor, és itt az egyetlen, amely adott Élő-pontszámon tud játszani."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesin terkuat yang ada, dan satu-satunya di sini yang bisa bermain pada rating tertentu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore più forte che esista, e l'unico qui capace di giocare a un Elo prestabilito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現存する最強のエンジンであり、ここで唯一、指定したレーティングまで手加減して指せるエンジンです。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ең күшті қозғалтқыш, әрі мұнда рейтингке дейін ойнай алатын жалғызы."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅತ್ಯಂತ ಬಲವಾದ ಎಂಜಿನ್, ಮತ್ತು ಇಲ್ಲಿ ರೇಟಿಂಗ್ ಮಟ್ಟಕ್ಕೆ ಇಳಿದು ಆಡಬಹುದಾದ ಏಕೈಕದು."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅತ್ಯಂತ ಬಲವಾದ ಎಂಜಿನ್, ಮತ್ತು ಇಲ್ಲಿ ರೇಟಿಂಗ್ ಮಟ್ಟಕ್ಕೆ ಇಳಿದು ಆಡಬಹುದಾದ ಏಕೈಕದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현존하는 가장 강한 엔진이며, 여기서 유일하게 지정한 레이팅에 맞춰 둘 수 있는 엔진입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലഭ്യമായതിൽ ഏറ്റവും ശക്തമായ എഞ്ചിൻ, ഇവിടെ റേറ്റിംഗിലേക്ക് പോലും കളിക്കാൻ കഴിയുന്ന ഏക എഞ്ചിൻ."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ലഭ്യമായതിൽ ഏറ്റവും ശക്തമായ എഞ്ചിൻ, ഇവിടെ റേറ്റിംഗിലേക്ക് പോലും കളിക്കാൻ കഴിയുന്ന ഏക എഞ്ചിൻ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "असलेले सर्वात बलवान इंजिन, आणि इथेच एकमेव जे रेटिंगपर्यंत खाली खेळू शकते."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "असलेले सर्वात बलवान इंजिन, आणि इथेच एकमेव जे रेटिंगपर्यंत खाली खेळू शकते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjin terkuat yang ada, dan satu-satunya di sini yang boleh bermain pada penarafan tertentu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den sterkeste motoren som finnes, og den eneste her som kan spille på en bestemt rating."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sterkste engine die er is, en de enige hier die op een bepaalde rating kan spelen."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De sterkste engine die er is, en de enige hier die op een bepaalde rating kan spelen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Den sterkeste motoren som finnes, og den eneste her som kan spille på en bestemt rating."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସବୁଠାରୁ ଶକ୍ତିଶାଳୀ engine, ଏବଂ ଏଠାରେ ଏକମାତ୍ର ଯାହା rating ପର୍ଯ୍ୟନ୍ତ ଖେଳିପାରେ।"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ସବୁଠାରୁ ଶକ୍ତିଶାଳୀ engine, ଏବଂ ଏଠାରେ ଏକମାତ୍ର ଯାହା rating ପର୍ଯ୍ୟନ୍ତ ଖେଳିପାରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਭ ਤੋਂ ਤਾਕਤਵਰ ਇੰਜਨ, ਅਤੇ ਇੱਥੇ ਇਕੱਲਾ ਜੋ ਰੇਟਿੰਗ ਤੱਕ ਖੇਡ ਸਕਦਾ ਹੈ।"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਭ ਤੋਂ ਤਾਕਤਵਰ ਇੰਜਨ, ਅਤੇ ਇੱਥੇ ਇਕੱਲਾ ਜੋ ਰੇਟਿੰਗ ਤੱਕ ਖੇਡ ਸਕਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najsilniejszy silnik, jaki istnieje, i jedyny tutaj, który potrafi grać na zadanym poziomie rankingowym."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O motor mais forte que existe, e o único aqui capaz de jogar em um rating definido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O motor mais forte que existe, e o único aqui capaz de jogar em um rating definido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O motor mais forte que existe, e o único aqui que pode jogar até um rating."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel mai puternic motor existent și singurul de aici care poate juca la un rating anume."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самый сильный движок из существующих и единственный здесь, который умеет играть на заданный рейтинг."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najsilnejší engine, aký existuje, a jediný tu, ktorý vie hrať na zvolenú silu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najmočnejši računalnik sploh in edini tukaj, ki lahko igra do določene ratinge."
          }
        },
        "sl-SI": {
          "stringUnit": {
            "state": "translated",
            "value": "Najmočnejši računalnik sploh in edini tukaj, ki lahko igra do določene ratinge."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den starkaste motorn som finns, och den enda här som kan spela på en bestämd rating."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இருப்பிலுள்ள மிகவும் வலுவான engine; இங்கே rating-க்கு ஏற்ப ஆடக்கூடிய ஒரே engine இதுதான்."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "இருப்பிலுள்ள மிகவும் வலுவான engine; இங்கே rating-க்கு ஏற்ப ஆடக்கூடிய ஒரே engine இதுதான்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అత్యంత బలమైన ఇంజిన్ ఇదే, ఇంకా రేటింగ్ స్థాయికి తగ్గించి ఆడగలిగేది ఇక్కడ ఇదొక్కటే."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "అత్యంత బలమైన ఇంజిన్ ఇదే, ఇంకా రేటింగ్ స్థాయికి తగ్గించి ఆడగలిగేది ఇక్కడ ఇదొక్కటే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอนจินที่แข็งแกร่งที่สุดเท่าที่มี และเป็นตัวเดียวที่นี่ที่เล่นตามระดับเรตติงที่กำหนดได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Var olan en güçlü motor ve burada belirli bir puan seviyesinde oynayabilen tek motor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найсильніший рушій із наявних і єдиний тут, що може грати до заданого рейтингу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب سے طاقتور engine، اور یہاں واحد جو rating تک کھیل سکتا ہے۔"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "سب سے طاقتور engine، اور یہاں واحد جو rating تک کھیل سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Engine mạnh nhất hiện có, và là engine duy nhất ở đây có thể chơi ở một mức Elo định sẵn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现存最强的引擎，也是这里唯一能按指定等级分下棋的引擎。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現存最強的引擎，也是這裡唯一能依指定等級分下棋的引擎。"
          }
        }
      }
    },
