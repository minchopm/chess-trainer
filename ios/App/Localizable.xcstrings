    "photo.foundBoard": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تم العثور على اللوح. اسحب أي مقبض إن لم يكن على زاويته."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šachovnice nalezena. Přetáhněte úchyt, pokud některý roh nesedí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bræt fundet. Træk et håndtag, hvis et hjørne ikke sidder på det."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Brett gefunden. Zieh einen Griff, wenn eine Ecke nicht sitzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρέθηκε σκακιέρα. Σύρε μια λαβή αν κάποια γωνία δεν είναι πάνω της."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Board found. Drag a handle if any corner is not on it."
          }
        },
        "en-CA": {
