    "settings.dimensionalCaveat": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "الأسهم وقيم النقلات تُرسم على الرقعة المسطّحة فقط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šipky a hodnoty tahů se kreslí jen na ploché šachovnici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pile og trækværdier tegnes kun på det flade bræt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Pfeile und Zugwerte werden nur auf dem flachen Brett gezeichnet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα βέλη και οι αξίες κινήσεων σχεδιάζονται μόνο στην επίπεδη σκακιέρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrows and move values are drawn on the flat board only."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrows and move values are drawn on the flat board only."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrows and move values are drawn on the flat board only."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las flechas y los valores de jugada solo se dibujan en el tablero plano."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuolet ja siirtojen arvot piirretään vain litteälle laudalle."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flèches et les valeurs de coups ne sont tracées que sur l’échiquier plat."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flèches et les valeurs de coups ne sont tracées que sur l’échiquier plat."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חיצים וערכי מהלכים מצוירים רק על הלוח השטוח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तीर और चाल-मूल्य केवल सपाट बोर्ड पर दिखाए जाते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nyilak és a lépésértékek csak a lapos táblán jelennek meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panah dan nilai langkah hanya digambar di papan datar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le frecce e i valori delle mosse si disegnano solo sulla scacchiera piatta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "矢印と手の評価値は平面盤にのみ描かれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화살표와 수의 값은 평면 판에만 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anak panah dan nilai langkah dilukis pada papan rata sahaja."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Pijlen en zetwaarden worden alleen op het platte bord getekend."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Piler og trekkverdier tegnes bare på det flate brettet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strzałki i wartości ruchów rysowane są tylko na płaskiej szachownicy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Setas e valores de lance são desenhados apenas no tabuleiro plano."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Săgețile și valorile mutărilor se desenează doar pe tabla plată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стрелки и оценки ходов рисуются только на плоской доске."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilar och dragvärden ritas bara på det platta brädet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลูกศรและค่าของตาเดินจะแสดงบนกระดานแบนเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oklar ve hamle değerleri yalnızca düz tahtada çizilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mũi tên và giá trị nước đi chỉ vẽ trên bàn cờ phẳng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "箭头与着法评分只画在平面棋盘上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "箭頭與著法評分只畫在平面棋盤上。"
          }
        }
      }
    },
    "settings.dimensionalNote": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "طقم مخروط في غرفة مضاءة. اسحب لتدوير الرقعة، وانقر للنقل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soustružená souprava v osvětlené místnosti. Tažením otočíte šachovnici, klepnutím táhnete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et drejet sæt i et oplyst rum. Træk for at dreje brættet, tryk for at flytte."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gedrechseltes Spiel in einem beleuchteten Raum. Ziehen dreht das Brett, Tippen zieht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τορνευτά κομμάτια σε φωτισμένο δωμάτιο. Σύρετε για περιστροφή, πατήστε για κίνηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A turned set in a lit room. Drag to turn the board, tap to move."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "A turned set in a lit room. Drag to turn the board, tap to move."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A turned set in a lit room. Drag to turn the board, tap to move."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Un juego torneado en una sala iluminada. Arrastra para girar el tablero, toca para mover."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorvattu nappulasarja valaistussa huoneessa. Vedä kääntääksesi lautaa, napauta siirtääksesi."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un jeu tourné dans une pièce éclairée. Glissez pour tourner l’échiquier, touchez pour jouer."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Un jeu tourné dans une pièce éclairée. Glissez pour tourner l’échiquier, touchez pour jouer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מערכת מחורטת בחדר מואר. גררו לסיבוב הלוח, הקישו כדי להזיז."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोशन कमरे में खरादा हुआ सेट। बोर्ड घुमाने के लिए खींचें, चाल के लिए टैप करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Esztergált készlet megvilágított szobában. Húzással forgatod a táblát, koppintással lépsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Set bubutan di ruang bercahaya. Seret untuk memutar papan, ketuk untuk melangkah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un set tornito in una stanza illuminata. Trascina per girare la scacchiera, tocca per muovere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "灯りのある部屋に置かれた挽物の駒。ドラッグで盤を回し、タップで指す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "불 밝힌 방의 깎아 만든 기물. 끌어서 판을 돌리고, 눌러서 둡니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Set larik dalam bilik bercahaya. Seret untuk memutar papan, ketik untuk bergerak."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gedraaid spel in een verlichte kamer. Sleep om het bord te draaien, tik om te zetten."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Et dreid sett i et opplyst rom. Dra for å snu brettet, trykk for å flytte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toczone bierki w oświetlonym pokoju. Przeciągnij, by obrócić szachownicę, dotknij, by zagrać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um jogo torneado numa sala iluminada. Arraste para girar o tabuleiro, toque para mover."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un set strunjit într-o cameră luminată. Trage pentru a roti tabla, atinge pentru a muta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точёные фигуры в освещённой комнате. Проведите, чтобы повернуть доску, коснитесь, чтобы сходить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett svarvat spel i ett upplyst rum. Dra för att vrida brädet, tryck för att dra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชุดหมากกลึงในห้องที่มีไฟ ลากเพื่อหมุนกระดาน แตะเพื่อเดิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aydınlık bir odada torna işi takım. Sürükleyerek tahtayı çevir, dokunarak oyna."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ quân tiện trong căn phòng có đèn. Kéo để xoay bàn cờ, chạm để đi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灯下房间里的一副车木棋子。拖动转动棋盘，点按走子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "燈下房間裡的一副車木棋子。拖曳轉動棋盤，點按走子。"
          }
        }
      }
    },
