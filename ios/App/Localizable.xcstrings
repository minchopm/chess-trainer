    "online.friendlyNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مباريات الدعوات والثأر ودّية، ولا تُحتسب في التصنيف إلا مباراة واحدة في اليوم ضد الخصم نفسه: المركز في القائمة يُكسب ضد من يجده البحث."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "مباريات الدعوات والثأر ودّية، ولا تُحتسب في التصنيف إلا مباراة واحدة في اليوم ضد الخصم نفسه: المركز في القائمة يُكسب ضد من يجده البحث."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Поканите и реваншите са приятелски партии, а за рейтинг се брои само една партия на ден срещу същия противник: място в класирането се печели срещу когото открие търсенето."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমন্ত্রণ এবং পুনরায় খেলা বন্ধুত্বপূর্ণ খেলা, আর একই প্রতিপক্ষের বিরুদ্ধে দিনে মাত্র একটি খেলা রেটেড: তালিকায় একটি স্থান জেতে সেই খেলোয়াড়ের বিরুদ্ধে, যাকে খোঁজে পাওয়া যায়।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "আমন্ত্রণ এবং পুনরায় খেলা বন্ধুত্বপূর্ণ খেলা, আর একই প্রতিপক্ষের বিরুদ্ধে দিনে মাত্র একটি খেলা রেটেড: তালিকায় একটি স্থান জেতে সেই খেলোয়াড়ের বিরুদ্ধে, যাকে খোঁজে পাওয়া যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les invitacions i les revenjades són partides amistoses, i només una partida al dia contra el mateix oponent es puntua: es guanya un lloc a la llista contra qui trobi la cerca."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozvánky a odvety jsou přátelské partie a proti stejnému soupeři se do ratingu počítá jen jedna partie denně: místo v žebříčku se vybojuje proti tomu, koho najde vyhledávání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitationer og revancher er venskabspartier, og kun ét parti om dagen mod den samme modstander giver rating: en plads på listen vindes mod dem, søgningen finder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einladungen und Revanchen sind Freundschaftspartien, und gegen denselben Gegner wird nur eine Partie pro Tag gewertet: Einen Platz auf der Liste gewinnt man gegen die, die die Suche findet."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Einladungen und Revanchen sind Freundschaftspartien, und gegen denselben Gegner wird nur eine Partie pro Tag gewertet: Einen Platz auf der Liste gewinnt man gegen die, die die Suche findet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι προσκλήσεις και οι ρεβάνς είναι φιλικές παρτίδες, και μόνο μία παρτίδα τη μέρα με τον ίδιο αντίπαλο βαθμολογείται: μια θέση στη λίστα κερδίζεται απέναντι σε όποιον βρει η αναζήτηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitations and rematches are friendly games, and only one game a day against the same opponent is rated: a place on the list is won against whoever the search finds."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitations and rematches are friendly games, and only one game a day against the same opponent is rated: a place on the list is won against whoever the search finds."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitations and rematches are friendly games, and only one game a day against the same opponent is rated: a place on the list is won against whoever the search finds."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitations and rematches are friendly games, and only one game a day against the same opponent is rated: a place on the list is won against whoever the search finds."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitations and rematches are friendly games, and only one game a day against the same opponent is rated: a place on the list is won against whoever the search finds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las invitaciones y las revanchas son partidas amistosas, y solo cuenta para la valoración una partida al día contra el mismo rival: un puesto en la lista se gana contra quien encuentre la búsqueda."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las invitaciones y las revanchas son partidas amistosas, y solo cuenta para la valoración una partida al día contra el mismo rival: un puesto en la lista se gana contra quien encuentre la búsqueda."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las invitaciones y las revanchas son partidas amistosas, y solo una partida al día contra el mismo oponente cuenta para Elo: el lugar en la lista se gana contra quien encuentre la búsqueda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutsut ja uusintapelit ovat ystävyysotteluita, ja saman vastustajan kanssa ratingiin lasketaan vain yksi peli päivässä: paikka listalla voitetaan niitä vastaan, jotka haku löytää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les invitations et les revanches sont des parties amicales, et une seule partie par jour contre le même adversaire est classée : une place au classement se gagne contre les adversaires que la recherche trouve."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les invitations et les revanches sont des parties amicales, et une seule partie par jour contre le même adversaire est classée : une place au classement se gagne contre les adversaires que la recherche trouve."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les invitations et les revanches sont des parties amicales, et une seule partie par jour contre le même adversaire est classée : une place au classement se gagne contre les adversaires que la recherche trouve."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આમંત્રણો અને ફરીથી રમવાની વિનંતીઓ મૈત્રીપૂર્ણ રમતો છે, અને એ જ પ્રતિસ્પર્ધી સામે દિવસમાં માત્ર એક જ રમત રેટેડ ગણાય છે: શોધે જેને શોધી કાઢે તેના સામે યાદીમાં સ્થાન જીતવામાં આવે છે."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "આમંત્રણો અને ફરીથી રમવાની વિનંતીઓ મૈત્રીપૂર્ણ રમતો છે, અને એ જ પ્રતિસ્પર્ધી સામે દિવસમાં માત્ર એક જ રમત રેટેડ ગણાય છે: શોધે જેને શોધી કાઢે તેના સામે યાદીમાં સ્થાન જીતવામાં આવે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזמנות ומשחקים חוזרים הם משחקי ידידות, ורק משחק אחד ביום מול אותו יריב מדורג: מקום ברשימה נכבש מול מי שהחיפוש מוצא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निमंत्रण और दोबारा खेली गई बाज़ियाँ दोस्ताना होती हैं, और एक ही प्रतिद्वंद्वी के ख़िलाफ़ दिन में सिर्फ़ एक बाज़ी की रेटिंग होती है: सूची में जगह उनके ख़िलाफ़ जीती जाती है जिन्हें खोज ढूँढ़ती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozivi i revanši su prijateljske partije, a samo je jedna partija dnevno protiv istog protivnika rejtingirana: mjesto na ljestvici osvaja se protiv onoga koga pronađe pretraga."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A meghívások és a visszavágók barátságos játszmák, és ugyanazzal az ellenféllel naponta csak egy játszma értékelt: a listán a helyet azok ellen lehet kivívni, akiket a keresés talál."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Undangan dan pertandingan ulang adalah partai persahabatan, dan hanya satu partai sehari melawan lawan yang sama yang dihitung ratingnya: tempat di daftar diraih melawan siapa pun yang ditemukan pencarian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviti e rivincite sono amichevoli, e contro lo stesso avversario vale punti una sola partita al giorno: un posto in classifica si conquista contro chi trova la ricerca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待と再戦は親善対局で、同じ相手とのレーティング対局は1日1局までです。リストの順位は、検索で見つかった相手との対局で勝ち取るものです。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шақырулар мен қайта матчтар — жолдастық ойындар, ал бір қарсыласпен күніне тек бір ойын ғана рейтингілік болады: тізімдегі орын іздеу тапқан кез келген қарсыласқа қарсы ұтылады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಹ್ವಾನಗಳು ಮತ್ತು ಮರುಆಟಗಳು ಸ್ನೇಹಪೂರ್ಣ ಆಟಗಳು; ಒಂದೇ ಎದುರಾಳಿಯ ವಿರುದ್ಧ ದಿನಕ್ಕೆ ಒಂದೇ ರೇಟೆಡ್ ಆಟ ಮಾತ್ರ ಎಣಿಕೆಗೊಳ್ಳುತ್ತದೆ: ಹುಡುಕಾಟಕ್ಕೆ ಸಿಕ್ಕವರ ಎದುರು ಪಟ್ಟಿಯಲ್ಲಿ ಸ್ಥಾನ ಸಿಗುತ್ತದೆ."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಹ್ವಾನಗಳು ಮತ್ತು ಮರುಆಟಗಳು ಸ್ನೇಹಪೂರ್ಣ ಆಟಗಳು; ಒಂದೇ ಎದುರಾಳಿಯ ವಿರುದ್ಧ ದಿನಕ್ಕೆ ಒಂದೇ ರೇಟೆಡ್ ಆಟ ಮಾತ್ರ ಎಣಿಕೆಗೊಳ್ಳುತ್ತದೆ: ಹುಡುಕಾಟಕ್ಕೆ ಸಿಕ್ಕವರ ಎದುರು ಪಟ್ಟಿಯಲ್ಲಿ ಸ್ಥಾನ ಸಿಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대와 재대국은 친선 대국이며, 같은 상대와는 하루에 한 판만 레이팅에 반영됩니다. 목록의 순위는 검색으로 만난 상대에게 이겨서 얻는 것입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്ഷണങ്ങളും റീമാച്ചുകളും സൗഹൃദ കളികളാണ്; ഒരേ എതിരാളിക്കെതിരേ ഒരു ദിവസത്തിൽ ഒരു കളി മാത്രം റേറ്റഡ് ആയിരിക്കും: തിരയൽ കണ്ടെത്തുന്നവനോടാണ് പട്ടികയിലെ സ്ഥാനം നേടുന്നത്."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്ഷണങ്ങളും റീമാച്ചുകളും സൗഹൃദ കളികളാണ്; ഒരേ എതിരാളിക്കെതിരേ ഒരു ദിവസത്തിൽ ഒരു കളി മാത്രം റേറ്റഡ് ആയിരിക്കും: തിരയൽ കണ്ടെത്തുന്നവനോടാണ് പട്ടികയിലെ സ്ഥാനം നേടുന്നത്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आमंत्रणे आणि पुनर्लढती या मैत्रीपूर्ण खेळ असतात, आणि त्याच प्रतिस्पर्ध्याविरुद्ध दिवसाला फक्त एकच खेळ रेटेड असतो: शोधाला जो मिळेल त्याच्याविरुद्ध यादीत स्थान मिळते."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "आमंत्रणे आणि पुनर्लढती या मैत्रीपूर्ण खेळ असतात, आणि त्याच प्रतिस्पर्ध्याविरुद्ध दिवसाला फक्त एकच खेळ रेटेड असतो: शोधाला जो मिळेल त्याच्याविरुद्ध यादीत स्थान मिळते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemputan dan perlawanan semula ialah perlawanan persahabatan, dan hanya satu permainan sehari menentang lawan yang sama diberi rating: tempat dalam senarai dimenangi menentang sesiapa yang ditemui carian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitasjoner og revansjer er vennskapspartier, og bare ett parti om dagen mot samme motstander gir rating: en plass på listen vinnes mot dem søket finner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitnodigingen en revanches zijn vriendschappelijke partijen, en tegen dezelfde tegenstander telt maar één partij per dag voor de rating: een plek op de lijst win je tegen wie de zoekopdracht vindt."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitnodigingen en revanches zijn vriendschappelijke partijen, en tegen dezelfde tegenstander telt maar één partij per dag voor de rating: een plek op de lijst win je tegen wie de zoekopdracht vindt."
