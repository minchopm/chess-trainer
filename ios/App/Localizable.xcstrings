        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आमंत्रण सुरक्षित है। ऐप इंस्टॉल करें, वह वहाँ प्रतीक्षा में मिलेगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
