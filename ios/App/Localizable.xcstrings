        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még mindig nem. Kérj tippet, vagy nézd meg a megoldást, és tanuld meg az ötletet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masih belum. Ambil petunjuk, atau buka solusinya dan pelajari gagasannya."
