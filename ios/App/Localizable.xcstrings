          "stringUnit": {
            "state": "translated",
            "value": "Game Center वरचा प्रत्यक्ष प्रतिस्पर्धी, घड्याळावर. सूचना नाहीत, इंजिन नाही, परत चाल नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lawan sebenar melalui Game Center, dengan jam. Tiada petunjuk, tiada enjin, tiada tarik balik langkah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En ekte motstander via Game Center, på klokke. Ingen hint, ingen motor, ingen angrede trekk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een echte tegenstander via Game Center, met klok. Geen hints, geen engine, geen zetten terugnemen."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Een echte tegenstander via Game Center, met klok. Geen hints, geen engine, geen zetten terugnemen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "En ekte motstander via Game Center, på klokke. Ingen hint, ingen motor, ingen angrede trekk."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center ରେ ଏକ ସତ୍ୟ ପ୍ରତିଦ୍ବନ୍ଦ୍ବୀଙ୍କ ସହ, ସମୟ ନିୟନ୍ତ୍ରଣରେ। କୌଣସି hint ନାହିଁ, engine ନାହିଁ, take-back ନାହିଁ।"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center ରେ ଏକ ସତ୍ୟ ପ୍ରତିଦ୍ବନ୍ଦ୍ବୀଙ୍କ ସହ, ସମୟ ନିୟନ୍ତ୍ରଣରେ। କୌଣସି hint ନାହିଁ, engine ନାହିଁ, take-back ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center ਰਾਹੀਂ ਹਕੀਕੀ ਵਿਰੋਧੀ, ਘੜੀ ‘ਤੇ। ਕੋਈ ਸੰਕੇਤ ਨਹੀਂ, ਕੋਈ ਇੰਜਣ ਨਹੀਂ, ਕੋਈ ਵਾਪਸੀ ਚਾਲ ਨਹੀਂ।"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center ਰਾਹੀਂ ਹਕੀਕੀ ਵਿਰੋਧੀ, ਘੜੀ ‘ਤੇ। ਕੋਈ ਸੰਕੇਤ ਨਹੀਂ, ਕੋਈ ਇੰਜਣ ਨਹੀਂ, ਕੋਈ ਵਾਪਸੀ ਚਾਲ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żywy przeciwnik przez Game Center, z zegarem. Bez podpowiedzi, bez silnika, bez cofania posunięć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um adversário de verdade pelo Game Center, no relógio. Sem dicas, sem motor, sem voltar lances."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um adversário de verdade pelo Game Center, no relógio. Sem dicas, sem motor, sem voltar lances."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um adversário real no Game Center, com relógio. Sem dicas, sem engine, sem desfazer jogadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un adversar real prin Game Center, cu ceas. Fără indicii, fără motor, fără mutări luate înapoi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Живой соперник через Game Center, с часами. Без подсказок, без движка, без взятия ходов назад."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skutočný súper cez Game Center, na čas. Bez nápoved, bez enginu, bez možnosti vrátenia ťahu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravi nasprotnik prek Game Centerja, na uro. Brez namigov, brez enginea, brez vračanja potez."
          }
        },
        "sl-SI": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravi nasprotnik prek Game Centerja, na uro. Brez namigov, brez enginea, brez vračanja potez."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En riktig motståndare via Game Center, med klocka. Inga tips, ingen motor, inga återtagna drag."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center மூலம் நேரடி எதிரணி, கடிகாரத்துடன். குறிப்பு இல்லை, என்ஜின் இல்லை, பின்னேற்றமும் இல்லை."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center மூலம் நேரடி எதிரணி, கடிகாரத்துடன். குறிப்பு இல்லை, என்ஜின் இல்லை, பின்னேற்றமும் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center ద్వారా నిజమైన ప్రత్యర్థి, గడియారంతో. సూచనలు లేవు, ఇంజిన్ లేదు, వెనక్కి తీసుకునే అవకాశం లేదు."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center ద్వారా నిజమైన ప్రత్యర్థి, గడియారంతో. సూచనలు లేవు, ఇంజిన్ లేదు, వెనక్కి తీసుకునే అవకాశం లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คู่แข่งตัวจริงผ่าน Game Center พร้อมนาฬิกา ไม่มีคำใบ้ ไม่มีเอนจิน ไม่มีการขอเดินใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center üzerinden gerçek bir rakip, saatle. İpucu yok, motor yok, hamle geri alma yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Справжній суперник через Game Center, із контролем часу. Без підказок, без рушія, без відкату ходів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center پر ایک حقیقی حریف، گھڑی کے ساتھ۔ نہ اشارے، نہ انجن، نہ چال واپس۔"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center پر ایک حقیقی حریف، گھڑی کے ساتھ۔ نہ اشارے، نہ انجن، نہ چال واپس۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đối thủ thật qua Game Center, có đồng hồ. Không gợi ý, không máy, không đi lại nước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Game Center 与真人对弈，带计时。没有提示，没有引擎，不能悔棋。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 Game Center 與真人對弈，附計時。沒有提示，沒有引擎，不能悔棋。"
          }
        }
      }
    },
