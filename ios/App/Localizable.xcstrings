          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still not it. Try a hint, or reveal the solution and study the idea."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Still not it. Try a hint, or reveal the solution and study the idea."
          }
        },
