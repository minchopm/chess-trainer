    "online.leavingAnOnlineGameLoses": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "مغادرة مباراة على الإنترنت تعني خسارتها، وتكلّفك نقاط تصنيف."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opustit online partii znamená prohru a stojí to rating."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At forlade et onlineparti er det samme som at tabe det, og det koster rating."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer eine Online-Partie verlässt, verliert sie — das kostet Wertungspunkte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αποχώρηση από διαδικτυακή παρτίδα σημαίνει ήττα και κοστίζει βαθμούς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving an online game loses it and costs you rating."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving an online game loses it and costs you rating."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving an online game loses it and costs you rating."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir de una partida en línea supone perderla y cuesta puntos de valoración."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkkopelistä poistuminen on häviö, ja se maksaa ratingia."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitter une partie en ligne, c'est la perdre, et cela coûte des points de classement."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitter une partie en ligne, c'est la perdre, et cela coûte des points de classement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עזיבת משחק מקוון פירושה הפסד, והיא עולה נקודות דירוג."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑनलाइन बाज़ी छोड़ना हार मानना है, और इससे रेटिंग घटती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy online játszma elhagyása vereség, és értékszámba kerül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meninggalkan partai daring berarti kalah, dan itu memotong rating."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uscire da una partita online significa perderla, e costa punti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンライン対局を離れると負けになり、レーティングも下がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온라인 대국에서 나가면 패배로 처리되고 레이팅이 깎입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Meninggalkan perlawanan dalam talian bermakna kalah, dan ia mengurangkan rating."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Een onlinepartij verlaten betekent verliezen, en dat kost rating."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Å forlate et nettparti er å tape det, og det koster rating."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyjście z partii online oznacza przegraną i kosztuje punkty rankingowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair de uma partida on-line é perdê-la, e custa pontos de rating."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Părăsirea unei partide online înseamnă înfrângere și costă puncte de rating."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выход из онлайн-партии означает поражение и стоит рейтинга."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
