    "play.theEnginePlaysAtThe": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلعب المحرّك بالقوة التي تختارها. ويقيّم المدرّب كل نقلة من نقلاتك أثناء اللعب."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يلعب المحرّك بالقوة التي تختارها. ويقيّم المدرّب كل نقلة من نقلاتك أثناء اللعب."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Двигателят играе на силата, която изберете. Coaching оценява всеки ваш ход, щом го направите."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইঞ্জিনটি আপনি যে শক্তি বাছবেন সেই শক্তিতে খেলে। কোচিং আপনি চাল দেওয়ার সঙ্গে সঙ্গেই প্রতিটি চালকে গ্রেড করে।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "ইঞ্জিনটি আপনি যে শক্তি বাছবেন সেই শক্তিতে খেলে। কোচিং আপনি চাল দেওয়ার সঙ্গে সঙ্গেই প্রতিটি চালকে গ্রেড করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordinador juga al nivell que trieu. L’entrenament qualifica cada moviment a mesura que el feu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Engine hraje v síle, kterou zvolíš. Kouč hodnotí každý tvůj tah průběžně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Motoren spiller i den styrke, du vælger. Træneren bedømmer hvert af dine træk undervejs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Engine spielt in der Stärke, die du wählst. Der Trainer bewertet jeden deiner Züge, während du spielst."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Engine spielt in der Stärke, die du wählst. Der Trainer bewertet jeden deiner Züge, während du spielst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μηχανή παίζει στην ισχύ που διαλέγεις. Ο προπονητής βαθμολογεί κάθε σου κίνηση καθώς παίζεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine plays at the strength you choose. Coaching grades each of your moves as you make it."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine plays at the strength you choose. Coaching grades each of your moves as you make it."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine plays at the strength you choose. Coaching grades each of your moves as you make it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine plays at the strength you choose. Coaching grades each of your moves as you make it."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine plays at the strength you choose. Coaching grades each of your moves as you make it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor juega con la fuerza que elijas. El entrenador valora cada una de tus jugadas mientras juegas."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor juega con la fuerza que elijas. El entrenador valora cada una de tus jugadas mientras juegas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor juega al nivel que elijas. El entrenamiento califica cada una de tus jugadas en cuanto la haces."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moottori pelaa valitsemallasi vahvuudella. Valmentaja arvioi jokaisen siirtosi pelin aikana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur joue à la force que vous choisissez. L'entraîneur note chacun de vos coups au fil de la partie."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur joue à la force que vous choisissez. L'entraîneur note chacun de vos coups au fil de la partie."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur joue à la force que vous choisissez. L'entraîneur note chacun de vos coups au fil de la partie."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એન્જિન તમે પસંદ કરેલી શક્તિએ રમે છે. કોચિંગ તમે દરેક ચાલ કરો તેમ તેને ગ્રેડ આપે છે."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "એન્જિન તમે પસંદ કરેલી શક્તિએ રમે છે. કોચિંગ તમે દરેક ચાલ કરો તેમ તેને ગ્રેડ આપે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המנוע משחק בעוצמה שתבחר. המאמן נותן ציון לכל מהלך שלך תוך כדי המשחק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंजन उसी ताक़त पर खेलता है जो आप चुनते हैं। कोच खेलते-खेलते आपकी हर चाल को आँकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Računalo igra snagom koju odaberete. Trener ocjenjuje svaki vaš potez kako ga odigrate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A motor az általad választott erővel játszik. Az edző menet közben osztályozza minden lépésedet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesin bermain pada kekuatan yang kamu pilih. Pelatih menilai setiap langkahmu sambil jalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore gioca alla forza che scegli. L'allenatore valuta ogni tua mossa mentre giochi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンジンは選んだ強さで指します。コーチは指すたびに一手ずつ評価します。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қозғалтқыш сіз таңдаған күшпен ойнайды. Coaching әр жүрісіңізді оны жасаған сәтте бағалайды."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಂಜಿನ್ ನೀವು ಆಯ್ಕೆ ಮಾಡುವ ಶಕ್ತಿಯಲ್ಲಿ ಆಡುತ್ತದೆ. ಕೋಚಿಂಗ್ ನೀವು ಪ್ರತಿ ನಡೆ ಮಾಡಿದ ಕೂಡಲೇ ಅದನ್ನು ಮೌಲ್ಯಮಾಪನ ಮಾಡುತ್ತದೆ."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಂಜಿನ್ ನೀವು ಆಯ್ಕೆ ಮಾಡುವ ಶಕ್ತಿಯಲ್ಲಿ ಆಡುತ್ತದೆ. ಕೋಚಿಂಗ್ ನೀವು ಪ್ರತಿ ನಡೆ ಮಾಡಿದ ಕೂಡಲೇ ಅದನ್ನು ಮೌಲ್ಯಮಾಪನ ಮಾಡುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엔진은 당신이 고른 강도로 둡니다. 코치는 당신이 둘 때마다 한 수씩 평가합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എഞ്ചിൻ നിങ്ങൾ തിരഞ്ഞെടുക്കുന്ന ശക്തിയിൽ കളിക്കും. കോച്ചിംഗ് നിങ്ങൾ ഓരോ നീക്കവും ചെയ്യുമ്പോൾ അതിന് ഗ്രേഡ് നൽകും."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "എഞ്ചിൻ നിങ്ങൾ തിരഞ്ഞെടുക്കുന്ന ശക്തിയിൽ കളിക്കും. കോച്ചിംഗ് നിങ്ങൾ ഓരോ നീക്കവും ചെയ്യുമ്പോൾ അതിന് ഗ്രേഡ് നൽകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इंजिन तुम्ही निवडलेल्या ताकदीने खेळते. कोचिंग तुम्ही प्रत्येक चाल केल्यावर तिला गुण देते."
