    "common.dataMissing": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُضمَّن البيانات في حزمة التطبيق. تأكّد من إدراج data/%@ ضمن موارد هدف Xcode."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Data se nedostala do balíčku aplikace. Zkontroluj, že data/%@ je mezi zdroji cíle v Xcode."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dataene kom ikke med i app-bundtet. Tjek at data/%@ står under ressourcerne for Xcode-målet."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten sind nicht im App-Bundle gelandet. Prüfe, ob data/%@ in den Ressourcen des Xcode-Targets steht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα δεδομένα δεν μπήκαν στο πακέτο της εφαρμογής. Έλεγξε ότι το data/%@ είναι στους πόρους του target του Xcode."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data did not make it into the app bundle. Check that data/%@ is listed in the Xcode target's resources."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The data did not make it into the app bundle. Check that data/%@ is listed in the Xcode target's resources."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The data did not make it into the app bundle. Check that data/%@ is listed in the Xcode target's resources."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos no llegaron al paquete de la aplicación. Comprueba que data/%@ esté en los recursos del target de Xcode."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Data ei päätynyt sovelluspakettiin. Tarkista, että data/%@ on Xcode-kohteen resursseissa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données ne sont pas arrivées dans le bundle. Vérifiez que data/%@ figure dans les ressources de la cible Xcode."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données ne sont pas arrivées dans le bundle. Vérifiez que data/%@ figure dans les ressources de la cible Xcode."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הנתונים לא נכנסו לחבילת האפליקציה. ודא ש-data/%@ מופיע במשאבים של יעד ה-Xcode."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेटा ऐप बंडल में नहीं पहुँचा। जाँचें कि data/%@ Xcode टारगेट के संसाधनों में है या नहीं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az adat nem került bele az alkalmazáscsomagba. Ellenőrizd, hogy a data/%@ szerepel-e az Xcode-cél erőforrásai közt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data tidak ikut masuk ke bundel aplikasi. Periksa apakah data/%@ terdaftar di sumber daya target Xcode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati non sono finiti nel bundle dell'app. Controlla che data/%@ sia tra le risorse del target Xcode."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データがアプリバンドルに入っていません。data/%@ が Xcode ターゲットのリソースにあるか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터가 앱 번들에 들어가지 않았습니다. data/%@ 이(가) Xcode 타깃 리소스에 있는지 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data tidak masuk ke dalam himpunan aplikasi. Periksa sama ada data/%@ tersenarai dalam sumber sasaran Xcode."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De gegevens zitten niet in de app-bundle. Controleer of data/%@ in de resources van het Xcode-target staat."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Dataene kom ikke med i app-pakken. Sjekk at data/%@ ligger under ressursene for Xcode-målet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane nie trafiły do pakietu aplikacji. Sprawdź, czy data/%@ jest w zasobach celu Xcode."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados não entraram no pacote do aplicativo. Verifique se data/%@ está nos recursos do target do Xcode."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele nu au ajuns în pachetul aplicației. Verifică dacă data/%@ apare în resursele țintei Xcode."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные не попали в пакет приложения. Проверьте, что data/%@ указан в ресурсах цели Xcode."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Data kom inte med i appaketet. Kontrollera att data/%@ finns bland resurserna för Xcode-målet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลไม่ได้ถูกรวมเข้าไปในแอป ตรวจสอบว่า data/%@ อยู่ในทรัพยากรของ target ใน Xcode"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veriler uygulama paketine girmemiş. data/%@ dosyasının Xcode hedefinin kaynaklarında olduğunu kontrol et."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu không được đóng gói vào ứng dụng. Kiểm tra xem data/%@ có trong tài nguyên của target Xcode không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据没有打包进应用。请检查 data/%@ 是否列在 Xcode target 的资源里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料沒有打包進 App。請檢查 data/%@ 是否列在 Xcode target 的資源中。"
          }
        }
      }
    },
