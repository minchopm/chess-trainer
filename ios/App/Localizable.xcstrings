        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೇಲಿನಿಂದ ಓದಿ. ಬಾಣಗಳು, ಸುಳಿವುಗಳು ಮತ್ತು ಚೌಕಗಳ ಮೇಲೆ ಕಲ್ಲನ್ನು ಎಳೆದು ಕೊಂಡು ಹೋಗುವುದು."
          }
        },
        "kn-IN": {
