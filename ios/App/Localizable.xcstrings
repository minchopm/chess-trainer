          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tablero encontrado. Arrastra un tirador si alguna esquina no encaja."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lauta löytyi. Vedä kahvaa, jos jokin kulma ei osu."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Échiquier trouvé. Faites glisser une poignée si un coin ne tombe pas juste."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Échiquier trouvé. Faites glisser une poignée si un coin ne tombe pas juste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הלוח נמצא. גררו ידית אם פינה כלשהי לא עליו."
          }
        },
        "hi": {
          "stringUnit": {
