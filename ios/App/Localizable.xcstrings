    "progress.onlineRatingIsKeptApart": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ تصنيف الإنترنت منفصلًا عن تصنيفات التدريب: فهو يقيسك أمام أشخاص تلعب ضدهم، لا أمام مجموعة تمارين."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Online rating se vede odděleně od tréninkových: měří tě proti lidem, se kterými hraješ, ne proti sbírce úloh."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Onlineratingen holdes adskilt fra træningsratings: den måler dig mod de mennesker, du spiller mod, ikke mod en samling opgaver."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Online-Wertung wird getrennt von den Trainingswertungen geführt: Sie misst dich an den Menschen, gegen die du spielst, nicht an einer Aufgabensammlung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διαδικτυακή βαθμολογία κρατιέται χωριστά από τις προπονητικές: σε μετρά απέναντι σε ανθρώπους, όχι απέναντι σε μια συλλογή ασκήσεων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Online rating is kept apart from the training ratings: it measures you against the people you play, not against a library. Each clock is rated on its own — three minutes and thirty are different games."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Online rating is kept apart from the training ratings: it measures you against the people you play, not against a library. Each clock is rated on its own — three minutes and thirty are different games."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Online rating is kept apart from the training ratings: it measures you against the people you play, not against a library. Each clock is rated on its own — three minutes and thirty are different games."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La valoración en línea se mantiene aparte de las de entrenamiento: te mide frente a las personas con las que juegas, no frente a una colección."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkkorating pidetään erillään harjoitusratingeista: se mittaa sinua ihmisiä vastaan, ei tehtäväkokoelmaa vastaan."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le classement en ligne est tenu à part des classements d'entraînement : il vous mesure face aux joueurs que vous affrontez, pas face à une collection."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le classement en ligne est tenu à part des classements d'entraînement : il vous mesure face aux joueurs que vous affrontez, pas face à une collection."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדירוג המקוון נשמר בנפרד מדירוגי האימון: הוא מודד אותך מול אנשים שאתה משחק נגדם, לא מול אוסף תרגילים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑनलाइन रेटिंग अभ्यास रेटिंग से अलग रखी जाती है: यह आपको उन लोगों के मुक़ाबले आँकती है जिनसे आप खेलते हैं, किसी प्रश्न-संग्रह के मुक़ाबले नहीं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az online értékszám külön áll az edzésértékszámoktól: emberekhez mér, nem egy feladatgyűjteményhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rating daring dipisahkan dari rating latihan: ia mengukurmu terhadap orang yang kamu lawan, bukan terhadap kumpulan soal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il punteggio online è tenuto separato da quelli di allenamento: misura te contro le persone con cui giochi, non contro una raccolta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンラインのレーティングは練習用とは別に管理されます。問題集ではなく、対戦した相手に対するあなたの強さを測るものだからです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온라인 레이팅은 훈련 레이팅과 따로 관리합니다. 문제집이 아니라 상대한 사람들을 기준으로 당신을 재기 때문입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rating dalam talian diasingkan daripada rating latihan: ia mengukur anda berbanding orang yang anda lawan, bukan berbanding kumpulan soalan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De onlinerating staat los van de trainingsratings: die meet je tegen de mensen met wie je speelt, niet tegen een verzameling opgaven."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettratingen holdes atskilt fra treningsratingene: den måler deg mot menneskene du møter, ikke mot en samling oppgaver."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ranking online jest trzymany osobno od treningowych: mierzy cię wobec ludzi, z którymi grasz, a nie wobec zbioru zadań."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O rating on-line fica separado dos ratings de treino: ele mede você contra as pessoas com quem joga, não contra uma coleção."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ratingul online e ținut separat de cele de antrenament: te măsoară față de oamenii cu care joci, nu față de o colecție de exerciții."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Онлайн-рейтинг ведётся отдельно от тренировочных: он измеряет вас против живых соперников, а не против набора задач."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Onlineratingen hålls skild från träningsratingarna: den mäter dig mot människorna du möter, inte mot en samling uppgifter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรตติ้งออนไลน์แยกจากเรตติ้งฝึกซ้อม เพราะมันวัดคุณกับคนที่คุณเล่นด้วย ไม่ใช่กับชุดแบบฝึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimiçi puan, antrenman puanlarından ayrı tutulur: seni bir soru bankasına değil, karşına çıkan insanlara göre ölçer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hệ số trực tuyến được tách khỏi hệ số luyện tập: nó đo bạn với những người bạn gặp, không phải với một tập bài."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在线等级分与训练等级分分开计算：它衡量的是你面对真人的水平，而不是面对一套题库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "線上等級分與訓練等級分分開計算：它衡量的是你面對真人的水準，而不是面對一套題庫。"
          }
        }
      }
    },
