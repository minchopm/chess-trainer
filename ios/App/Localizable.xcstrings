          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "এতে Stockfish আছে, যা GPLv3, এবং Reckless, যা AGPLv3। যেহেতু দুটিই অ্যাপে যুক্ত, তাই পুরো অ্যাপ্লিকেশন AGPLv3-এর অধীনে — আর এর সম্পূর্ণ সোর্স প্রকাশিত।"
