        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάστηκαν %lld κινήσεις και μετά σταμάτησε στο «%@»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
