        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'articles. Ils paraissent après chaque ronde d'un grand tournoi."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'articles. Ils paraissent après chaque ronde d'un grand tournoi."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હજુ કોઈ વાર્તાઓ નથી. ટોચની ઇવેન્ટના દરેક રાઉન્ડ પછી તે ઉમેરાય છે."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "હજુ કોઈ વાર્તાઓ નથી. ટોચની ઇવેન્ટના દરેક રાઉન્ડ પછી તે ઉમેરાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין כתבות. הן עולות אחרי כל סיבוב של אירוע מוביל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई कहानी नहीं। ये किसी बड़े टूर्नामेंट के हर राउंड के बाद आती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema priča. Objavljuju se nakon svakog kola turnira vrhunske razine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs történet. Egy nagy verseny minden fordulója után jelennek meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada cerita. Cerita muncul setelah setiap babak turnamen besar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna storia. Arrivano dopo ogni turno di un grande torneo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ記事はありません。主要大会の各ラウンド後に掲載されます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әзір әңгіме жоқ. Олар жоғары деңгейлі турнирдің әр айналымынан кейін қосылады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನೂ ಕಥೆಗಳು ಇಲ್ಲ. ಉನ್ನತ ಈವೆಂಟ್‌ನ ಪ್ರತಿ ಸುತ್ತಿನ ನಂತರ ಅವು ಪ್ರಕಟವಾಗುತ್ತವೆ."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನೂ ಕಥೆಗಳು ಇಲ್ಲ. ಉನ್ನತ ಈವೆಂಟ್‌ನ ಪ್ರತಿ ಸುತ್ತಿನ ನಂತರ ಅವು ಪ್ರಕಟವಾಗುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 소식이 없습니다. 주요 대회의 라운드가 끝날 때마다 올라옵니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതുവരെ കഥകളില്ല. ഓരോ വലിയ ടൂർണമെന്റിന്റെ ഓരോ റൗണ്ടിനുശേഷവും അവ ഇവിടെ വരും."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതുവരെ കഥകളില്ല. ഓരോ വലിയ ടൂർണമെന്റിന്റെ ഓരോ റൗണ്ടിനുശേഷവും അവ ഇവിടെ വരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अजून कथा नाहीत. प्रत्येक प्रमुख स्पर्धेच्या फेरीनंतर त्या प्रकाशित होतात."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "अजून कथा नाहीत. प्रत्येक प्रमुख स्पर्धेच्या फेरीनंतर त्या प्रकाशित होतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada cerita. Ia disiarkan selepas setiap pusingan kejohanan besar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen saker ennå. De kommer etter hver runde i en stor turnering."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen verhalen. Ze verschijnen na elke ronde van een groot toernooi."
