    "clip.fourteenThousandMore": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضمّ Brass Pawn أربعة عشر ألفًا غيرها، مختارة ممّا تجده صعبًا لا بالقرعة — ومحرّكًا يخبرك بقيمة النقلة الأقوى."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يضمّ Brass Pawn أربعة عشر ألفًا غيرها، مختارة ممّا تجده صعبًا لا بالقرعة — ومحرّكًا يخبرك بقيمة النقلة الأقوى."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn има още четиринадесет хиляди, подбрани от това, което ви е било трудно, а не на случаен принцип — и двигател, който показва колко е струвал по-силният ход."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn-এ আরও চৌদ্দ হাজার আছে, যেগুলো এলোমেলো নয়—আপনি যেগুলোতে বেশি হোঁচট খাচ্ছেন সেখান থেকেই বেছে নেওয়া; আর আছে এমন একটি ইঞ্জিন, যা বলে দেয় শক্তিশালী চালটার আসল মূল্য কত ছিল।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn-এ আরও চৌদ্দ হাজার আছে, যেগুলো এলোমেলো নয়—আপনি যেগুলোতে বেশি হোঁচট খাচ্ছেন সেখান থেকেই বেছে নেওয়া; আর আছে এমন একটি ইঞ্জিন, যা বলে দেয় শক্তিশালী চালটার আসল মূল্য কত ছিল।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn té catorze mil més, triats entre el que et costa més en lloc d'aleatòriament, i un motor que et diu quant valia la jugada més forta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn jich má dalších čtrnáct tisíc, vybíraných podle toho, co vám dělá potíže, ne náhodně — a motor, který řekne, co silnější tah stál za."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn har fjorten tusinde mere, valgt ud fra det, du har svært ved, ikke tilfældigt — og en motor, der fortæller, hvad det stærkere træk var værd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn hat vierzehntausend weitere, ausgewählt nach dem, was Ihnen schwerfällt, nicht zufällig — und eine Engine, die sagt, was der stärkere Zug wert war."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn hat vierzehntausend weitere, ausgewählt nach dem, was Ihnen schwerfällt, nicht zufällig — und eine Engine, die sagt, was der stärkere Zug wert war."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Brass Pawn έχει άλλα δεκατέσσερις χιλιάδες, επιλεγμένα από όσα δυσκολεύεστε και όχι στην τύχη — και μια μηχανή που λέει πόσο άξιζε η δυνατότερη κίνηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn has fourteen thousand more, chosen from what you have been finding hard rather than at random — and an engine that tells you what the stronger move was worth."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn has fourteen thousand more, chosen from what you have been finding hard rather than at random — and an engine that tells you what the stronger move was worth."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn has fourteen thousand more, chosen from what you have been finding hard rather than at random — and an engine that tells you what the stronger move was worth."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn has fourteen thousand more, chosen from what you have been finding hard rather than at random — and an engine that tells you what the stronger move was worth."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn has fourteen thousand more, chosen from what you have been finding hard rather than at random — and an engine that tells you what the stronger move was worth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn tiene catorce mil más, elegidos entre lo que te cuesta y no al azar — y un motor que dice cuánto valía la jugada más fuerte."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn tiene catorce mil más, elegidos entre lo que te cuesta y no al azar — y un motor que dice cuánto valía la jugada más fuerte."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn tiene catorce mil más, elegidos de lo que te ha costado trabajo en vez de al azar, y un motor que te dice cuánto valía la jugada más fuerte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawnissa on neljätoista tuhatta lisää, valittuna siitä mikä on tuntunut vaikealta eikä sattumanvaraisesti — ja moottori, joka kertoo mitä vahvempi siirto oli arvoltaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn en compte quatorze mille autres, choisis selon ce qui vous résiste plutôt qu’au hasard — et un moteur qui dit ce que valait le meilleur coup."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn en compte quatorze mille autres, choisis selon ce qui vous résiste plutôt qu’au hasard — et un moteur qui dit ce que valait le meilleur coup."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn en compte quatorze mille autres, choisis selon ce qui vous résiste plutôt qu’au hasard — et un moteur qui dit ce que valait le meilleur coup."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawnમાં ચૌદ હજાર વધુ છે, જે યાદ્રચ્છિક રીતે નહીં પરંતુ તમે જેમાં મુશ્કેલી અનુભવો છો તેમાંથી પસંદ કરેલા છે — અને એક એન્જિન છે જે તમને કહે છે કે વધુ મજબૂત ચાલ કેટલી કીમતની હતી."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawnમાં ચૌદ હજાર વધુ છે, જે યાદ્રચ્છિક રીતે નહીં પરંતુ તમે જેમાં મુશ્કેલી અનુભવો છો તેમાંથી પસંદ કરેલા છે — અને એક એન્જિન છે જે તમને કહે છે કે વધુ મજબૂત ચાલ કેટલી કીમતની હતી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ל‑Brass Pawn יש עוד ארבעה‑עשר אלף, נבחרים לפי מה שקשה לך ולא באקראי — ומנוע שאומר כמה היה שווה המהלך החזק יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn में चौदह हज़ार और हैं, जो बेतरतीब नहीं बल्कि आपकी कठिनाइयों से चुने जाते हैं — और एक इंजन जो बताता है कि बेहतर चाल कितनी क़ीमती थी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn ima četrnaest tisuća novih zadataka, odabranih prema onome što vam je teže, a ne nasumično — i engine koji vam govori koliko je vrijedila jača potez."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Brass Pawnban további tizennégyezer van, abból válogatva, ami nehezen megy, nem véletlenszerűen — és egy motor, amely megmondja, mit ért az erősebb lépés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn punya empat belas ribu lagi, dipilih dari apa yang terasa sulit bagi Anda, bukan secara acak — dan mesin yang memberi tahu nilai langkah yang lebih kuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn ne ha altri quattordicimila, scelti tra ciò che trovi difficile e non a caso — e un motore che dice quanto valeva la mossa migliore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn にはさらに 14,000 問。無作為ではなく、あなたが苦手にしてきたものから選ばれます。より強い手が何点だったかを教えるエンジンつき。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn-та он төрт мыңнан аса қосымша тапсырма бар: олар кездейсоқ емес, сізге қиын болғандарынан таңдалған, әрі қозғалыс қаншалықты күшті болғанын айтатын engine бар."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn ನಲ್ಲಿ ಇನ್ನೂ ಹದಿನಾಲ್ಕು ಸಾವಿರ ಸ್ಥಾನಗಳಿವೆ; ಅವುಗಳನ್ನು ಯಾದೃಚ್ಛಿಕವಾಗಿ ಅಲ್ಲ, ನೀವು ಕಷ್ಟಪಡುತ್ತಿರುವವುಗಳನ್ನು ಆಧರಿಸಿ ಆರಿಸಲಾಗಿದೆ — ಜೊತೆಗೆ ಬಲವಾದ ನಡೆ ಯಾವ ಮೌಲ್ಯದದ್ದಾಗಿತ್ತು ಎಂದು ಹೇಳುವ ಎಂಜಿನ್ ಕೂಡ ಇದೆ."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn ನಲ್ಲಿ ಇನ್ನೂ ಹದಿನಾಲ್ಕು ಸಾವಿರ ಸ್ಥಾನಗಳಿವೆ; ಅವುಗಳನ್ನು ಯಾದೃಚ್ಛಿಕವಾಗಿ ಅಲ್ಲ, ನೀವು ಕಷ್ಟಪಡುತ್ತಿರುವವುಗಳನ್ನು ಆಧರಿಸಿ ಆರಿಸಲಾಗಿದೆ — ಜೊತೆಗೆ ಬಲವಾದ ನಡೆ ಯಾವ ಮೌಲ್ಯದದ್ದಾಗಿತ್ತು ಎಂದು ಹೇಳುವ ಎಂಜಿನ್ ಕೂಡ ಇದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn에는 14,000문제가 더 있습니다. 무작위가 아니라 어려워한 것에서 고릅니다 — 그리고 더 강한 수의 가치를 알려주는 엔진이 함께합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn-ൽ നിങ്ങൾക്ക് പ്രയാസമുള്ളതായി കണ്ടെത്തിയതിൽ നിന്നു തിരഞ്ഞെടുത്ത, പതിനാലായിരത്തിലധികം അധികങ്ങളുണ്ട് — കൂടാതെ കൂടുതൽ ശക്തമായ നീക്കം എത്ര വിലപ്പെട്ടതായിരുന്നു എന്നു പറയുന്ന ഒരു എൻജിനുമുണ്ട്."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn-ൽ നിങ്ങൾക്ക് പ്രയാസമുള്ളതായി കണ്ടെത്തിയതിൽ നിന്നു തിരഞ്ഞെടുത്ത, പതിനാലായിരത്തിലധികം അധികങ്ങളുണ്ട് — കൂടാതെ കൂടുതൽ ശക്തമായ നീക്കം എത്ര വിലപ്പെട്ടതായിരുന്നു എന്നു പറയുന്ന ഒരു എൻജിനുമുണ്ട്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn मध्ये आणखी चौदा हजार सराव आहेत, जे यादृच्छिक न घेता तुम्हाला कठीण वाटलेल्या गोष्टींमधून निवडलेले आहेत — आणि एक इंजिन आहे जे मजबूत चालीची किंमत किती होती ते सांगते."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn मध्ये आणखी चौदा हजार सराव आहेत, जे यादृच्छिक न घेता तुम्हाला कठीण वाटलेल्या गोष्टींमधून निवडलेले आहेत — आणि एक इंजिन आहे जे मजबूत चालीची किंमत किती होती ते सांगते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn ada empat belas ribu lagi, dipilih daripada apa yang anda dapati sukar dan bukan secara rawak — serta enjin yang memberitahu nilai langkah yang lebih kuat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn har fjorten tusen til, valgt ut fra det du synes er vanskelig og ikke tilfeldig — og en motor som sier hva det sterkere trekket var verdt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn heeft er nog veertienduizend, gekozen op wat je lastig vindt in plaats van willekeurig — en een engine die zegt wat de sterkere zet waard was."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn heeft er nog veertienduizend, gekozen op wat je lastig vindt in plaats van willekeurig — en een engine die zegt wat de sterkere zet waard was."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn har fjorten tusen til, valgt ut fra det du synes er vanskelig og ikke tilfeldig — og en motor som sier hva det sterkere trekket var verdt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn ରେ ଚଉଦ ହଜାର ଅଧିକ ଅଛି, ଯାହା ଆପଣଙ୍କୁ କଠିନ ଲାଗୁଥିବା ବିଷୟରୁ ବାଛାଯାଇଛି, ଯାଦୃଚ୍ଛିକ ଭାବେ ନୁହେଁ — ଏବଂ ଏକ ଇଞ୍ଜିନ୍ ଅଛି ଯାହା ଆପଣଙ୍କୁ କହେ ଶକ୍ତିଶାଳୀ ଚାଲଟିର ମୂଲ୍ୟ କେତେ ଥିଲା।"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn ରେ ଚଉଦ ହଜାର ଅଧିକ ଅଛି, ଯାହା ଆପଣଙ୍କୁ କଠିନ ଲାଗୁଥିବା ବିଷୟରୁ ବାଛାଯାଇଛି, ଯାଦୃଚ୍ଛିକ ଭାବେ ନୁହେଁ — ଏବଂ ଏକ ଇଞ୍ଜିନ୍ ଅଛି ଯାହା ଆପଣଙ୍କୁ କହେ ଶକ୍ତିଶାଳୀ ଚାଲଟିର ମୂଲ୍ୟ କେତେ ଥିଲା।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn ਵਿੱਚ ਹੋਰ ਚੌਦਾਂ ਹਜ਼ਾਰ ਹਨ, ਜੋ ਤੁਹਾਡੇ ਲਈ ਔਖੇ ਰਹੇ ਮੋਵਾਂ ਵਿਚੋਂ ਚੁਣੇ ਗਏ ਹਨ, ਬੇਤਰਤੀਬ ਨਹੀਂ — ਅਤੇ ਇੱਕ ਇੰਜਨ ਜੋ ਦੱਸਦਾ ਹੈ ਕਿ ਮਜ਼ਬੂਤ ਚਾਲ ਦੀ ਕੀਮਤ ਕਿੰਨੀ ਸੀ।"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn ਵਿੱਚ ਹੋਰ ਚੌਦਾਂ ਹਜ਼ਾਰ ਹਨ, ਜੋ ਤੁਹਾਡੇ ਲਈ ਔਖੇ ਰਹੇ ਮੋਵਾਂ ਵਿਚੋਂ ਚੁਣੇ ਗਏ ਹਨ, ਬੇਤਰਤੀਬ ਨਹੀਂ — ਅਤੇ ਇੱਕ ਇੰਜਨ ਜੋ ਦੱਸਦਾ ਹੈ ਕਿ ਮਜ਼ਬੂਤ ਚਾਲ ਦੀ ਕੀਮਤ ਕਿੰਨੀ ਸੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn ma jeszcze czternaście tysięcy, wybieranych z tego, co sprawia Ci trudność, a nie losowo — i silnik, który mówi, ile wart był mocniejszy ruch."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Brass Pawn tem mais catorze mil, escolhidos pelo que você tem achado difícil e não ao acaso — e um motor que diz quanto valia o lance mais forte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Brass Pawn tem mais catorze mil, escolhidos pelo que você tem achado difícil e não ao acaso — e um motor que diz quanto valia o lance mais forte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Brass Pawn tem mais catorze mil posições, escolhidas a partir do que tem achado mais difícil em vez de ao acaso — e um motor que lhe diz quanto valia a jogada mais forte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn mai are paisprezece mii, alese din ce ți se pare greu, nu la întâmplare — și un motor care spune cât a valorat mutarea mai bună."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Brass Pawn их ещё четырнадцать тысяч — выбранных по тому, что даётся вам трудно, а не наугад, и движок, который говорит, чего стоил более сильный ход."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn má o štrnásťtisíc viac, vybrané podľa toho, čo vám robí problémy, nie náhodne — a engine, ktorý vám povie, akú hodnotu mal silnejší ťah."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn ima štirinajst tisoč dodatnih, izbranih med tistimi, ki vam delajo največ težav, ne naključno — in pogon, ki pove, koliko je bil vreden močnejši potezni predlog."
          }
        },
        "sl-SI": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn ima štirinajst tisoč dodatnih, izbranih med tistimi, ki vam delajo največ težav, ne naključno — in pogon, ki pove, koliko je bil vreden močnejši potezni predlog."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn har fjortontusen till, valda utifrån vad du tycker är svårt och inte slumpmässigt — och en motor som säger vad det starkare draget var värt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn-இல் இன்னும் பதினான்கு ஆயிரம் உள்ளன; அவை சீரற்ற முறையில் அல்ல, நீங்கள் கடினமாகக் கண்டவற்றிலிருந்து தேர்ந்தெடுக்கப்பட்டவை — மேலும் வலுவான நகர்வு எவ்வளவு மதிப்புடையது என்பதைச் சொல்லும் ஒரு engine-உம் உள்ளது."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn-இல் இன்னும் பதினான்கு ஆயிரம் உள்ளன; அவை சீரற்ற முறையில் அல்ல, நீங்கள் கடினமாகக் கண்டவற்றிலிருந்து தேர்ந்தெடுக்கப்பட்டவை — மேலும் வலுவான நகர்வு எவ்வளவு மதிப்புடையது என்பதைச் சொல்லும் ஒரு engine-உம் உள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn లో ఇంకో పద్నాలుగు వేల పజిల్లు ఉన్నాయి; అవి యాదృచ్ఛికంగా కాక, మీకు కష్టంగా అనిపించిన వాటినుంచే ఎంపిక చేసినవి — అంతేకాదు, బలమైన కదలిక విలువ ఎంత ఉందో చెప్పే ఇంజిన్ కూడా ఉంది."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn లో ఇంకో పద్నాలుగు వేల పజిల్లు ఉన్నాయి; అవి యాదృచ్ఛికంగా కాక, మీకు కష్టంగా అనిపించిన వాటినుంచే ఎంపిక చేసినవి — అంతేకాదు, బలమైన కదలిక విలువ ఎంత ఉందో చెప్పే ఇంజిన్ కూడా ఉంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn มีอีกหนึ่งหมื่นสี่พันข้อ คัดจากสิ่งที่คุณทำได้ยาก ไม่ใช่สุ่ม — พร้อมเอนจินที่บอกว่าตาเดินที่ดีกว่ามีค่าเท่าใด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn’da on dört bin tane daha var; rastgele değil, zorlandığınız yerlerden seçilir — ve daha güçlü hamlenin kaç ettiğini söyleyen bir motor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У Brass Pawn є ще чотирнадцять тисяч завдань — підібраних із того, що дається вам найважче, а не навмання, — і движок, який показує, скільки коштував би кращий хід."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn میں چودہ ہزار مزید ہیں، جو بے ترتیبی سے نہیں بلکہ ان چیزوں سے چنے گئے ہیں جن میں آپ کو مشکل پیش آ رہی تھی — اور ایک انجن جو بتاتا ہے کہ مضبوط چال کی قدر کیا تھی۔"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn میں چودہ ہزار مزید ہیں، جو بے ترتیبی سے نہیں بلکہ ان چیزوں سے چنے گئے ہیں جن میں آپ کو مشکل پیش آ رہی تھی — اور ایک انجن جو بتاتا ہے کہ مضبوط چال کی قدر کیا تھی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn còn mười bốn nghìn bài nữa, chọn theo những gì bạn thấy khó chứ không ngẫu nhiên — cùng một engine cho biết nước đi mạnh hơn đáng giá bao nhiêu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn 还有一万四千道，按你觉得难的来挑，而非随机 —— 并有引擎告诉你更强的一手值多少。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn 還有一萬四千道，按你覺得難的來挑，而非隨機 —— 並有引擎告訴你更強的一手值多少。"
          }
        }
      }
    },
    "clip.gameKept": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المباراة محفوظة. ثبّت Brass Pawn وسيفتح عليها — لتعيد عرضها على رقعة ثلاثية الأبعاد، ولتواصل اللعب من النقلة الحاسمة ضد المحرك."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "المباراة محفوظة. ثبّت Brass Pawn وسيفتح عليها — لتعيد عرضها على رقعة ثلاثية الأبعاد، ولتواصل اللعب من النقلة الحاسمة ضد المحرك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Партидата е запазена. Инсталирайте Brass Pawn и ще се отвори там — за да я прегледате на дъска в 3D и да продължите да играете от ключовия ход срещу двигателя."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গেমটি সংরক্ষিত আছে। Brass Pawn ইনস্টল করুন, আর এটি সেটি খুলে দেবে — 3D বোর্ডে আবার খেলতে, এবং মূল চাল থেকে ইঞ্জিনের বিরুদ্ধে খেলা চালিয়ে যেতে।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "গেমটি সংরক্ষিত আছে। Brass Pawn ইনস্টল করুন, আর এটি সেটি খুলে দেবে — 3D বোর্ডে আবার খেলতে, এবং মূল চাল থেকে ইঞ্জিনের বিরুদ্ধে খেলা চালিয়ে যেতে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La partida s’ha desat. Instal·leu Brass Pawn i s’obrirà aquí — per reproduir-la en un tauler 3D i per continuar des del moviment clau contra l’ordinador."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Partie je uložená. Nainstaluj Brass Pawn a otevře se právě na ní — přehraješ si ji na 3D šachovnici a od klíčového tahu ji můžeš dohrát proti enginu."
          }
        },
        "da": {
