    "store.rushAllowanceCount": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "مجاناً كل يوم: %lld جولات Rush، منفصلة عن حصة التكتيك. كلاهما يُعاد ضبطه الساعة 9:00 صباحاً بالتوقيت المحلي. اللعب ضد الحاسوب أو ضد شخص آخر يبقى بلا حدود."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdarma každý den: %lld běhů Rush, odděleně od přídělu na taktiku. Oboje se obnovuje v 9:00 místního času. Hra proti počítači i proti člověku zůstává bez omezení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis hver dag: %lld Rush-runder, adskilt fra taktikkvoten. Begge nulstilles kl. 9:00 lokal tid. At spille mod AI eller mod en anden person er fortsat ubegrænset."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlos pro Tag: %lld Rush-Läufe, getrennt vom Taktik-Kontingent. Beides wird um 9:00 Uhr Ortszeit zurückgesetzt. Das Spiel gegen die KI oder gegen eine andere Person bleibt unbegrenzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δωρεάν κάθε μέρα: %lld γύροι Rush, ξεχωριστά από το όριο τακτικής. Και τα δύο μηδενίζονται στις 9:00 τοπική ώρα. Το παιχνίδι εναντίον υπολογιστή ή άλλου παίκτη παραμένει απεριόριστο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free each day: %lld Rush runs, separate from the Tactics allowance. Both reset at 9:00 AM local time. Playing against AI or another person remains unlimited."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Free each day: %lld Rush runs, separate from the Tactics allowance. Both reset at 9:00 AM local time. Playing against AI or another person remains unlimited."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Free each day: %lld Rush runs, separate from the Tactics allowance. Both reset at 9:00 AM local time. Playing against AI or another person remains unlimited."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis cada día: %lld rondas de Rush, aparte de la cuota de táctica. Ambos se reinician a las 9:00 hora local. Jugar contra la IA o contra otra persona sigue siendo ilimitado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmaiseksi joka päivä: %lld Rush-kierrosta, erillään taktiikkakiintiöstä. Molemmat nollautuvat klo 9.00 paikallista aikaa. Pelaaminen tekoälyä tai toista ihmistä vastaan on edelleen rajatonta."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit chaque jour : %lld parties Rush, distinctes du quota de tactique. Les deux se réinitialisent à 9 h, heure locale. Jouer contre l’IA ou contre une autre personne reste illimité."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit chaque jour : %lld parties Rush, distinctes du quota de tactique. Les deux se réinitialisent à 9 h, heure locale. Jouer contre l’IA ou contre une autre personne reste illimité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחינם בכל יום: %lld סבבי Rush, בנפרד ממכסת הטקטיקה. שניהם מתאפסים ב־9:00 שעון מקומי. משחק מול המחשב או מול אדם אחר נשאר ללא הגבלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर दिन मुफ़्त: %lld Rush राउंड, टैक्टिक्स कोटे से अलग। दोनों स्थानीय समयानुसार सुबह 9:00 बजे रीसेट होते हैं। AI या किसी व्यक्ति के विरुद्ध खेलना असीमित रहता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingyen naponta: %lld Rush-kör, a taktikai kerettől külön. Mindkettő 9:00-kor, helyi idő szerint nullázódik. A gép vagy másik ember elleni játék továbbra is korlátlan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis setiap hari: %lld ronde Rush, terpisah dari kuota taktik. Keduanya disetel ulang pukul 09.00 waktu setempat. Bermain melawan AI atau orang lain tetap tanpa batas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis ogni giorno: %lld sessioni Rush, separate dalla quota di tattica. Entrambi si azzerano alle 9:00 ora locale. Giocare contro l’IA o contro un’altra persona resta illimitato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日無料: %lld 回の Rush。戦術問題とは別枠です。どちらも現地時間の午前9時にリセットされます。AI や人との対局は無制限のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 무료: Rush %lld회, 전술 한도와는 별개입니다. 둘 다 현지 시간 오전 9시에 초기화됩니다. AI나 다른 사람과의 대국은 계속 무제한입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Percuma setiap hari: %lld pusingan Rush, berasingan daripada kuota taktik. Kedua-duanya ditetapkan semula pada 9:00 pagi waktu tempatan. Bermain menentang AI atau orang lain kekal tanpa had."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis per dag: %lld Rush-rondes, los van het tactiektegoed. Beide worden om 9:00 uur lokale tijd hersteld. Spelen tegen de AI of tegen een ander blijft onbeperkt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis hver dag: %lld Rush-runder, atskilt fra taktikkvoten. Begge nullstilles kl. 9:00 lokal tid. Å spille mot KI eller mot en annen person er fortsatt ubegrenset."
