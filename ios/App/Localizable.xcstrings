    "today.privacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح «اليوم» ينزّل أحدث المباريات من brasspawn.com، والأيام السابقة كلما رجعت إليها. لا يُرسل شيء عنك، ولا يُحتفظ بشيء."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح «اليوم» ينزّل أحدث المباريات من brasspawn.com، والأيام السابقة كلما رجعت إليها. لا يُرسل شيء عنك، ولا يُحتفظ بشيء."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Откриване Today изтегля най-новите партии от brasspawn.com, а при връщане назад — и по-ранните дни. Нищо за вас не се изпраща и нищо не се запазва."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening Today brasspawn.com থেকে সর্বশেষ খেলা নামায়, আর আপনি পেছনে স্ক্রল করলে আগের দিনের খেলা দেখায়। আপনার সম্পর্কে কিছুই পাঠানো হয় না, আর কিছুই রাখা হয় না।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening Today brasspawn.com থেকে সর্বশেষ খেলা নামায়, আর আপনি পেছনে স্ক্রল করলে আগের দিনের খেলা দেখায়। আপনার সম্পর্কে কিছুই পাঠানো হয় না, আর কিছুই রাখা হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obertura avallga les partides més recents de brasspawn.com, i les de dies anteriors a mesura que t’hi desplaces enrere. No se n’envia res sobre tu ni es conserva res."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřením Dnes se stáhnou nejnovější partie z brasspawn.com a při posouvání zpět i starší dny. Nic o tobě se neodesílá a nic se neukládá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du åbner I dag, hentes de nyeste partier fra brasspawn.com, og ældre dage, når du ruller tilbage. Intet om dig sendes, og intet gemmes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Öffnen von Heute werden die neuesten Partien von brasspawn.com geladen, und frühere Tage, wenn du zurückscrollst. Dabei wird nichts über dich gesendet, und nichts wird gespeichert."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Öffnen von Heute werden die neuesten Partien von brasspawn.com geladen, und frühere Tage, wenn du zurückscrollst. Dabei wird nichts über dich gesendet, und nichts wird gespeichert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν ανοίγεις το Σήμερα, κατεβαίνουν οι πιο πρόσφατες παρτίδες από το brasspawn.com, και οι προηγούμενες μέρες καθώς κυλάς προς τα πίσω. Τίποτα για σένα δεν στέλνεται και τίποτα δεν κρατιέται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening Today downloads the latest games from brasspawn.com, and earlier days as you scroll back. Nothing about you is sent, and nothing is kept."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening Today downloads the latest games from brasspawn.com, and earlier days as you scroll back. Nothing about you is sent, and nothing is kept."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening Today downloads the latest games from brasspawn.com, and earlier days as you scroll back. Nothing about you is sent, and nothing is kept."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening Today downloads the latest games from brasspawn.com, and earlier days as you scroll back. Nothing about you is sent, and nothing is kept."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening Today downloads the latest games from brasspawn.com, and earlier days as you scroll back. Nothing about you is sent, and nothing is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al abrir Hoy se descargan las últimas partidas de brasspawn.com, y los días anteriores al desplazarte hacia atrás. No se envía nada sobre ti y no se guarda nada."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Al abrir Hoy se descargan las últimas partidas de brasspawn.com, y los días anteriores al desplazarte hacia atrás. No se envía nada sobre ti y no se guarda nada."
          }
