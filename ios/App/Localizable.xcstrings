        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 한 번. 구독도, 갱신도 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sekali sahaja. Tiada langganan, tiada pembaharuan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ eenmalig. Geen abonnement, geen verlenging."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ én gang. Ingen abonnement, ingen fornyelse."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ raz. Bez subskrypcji, bez odnawiania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uma vez só. Sem assinatura, sem renovação."
          }
        },
        "ro": {
          "stringUnit": {
