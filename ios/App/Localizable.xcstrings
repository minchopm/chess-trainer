    "online.playersNote4": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأسماء المستعارة والتصنيفات من Game Center بحسب ما يسمح به كل لاعب. «على التطبيق الآن» يعني أن التطبيق على شاشتهم في هذه اللحظة لمن يُظهر ذلك، و«نشِط» يعني الظهور خلال الأيام السبعة الأخيرة."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "الأسماء المستعارة والتصنيفات من Game Center بحسب ما يسمح به كل لاعب. «على التطبيق الآن» يعني أن التطبيق على شاشتهم في هذه اللحظة لمن يُظهر ذلك، و«نشِط» يعني الظهور خلال الأيام السبعة الأخيرة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прякорите и рейтингите са на Game Center, както всеки играч е разрешил да се показват. „Онлайн сега“ означава, че приложението е на екрана им в този момент, за тези, които го показват; „активен“ означава видян през последните седем дни."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডাকনাম আর রেটিং Game Center-এর, কারণ প্রতিটি খেলোয়াড় এগুলো দেখাতে দেন। Online now মানে এই মুহূর্তে অ্যাপটি তাদের স্ক্রিনে খোলা আছে, যাঁরা দেখাতে চান তাঁদের ক্ষেত্রে; active মানে গত সাত দিনে দেখা গেছে।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "ডাকনাম আর রেটিং Game Center-এর, কারণ প্রতিটি খেলোয়াড় এগুলো দেখাতে দেন। Online now মানে এই মুহূর্তে অ্যাপটি তাদের স্ক্রিনে খোলা আছে, যাঁরা দেখাতে চান তাঁদের ক্ষেত্রে; active মানে গত সাত দিনে দেখা গেছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els sobrenoms i els ELO són els de Game Center, tal com cada jugador en permet la visualització. En línia ara vol dir que l'app és a la pantalla en aquest moment, per als qui ho mostren; actiu vol dir vist els últims set dies."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přezdívky a ratingy jsou z Game Center, jak je každý hráč nechá zobrazit. Právě online znamená, že aplikace je teď na obrazovce, u těch, kdo to ukazují; aktivní znamená viděný za posledních sedm dní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldenavne og ratings kommer fra Game Center, som hver spiller lader dem vise. Online nu betyder, at appen er på deres skærm lige nu, for dem der viser det; aktiv betyder set de sidste syv dage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spitznamen und Wertungen stammen aus Game Center, so wie jeder Spieler sie zeigen lässt. Jetzt online heißt: Die App ist gerade auf dem Bildschirm, bei allen, die das zeigen; aktiv heißt: in den letzten sieben Tagen gesehen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Spitznamen und Wertungen stammen aus Game Center, so wie jeder Spieler sie zeigen lässt. Jetzt online heißt: Die App ist gerade auf dem Bildschirm, bei allen, die das zeigen; aktiv heißt: in den letzten sieben Tagen gesehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ψευδώνυμα και οι βαθμολογίες είναι του Game Center, όπως επιτρέπει κάθε παίκτης. Σε σύνδεση τώρα σημαίνει ότι η εφαρμογή είναι στην οθόνη τους αυτή τη στιγμή, για όσους το δείχνουν· ενεργός σημαίνει ότι εμφανίστηκε τις τελευταίες επτά ημέρες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicknames and ratings are Game Center's, as each player lets them be shown. Online now means the app is on their screen this minute, for those who show it; active means seen in the last seven days."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicknames and ratings are Game Center's, as each player lets them be shown. Online now means the app is on their screen this minute, for those who show it; active means seen in the last seven days."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicknames and ratings are Game Center's, as each player lets them be shown. Online now means the app is on their screen this minute, for those who show it; active means seen in the last seven days."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicknames and ratings are Game Center's, as each player lets them be shown. Online now means the app is on their screen this minute, for those who show it; active means seen in the last seven days."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicknames and ratings are Game Center's, as each player lets them be shown. Online now means the app is on their screen this minute, for those who show it; active means seen in the last seven days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los apodos y las valoraciones son de Game Center, según lo que cada jugador permita mostrar. En línea ahora significa que la app está en su pantalla en este momento, para quienes lo muestran; activo, visto en los últimos siete días."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los apodos y las valoraciones son de Game Center, según lo que cada jugador permita mostrar. En línea ahora significa que la app está en su pantalla en este momento, para quienes lo muestran; activo, visto en los últimos siete días."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los apodos y rankings son los de Game Center, según permita cada jugador que se muestren. En línea ahora significa que la app está en su pantalla en este momento, para quienes lo muestran; activo significa visto en los últimos siete días."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimimerkit ja ratingit ovat Game Centerin, sen mukaan kuin kukin pelaaja sallii. Paikalla nyt tarkoittaa, että sovellus on juuri nyt pelaajan näytöllä, niillä jotka sen näyttävät; aktiivinen tarkoittaa nähtyä viimeisen seitsemän päivän aikana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pseudos et les classements viennent de Game Center, selon ce que chaque joueur autorise. En ligne signifie que l’app est à l’écran en ce moment, pour ceux qui l’indiquent ; actif signifie vu ces sept derniers jours."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pseudos et les classements viennent de Game Center, selon ce que chaque joueur autorise. En ligne signifie que l’app est à l’écran en ce moment, pour ceux qui l’indiquent ; actif signifie vu ces sept derniers jours."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pseudos et les classements viennent de Game Center, selon ce que chaque joueur autorise. En ligne signifie que l’app est à l’écran en ce moment, pour ceux qui l’indiquent ; actif signifie vu ces sept derniers jours."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઉપનામો અને રેટિંગ્સ Game Centerનાં છે, કારણ કે દરેક ખેલાડી તેને દેખાડવાની મંજૂરી આપે છે. Online now એટલે કે આ ક્ષણે તેમનું એપ તેમની સ્ક્રીન પર છે, જે લોકો એ બતાવે છે તેમના માટે; active એટલે છેલ્લા સાત દિવસમાં જોયેલું."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ઉપનામો અને રેટિંગ્સ Game Centerનાં છે, કારણ કે દરેક ખેલાડી તેને દેખાડવાની મંજૂરી આપે છે. Online now એટલે કે આ ક્ષણે તેમનું એપ તેમની સ્ક્રીન પર છે, જે લોકો એ બતાવે છે તેમના માટે; active એટલે છેલ્લા સાત દિવસમાં જોયેલું."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכינויים והדירוגים הם של Game Center, כפי שכל שחקן מתיר להציג. באפליקציה עכשיו פירושו שהאפליקציה על המסך שלהם ברגע זה, אצל מי שמציג זאת; פעיל פירושו שנראה בשבעת הימים האחרונים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपनाम और रेटिंग Game Center की हैं, जितना हर खिलाड़ी दिखाने देता है। अभी ऑनलाइन का अर्थ है कि ऐप इस पल उनकी स्क्रीन पर है, उनके लिए जो यह दिखाते हैं; सक्रिय का अर्थ है पिछले सात दिनों में दिखे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadimci i rejting su iz Game Centera, kako ih svaki igrač dopusti prikazati. Online sada znači da je aplikacija trenutačno na njihovom zaslonu, za one koji to prikazuju; aktivan znači da su viđeni u posljednjih sedam dana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A becenevek és az értékszámok a Game Centeréi, ahogy az egyes játékosok engedik mutatni őket. Most online: az alkalmazás éppen a képernyőjükön van, azoknál, akik ezt mutatják; aktív: az elmúlt hét napban látott."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama panggilan dan rating berasal dari Game Center, sesuai izin tiap pemain. Daring sekarang berarti aplikasi sedang ada di layar mereka saat ini, bagi yang menunjukkannya; aktif berarti terlihat dalam tujuh hari terakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nickname e i punteggi sono di Game Center, come ogni giocatore permette di mostrarli. Online ora significa che l'app è sul loro schermo in questo momento, per chi lo mostra; attivo, visto negli ultimi sette giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ニックネームとレーティングは、各プレイヤーが許可した範囲で Game Center が表示するものです。「オンライン中」は今この瞬間アプリが画面に表示されていること（表示を許可した人のみ）、「アクティブ」は過去7日間に見かけたことを意味します。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лақап аттар мен рейтингтер — әр ойыншы Game Center-де қалай көрсетуге рұқсат етсе, солай көрінеді. «Қазір онлайн» дегені — осы сәтте қолданба олардың экранында ашық тұр деген сөз, егер олар мұны көрсетуді таңдаса; «белсенді» дегені — соңғы жеті күнде көрінген."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicknames ಮತ್ತು ratings ಗಳು Game Center ನವು, ಪ್ರತಿಯೊಬ್ಬ ಆಟಗಾರ ಅವು ಪ್ರದರ್ಶಿಸಲು ಅನುಮತಿಸಿದಂತೆ. ಈಗ ಆನ್‌ಲೈನ್ ಎಂದರೆ ಆ ಕ್ಷಣದಲ್ಲಿ ಅವರ ಪರದೆಯಲ್ಲಿ ಆಪ್ ತೆರೆದಿದೆ; ಅವರು ತೋರಿಸಿದರೆ. ಸಕ್ರಿಯ ಎಂದರೆ ಕಳೆದ ಏಳು ದಿನಗಳಲ್ಲಿ ಕಂಡುಬಂದವರು."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicknames ಮತ್ತು ratings ಗಳು Game Center ನವು, ಪ್ರತಿಯೊಬ್ಬ ಆಟಗಾರ ಅವು ಪ್ರದರ್ಶಿಸಲು ಅನುಮತಿಸಿದಂತೆ. ಈಗ ಆನ್‌ಲೈನ್ ಎಂದರೆ ಆ ಕ್ಷಣದಲ್ಲಿ ಅವರ ಪರದೆಯಲ್ಲಿ ಆಪ್ ತೆರೆದಿದೆ; ಅವರು ತೋರಿಸಿದರೆ. ಸಕ್ರಿಯ ಎಂದರೆ ಕಳೆದ ಏಳು ದಿನಗಳಲ್ಲಿ ಕಂಡುಬಂದವರು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닉네임과 레이팅은 각 플레이어가 공개를 허용한 범위에서 Game Center가 제공합니다. '지금 온라인'은 앱이 지금 화면에 떠 있다는 뜻이며(표시를 켠 사람만), '활동'은 최근 7일 안에 보였다는 뜻입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പേരും റേറ്റിംഗും Game Center-ലേതാണ്, ഓരോ കളിക്കാരനും അത് കാണിക്കാൻ അനുവദിക്കുന്നതനുസരിച്ച്. Online now എന്നത് ആ നിമിഷം അവരുടെ സ്ക്രീനിൽ ആപ്പ് തുറന്നിരിക്കുന്നുവെന്നർത്ഥം; അത് കാണിക്കാൻ അനുവദിച്ചിരിക്കുന്നവർക്കായി മാത്രം. Active എന്നത് കഴിഞ്ഞ ഏഴ് ദിവസത്തിനുള്ളിൽ കണ്ടതായി അർത്ഥം."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "പേരും റേറ്റിംഗും Game Center-ലേതാണ്, ഓരോ കളിക്കാരനും അത് കാണിക്കാൻ അനുവദിക്കുന്നതനുസരിച്ച്. Online now എന്നത് ആ നിമിഷം അവരുടെ സ്ക്രീനിൽ ആപ്പ് തുറന്നിരിക്കുന്നുവെന്നർത്ഥം; അത് കാണിക്കാൻ അനുവദിച്ചിരിക്കുന്നവർക്കായി മാത്രം. Active എന്നത് കഴിഞ്ഞ ഏഴ് ദിവസത്തിനുള്ളിൽ കണ്ടതായി അർത്ഥം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "टोपणनावे आणि रेटिंग Game Center ची आहेत, कारण प्रत्येक खेळाडूने ती दाखवू दिलेली असतात. Online now म्हणजे त्या क्षणी अॅप त्यांच्या स्क्रीनवर उघडे आहे; ज्यांनी ते दाखवले आहे त्यांच्यासाठी active म्हणजे गेल्या सात दिवसांत पाहिले गेले आहे."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "टोपणनावे आणि रेटिंग Game Center ची आहेत, कारण प्रत्येक खेळाडूने ती दाखवू दिलेली असतात. Online now म्हणजे त्या क्षणी अॅप त्यांच्या स्क्रीनवर उघडे आहे; ज्यांनी ते दाखवले आहे त्यांच्यासाठी active म्हणजे गेल्या सात दिवसांत पाहिले गेले आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama samaran dan rating daripada Game Center, mengikut izin setiap pemain. Dalam talian sekarang bermakna aplikasi berada pada skrin mereka ketika ini, bagi yang menunjukkannya; aktif bermakna dilihat dalam tujuh hari lepas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kallenavn og ratinger kommer fra Game Center, slik hver spiller lar dem vises. Pålogget nå betyr at appen er på skjermen deres akkurat nå, for dem som viser det; aktiv betyr sett de siste sju dagene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijnamen en ratings komen uit Game Center, zoals elke speler ze laat zien. Nu online betekent dat de app op dit moment op hun scherm staat, voor wie dat laat zien; actief betekent gezien in de afgelopen zeven dagen."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijnamen en ratings komen uit Game Center, zoals elke speler ze laat zien. Nu online betekent dat de app op dit moment op hun scherm staat, voor wie dat laat zien; actief betekent gezien in de afgelopen zeven dagen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Kallenavn og ratinger kommer fra Game Center, slik hver spiller lar dem vises. Pålogget nå betyr at appen er på skjermen deres akkurat nå, for dem som viser det; aktiv betyr sett de siste sju dagene."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଡାକନାମ ଏବଂ ରେଟିଂଗୁଡ଼ିକ Game Center ର, କାରଣ ପ୍ରତ୍ୟେକ ଖେଳାଳି ସେଗୁଡ଼ିକୁ ଦେଖାଇବାକୁ ଦେଇଛନ୍ତି। Online now ମାନେ ଏହି ମୁହୂର୍ତ୍ତରେ ସେମାନଙ୍କ ସ୍କ୍ରିନରେ ଆପ୍ ଖୋଲା ଅଛି, ଯେମାନେ ଏହା ଦେଖାନ୍ତି; active ମାନେ ଗତ ସାତ ଦିନରେ ଦେଖାଯାଇଛନ୍ତି।"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ଡାକନାମ ଏବଂ ରେଟିଂଗୁଡ଼ିକ Game Center ର, କାରଣ ପ୍ରତ୍ୟେକ ଖେଳାଳି ସେଗୁଡ଼ିକୁ ଦେଖାଇବାକୁ ଦେଇଛନ୍ତି। Online now ମାନେ ଏହି ମୁହୂର୍ତ୍ତରେ ସେମାନଙ୍କ ସ୍କ୍ରିନରେ ଆପ୍ ଖୋଲା ଅଛି, ଯେମାନେ ଏହା ଦେଖାନ୍ତି; active ମାନେ ଗତ ସାତ ଦିନରେ ଦେଖାଯାଇଛନ୍ତି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਪਨਾਮ ਅਤੇ ਰੇਟਿੰਗਾਂ Game Center ਦੀਆਂ ਹਨ, ਜਿਵੇਂ ਹਰ ਖਿਡਾਰੀ ਉਨ੍ਹਾਂ ਨੂੰ ਦਿਖਾਉਣ ਦੀ ਇਜਾਜ਼ਤ ਦਿੰਦਾ ਹੈ। Online now ਦਾ ਮਤਲਬ ਹੈ ਕਿ ਜਿਸ ਵੇਲੇ ਇਹ ਲਿਖਿਆ ਗਿਆ ਹੈ, ਐਪ ਉਹਨਾਂ ਦੀ ਸਕ੍ਰੀਨ 'ਤੇ ਹੈ; ਜੋ ਇਹ ਦਿਖਾਉਂਦੇ ਹਨ, ਉਨ੍ਹਾਂ ਲਈ ਇਹ ਹੁੰਦਾ ਹੈ। active ਦਾ ਮਤਲਬ ਹੈ ਪਿਛਲੇ ਸੱਤ ਦਿਨਾਂ ਵਿੱਚ ਵੇਖਿਆ ਗਿਆ।"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਪਨਾਮ ਅਤੇ ਰੇਟਿੰਗਾਂ Game Center ਦੀਆਂ ਹਨ, ਜਿਵੇਂ ਹਰ ਖਿਡਾਰੀ ਉਨ੍ਹਾਂ ਨੂੰ ਦਿਖਾਉਣ ਦੀ ਇਜਾਜ਼ਤ ਦਿੰਦਾ ਹੈ। Online now ਦਾ ਮਤਲਬ ਹੈ ਕਿ ਜਿਸ ਵੇਲੇ ਇਹ ਲਿਖਿਆ ਗਿਆ ਹੈ, ਐਪ ਉਹਨਾਂ ਦੀ ਸਕ੍ਰੀਨ 'ਤੇ ਹੈ; ਜੋ ਇਹ ਦਿਖਾਉਂਦੇ ਹਨ, ਉਨ੍ਹਾਂ ਲਈ ਇਹ ਹੁੰਦਾ ਹੈ। active ਦਾ ਮਤਲਬ ਹੈ ਪਿਛਲੇ ਸੱਤ ਦਿਨਾਂ ਵਿੱਚ ਵੇਖਿਆ ਗਿਆ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pseudonimy i rankingi pochodzą z Game Center, zgodnie z tym, na co pozwala każdy gracz. Teraz online oznacza, że aplikacja jest w tej chwili na ekranie, u tych, którzy to pokazują; aktywni to widziani w ciągu ostatnich siedmiu dni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apelidos e os ratings são do Game Center, conforme cada jogador permite mostrar. On-line agora significa que o app está na tela da pessoa neste momento, para quem mostra isso; ativo, visto nos últimos sete dias."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apelidos e os ratings são do Game Center, conforme cada jogador permite mostrar. On-line agora significa que o app está na tela da pessoa neste momento, para quem mostra isso; ativo, visto nos últimos sete dias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes e classificações são do Game Center, conforme cada jogador permite que sejam mostrados. «Online agora» significa que a app está no ecrã dessa pessoa neste momento, para quem o mostrar; «ativo» significa visto nos últimos sete dias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poreclele și ratingurile vin din Game Center, după cum permite fiecare jucător. Online acum înseamnă că aplicația e pe ecranul lor în acest moment, pentru cei care arată asta; activ înseamnă văzut în ultimele șapte zile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ники и рейтинги берутся из Game Center — в той мере, в какой игрок разрешает их показывать. «Сейчас онлайн» — приложение открыто на экране в эту минуту, у тех, кто это показывает; «активные» — заходили за последние семь дней."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prezývky a hodnotenia sú z Game Center, podľa toho, ako ich každý hráč povoľuje zobrazovať. Online teraz znamená, že je aplikácia práve na ich obrazovke; aktívny znamená videný za posledných sedem dní."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzdevki in ocene so iz Game Centerja, saj jih posamezni igralec dovoli prikazati. »Trenutno na spletu« pomeni, da je aplikacija v tem trenutku na njegovem zaslonu, za tiste, ki to prikazujejo; »aktiven« pomeni, da je bil viden v zadnjih sedmih dneh."
          }
        },
        "sl-SI": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzdevki in ocene so iz Game Centerja, saj jih posamezni igralec dovoli prikazati. »Trenutno na spletu« pomeni, da je aplikacija v tem trenutku na njegovem zaslonu, za tiste, ki to prikazujejo; »aktiven« pomeni, da je bil viden v zadnjih sedmih dneh."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Smeknamn och ratingar kommer från Game Center, så som varje spelare låter dem visas. Online nu betyder att appen är på deras skärm just nu, för dem som visar det; aktiv betyder sedd de senaste sju dagarna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "போக்குப்பெயர்களும் மதிப்பெண்களும் Game Center-இன் தகவல்கள்; ஒவ்வொரு வீரரும் அவை காட்ட அனுமதிப்பதுபோல். இப்போது ஆன்லைன் என்றால், அந்த நிமிடத்தில் அவர்களின் திரையில் பயன்பாடு திறந்திருப்பது; செயலில் உள்ளவர் என்றால் கடந்த ஏழு நாட்களில் காணப்பட்டவர்."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "போக்குப்பெயர்களும் மதிப்பெண்களும் Game Center-இன் தகவல்கள்; ஒவ்வொரு வீரரும் அவை காட்ட அனுமதிப்பதுபோல். இப்போது ஆன்லைன் என்றால், அந்த நிமிடத்தில் அவர்களின் திரையில் பயன்பாடு திறந்திருப்பது; செயலில் உள்ளவர் என்றால் கடந்த ஏழு நாட்களில் காணப்பட்டவர்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పేరుపేర్లు మరియు రేటింగ్‌లు Game Center కి చెందినవే; ప్రతి ఆటగాడు వాటిని చూపేందుకు అనుమతిస్తాడు. Online now అంటే ఈ క్షణంలో వారి స్క్రీన్‌పై యాప్ తెరిచి ఉందని అర్థం, అది చూపించేవారికి మాత్రమే; active అంటే గత ఏడు రోజుల్లో కనిపించిందని అర్థం."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "పేరుపేర్లు మరియు రేటింగ్‌లు Game Center కి చెందినవే; ప్రతి ఆటగాడు వాటిని చూపేందుకు అనుమతిస్తాడు. Online now అంటే ఈ క్షణంలో వారి స్క్రీన్‌పై యాప్ తెరిచి ఉందని అర్థం, అది చూపించేవారికి మాత్రమే; active అంటే గత ఏడు రోజుల్లో కనిపించిందని అర్థం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อเล่นและเรตติ้งมาจาก Game Center ตามที่ผู้เล่นแต่ละคนอนุญาตให้แสดง ออนไลน์ตอนนี้หมายถึงแอปอยู่บนหน้าจอของเขาในขณะนี้ สำหรับผู้ที่เลือกแสดง ส่วนใช้งานอยู่หมายถึงพบในช่วงเจ็ดวันที่ผ่านมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takma adlar ve puanlar Game Center'ındır, her oyuncunun gösterilmesine izin verdiği kadarıyla. Şu an çevrimiçi, uygulamanın şu anda ekranlarında olduğu anlamına gelir (gösterenler için); etkin, son yedi günde görülmüş demektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Псевдоніми та рейтинги — це дані Game Center, якщо кожен гравець дозволив їх показувати. «В мережі зараз» означає, що цього хвилинного моменту додаток відкритий на його екрані, для тих, хто це показує; «активний» означає, що гравця бачили протягом останніх семи днів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عرف اور ریٹنگ Game Center کی ہیں، جیسا کہ ہر کھلاڑی انہیں دکھانے دیتا ہے۔ Online now کا مطلب ہے کہ اس لمحے ایپ ان کی اسکرین پر ہے، اگر وہ اسے دکھاتے ہیں؛ active کا مطلب ہے پچھلے سات دن میں دیکھا گیا۔"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "عرف اور ریٹنگ Game Center کی ہیں، جیسا کہ ہر کھلاڑی انہیں دکھانے دیتا ہے۔ Online now کا مطلب ہے کہ اس لمحے ایپ ان کی اسکرین پر ہے، اگر وہ اسے دکھاتے ہیں؛ active کا مطلب ہے پچھلے سات دن میں دیکھا گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biệt danh và hệ số là của Game Center, theo mức mỗi người chơi cho phép hiển thị. Đang trực tuyến nghĩa là ứng dụng đang ở trên màn hình của họ lúc này, với ai chọn hiển thị; hoạt động nghĩa là xuất hiện trong bảy ngày qua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "昵称和等级分来自 Game Center，按每位玩家允许的方式显示。“正在在线”指此刻应用正显示在对方屏幕上（仅限选择显示的人）；“活跃”指过去七天内出现过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暱稱和等級分來自 Game Center，依每位玩家允許的方式顯示。「正在線上」指此刻 App 正顯示在對方螢幕上（僅限選擇顯示的人）；「活躍」指過去七天內出現過。"
          }
        }
      }
    },
    "online.presence.looking": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
