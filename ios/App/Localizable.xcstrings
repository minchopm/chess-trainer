        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ଯେକୌଣସି ସମୟରେ ଆପଣଙ୍କ ପ୍ଲାନ୍ ବଦଳାଇ ପାରିବେ। ମାସିକ ଓ ବାର୍ଷିକ ମଧ୍ୟରେ ପରିବର୍ତ୍ତନ ପରବର୍ତ୍ତୀ ନବୀକରଣରୁ ଆରମ୍ଭ ହେବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਕਿਸੇ ਵੀ ਸਮੇਂ ਆਪਣੀ ਯੋਜਨਾ ਬਦਲ ਸਕਦੇ ਹੋ। ਮਹੀਨਾਵਾਰ ਅਤੇ ਸਾਲਾਨਾ ਵਿਚ ਬਦਲਾਅ ਤੁਹਾਡੀ ਅਗਲੀ ਨਵੀਨੀਕਰਨ ਤੋਂ ਸ਼ੁਰੂ ਹੁੰਦਾ ਹੈ।"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਕਿਸੇ ਵੀ ਸਮੇਂ ਆਪਣੀ ਯੋਜਨਾ ਬਦਲ ਸਕਦੇ ਹੋ। ਮਹੀਨਾਵਾਰ ਅਤੇ ਸਾਲਾਨਾ ਵਿਚ ਬਦਲਾਅ ਤੁਹਾਡੀ ਅਗਲੀ ਨਵੀਨੀਕਰਨ ਤੋਂ ਸ਼ੁਰੂ ਹੁੰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan możesz zmienić w każdej chwili. Zmiana między miesięcznym a rocznym zaczyna się od następnego odnowienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode mudar de plano a qualquer momento. A troca entre mensal e anual começa na próxima renovação."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode mudar de plano a qualquer momento. A troca entre mensal e anual começa na próxima renovação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes alterar o teu plano a qualquer momento. A passagem de mensal para anual começa na tua próxima renovação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți schimba planul oricând. Trecerea între lunar și anual începe la următoarea reînnoire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "План можно сменить в любой момент. Переход между месячным и годовым начнётся со следующего продления."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plán môžete kedykoľvek zmeniť. Prechod medzi mesačným a ročným začne pri najbližšom obnovení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Načrt lahko kadar koli spremeniš. Preklop med mesečnim in letnim se začne ob naslednjem podaljšanju."
          }
        },
        "sl-SI": {
          "stringUnit": {
            "state": "translated",
            "value": "Načrt lahko kadar koli spremeniš. Preklop med mesečnim in letnim se začne ob naslednjem podaljšanju."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan byta plan när som helst. Ett byte mellan månadsvis och årsvis börjar vid nästa förnyelse."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் உங்கள் திட்டத்தை எப்போது வேண்டுமானாலும் மாற்றலாம். மாதாந்திரத்திலிருந்து ஆண்டாந்திரமாக அல்லது அதற்கு மாறுவது உங்கள் அடுத்த புதுப்பிப்பில் தொடங்கும்."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் உங்கள் திட்டத்தை எப்போது வேண்டுமானாலும் மாற்றலாம். மாதாந்திரத்திலிருந்து ஆண்டாந்திரமாக அல்லது அதற்கு மாறுவது உங்கள் அடுத்த புதுப்பிப்பில் தொடங்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ప్లాన్‌ను ఎప్పుడైనా మార్చుకోవచ్చు. నెలవారీ మరియు వార్షిక ప్లాన్‌ల మధ్య మార్పు మీ తదుపరి రీన్యువల్ నుంచే ప్రారంభమవుతుంది."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ప్లాన్‌ను ఎప్పుడైనా మార్చుకోవచ్చు. నెలవారీ మరియు వార్షిక ప్లాన్‌ల మధ్య మార్పు మీ తదుపరి రీన్యువల్ నుంచే ప్రారంభమవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเปลี่ยนแผนได้ทุกเมื่อ การสลับระหว่างรายเดือนและรายปีจะเริ่มในการต่ออายุครั้งถัดไป"
