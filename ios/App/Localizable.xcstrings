    "online.invitationClock": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ لكلٍّ منكما. ستُوصَل بهم مباشرةً لا إلى قائمة الانتظار العامة."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ لكلٍّ منكما. ستُوصَل بهم مباشرةً لا إلى قائمة الانتظار العامة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ всяко. Ще бъдете свързани директно с тях, а не с общия пул."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ করে। আপনাকে সাধারণ পুলে না পাঠিয়ে সরাসরি তার কাছে নিয়ে যাওয়া হবে।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ করে। আপনাকে সাধারণ পুলে না পাঠিয়ে সরাসরি তার কাছে নিয়ে যাওয়া হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cadascun. Se’t connectarà directament amb ells en lloc d’enviar-te al grup general."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pro každého. Budete spojeni přímo s nimi, ne s obecnou frontou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ til hver. Du bliver stillet direkte igennem til dem, ikke ud i den almindelige pulje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je %@. Sie werden direkt mit ihnen verbunden, nicht in den allgemeinen Pool gestellt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Je %@. Sie werden direkt mit ihnen verbunden, nicht in den allgemeinen Pool gestellt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ο καθένας. Θα συνδεθείτε απευθείας μαζί τους, όχι με τη γενική δεξαμενή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ each. You will be put straight through to them rather than into the general pool."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ each. You will be put straight through to them rather than into the general pool."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ each. You will be put straight through to them rather than into the general pool."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ each. You will be put straight through to them rather than into the general pool."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ each. You will be put straight through to them rather than into the general pool."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cada uno. Se te conectará directamente con esa persona, no con la cola general."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cada uno. Se te conectará directamente con esa persona, no con la cola general."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cada uno. Se te conectará directo con ellos, en lugar de pasarte al grupo general."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kummallekin. Sinut yhdistetään suoraan heihin, ei yleiseen jonoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chacun. Vous serez mis en relation directement avec cette personne, pas avec la file générale."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chacun. Vous serez mis en relation directement avec cette personne, pas avec la file générale."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chacun. Vous serez mis en relation directement avec cette personne, pas avec la file générale."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેકને %@. તમને સામાન્ય પૂલમાં મૂકવા બદલે સીધા તેમના સાથે જોડવામાં આવશે."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેકને %@. તમને સામાન્ય પૂલમાં મૂકવા બદલે સીધા તેમના સાથે જોડવામાં આવશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ לכל צד. תחוברו ישירות אליהם ולא לתור הכללי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक को %@। आपको सीधे उन्हीं से जोड़ा जाएगा, आम कतार से नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ svaki. Odmah ćete biti povezani s njima, a ne s općim bazenom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fejenként %@. Közvetlenül vele kapcsolják össze, nem az általános sorba kerül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ masing-masing. Anda akan langsung disambungkan dengan mereka, bukan ke antrean umum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a testa. Sarai messo direttamente in contatto con loro, non nella coda generale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "持ち時間は各 %@。一般の待ち行列ではなく、その相手に直接つながります。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әрқайсысы %@. Сізді жалпы кезекке қоспай, тікелей соған қосады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿೊಬ್ಬರಿಗೆ %@. ಸಾಮಾನ್ಯ ಪಟ್ಟಿಗೆ ಹಾಕದೆ ನೇರವಾಗಿ ಅವರಿಗೆ ನಿಮ್ಮನ್ನು ಕಳುಹಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿೊಬ್ಬರಿಗೆ %@. ಸಾಮಾನ್ಯ ಪಟ್ಟಿಗೆ ಹಾಕದೆ ನೇರವಾಗಿ ಅವರಿಗೆ ನಿಮ್ಮನ್ನು ಕಳುಹಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각자 %@. 일반 대기열이 아니라 그 상대와 바로 연결됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ വീതം. പൊതുവായ പൂളിൽ പോകാതെ നിങ്ങളെ നേരിട്ട് അവരിലേക്കാണ് ചേർക്കുക."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ വീതം. പൊതുവായ പൂളിൽ പോകാതെ നിങ്ങളെ നേരിട്ട് അവരിലേക്കാണ് ചേർക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येकी %@. तुम्हाला सर्वसाधारण रांगेत न टाकता थेट त्यांच्याशी जोडले जाईल."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येकी %@. तुम्हाला सर्वसाधारण रांगेत न टाकता थेट त्यांच्याशी जोडले जाईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ setiap seorang. Anda akan disambungkan terus kepada mereka, bukan ke barisan umum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hver. Du blir koblet rett til dem, ikke til den vanlige køen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ elk. Je wordt rechtstreeks met hen verbonden, niet met de algemene wachtrij."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ elk. Je wordt rechtstreeks met hen verbonden, niet met de algemene wachtrij."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hver. Du blir koblet rett til dem, ikke til den vanlige køen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରତିଟି %@। ଆପଣଙ୍କୁ ସିଧାସଳଖ ତାଙ୍କ ପାଖକୁ ପଠାଯିବ, ସାଧାରଣ ପୁଲକୁ ନୁହେଁ।"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରତିଟି %@। ଆପଣଙ୍କୁ ସିଧାସଳଖ ତାଙ୍କ ପାଖକୁ ପଠାଯିବ, ସାଧାରଣ ପୁଲକୁ ନୁହେଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਹਰ ਇੱਕ। ਤੁਹਾਨੂੰ ਆਮ ਪੂਲ ਵਿੱਚ ਪਾਉਣ ਦੀ ਬਜਾਏ ਸਿੱਧੇ ਉਸ ਨਾਲ ਮਿਲਾਇਆ ਜਾਵੇਗਾ।"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਹਰ ਇੱਕ। ਤੁਹਾਨੂੰ ਆਮ ਪੂਲ ਵਿੱਚ ਪਾਉਣ ਦੀ ਬਜਾਏ ਸਿੱਧੇ ਉਸ ਨਾਲ ਮਿਲਾਇਆ ਜਾਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po %@ na gracza. Zostaniesz połączony(a) bezpośrednio z tą osobą, nie z ogólną kolejką."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ para cada um. Você será ligado diretamente a essa pessoa, não à fila geral."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ para cada um. Você será ligado diretamente a essa pessoa, não à fila geral."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cada. Serás encaminhado diretamente para essa pessoa, em vez de ires para o grupo geral."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Câte %@ fiecare. Vei fi conectat direct la ei, nu la coada generală."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По %@ каждому. Вас соединят напрямую с ним, а не с общей очередью."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
