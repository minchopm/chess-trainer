    "play.coachingGradesEveryMove": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يُقيّم المدرب كل نقلة تلعبها فور لعبها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenér hodnotí každý váš tah hned, jak jej zahrajete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træneren bedømmer hvert af dine træk, efterhånden som du spiller dem."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Trainer bewertet jeden deiner Züge, sobald du ihn machst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο προπονητής βαθμολογεί κάθε κίνησή σας μόλις την κάνετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coaching grades each of your moves as you make it."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Coaching grades each of your moves as you make it."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Coaching grades each of your moves as you make it."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El entrenador califica cada una de tus jugadas en cuanto la haces."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmentaja arvioi jokaisen siirtosi heti kun teet sen."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L'entraîneur évalue chacun de vos coups au fur et à mesure."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "L'entraîneur évalue chacun de vos coups au fur et à mesure."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המאמן מדרג כל מהלך שלך ברגע שאתה עושה אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोच आपकी हर चाल का मूल्यांकन उसी समय करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az edző minden lépésedet értékeli, ahogy megteszed."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelatih menilai setiap langkah Anda begitu Anda memainkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'allenatore valuta ogni tua mossa nel momento in cui la giochi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーチが、指したそばから一手ごとに評価します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코치가 두는 즉시 매 수를 평가합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jurulatih menilai setiap langkah anda sebaik sahaja anda memainkannya."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De coach beoordeelt elke zet zodra je hem doet."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Treneren vurderer hvert av trekkene dine etter hvert som du gjør dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trener ocenia każdy Twój ruch zaraz po jego wykonaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O treinador avalia cada lance seu assim que você o joga."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenorul evaluează fiecare mutare a ta imediat ce o faci."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренер оценивает каждый ваш ход сразу после того, как вы его сделали."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tränaren bedömer vart och ett av dina drag allteftersom du gör dem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โค้ชจะให้คะแนนทุกตาเดินของคุณทันทีที่คุณเดิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenör, yaptığınız her hamleyi anında değerlendirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huấn luyện viên chấm điểm từng nước đi của bạn ngay khi bạn đi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "教练会在你每走一步时立即为其评分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "教練會在你每走一步時立即為其評分。"
