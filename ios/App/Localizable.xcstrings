        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू करने के लिए गेम या पोज़िशन पेस्ट करें, या बस चालें चलें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Illessz be játszmát vagy állást kiindulásnak, vagy csak lépj."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempel permainan atau posisi awal, atau langsung mainkan langkah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla una partita o una posizione di partenza, oppure gioca e basta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始局面として棋譜や局面を貼り付けるか、そのまま指してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작할 기보나 포지션을 붙여넣거나, 그냥 두셔도 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
