    "store.freeForever": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "اللعب يبقى مجانًا — أمام المحرّك وأمام الناس، بلا حدود وبلا إعلانات. ما يفتحه Pro هو التدريب."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hraní zůstává zdarma — proti enginu i proti lidem, bez omezení a bez reklam. Pro odemyká trénink."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At spille er stadig gratis — mod motoren og mod mennesker, uden grænser og uden reklamer. Det Pro låser op for, er træningen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielen bleibt kostenlos — gegen die Engine wie gegen Menschen, ohne Grenze und ohne Werbung. Pro schaltet das Training frei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το παιχνίδι μένει δωρεάν — απέναντι στη μηχανή και απέναντι σε ανθρώπους, χωρίς όριο και χωρίς διαφημίσεις. Αυτό που ξεκλειδώνει το Pro είναι η προπόνηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playing stays free — against the engine and against people, with no limit and no adverts. What Pro unlocks is the training."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Playing stays free — against the engine and against people, with no limit and no adverts. What Pro unlocks is the training."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Playing stays free — against the engine and against people, with no limit and no adverts. What Pro unlocks is the training."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Jugar sigue siendo gratis — contra el motor y contra personas, sin límite y sin anuncios. Lo que Pro desbloquea es el entrenamiento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelaaminen pysyy ilmaisena — moottoria ja ihmisiä vastaan, ilman rajaa ja ilman mainoksia. Pro avaa harjoittelun."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouer reste gratuit — contre le moteur comme contre des personnes, sans limite et sans publicité. Ce que Pro débloque, c'est l'entraînement."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouer reste gratuit — contre le moteur comme contre des personnes, sans limite et sans publicité. Ce que Pro débloque, c'est l'entraînement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשחק נשאר חינם — מול המנוע ומול אנשים, בלי הגבלה ובלי פרסומות. מה ש-Pro פותח זה האימון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खेलना मुफ़्त ही रहेगा — इंजन के साथ भी और लोगों के साथ भी, बिना सीमा और बिना विज्ञापन। Pro जो खोलता है वह अभ्यास है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A játék ingyenes marad — a motor és emberek ellen is, korlát és reklám nélkül. A Pro az edzést oldja fel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bermain tetap gratis — lawan mesin maupun lawan orang, tanpa batas dan tanpa iklan. Yang dibuka Pro adalah latihannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Giocare resta gratis — contro il motore e contro le persone, senza limiti e senza pubblicità. Quello che Pro sblocca è l'allenamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対局は無料のままです — エンジン相手でも人相手でも、制限なし・広告なし。Pro が解放するのはトレーニングです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대국은 계속 무료입니다 — 엔진이든 사람이든, 제한도 광고도 없습니다. Pro가 여는 것은 훈련입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bermain kekal percuma — menentang enjin mahupun orang, tanpa had dan tanpa iklan. Yang dibuka oleh Pro ialah latihan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelen blijft gratis — tegen de engine en tegen mensen, zonder limiet en zonder advertenties. Wat Pro ontgrendelt, is de training."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Å spille forblir gratis — mot motoren og mot mennesker, uten grense og uten reklame. Det Pro låser opp, er treningen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gra pozostaje darmowa — z silnikiem i z ludźmi, bez limitu i bez reklam. Pro odblokowuje trening."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogar continua de graça — contra o motor e contra pessoas, sem limite e sem anúncios. O que o Pro desbloqueia é o treino."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Jocul rămâne gratuit — și cu motorul, și cu oameni, fără limită și fără reclame. Ce deblochează Pro este antrenamentul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игра остаётся бесплатной — и с движком, и с людьми, без ограничений и без рекламы. Pro открывает тренировки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att spela förblir gratis — mot motorn och mot människor, utan gräns och utan reklam. Det Pro låser upp är träningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเล่นยังฟรี — ทั้งกับเอนจินและกับคน ไม่จำกัดและไม่มีโฆษณา สิ่งที่ Pro ปลดล็อกคือการฝึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynamak ücretsiz kalır — motora karşı da insana karşı da, sınırsız ve reklamsız. Pro'nun açtığı şey antrenman."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chơi cờ vẫn miễn phí — với máy hay với người, không giới hạn và không quảng cáo. Pro mở khóa phần luyện tập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对弈始终免费——无论对手是引擎还是真人，不限次数，也没有广告。Pro 解锁的是训练。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對弈始終免費——不論對手是引擎還是真人，不限次數，也沒有廣告。Pro 解鎖的是訓練。"
          }
        }
      }
    },
