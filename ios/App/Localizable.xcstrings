        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane nie trafiły do pakietu aplikacji. Sprawdź, czy data/%@ jest w zasobach celu Xcode."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados não entraram no pacote do aplicativo. Verifique se data/%@ está nos recursos do target do Xcode."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados não entraram no pacote do aplicativo. Verifique se data/%@ está nos recursos do target do Xcode."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados não foram incluídos no pacote da app. Verifique se data/%@ está listado nos recursos do target no Xcode."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele nu au ajuns în pachetul aplicației. Verifică dacă data/%@ apare în resursele țintei Xcode."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные не попали в пакет приложения. Проверьте, что data/%@ указан в ресурсах цели Xcode."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dáta sa nedostali do balíka aplikácie. Skontrolujte, či je data/%@ uvedené v zdrojoch cieľa Xcode."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podatki niso bili vključeni v paket aplikacije. Preverite, ali je data/%@ naveden med viri cilja Xcode."
          }
        },
        "sl-SI": {
          "stringUnit": {
            "state": "translated",
            "value": "Podatki niso bili vključeni v paket aplikacije. Preverite, ali je data/%@ naveden med viri cilja Xcode."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Data kom inte med i appaketet. Kontrollera att data/%@ finns bland resurserna för Xcode-målet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தரவு app bundle-இல் சேரவில்லை. Xcode target-இன் resources-இல் data/%@ பட்டியலிடப்பட்டுள்ளதா என்று சரிபார்க்கவும்."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "தரவு app bundle-இல் சேரவில்லை. Xcode target-இன் resources-இல் data/%@ பட்டியலிடப்பட்டுள்ளதா என்று சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "డేటా యాప్ బండిల్‌లోకి చేరలేదు. Xcode టార్గెట్ resources లో data/%@ జాబితా చేయబడి ఉందో చూసుకోండి."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "డేటా యాప్ బండిల్‌లోకి చేరలేదు. Xcode టార్గెట్ resources లో data/%@ జాబితా చేయబడి ఉందో చూసుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลไม่ได้ถูกรวมเข้าไปในแอป ตรวจสอบว่า data/%@ อยู่ในทรัพยากรของ target ใน Xcode"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veriler uygulama paketine girmemiş. data/%@ dosyasının Xcode hedefinin kaynaklarında olduğunu kontrol et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані не потрапили до пакета застосунку. Перевірте, чи data/%@ додано до ресурсів цілі в Xcode."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈیٹا app bundle میں شامل نہیں ہوا۔ چیک کریں کہ data/%@ Xcode target کے resources میں درج ہے۔"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈیٹا app bundle میں شامل نہیں ہوا۔ چیک کریں کہ data/%@ Xcode target کے resources میں درج ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu không được đóng gói vào ứng dụng. Kiểm tra xem data/%@ có trong tài nguyên của target Xcode không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据没有打包进应用。请检查 data/%@ 是否列在 Xcode target 的资源里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料沒有打包進 App。請檢查 data/%@ 是否列在 Xcode target 的資源中。"
          }
        }
      }
