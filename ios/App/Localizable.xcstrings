    "endgame.afterThatMove": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد تلك النقلة %@. تابع إن شئت، أو ابدأ من جديد وجرّب الخطة الصحيحة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po tomto tahu %@. Můžeš hrát dál, nebo začít znovu a zkusit správný plán."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter det træk %@. Spil videre hvis du vil, eller start forfra og prøv den rigtige plan."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach diesem Zug %@. Spiel ruhig weiter oder starte neu und versuche den richtigen Plan."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετά από αυτή την κίνηση %@. Συνέχισε αν θέλεις, ή ξεκίνα από την αρχή και δοκίμασε το σωστό σχέδιο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After that move %@. Play on if you like, or restart and try the correct plan."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "After that move %@. Play on if you like, or restart and try the correct plan."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "After that move %@. Play on if you like, or restart and try the correct plan."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de esa jugada %@. Sigue jugando si quieres, o reinicia e intenta el plan correcto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuon siirron jälkeen %@. Voit jatkaa, tai aloittaa alusta ja kokeilla oikeaa suunnitelmaa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Après ce coup %@. Continuez si vous voulez, ou recommencez et essayez le bon plan."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Après ce coup %@. Continuez si vous voulez, ou recommencez et essayez le bon plan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחרי המהלך הזה %@. אפשר להמשיך לשחק, או להתחיל מחדש ולנסות את התוכנית הנכונה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस चाल के बाद %@। चाहें तो खेलते रहें, या फिर से शुरू करके सही योजना आज़माएँ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "E lépés után %@. Játszhatsz tovább, vagy kezdd elölről, és próbáld a helyes tervet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah langkah itu %@. Silakan lanjut, atau ulang dari awal dan coba rencana yang benar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo quella mossa %@. Continua pure, oppure ricomincia e prova il piano giusto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その手のあと、%@。そのまま続けても、最初からやり直して正しい方針を試しても構いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 수 이후 %@. 계속 두어도 되고, 처음부터 다시 시작해 올바른 계획을 시도해도 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selepas langkah itu %@. Teruskan jika mahu, atau mula semula dan cuba rancangan yang betul."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Na die zet %@. Speel gerust door, of begin opnieuw en probeer het juiste plan."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Etter det trekket %@. Spill videre om du vil, eller start på nytt og prøv riktig plan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po tym posunięciu %@. Możesz grać dalej albo zacząć od nowa i spróbować właściwego planu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois desse lance %@. Continue se quiser, ou recomece e tente o plano certo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După acea mutare %@. Poți continua, sau o iei de la capăt și încerci planul corect."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После этого хода %@. Можете играть дальше или начать заново и попробовать верный план."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter det draget %@. Spela vidare om du vill, eller börja om och pröva rätt plan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังจากตานั้น %@ จะเล่นต่อก็ได้ หรือเริ่มใหม่แล้วลองแผนที่ถูกต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hamleden sonra %@. İstersen devam et, ya da baştan başlayıp doğru planı dene."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau nước đó %@. Bạn có thể chơi tiếp, hoặc bắt đầu lại và thử phương án đúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
