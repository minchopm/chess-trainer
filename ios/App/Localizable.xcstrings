        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अखरोट वाले सेट के साथ उसका अपना बोर्ड भी आता है: मेज़ पर रखी फ्रेम लगी मेपल की बिसात, एक लैंप के नीचे।"
          }
        },
        "hr": {
          "stringUnit": {
