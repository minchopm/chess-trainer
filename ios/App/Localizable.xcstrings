    "online.clockExplanation": {
      "extractionState": "manual",
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Je %@ — %@. Du wirst nur mit Spielern zusammengebracht, die dieselbe Bedenkzeit gewählt haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ each — %@. You are only paired with players who chose the same clock."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ each — %@. You are only paired with players who chose the same clock."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ each — %@. You are only paired with players who chose the same clock."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ para cada uno — %@. Solo te emparejamos con jugadores que eligieron el mismo reloj."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chacun — %@. Vous n'êtes apparié qu'avec des joueurs ayant choisi la même cadence."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chacun — %@. Vous n'êtes apparié qu'avec des joueurs ayant choisi la même cadence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a testa — %@. Vieni abbinato solo a giocatori che hanno scelto la stessa cadenza."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ elk — %@. Je wordt alleen gekoppeld aan spelers die hetzelfde tempo kozen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po %@ — %@. Dobieramy cię tylko z graczami, którzy wybrali to samo tempo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ para cada um — %@. Você só é pareado com quem escolheu o mesmo ritmo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
