        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O conjunto de nogueira vem com seu próprio tabuleiro: um tabuleiro de bordo com moldura, sobre uma mesa, sob uma luminária."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conjunto de nogueira vem com seu próprio tabuleiro: um tabuleiro de bordo com moldura, sobre uma mesa, sob uma luminária."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O conjunto em nogueira traz o seu próprio tabuleiro: um tabuleiro em ácer emoldurado sobre uma mesa, sob uma lâmpada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setul de nuc vine cu propria lui tablă: o tablă din arțar, încadrată, pe o masă, sub o lampă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Набор из ореха идёт со своей доской: обрамлённая клёновая доска на столе, под лампой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Orechová súprava má vlastnú šachovnicu: rámovanú javorovú šachovnicu na stole pod lampou."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Orehov komplet ima svojo desko: uokvirjeno javorjevo desko na mizi, pod svetilko."
          }
        },
        "sl-SI": {
          "stringUnit": {
            "state": "translated",
            "value": "Orehov komplet ima svojo desko: uokvirjeno javorjevo desko na mizi, pod svetilko."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valnötssatsen levereras med ett eget bräde: ett ramat lönnbräde på ett bord, under en lampa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வால்நட் செட் தனது சொந்த பலகையுடன் வருகிறது: மேசையில் விளக்கின் கீழ் இருக்கும் சட்டகமிட்ட மேபிள் பலகை."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "வால்நட் செட் தனது சொந்த பலகையுடன் வருகிறது: மேசையில் விளக்கின் கீழ் இருக்கும் சட்டகமிட்ட மேபிள் பலகை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వాల్‌నట్ సెట్‌కు దాని స్వంత బోర్డు ఉంది: టేబుల్‌పై దీపం కింద ఉన్న ఫ్రేమ్ చేసిన మేపుల్ బోర్డు."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "వాల్‌నట్ సెట్‌కు దాని స్వంత బోర్డు ఉంది: టేబుల్‌పై దీపం కింద ఉన్న ఫ్రేమ్ చేసిన మేపుల్ బోర్డు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชุดวอลนัตมาพร้อมกระดานของตัวเอง: กระดานเมเปิลมีกรอบวางบนโต๊ะ ใต้โคมไฟ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceviz seti kendi tahtasıyla gelir: masanın üzerinde, bir lambanın altında çerçeveli bir akçaağaç tahta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комплект із горіхового дерева постачається з власною дошкою: обрамлена кленова дошка на столі, під лампою."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اخروٹ سیٹ کے ساتھ اپنا بورڈ بھی آتا ہے: میز پر فریم والا میپل بورڈ، چراغ کے نیچے۔"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "اخروٹ سیٹ کے ساتھ اپنا بورڈ بھی آتا ہے: میز پر فریم والا میپل بورڈ، چراغ کے نیچے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ cẩm lai đi kèm bàn cờ riêng: một bàn cờ gỗ thích có khung, đặt trên bàn dưới đèn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "胡桃木套装自带棋盘：一块桌上的带框枫木棋盘，下面还有一盏灯。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "胡桃木組合還附有自己的棋盤：一塊帶框的楓木棋盤，放在桌上、燈下。"
          }
        }
      }
    },
