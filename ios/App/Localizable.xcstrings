    "online.aRealOpponentOverGame": {
      "extractionState": "manual",
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein echter Gegner über Game Center, mit Uhr. Keine Tipps, keine Engine, keine Zugrücknahme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A real opponent over Game Center, on the clock. No hints, no engine, no take-backs."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "A real opponent over Game Center, on the clock. No hints, no engine, no take-backs."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A real opponent over Game Center, on the clock. No hints, no engine, no take-backs."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rival de verdad a través de Game Center, con reloj. Sin pistas, sin motor, sin deshacer jugadas."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vrai adversaire via Game Center, à la pendule. Pas d'indice, pas de moteur, pas de retour en arrière."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vrai adversaire via Game Center, à la pendule. Pas d'indice, pas de moteur, pas de retour en arrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un avversario vero tramite Game Center, con l'orologio. Nessun suggerimento, nessun motore, nessuna mossa ritirata."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Een echte tegenstander via Game Center, met klok. Geen hints, geen engine, geen zetten terugnemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żywy przeciwnik przez Game Center, z zegarem. Bez podpowiedzi, bez silnika, bez cofania posunięć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um adversário de verdade pelo Game Center, no relógio. Sem dicas, sem motor, sem voltar lances."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Живой соперник через Game Center, с часами. Без подсказок, без движка, без взятия ходов назад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center üzerinden gerçek bir rakip, saatle. İpucu yok, motor yok, hamle geri alma yok."
