    "about.itIncludesStockfishWhichIs": {
      "extractionState": "manual",
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App enthält Stockfish, das unter der GPLv3 steht. Weil Stockfish in die App eingebunden ist, gilt dieselbe Lizenz für die gesamte Anwendung — und ihr vollständiger Quelltext ist veröffentlicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It includes Stockfish, which is GPLv3. Because Stockfish is linked into the app, the whole application carries the same licence — and its complete source is published."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "It includes Stockfish, which is GPLv3. Because Stockfish is linked into the app, the whole application carries the same licence — and its complete source is published."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "It includes Stockfish, which is GPLv3. Because Stockfish is linked into the app, the whole application carries the same licence — and its complete source is published."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye Stockfish, que está bajo la GPLv3. Como Stockfish está enlazado en la aplicación, toda la aplicación lleva la misma licencia, y su código fuente completo está publicado."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application inclut Stockfish, publié sous GPLv3. Comme Stockfish y est lié, toute l'application porte la même licence — et son code source complet est publié."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application inclut Stockfish, publié sous GPLv3. Comme Stockfish y est lié, toute l'application porte la même licence — et son code source complet est publié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Include Stockfish, distribuito con licenza GPLv3. Poiché Stockfish è collegato all'app, l'intera applicazione porta la stessa licenza — e il suo codice sorgente completo è pubblicato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui o Stockfish, que é GPLv3. Como o Stockfish está ligado ao aplicativo, todo o aplicativo carrega a mesma licença — e o código-fonte completo está publicado."
          }
        }
      }
    },
