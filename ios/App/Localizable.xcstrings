        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या प्रत्येकाचे स्वतंत्रपणे गुणांकन होते. घड्याळ सुरू असताना सोडवणे ही दुपारभर वेळ घेऊन सोडवण्यापेक्षा वेगळी कौशल्याची गोष्ट आहे, आणि तुम्ही निवडलेल्या ताकदीच्या बॉटला हरवणे ही आणखी वेगळी मोजपट्टी आहे."
          }
        },
        "mr-IN": {
