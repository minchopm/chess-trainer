    "board.stoppedAt": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت قراءة %lld نقلة، ثم توقفت عند «%@»."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت قراءة %lld نقلة، ثم توقفت عند «%@»."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочетени са %1$lld хода, после спря на „%2$@“."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld চাল পড়া হয়েছে, তারপর “%2$@”-এ থেমে গেছে।"
