    "progress.puzzleRatingsRunAFew": {
      "extractionState": "manual",
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgabenwertungen liegen einige hundert Punkte über Turnierwertungen — nimm sie als Maß für deinen eigenen Fortschritt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Puzzle ratings run a few hundred points above over-the-board ratings — treat them as a measure of progress against yourself."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Puzzle ratings run a few hundred points above over-the-board ratings — treat them as a measure of progress against yourself."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Puzzle ratings run a few hundred points above over-the-board ratings — treat them as a measure of progress against yourself."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las valoraciones de los ejercicios están unos cientos de puntos por encima de las de torneo: tómalas como medida de tu propio progreso."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les classements de problèmes se situent quelques centaines de points au-dessus des classements de tournoi — prenez-les comme une mesure de votre propre progression."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les classements de problèmes se situent quelques centaines de points au-dessus des classements de tournoi — prenez-les comme une mesure de votre propre progression."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I punteggi degli esercizi stanno qualche centinaio di punti sopra quelli da torneo: prendili come misura dei tuoi progressi."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Puzzelratings liggen een paar honderd punten boven toernooiratings — zie ze als maat voor je eigen vooruitgang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rankingi zadań są o kilkaset punktów wyższe od turniejowych — traktuj je jako miarę własnych postępów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ratings de exercícios ficam algumas centenas de pontos acima dos de torneio — trate-os como medida do seu próprio progresso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рейтинг задач на несколько сотен очков выше турнирного — считайте его мерой собственного прогресса."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Problem puanları turnuva puanlarının birkaç yüz puan üstündedir — onları kendi ilerlemenin ölçüsü say."
          }
        }
      }
    },
