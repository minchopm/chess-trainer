        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस छवि से शतरंज की बिसात नहीं पढ़ी जा सकी। कोई स्पष्ट कोण आज़माएँ या कोनों को मैन्युअल रूप से समायोजित करें।"
