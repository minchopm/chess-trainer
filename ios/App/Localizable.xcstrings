            "state": "translated",
            "value": "Papan dijumpai. Seret pemegang jika ada penjuru yang tersasar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brett funnet. Dra et håndtak hvis et hjørne ikke sitter."
          }
        },
        "nl": {
