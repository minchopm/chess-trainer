        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңғақ жинағына өз тақтасы да кіреді: үстел үстіндегі рамаға салынған үйеңкі тақта, шамның астында."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಾಲ್ನಟ್ ಸೆಟ್‌ ಜೊತೆಗೆ ತನ್ನದೇ ಬೋರ್ಡ್ ಬರುತ್ತದೆ: ಮೇಜಿನ ಮೇಲೆ ಚೌಕಟ್ಟಿನ ಮೇಪಲ್ ಬೋರ್ಡ್, ದೀಪದ ಕೆಳಗೆ."
