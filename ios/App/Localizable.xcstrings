            "value": "%1$@ ನಿಮ್ಮನ್ನು %2$@ ಆಟಕ್ಕೆ ಆಹ್ವಾನಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 님이 %2$@ 대국에 초대했습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ നിങ്ങളെ ഒരു %2$@ കളിയിലേക്ക് ക്ഷണിക്കുന്നു."
          }
