    "tactics.tryForcing": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "هنا نقلة أقوى. انظر أولًا إلى الخيارات الأكثر إجبارًا — الكشوف والأخذ والتهديدات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tu silnější tah. Podívej se nejdřív na nejforsírovanější možnosti — šachy, braní, hrozby."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er et stærkere træk her. Kig først på det mest tvingende — skak, slag, trusler."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier gibt es einen stärkeren Zug. Sieh dir zuerst die forcierenden Möglichkeiten an — Schachs, Schläge, Drohungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπάρχει ισχυρότερη κίνηση εδώ. Κοίτα πρώτα τις πιο βεβιασμένες επιλογές — σαχ, παρσίματα, απειλές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is a stronger move here. Look at the most forcing options first — checks, captures, threats."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "There is a stronger move here. Look at the most forcing options first — checks, captures, threats."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "There is a stronger move here. Look at the most forcing options first — checks, captures, threats."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí hay una jugada más fuerte. Mira primero lo más forzado: jaques, capturas, amenazas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täällä on vahvempi siirto. Katso ensin pakottavimmat vaihtoehdot — shakit, lyönnit, uhkaukset."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a plus fort ici. Regardez d'abord les coups les plus forçants — échecs, prises, menaces."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a plus fort ici. Regardez d'abord les coups les plus forçants — échecs, prises, menaces."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש כאן מהלך חזק יותר. הסתכל קודם על האפשרויות הכופות — שחים, אכילות, איומים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ इससे मज़बूत चाल है। पहले सबसे बाध्यकारी विकल्प देखिए — शह, कटाई, धमकियाँ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Van itt erősebb lépés. Először a legkényszerítőbbeket nézd — sakkok, ütések, fenyegetések."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada langkah yang lebih kuat di sini. Lihat dulu yang paling memaksa — sekak, tangkapan, ancaman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui c'è una mossa più forte. Guarda prima le opzioni più forzanti: scacchi, catture, minacce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにはもっと強い手があります。まず強制力のある手 — 王手、駒取り、脅し — から見てください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기 더 강한 수가 있습니다. 강제성이 큰 수부터 보세요 — 체크, 잡기, 위협."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada langkah lebih kuat di sini. Lihat dahulu yang paling memaksa — sekak, tangkapan, ancaman."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is hier een sterkere zet. Kijk eerst naar het meest forcerende — schaakjes, slagzetten, dreigingen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finnes et sterkere trekk her. Se først på det mest tvingende — sjakker, slag, trusler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jest tu silniejsze posunięcie. Najpierw sprawdź to, co wymusza — szachy, bicia, groźby."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui há um lance mais forte. Olhe primeiro o mais forçado — xeques, capturas, ameaças."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Există o mutare mai puternică aici. Uită-te întâi la cele mai forțate — șahuri, capturi, amenințări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь есть ход сильнее. Смотрите сначала самое форсированное — шахи, взятия, угрозы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns ett starkare drag här. Titta först på det mest forcerande — schackar, slag, hot."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรงนี้มีตาที่แรงกว่า ลองดูตาที่บังคับที่สุดก่อน — รุก กิน ขู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada daha güçlü bir hamle var. Önce en zorlayıcı seçeneklere bak — şahlar, almalar, tehditler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ở đây có nước mạnh hơn. Hãy xem trước những nước ép nhất — chiếu, ăn quân, đe dọa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里有更强的一步。先看最强制的选择 — 将军、吃子、威胁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡有更強的一步。先看最強制的選擇 — 將軍、吃子、威脅。"
          }
        }
      }
    },
