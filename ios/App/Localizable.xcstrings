          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待は保存されます。アプリを入れれば、そこで待っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대는 보관됩니다. 앱을 설치하면 그대로 기다리고 있습니다."
          }
        },
        "ms": {
