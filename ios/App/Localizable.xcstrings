    "rush.theClockIsStillGoing": {
      "extractionState": "manual",
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr läuft noch. Wer jetzt geht, beendet den Lauf und behält den bisherigen Punktestand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clock is still going. Leaving now ends the run and keeps the score so far."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The clock is still going. Leaving now ends the run and keeps the score so far."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The clock is still going. Leaving now ends the run and keeps the score so far."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El reloj sigue corriendo. Si sales ahora, la serie termina y se guarda la puntuación conseguida."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La pendule tourne encore. Partir maintenant arrête la série et garde le score acquis."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "La pendule tourne encore. Partir maintenant arrête la série et garde le score acquis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
