        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center-এ বাস্তব প্রতিপক্ষের বিরুদ্ধে, সময়সীমার মধ্যে খেলা। কোনো ইঙ্গিত নেই, কোনো ইঞ্জিন নেই, কোনো চাল ফেরত নেই।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
