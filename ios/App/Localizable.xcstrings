    "store.comeBackAtNine": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعاد الحصة كل يوم في الساعة 9 صباحًا بالتوقيت المحلي. اللعب — أمام المحرّك أو أمام شخص — بلا حدود ولا يحتاج شيئًا."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعاد الحصة كل يوم في الساعة 9 صباحًا بالتوقيت المحلي. اللعب — أمام المحرّك أو أمام شخص — بلا حدود ولا يحتاج شيئًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Безплатният лимит се нулира всеки ден в 9:00 ч. местно време. Играта — срещу двигателя или срещу човек — няма ограничение и не изисква нищо."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুমতি প্রতিদিন স্থানীয় সময় সকাল ৯:০০টায় আবার সেট হয়। খেলা — ইঞ্জিনের বিরুদ্ধে হোক বা মানুষের বিরুদ্ধে — এর কোনো সীমা নেই এবং এর জন্য কিছুই দরকার হয় না।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুমতি প্রতিদিন স্থানীয় সময় সকাল ৯:০০টায় আবার সেট হয়। খেলা — ইঞ্জিনের বিরুদ্ধে হোক বা মানুষের বিরুদ্ধে — এর কোনো সীমা নেই এবং এর জন্য কিছুই দরকার হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assignació es reinicia cada dia a les 9:00 del matí, hora local. Jugar — contra l’ordinador o contra una persona — no té límit i no cal res."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit se obnoví každý den v 9:00 místního času. Hraní — proti enginu i proti člověku — je bez omezení a zdarma."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvoten nulstilles hver dag kl. 9.00 lokal tid. At spille — mod motoren eller mod et menneske — er uden grænser og gratis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Kontingent wird jeden Tag um 9:00 Uhr Ortszeit zurückgesetzt. Spielen — gegen die Engine oder gegen einen Menschen — ist unbegrenzt und kostet nichts."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Kontingent wird jeden Tag um 9:00 Uhr Ortszeit zurückgesetzt. Spielen — gegen die Engine oder gegen einen Menschen — ist unbegrenzt und kostet nichts."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το όριο μηδενίζει κάθε μέρα στις 9:00 τοπική ώρα. Το παιχνίδι — με τη μηχανή ή με άνθρωπο — είναι απεριόριστο και δωρεάν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The allowance resets every day at 9:00 AM local time. Playing — against the engine or against a person — has no limit and needs nothing."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The allowance resets every day at 9:00 AM local time. Playing — against the engine or against a person — has no limit and needs nothing."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The allowance resets every day at 9:00 AM local time. Playing — against the engine or against a person — has no limit and needs nothing."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The allowance resets every day at 9:00 AM local time. Playing — against the engine or against a person — has no limit and needs nothing."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The allowance resets every day at 9:00 AM local time. Playing — against the engine or against a person — has no limit and needs nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cupo se reinicia cada día a las 9:00, hora local. Jugar —contra el motor o contra una persona— no tiene límite y no cuesta nada."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El cupo se reinicia cada día a las 9:00, hora local. Jugar —contra el motor o contra una persona— no tiene límite y no cuesta nada."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El cupo se restablece todos los días a las 9:00 a. m., hora local. Jugar —contra el motor o contra una persona— no tiene límite y no requiere nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiintiö nollautuu joka päivä klo 9.00 paikallista aikaa. Pelaaminen — moottoria tai ihmistä vastaan — on rajatonta ja ilmaista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quota repart chaque jour à 9 h, heure locale. Jouer — contre le moteur ou contre quelqu'un — reste illimité et gratuit."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quota repart chaque jour à 9 h, heure locale. Jouer — contre le moteur ou contre quelqu'un — reste illimité et gratuit."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quota repart chaque jour à 9 h, heure locale. Jouer — contre le moteur ou contre quelqu'un — reste illimité et gratuit."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મંજૂરી દરરોજ સ્થાનિક સમય મુજબ સવારે 9:00 વાગ્યે ફરી સેટ થાય છે. રમવાનું — એન્જિન સામે કે માણસ સામે — કોઈ મર્યાદા વિના છે અને તેમાં કશાની જરૂર નથી."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "મંજૂરી દરરોજ સ્થાનિક સમય મુજબ સવારે 9:00 વાગ્યે ફરી સેટ થાય છે. રમવાનું — એન્જિન સામે કે માણસ સામે — કોઈ મર્યાદા વિના છે અને તેમાં કશાની જરૂર નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המכסה מתאפסת בכל יום ב-9:00 לפי השעון המקומי. משחק — מול המנוע או מול אדם — הוא ללא הגבלה ובחינם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमा हर दिन स्थानीय समयानुसार सुबह 9 बजे फिर से शुरू होती है। खेलना — इंजन के साथ या किसी व्यक्ति के साथ — बिना सीमा और मुफ़्त है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnevna kvota resetira se svaki dan u 9:00 po lokalnom vremenu. Igranje — protiv računala ili protiv osobe — nema ograničenja i ne traži ništa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A keret minden nap 9:00-kor, helyi idő szerint nullázódik. A játék — a motor vagy egy ember ellen — korlátlan és ingyenes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatahnya direset setiap hari pukul 09.00 waktu setempat. Bermain — lawan mesin atau lawan orang — tanpa batas dan gratis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conteggio riparte ogni giorno alle 9:00, ora locale. Giocare — contro il motore o contro una persona — è senza limiti e non costa nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回数は毎日午前 9 時（現地時間）に戻ります。対局はエンジン相手でも人相手でも無制限、無料のままです。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимит күн сайын жергілікті уақыт бойынша таңғы 9:00-де жаңартылады. Ойнауға — қозғалтқышқа қарсы болсын, адамға қарсы болсын — шектеу жоқ, ештеңе қажет емес."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅನುಮತಿ ಪ್ರತಿದಿನ ಸ್ಥಳೀಯ ಸಮಯ ಬೆಳಿಗ್ಗೆ 9:00ಕ್ಕೆ ಮರುಹೊಂದಿಸುತ್ತದೆ. ಎಂಜಿನ್ ವಿರುದ್ಧವಾಗಲಿ ಅಥವಾ ವ್ಯಕ್ತಿಯ ವಿರುದ್ಧವಾಗಲಿ ಆಟಕ್ಕೆ ಮಿತಿ ಇಲ್ಲ, ಯಾವುದೂ ಅಗತ್ಯವಿಲ್ಲ."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅನುಮತಿ ಪ್ರತಿದಿನ ಸ್ಥಳೀಯ ಸಮಯ ಬೆಳಿಗ್ಗೆ 9:00ಕ್ಕೆ ಮರುಹೊಂದಿಸುತ್ತದೆ. ಎಂಜಿನ್ ವಿರುದ್ಧವಾಗಲಿ ಅಥವಾ ವ್ಯಕ್ತಿಯ ವಿರುದ್ಧವಾಗಲಿ ಆಟಕ್ಕೆ ಮಿತಿ ಇಲ್ಲ, ಯಾವುದೂ ಅಗತ್ಯವಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "횟수는 매일 현지 시간 오전 9시에 초기화됩니다. 대국은 엔진이든 사람이든 제한 없이 무료입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ദിനവ്യവസ്ഥ എല്ലാ ദിവസവും പ്രാദേശിക സമയം രാവിലെ 9:00-ന് പുനഃസജ്ജമാകും. എഞ്ചിനിനെതിരെയോ ഒരു വ്യക്തിക്കെതിരെയോ കളിക്കുന്നത് പരിധിയില്ലാത്തതാണ്, അതിന് ഒന്നും വേണ്ട."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ദിനവ്യവസ്ഥ എല്ലാ ദിവസവും പ്രാദേശിക സമയം രാവിലെ 9:00-ന് പുനഃസജ്ജമാകും. എഞ്ചിനിനെതിരെയോ ഒരു വ്യക്തിക്കെതിരെയോ കളിക്കുന്നത് പരിധിയില്ലാത്തതാണ്, അതിന് ഒന്നും വേണ്ട."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ही मर्यादा दररोज स्थानिक वेळेनुसार सकाळी 9:00 वाजता रीसेट होते. खेळणे — इंजिनविरुद्ध किंवा माणसाविरुद्ध — याला कोणतीही मर्यादा नाही आणि त्यासाठी काहीही लागत नाही."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ही मर्यादा दररोज स्थानिक वेळेनुसार सकाळी 9:00 वाजता रीसेट होते. खेळणे — इंजिनविरुद्ध किंवा माणसाविरुद्ध — याला कोणतीही मर्यादा नाही आणि त्यासाठी काहीही लागत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuota ditetapkan semula setiap hari pada pukul 9:00 pagi waktu tempatan. Bermain — menentang enjin atau menentang orang — tanpa had dan percuma."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvoten nullstilles hver dag kl. 09.00 lokal tid. Å spille — mot motoren eller mot et menneske — er uten grense og gratis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het tegoed gaat elke dag om 9:00 uur lokale tijd weer open. Spelen — tegen de engine of tegen iemand — is onbeperkt en gratis."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Het tegoed gaat elke dag om 9:00 uur lokale tijd weer open. Spelen — tegen de engine of tegen iemand — is onbeperkt en gratis."
