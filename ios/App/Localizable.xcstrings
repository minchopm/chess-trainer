            "value": "%@ פעם אחת. בלי מנוי, בלי חידוש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ सिर्फ़ एक बार। न सदस्यता, न नवीनीकरण।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ egyszer. Nincs előfizetés, nincs megújulás."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sekali saja. Tanpa langganan, tanpa perpanjangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ una volta sola. Nessun abbonamento, nessun rinnovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を一度だけ。サブスクリプションなし、更新なし。"
