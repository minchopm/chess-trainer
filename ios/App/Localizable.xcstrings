    "online.invitationClock": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ لكلٍّ منكما. ستُوصَل بهم مباشرةً لا إلى قائمة الانتظار العامة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pro každého. Budete spojeni přímo s nimi, ne s obecnou frontou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ til hver. Du bliver stillet direkte igennem til dem, ikke ud i den almindelige pulje."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Je %@. Sie werden direkt mit ihnen verbunden, nicht in den allgemeinen Pool gestellt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ο καθένας. Θα συνδεθείτε απευθείας μαζί τους, όχι με τη γενική δεξαμενή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ each. You will be put straight through to them rather than into the general pool."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ each. You will be put straight through to them rather than into the general pool."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ each. You will be put straight through to them rather than into the general pool."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cada uno. Se te conectará directamente con esa persona, no con la cola general."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kummallekin. Sinut yhdistetään suoraan heihin, ei yleiseen jonoon."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chacun. Vous serez mis en relation directement avec cette personne, pas avec la file générale."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chacun. Vous serez mis en relation directement avec cette personne, pas avec la file générale."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ לכל צד. תחוברו ישירות אליהם ולא לתור הכללי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक को %@। आपको सीधे उन्हीं से जोड़ा जाएगा, आम कतार से नहीं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fejenként %@. Közvetlenül vele kapcsolják össze, nem az általános sorba kerül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ masing-masing. Anda akan langsung disambungkan dengan mereka, bukan ke antrean umum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a testa. Sarai messo direttamente in contatto con loro, non nella coda generale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "持ち時間は各 %@。一般の待ち行列ではなく、その相手に直接つながります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각자 %@. 일반 대기열이 아니라 그 상대와 바로 연결됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ setiap seorang. Anda akan disambungkan terus kepada mereka, bukan ke barisan umum."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ elk. Je wordt rechtstreeks met hen verbonden, niet met de algemene wachtrij."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hver. Du blir koblet rett til dem, ikke til den vanlige køen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po %@ na gracza. Zostaniesz połączony(a) bezpośrednio z tą osobą, nie z ogólną kolejką."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ para cada um. Você será ligado diretamente a essa pessoa, não à fila geral."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Câte %@ fiecare. Vei fi conectat direct la ei, nu la coada generală."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По %@ каждому. Вас соединят напрямую с ним, а не с общей очередью."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ var. Du kopplas direkt till dem, inte till den allmänna kön."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฝ่ายละ %@ คุณจะถูกต่อตรงไปยังเขา ไม่ใช่คิวรวม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişi başı %@. Genel havuza değil, doğrudan ona bağlanacaksınız."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi bên %@. Bạn sẽ được nối thẳng tới họ, không phải hàng chờ chung."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每方 %@。你会直接与对方连上，而不是进入公共队列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每方 %@。你會直接與對方連上，而不是進入公共佇列。"
          }
        }
      }
    },
    "online.inviteExplanation": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسِل رابطًا. من يفتحه يمكنه لعب بعض التكتيكات فورًا، بالتطبيق أو بدونه، وتبقى الدعوة بانتظاره هنا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošlete odkaz. Kdo ho otevře, může si hned zahrát pár taktik — s aplikací i bez ní — a pozvánka na něj počká tady."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send et link. Den, der åbner det, kan spille et par taktikopgaver med det samme, med eller uden appen, og invitationen venter på dem her."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Schicken Sie einen Link. Wer ihn öffnet, kann sofort ein paar Taktikaufgaben spielen, mit oder ohne App, und die Einladung wartet hier auf ihn."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στείλτε έναν σύνδεσμο. Όποιος τον ανοίξει μπορεί να παίξει αμέσως μερικές τακτικές, με ή χωρίς την εφαρμογή, και η πρόσκληση τον περιμένει εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a link. Whoever opens it can play a few tactics straight away, with or without the app, and the invitation waits for them here."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a link. Whoever opens it can play a few tactics straight away, with or without the app, and the invitation waits for them here."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a link. Whoever opens it can play a few tactics straight away, with or without the app, and the invitation waits for them here."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía un enlace. Quien lo abra podrá jugar unas tácticas al momento, con o sin la app, y la invitación le esperará aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetä linkki. Sen avaaja voi pelata heti pari taktiikkatehtävää, sovelluksen kanssa tai ilman, ja kutsu odottaa häntä täällä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez un lien. Qui l’ouvre peut jouer quelques tactiques tout de suite, avec ou sans l’app, et l’invitation l’attend ici."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez un lien. Qui l’ouvre peut jouer quelques tactiques tout de suite, avec ou sans l’app, et l’invitation l’attend ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שלחו קישור. מי שיפתח אותו יוכל לפתור כמה תרגילים מיד, עם האפליקציה או בלעדיה, וההזמנה תחכה לו כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक लिंक भेजें। जो इसे खोलेगा वह तुरंत कुछ टैक्टिक्स खेल सकता है — ऐप के साथ या बिना — और आमंत्रण यहाँ उसकी प्रतीक्षा करेगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Küldjön egy linket. Aki megnyitja, azonnal játszhat néhány taktikát, apppal vagy anélkül, a meghívó pedig itt várja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirim tautan. Siapa pun yang membukanya bisa langsung memainkan beberapa taktik, dengan atau tanpa aplikasi, dan undangannya menunggu di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Manda un link. Chi lo apre può giocare subito qualche tattica, con o senza l’app, e l’invito lo aspetta qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクを送ります。開いた人はアプリの有無にかかわらずすぐに戦術問題を解け、招待はここで待っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크를 보내세요. 받은 사람은 앱이 없어도 바로 전술 몇 개를 풀 수 있고, 초대는 여기서 기다립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hantar pautan. Sesiapa yang membukanya boleh terus bermain beberapa taktik, dengan atau tanpa apl, dan jemputan menunggu mereka di sini."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuur een link. Wie hem opent, kan meteen een paar tactieken spelen, met of zonder de app, en de uitnodiging wacht hier op ze."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Send en lenke. Den som åpner den, kan spille et par taktikkoppgaver med en gang, med eller uten appen, og invitasjonen venter på dem her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyślij link. Kto go otworzy, od razu rozwiąże kilka taktyk — z aplikacją albo bez — a zaproszenie czeka na niego tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie um link. Quem o abrir pode jogar algumas táticas na hora, com ou sem o app, e o convite espera por essa pessoa aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimite un link. Cine îl deschide poate juca imediat câteva tactici, cu sau fără aplicație, iar invitația îl așteaptă aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправьте ссылку. Кто её откроет, сразу решит пару задач — с приложением или без, — а приглашение будет ждать его здесь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicka en länk. Den som öppnar den kan spela ett par taktikuppgifter direkt, med eller utan appen, och inbjudan väntar på dem här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งลิงก์ไป ใครเปิดก็เล่นโจทย์แทกติกได้ทันที ไม่ว่าจะมีแอปหรือไม่ และคำเชิญจะรออยู่ตรงนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bağlantı gönderin. Açan kişi uygulama olsun olmasın hemen birkaç taktik oynayabilir, davet de burada onu bekler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi một liên kết. Ai mở nó đều chơi được vài bài chiến thuật ngay, có hay không có ứng dụng, và lời mời sẽ đợi họ ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发一个链接。打开的人不论有没有装应用，都能立刻做几道战术题，邀请就在这里等着他。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發一個連結。打開的人不論有沒有裝應用程式，都能立刻做幾道戰術題，邀請就在這裡等著他。"
          }
        }
      }
    },
