    "store.restored": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت الاستعادة. التدريب مفتوح."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnoveno. Trénink je odemčený."
          }
        },
        "da": {
