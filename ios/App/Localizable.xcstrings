    "rush.solveAsManyAsYou": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "حُلَّ أكبر عدد ممكن قبل نفاد الوقت. تبدأ الألغاز سهلة ثم تصعب. ثلاثة إخفاقات تنهي الجولة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyřeš jich co nejvíc, než vyprší čas. Úlohy začínají lehce a přitvrzují. Tři chyby sérii ukončí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Løs så mange du kan, før tiden løber ud. Opgaverne starter let og bliver sværere. Tre fejl afslutter runden."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Löse so viele wie möglich, bevor die Zeit abläuft. Die Aufgaben beginnen leicht und werden schwerer. Drei Fehler beenden den Lauf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λύσε όσες προλάβεις πριν τελειώσει ο χρόνος. Ξεκινούν εύκολες και δυσκολεύουν. Τρεις αστοχίες τερματίζουν τον γύρο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solve as many as you can before the clock runs out. Puzzles start easy and get harder as you go. Three misses ends the run."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Solve as many as you can before the clock runs out. Puzzles start easy and get harder as you go. Three misses ends the run."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Solve as many as you can before the clock runs out. Puzzles start easy and get harder as you go. Three misses ends the run."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuelve todos los que puedas antes de que se acabe el tiempo. Empiezan fáciles y se van complicando. Tres fallos terminan la serie."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ratkaise niin monta kuin ehdit ennen kellon loppumista. Tehtävät alkavat helpoista ja vaikeutuvat. Kolme ohilyöntiä päättää kierroksen."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Résolvez-en le plus possible avant la fin du temps. Les problèmes commencent faciles et se corsent. Trois ratés arrêtent la série."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Résolvez-en le plus possible avant la fin du temps. Les problèmes commencent faciles et se corsent. Trois ratés arrêtent la série."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתור כמה שיותר לפני שהזמן נגמר. התרגילים מתחילים קלים ונעשים קשים יותר. שלושה פספוסים מסיימים את הסבב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय ख़त्म होने से पहले जितनी हो सकें उतनी हल कीजिए। पहेलियाँ आसान से शुरू होकर कठिन होती जाती हैं। तीन ग़लतियाँ दौर ख़त्म कर देती हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oldj meg annyit, amennyit bírsz, mielőtt lejár az idő. A feladványok könnyen kezdenek, majd nehezednek. Három hiba lezárja a kört."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pecahkan sebanyak mungkin sebelum waktu habis. Soal dimulai mudah lalu makin sulit. Tiga kesalahan mengakhiri sesi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risolvine più che puoi prima che scada il tempo. Si parte facili e si sale di difficoltà. Tre errori chiudono la serie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間切れまでにできるだけ多く解いてください。問題はやさしく始まり、次第に難しくなります。3回ミスすると終了です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간이 끝나기 전에 최대한 많이 푸세요. 문제는 쉽게 시작해 점점 어려워집니다. 세 번 틀리면 끝납니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan sebanyak mungkin sebelum masa tamat. Teka-teki bermula mudah dan makin sukar. Tiga kesilapan menamatkan pusingan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Los er zo veel mogelijk op voordat de klok afloopt. De puzzels beginnen makkelijk en worden lastiger. Bij drie missers stopt de ronde."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Løs så mange du rekker før tiden går ut. Oppgavene starter lett og blir vanskeligere. Tre bom avslutter runden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozwiąż tyle, ile zdążysz, zanim skończy się czas. Zadania zaczynają się łatwo i robią się trudniejsze. Trzy pomyłki kończą serię."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolva o máximo que conseguir antes de o tempo acabar. Os exercícios começam fáceis e vão ficando difíceis. Três erros encerram a série."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezolvă cât de multe poți până expiră timpul. Exercițiile încep ușor și se complică. Trei ratări încheie runda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Решите как можно больше, пока идут часы. Задачи начинаются с лёгких и усложняются. Три промаха завершают серию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lös så många du hinner innan tiden tar slut. Uppgifterna börjar lätt och blir svårare. Tre missar avslutar rundan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ให้ได้มากที่สุดก่อนหมดเวลา โจทย์เริ่มจากง่ายแล้วยากขึ้น ผิดสามครั้งจบรอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süre bitmeden elinden geldiğince çok problem çöz. Problemler kolay başlar ve zorlaşır. Üç hata turu bitirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giải càng nhiều càng tốt trước khi hết giờ. Bài bắt đầu dễ rồi khó dần. Ba lần sai là kết thúc lượt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在时间用完之前尽量多解。题目由易到难，错三次结束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在時間用完之前盡量多解。題目由易到難，錯三次結束。"
          }
        }
      }
    },
