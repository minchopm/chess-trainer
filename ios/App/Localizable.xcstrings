    "rush.solveAsManyAsYou": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُلَّ أكبر عدد ممكن قبل نفاد الوقت. تبدأ الألغاز سهلة ثم تصعب. ثلاثة إخفاقات تنهي الجولة."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "حُلَّ أكبر عدد ممكن قبل نفاد الوقت. تبدأ الألغاز سهلة ثم تصعب. ثلاثة إخفاقات تنهي الجولة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Решете колкото можете повече, преди времето да изтече. Пъзелите започват лесно и стават все по-трудни. Три пропуска прекратяват серията."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সময় ফুরোনোর আগেই যতগুলো পারেন সমাধান করুন। পাজলগুলো শুরুতে সহজ, এরপর ধীরে ধীরে কঠিন হবে। তিনটি ভুল হলে রান শেষ।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "সময় ফুরোনোর আগেই যতগুলো পারেন সমাধান করুন। পাজলগুলো শুরুতে সহজ, এরপর ধীরে ধীরে কঠিন হবে। তিনটি ভুল হলে রান শেষ।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Resol tantes com puguis abans que s’acabi el temps. Els problemes comencen fàcils i es van complicant. Tres errades i s’acaba la tirada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyřeš jich co nejvíc, než vyprší čas. Úlohy začínají lehce a přitvrzují. Tři chyby sérii ukončí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Løs så mange du kan, før tiden løber ud. Opgaverne starter let og bliver sværere. Tre fejl afslutter runden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löse so viele wie möglich, bevor die Zeit abläuft. Die Aufgaben beginnen leicht und werden schwerer. Drei Fehler beenden den Lauf."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Löse so viele wie möglich, bevor die Zeit abläuft. Die Aufgaben beginnen leicht und werden schwerer. Drei Fehler beenden den Lauf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λύσε όσες προλάβεις πριν τελειώσει ο χρόνος. Ξεκινούν εύκολες και δυσκολεύουν. Τρεις αστοχίες τερματίζουν τον γύρο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solve as many as you can before the clock runs out. Puzzles start easy and get harder as you go. Three misses ends the run."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Solve as many as you can before the clock runs out. Puzzles start easy and get harder as you go. Three misses ends the run."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Solve as many as you can before the clock runs out. Puzzles start easy and get harder as you go. Three misses ends the run."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Solve as many as you can before the clock runs out. Puzzles start easy and get harder as you go. Three misses ends the run."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Solve as many as you can before the clock runs out. Puzzles start easy and get harder as you go. Three misses ends the run."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuelve todos los que puedas antes de que se acabe el tiempo. Empiezan fáciles y se van complicando. Tres fallos terminan la serie."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuelve todos los que puedas antes de que se acabe el tiempo. Empiezan fáciles y se van complicando. Tres fallos terminan la serie."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuelve tantas como puedas antes de que se acabe el tiempo. Los problemas empiezan fáciles y se van poniendo más difíciles. Tres errores terminan la racha."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ratkaise niin monta kuin ehdit ennen kellon loppumista. Tehtävät alkavat helpoista ja vaikeutuvat. Kolme ohilyöntiä päättää kierroksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résolvez-en le plus possible avant la fin du temps. Les problèmes commencent faciles et se corsent. Trois ratés arrêtent la série."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Résolvez-en le plus possible avant la fin du temps. Les problèmes commencent faciles et se corsent. Trois ratés arrêtent la série."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Résolvez-en le plus possible avant la fin du temps. Les problèmes commencent faciles et se corsent. Trois ratés arrêtent la série."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઘડિયાળ પૂરી થાય એ પહેલાં જેટલા બની શકે તેટલા ઉકેલો. puzzles શરૂઆતમાં સરળ હોય છે અને આગળ વધતા મુશ્કેલ બનતા જાય છે. ત્રણ ભૂલો થતાં રન પૂરુ થઈ જાય છે."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ઘડિયાળ પૂરી થાય એ પહેલાં જેટલા બની શકે તેટલા ઉકેલો. puzzles શરૂઆતમાં સરળ હોય છે અને આગળ વધતા મુશ્કેલ બનતા જાય છે. ત્રણ ભૂલો થતાં રન પૂરુ થઈ જાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתור כמה שיותר לפני שהזמן נגמר. התרגילים מתחילים קלים ונעשים קשים יותר. שלושה פספוסים מסיימים את הסבב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय ख़त्म होने से पहले जितनी हो सकें उतनी हल कीजिए। पहेलियाँ आसान से शुरू होकर कठिन होती जाती हैं। तीन ग़लतियाँ दौर ख़त्म कर देती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Riješi ih što više prije nego što istekne vrijeme. Zagonetke počinju lagano i postaju sve teže. Tri promašaja završavaju niz."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oldj meg annyit, amennyit bírsz, mielőtt lejár az idő. A feladványok könnyen kezdenek, majd nehezednek. Három hiba lezárja a kört."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pecahkan sebanyak mungkin sebelum waktu habis. Soal dimulai mudah lalu makin sulit. Tiga kesalahan mengakhiri sesi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risolvine più che puoi prima che scada il tempo. Si parte facili e si sale di difficoltà. Tre errori chiudono la serie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間切れまでにできるだけ多く解いてください。問題はやさしく始まり、次第に難しくなります。3回ミスすると終了です。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уақыт бітпей тұрғанда мүмкін болғанша көп есепті шешіңіз. Есептер алдымен оңай болады да, барған сайын қиындай береді. Үш қате — аяқталды."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗಡಿಯಾರ ಮುಗಿಯುವ ಮೊದಲು ಸಾಧ್ಯವಾದಷ್ಟು ಹೆಚ್ಚು ಸಮಸ್ಯೆಗಳನ್ನು ಬಗೆಹರಿಸಿ. ಪಜಲ್‌ಗಳು ಸುಲಭವಾಗಿ ಆರಂಭವಾಗಿ ಕ್ರಮೇಣ ಕಷ್ಟವಾಗುತ್ತವೆ. ಮೂರು ತಪ್ಪುಗಳು ಓಟವನ್ನು ಮುಗಿಸುತ್ತವೆ."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗಡಿಯಾರ ಮುಗಿಯುವ ಮೊದಲು ಸಾಧ್ಯವಾದಷ್ಟು ಹೆಚ್ಚು ಸಮಸ್ಯೆಗಳನ್ನು ಬಗೆಹರಿಸಿ. ಪಜಲ್‌ಗಳು ಸುಲಭವಾಗಿ ಆರಂಭವಾಗಿ ಕ್ರಮೇಣ ಕಷ್ಟವಾಗುತ್ತವೆ. ಮೂರು ತಪ್ಪುಗಳು ಓಟವನ್ನು ಮುಗಿಸುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간이 끝나기 전에 최대한 많이 푸세요. 문제는 쉽게 시작해 점점 어려워집니다. 세 번 틀리면 끝납니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സമയം തീരുന്നതിന് മുമ്പ് കഴിയുന്നതും അധികം പരിഹരിക്കുക. പസിലുകൾ ആദ്യം എളുപ്പമായിരിക്കും; പോകുന്തോറും കഠിനമാകും. മൂന്നു തവണ പിഴച്ചാൽ റൺ അവസാനിക്കും."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "സമയം തീരുന്നതിന് മുമ്പ് കഴിയുന്നതും അധികം പരിഹരിക്കുക. പസിലുകൾ ആദ്യം എളുപ്പമായിരിക്കും; പോകുന്തോറും കഠിനമാകും. മൂന്നു തവണ പിഴച്ചാൽ റൺ അവസാനിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "घड्याळ संपेपर्यंत शक्य तितकी कोडी सोडवा. सुरुवातीला कोडी सोपी असतात आणि पुढे अधिक कठीण होत जातात. तीन चुका झाल्या की ही फेरी संपते."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "घड्याळ संपेपर्यंत शक्य तितकी कोडी सोडवा. सुरुवातीला कोडी सोपी असतात आणि पुढे अधिक कठीण होत जातात. तीन चुका झाल्या की ही फेरी संपते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan sebanyak mungkin sebelum masa tamat. Teka-teki bermula mudah dan makin sukar. Tiga kesilapan menamatkan pusingan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Løs så mange du rekker før tiden går ut. Oppgavene starter lett og blir vanskeligere. Tre bom avslutter runden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Los er zo veel mogelijk op voordat de klok afloopt. De puzzels beginnen makkelijk en worden lastiger. Bij drie missers stopt de ronde."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Los er zo veel mogelijk op voordat de klok afloopt. De puzzels beginnen makkelijk en worden lastiger. Bij drie missers stopt de ronde."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Løs så mange du rekker før tiden går ut. Oppgavene starter lett og blir vanskeligere. Tre bom avslutter runden."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଘଡ଼ି ସମୟ ସମାପ୍ତ ହେବା ପୂର୍ବରୁ ସମ୍ଭବ ଯେତେ ଟିକିଏ ସମାଧାନ କରନ୍ତୁ। ପଜଲ୍‌ଗୁଡ଼ିକ ସହଜରୁ ଆରମ୍ଭ ହୋଇ ପରେ କ୍ରମେ କଠିନ ହେବ। ତିନୋଟି ଭୁଲ୍ ହେଲେ ରନ୍ ଶେଷ।"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ଘଡ଼ି ସମୟ ସମାପ୍ତ ହେବା ପୂର୍ବରୁ ସମ୍ଭବ ଯେତେ ଟିକିଏ ସମାଧାନ କରନ୍ତୁ। ପଜଲ୍‌ଗୁଡ଼ିକ ସହଜରୁ ଆରମ୍ଭ ହୋଇ ପରେ କ୍ରମେ କଠିନ ହେବ। ତିନୋଟି ଭୁଲ୍ ହେଲେ ରନ୍ ଶେଷ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਘੜੀ ਖਤਮ ਹੋਣ ਤੋਂ ਪਹਿਲਾਂ ਜਿੰਨੇ ਹੋ ਸਕਣ ਉਨ੍ਹਾਂ ਨੂੰ ਹੱਲ ਕਰੋ। ਪਹੇਲੀਆਂ ਆਸਾਨੀ ਨਾਲ ਸ਼ੁਰੂ ਹੁੰਦੀਆਂ ਹਨ ਅਤੇ ਅੱਗੇ ਚਲ ਕੇ ਔਖੀਆਂ ਹੋ ਜਾਂਦੀਆਂ ਹਨ। ਤਿੰਨ ਗਲਤੀਆਂ ਨਾਲ ਦੌੜ ਖਤਮ ਹੋ ਜਾਂਦੀ ਹੈ।"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਘੜੀ ਖਤਮ ਹੋਣ ਤੋਂ ਪਹਿਲਾਂ ਜਿੰਨੇ ਹੋ ਸਕਣ ਉਨ੍ਹਾਂ ਨੂੰ ਹੱਲ ਕਰੋ। ਪਹੇਲੀਆਂ ਆਸਾਨੀ ਨਾਲ ਸ਼ੁਰੂ ਹੁੰਦੀਆਂ ਹਨ ਅਤੇ ਅੱਗੇ ਚਲ ਕੇ ਔਖੀਆਂ ਹੋ ਜਾਂਦੀਆਂ ਹਨ। ਤਿੰਨ ਗਲਤੀਆਂ ਨਾਲ ਦੌੜ ਖਤਮ ਹੋ ਜਾਂਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozwiąż tyle, ile zdążysz, zanim skończy się czas. Zadania zaczynają się łatwo i robią się trudniejsze. Trzy pomyłki kończą serię."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolva o máximo que conseguir antes de o tempo acabar. Os exercícios começam fáceis e vão ficando difíceis. Três erros encerram a série."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolva o máximo que conseguir antes de o tempo acabar. Os exercícios começam fáceis e vão ficando difíceis. Três erros encerram a série."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolva tantas quanto conseguir antes que o relógio acabe. Os problemas começam fáceis e vão ficando mais difíceis. Três falhas terminam a série."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezolvă cât de multe poți până expiră timpul. Exercițiile încep ușor și se complică. Trei ratări încheie runda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Решите как можно больше, пока идут часы. Задачи начинаются с лёгких и усложняются. Три промаха завершают серию."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyriešte čo najviac úloh, kým vyprší čas. Úlohy začínajú ľahko a postupne sa zhoršujú. Po troch chybných pokusoch sa séria končí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reši jih čim več, preden poteče čas. Uganke se začnejo enostavno in postajajo vse težje. Po treh napakah je konec teka."
          }
        },
        "sl-SI": {
          "stringUnit": {
            "state": "translated",
            "value": "Reši jih čim več, preden poteče čas. Uganke se začnejo enostavno in postajajo vse težje. Po treh napakah je konec teka."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lös så många du hinner innan tiden tar slut. Uppgifterna börjar lätt och blir svårare. Tre missar avslutar rundan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடிகாரம் முடிவதற்குள் முடிந்த அளவு பிரச்சினைகளைத் தீர்க்கவும். புதிர்கள் எளிதாகத் தொடங்கி, செல்லச் செல்ல கடினமாகும். மூன்று தவறுகள் வந்தால் ஓட்டம் முடியும்."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "கடிகாரம் முடிவதற்குள் முடிந்த அளவு பிரச்சினைகளைத் தீர்க்கவும். புதிர்கள் எளிதாகத் தொடங்கி, செல்லச் செல்ல கடினமாகும். மூன்று தவறுகள் வந்தால் ஓட்டம் முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గడియారం ఆగేలోపు మీరు ఎన్ని సాధ్యమో అంత పరిష్కరించండి. పజిల్స్ సులభంగా మొదలై, మీరు ముందుకు సాగేకొద్దీ కష్టమవుతాయి. మూడు తప్పులు అయితే పరుగెత్తడం ముగుస్తుంది."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "గడియారం ఆగేలోపు మీరు ఎన్ని సాధ్యమో అంత పరిష్కరించండి. పజిల్స్ సులభంగా మొదలై, మీరు ముందుకు సాగేకొద్దీ కష్టమవుతాయి. మూడు తప్పులు అయితే పరుగెత్తడం ముగుస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ให้ได้มากที่สุดก่อนหมดเวลา โจทย์เริ่มจากง่ายแล้วยากขึ้น ผิดสามครั้งจบรอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süre bitmeden elinden geldiğince çok problem çöz. Problemler kolay başlar ve zorlaşır. Üç hata turu bitirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розв'яжіть якнайбільше до завершення часу. Завдання починаються легкими й поступово ускладнюються. Після трьох помилок серія завершується."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جتنے زیادہ ہو سکیں حل کریں، اس سے پہلے کہ گھڑی ختم ہو جائے۔ puzzles شروع میں آسان ہوتے ہیں اور آگے چل کر مشکل ہو جاتے ہیں۔ تین غلطیوں پر سلسلہ ختم ہو جاتا ہے۔"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "جتنے زیادہ ہو سکیں حل کریں، اس سے پہلے کہ گھڑی ختم ہو جائے۔ puzzles شروع میں آسان ہوتے ہیں اور آگے چل کر مشکل ہو جاتے ہیں۔ تین غلطیوں پر سلسلہ ختم ہو جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giải càng nhiều càng tốt trước khi hết giờ. Bài bắt đầu dễ rồi khó dần. Ba lần sai là kết thúc lượt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在时间用完之前尽量多解。题目由易到难，错三次结束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在時間用完之前盡量多解。題目由易到難，錯三次結束。"
          }
        }
      }
    },
