    "board.importHint": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "FEN أو PGN أو النقلات فقط — 1.e4 e5 أو e2e4 e7e5. تُتجاهل التعليقات وأرقام النقلات والتنويعات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "FEN, PGN nebo jen tahy — 1.e4 e5 nebo e2e4 e7e5. Komentáře, čísla tahů a varianty se ignorují."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En FEN, en PGN eller bare trækkene — 1.e4 e5 eller e2e4 e7e5. Kommentarer, træknumre og varianter ignoreres."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine FEN, eine PGN oder einfach die Züge — 1.e4 e5 oder e2e4 e7e5. Kommentare, Zugnummern und Varianten werden ignoriert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα FEN, ένα PGN ή απλώς οι κινήσεις — 1.e4 e5 ή e2e4 e7e5. Σχόλια, αριθμοί κινήσεων και παραλλαγές αγνοούνται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A FEN, a PGN, or just the moves — 1.e4 e5 or e2e4 e7e5. Comments, move numbers and variations are ignored."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "A FEN, a PGN, or just the moves — 1.e4 e5 or e2e4 e7e5. Comments, move numbers and variations are ignored."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A FEN, a PGN, or just the moves — 1.e4 e5 or e2e4 e7e5. Comments, move numbers and variations are ignored."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Un FEN, un PGN o solo las jugadas — 1.e4 e5 o e2e4 e7e5. Se ignoran comentarios, números de jugada y variantes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "FEN, PGN tai pelkät siirrot — 1.e4 e5 tai e2e4 e7e5. Kommentit, siirtonumerot ja muunnelmat ohitetaan."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un FEN, un PGN ou juste les coups — 1.e4 e5 ou e2e4 e7e5. Les commentaires, numéros de coup et variantes sont ignorés."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Un FEN, un PGN ou juste les coups — 1.e4 e5 ou e2e4 e7e5. Les commentaires, numéros de coup et variantes sont ignorés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "FEN, PGN או רק המהלכים — 1.e4 e5 או e2e4 e7e5. הערות, מספרי מהלכים ווריאציות אינם נקראים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक FEN, एक PGN, या सिर्फ़ चालें — 1.e4 e5 या e2e4 e7e5। टिप्पणियाँ, चाल संख्याएँ और वैरिएशन अनदेखे रहते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy FEN, egy PGN vagy csak a lépések — 1.e4 e5 vagy e2e4 e7e5. A megjegyzéseket, lépésszámokat és változatokat figyelmen kívül hagyjuk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah FEN, PGN, atau langkahnya saja — 1.e4 e5 atau e2e4 e7e5. Komentar, nomor langkah, dan variasi diabaikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un FEN, un PGN o solo le mosse — 1.e4 e5 oppure e2e4 e7e5. Commenti, numeri di mossa e varianti vengono ignorati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FEN、PGN、または手順だけ — 1.e4 e5 や e2e4 e7e5。コメント・手数番号・変化手順は無視されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FEN, PGN, 또는 수순만 — 1.e4 e5 또는 e2e4 e7e5. 주석, 수 번호, 변화수는 무시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "FEN, PGN, atau langkahnya sahaja — 1.e4 e5 atau e2e4 e7e5. Komen, nombor langkah dan variasi diabaikan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Een FEN, een PGN of gewoon de zetten — 1.e4 e5 of e2e4 e7e5. Commentaar, zetnummers en varianten worden genegeerd."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "En FEN, en PGN eller bare trekkene — 1.e4 e5 eller e2e4 e7e5. Kommentarer, trekknumre og varianter ignoreres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "FEN, PGN albo same ruchy — 1.e4 e5 lub e2e4 e7e5. Komentarze, numery ruchów i warianty są pomijane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um FEN, um PGN ou apenas os lances — 1.e4 e5 ou e2e4 e7e5. Comentários, números de lance e variantes são ignorados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un FEN, un PGN sau doar mutările — 1.e4 e5 sau e2e4 e7e5. Comentariile, numerele mutărilor și variantele sunt ignorate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "FEN, PGN или просто ходы — 1.e4 e5 либо e2e4 e7e5. Комментарии, номера ходов и варианты пропускаются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En FEN, en PGN eller bara dragen — 1.e4 e5 eller e2e4 e7e5. Kommentarer, dragnummer och varianter ignoreras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "FEN, PGN หรือแค่ลำดับหมาก — 1.e4 e5 หรือ e2e4 e7e5 ระบบจะข้ามคำอธิบาย เลขตา และแนวแปร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir FEN, bir PGN ya da sadece hamleler — 1.e4 e5 veya e2e4 e7e5. Yorumlar, hamle numaraları ve varyantlar yok sayılır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một FEN, một PGN, hoặc chỉ các nước đi — 1.e4 e5 hoặc e2e4 e7e5. Chú thích, số nước và biến thể sẽ được bỏ qua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FEN、PGN，或只有着法 — 1.e4 e5 或 e2e4 e7e5。注释、回合数和变着都会被忽略。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "FEN、PGN，或只有著法 — 1.e4 e5 或 e2e4 e7e5。註解、回合數和變著都會被忽略。"
          }
        }
      }
    },
