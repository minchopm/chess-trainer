    "about.somethingWrongOrMissing": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "هل من خطأ أو نقص؟ هناك شخص على الطرف الآخر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Něco nefunguje nebo chybí? Na druhém konci je člověk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noget galt eller mangler der noget? Der sidder et menneske i den anden ende."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas falsch oder fehlt etwas? Am anderen Ende sitzt ein Mensch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάτι λάθος ή κάτι λείπει; Στην άλλη άκρη υπάρχει άνθρωπος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something wrong, or missing? There is somebody at the other end of this."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Something wrong, or missing? There is somebody at the other end of this."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Something wrong, or missing? There is somebody at the other end of this."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Algo va mal, o falta algo? Al otro lado hay alguien."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Onko jokin väärin tai puuttuuko jotain? Toisessa päässä on ihminen."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose ne va pas, ou manque? Il y a quelqu’un à l’autre bout."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose ne va pas, ou manque ? Il y a quelqu’un à l’autre bout."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משהו לא בסדר או חסר? יש מישהו בצד השני."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ ग़लत है, या कुछ छूट गया है? दूसरी ओर एक इंसान है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Valami hibás vagy hiányzik? A másik végén ember ül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada yang salah atau kurang? Ada orang di ujung sana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa non va, o manca? Dall’altra parte c’è qualcuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おかしいところ、足りないところがありますか。この先には人がいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘못되었거나 빠진 것이 있나요? 저쪽 끝에는 사람이 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada yang tidak kena atau tertinggal? Ada orang di hujung sana."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Iets fout, of ontbreekt er iets? Aan de andere kant zit een mens."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Noe galt, eller mangler noe? Det sitter et menneske i andre enden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś nie działa albo czegoś brakuje? Po drugiej stronie jest człowiek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo errado, ou faltando? Há alguém do outro lado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceva greșit sau lipsește? La celălalt capăt e cineva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то не так или чего-то не хватает? На том конце — человек."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Något fel, eller saknas något? Det sitter en människa i andra änden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีอะไรผิดพลาดหรือขาดหายไหม ปลายทางมีคนอยู่จริง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şey yanlış ya da eksik mi? Diğer uçta bir insan var."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có gì sai, hay còn thiếu? Đầu bên kia là một con người."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪里不对，或者少了什么？另一头有人在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "哪裡不對，或者少了什麼？另一頭有人在。"
          }
        }
      }
    },
    "about.tacticsPositionalJudgementEndgameTechnique": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تكتيك، وتقييم للأوضاع، وتقنية نهايات، ومباريات مع تدريب — ومحرّك المحرك يعمل على الجهاز نفسه. لا شيء يغادر الهاتف."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Taktika, poziční úsudek, koncovková technika a partie s koučem, se engineem běžícím přímo v zařízení. Nic neopouští telefon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Taktik, positionsvurdering, slutspilsteknik og partier med coaching, med motoren kørende på selve enheden. Intet forlader telefonen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Taktik, Stellungsbeurteilung, Endspieltechnik und begleitetes Spiel, mit der Engine direkt auf dem Gerät. Nichts verlässt das Telefon."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τακτική, κρίση θέσης, τεχνική φινάλε και παρτίδες με καθοδήγηση, με το η μηχανή να τρέχει πάνω στη συσκευή. Τίποτα δεν φεύγει από το τηλέφωνο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tactics, positional judgement, endgame technique and coached play, with the engine running on the device. Nothing leaves the phone."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tactics, positional judgement, endgame technique and coached play, with the engine running on the device. Nothing leaves the phone."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Tactics, positional judgement, endgame technique and coached play, with the engine running on the device. Nothing leaves the phone."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Táctica, criterio posicional, técnica de finales y partidas comentadas, con el motor funcionando en el dispositivo. Nada sale del teléfono."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taktiikkaa, aseman arviointia, loppupelitekniikkaa ja valmennettuja pelejä — moottori pyörii itse laitteessa. Mikään ei lähde puhelimesta."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tactique, jugement positionnel, technique de finale et parties commentées, avec le moteur qui tourne sur l'appareil. Rien ne quitte le téléphone."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tactique, jugement positionnel, technique de finale et parties commentées, avec le moteur qui tourne sur l'appareil. Rien ne quitte le téléphone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טקטיקה, שיפוט עמדתי, טכניקת סופים ומשחקים עם אימון — כאשר המנוע רץ על המכשיר עצמו. שום דבר לא יוצא מהטלפון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रणनीति, स्थिति का आकलन, अंत-खेल तकनीक और कोचिंग के साथ बाज़ियाँ — इंजन डिवाइस पर ही चलता है। कुछ भी फ़ोन से बाहर नहीं जाता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Taktika, állásértékelés, végjátéktechnika és edzővel kísért játszmák, a a motor pedig magán a készüléken fut. Semmi nem hagyja el a telefont."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Taktik, penilaian posisi, teknik akhir permainan, dan partai berpendamping, dengan mesin berjalan di perangkat itu sendiri. Tidak ada yang meninggalkan ponsel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tattica, giudizio posizionale, tecnica di finale e partite commentate, con il motore che gira sul dispositivo. Niente esce dal telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戦術、局面判断、終盤技術、そして解説つきの対局。エンジン は端末上で動作し、データが端末の外に出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전술, 포지션 판단, 엔드게임 기술, 그리고 코칭이 붙은 대국. 엔진이 기기 안에서 돌아가며, 어떤 데이터도 휴대폰을 떠나지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Taktik, penilaian kedudukan, teknik permainan akhir dan perlawanan berjurulatih, dengan enjin berjalan pada peranti itu sendiri. Tiada apa-apa meninggalkan telefon."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Tactiek, positioneel inzicht, eindspeltechniek en partijen met begeleiding, met de engine op het toestel zelf. Er verlaat niets de telefoon."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Taktikk, posisjonsvurdering, sluttspillteknikk og partier med coaching, med motoren som kjører på selve enheten. Ingenting forlater telefonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taktyka, ocena pozycji, technika końcówek i partie z komentarzem, ze silnikem działającym na urządzeniu. Nic nie opuszcza telefonu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tática, julgamento posicional, técnica de finais e partidas comentadas, com o o motor rodando no aparelho. Nada sai do telefone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tactică, judecată pozițională, tehnică de final și partide cu antrenor, cu motorul rulând chiar pe dispozitiv. Nimic nu părăsește telefonul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тактика, позиционная оценка, эндшпильная техника и партии с разбором — движок работает прямо на устройстве. Ничего не покидает телефон."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Taktik, positionsbedömning, slutspelsteknik och partier med coachning, med motorn igång på själva enheten. Ingenting lämnar telefonen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แทคติก การประเมินตำแหน่ง เทคนิคเกมท้าย และเกมที่มีโค้ช โดย เอนจิน ทำงานบนเครื่องเอง ไม่มีข้อมูลใดออกจากโทรศัพท์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taktik, konum değerlendirmesi, oyunsonu tekniği ve koçluk eşliğinde oyun; motor cihazın kendisinde çalışır. Hiçbir şey telefondan çıkmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiến thuật, đánh giá thế cờ, kỹ thuật tàn cuộc và các ván có huấn luyện viên, với engine chạy ngay trên máy. Không có gì rời khỏi điện thoại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "战术、局面判断、残局技术和带讲解的对局，引擎 直接在设备上运行。没有任何数据离开手机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "戰術、局面判斷、殘局技術與附講解的對局，引擎 直接在裝置上執行。沒有任何資料離開手機。"
          }
        }
      }
    },
    "about.theAppCollectsNothingSends": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يجمع التطبيق شيئًا، ولا يرسل شيئًا، ولا يجري أي اتصال بالشبكة. تصنيفاتك وسجلّك محفوظة على هذا الجهاز وحده، وتُحذف بحذف التطبيق."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace nic nesbírá, nic neodesílá a nedělá žádné síťové požadavky. Tvoje ratingy a historie zůstávají jen v tomto zařízení a smažou se spolu s aplikací."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen indsamler intet, sender intet og laver ingen netværkskald. Dine ratings og din historik ligger kun på denne enhed og slettes sammen med appen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App sammelt nichts, sendet nichts und stellt keine Netzwerkanfragen. Deine Wertungen und deine Historie liegen nur auf diesem Gerät; wer die App löscht, löscht sie mit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή δεν συλλέγει τίποτα, δεν στέλνει τίποτα και δεν κάνει αιτήματα δικτύου. Οι βαθμολογίες και το ιστορικό σου μένουν μόνο σε αυτή τη συσκευή και σβήνονται μαζί με την εφαρμογή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app collects nothing, sends nothing and makes no network requests. Your ratings and history are stored only on this device, and deleting the app deletes them."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The app collects nothing, sends nothing and makes no network requests. Your ratings and history are stored only on this device, and deleting the app deletes them."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The app collects nothing, sends nothing and makes no network requests. Your ratings and history are stored only on this device, and deleting the app deletes them."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación no recoge nada, no envía nada y no hace peticiones de red. Tus valoraciones y tu historial se guardan solo en este dispositivo, y se borran al borrar la aplicación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellus ei kerää mitään, ei lähetä mitään eikä tee verkkopyyntöjä. Ratingisi ja historiasi ovat vain tässä laitteessa ja katoavat sovelluksen mukana."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application ne collecte rien, n'envoie rien et ne fait aucune requête réseau. Vos classements et votre historique restent sur cet appareil, et disparaissent avec l'application."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application ne collecte rien, n'envoie rien et ne fait aucune requête réseau. Vos classements et votre historique restent sur cet appareil, et disparaissent avec l'application."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציה לא אוספת דבר, לא שולחת דבר ולא מבצעת פניות רשת. הדירוגים וההיסטוריה שלך נשמרים רק במכשיר הזה, ונמחקים יחד עם האפליקציה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप कुछ भी इकट्ठा नहीं करता, कुछ भी नहीं भेजता और कोई नेटवर्क अनुरोध नहीं करता। आपकी रेटिंग और इतिहास सिर्फ़ इसी डिवाइस पर रहते हैं और ऐप हटाने पर मिट जाते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alkalmazás semmit nem gyűjt, semmit nem küld, és nem indít hálózati kérést. Az értékszámaid és az előzményeid csak ezen a készüléken vannak, és a törléssel együtt tűnnek el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi tidak mengumpulkan apa pun, tidak mengirim apa pun, dan tidak melakukan permintaan jaringan. Rating dan riwayatmu hanya tersimpan di perangkat ini dan ikut terhapus bersama aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app non raccoglie nulla, non invia nulla e non fa richieste di rete. I tuoi punteggi e la tua cronologia restano solo su questo dispositivo e si cancellano con l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本アプリは何も収集せず、何も送信せず、ネットワーク通信も行いません。レーティングと履歴はこの端末にのみ保存され、アプリを削除すれば一緒に消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱은 아무것도 수집하지 않고, 아무것도 보내지 않으며, 네트워크 요청도 하지 않습니다. 레이팅과 기록은 이 기기에만 저장되고, 앱을 지우면 함께 사라집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi tidak mengumpul apa-apa, tidak menghantar apa-apa dan tidak membuat permintaan rangkaian. Rating dan sejarah anda hanya tersimpan pada peranti ini dan terpadam bersama aplikasi."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De app verzamelt niets, verstuurt niets en doet geen netwerkverzoeken. Je ratings en geschiedenis staan alleen op dit toestel en verdwijnen met de app."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen samler ikke inn noe, sender ingenting og gjør ingen nettverkskall. Ratingene og historikken din ligger bare på denne enheten og slettes sammen med appen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja niczego nie zbiera, niczego nie wysyła i nie łączy się z siecią. Twoje rankingi i historia są tylko na tym urządzeniu i znikają razem z aplikacją."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplicativo não coleta nada, não envia nada e não faz requisições de rede. Seus ratings e seu histórico ficam só neste aparelho, e somem junto com o aplicativo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația nu colectează nimic, nu trimite nimic și nu face cereri de rețea. Ratingurile și istoricul rămân doar pe acest dispozitiv și dispar odată cu aplicația."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение ничего не собирает, ничего не отправляет и не обращается к сети. Ваши рейтинги и история хранятся только на этом устройстве и удаляются вместе с приложением."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen samlar inte in något, skickar inget och gör inga nätverksanrop. Dina ratings och din historik finns bara på den här enheten och försvinner med appen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปไม่เก็บข้อมูลใด ไม่ส่งข้อมูลใด และไม่เรียกเครือข่าย เรตติ้งและประวัติของคุณอยู่บนเครื่องนี้เท่านั้น และจะหายไปพร้อมกับแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama hiçbir şey toplamaz, hiçbir şey göndermez ve ağ isteği yapmaz. Puanların ve geçmişin yalnızca bu cihazda durur; uygulamayı silmek onları da siler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng không thu thập gì, không gửi gì và không thực hiện yêu cầu mạng nào. Hệ số và lịch sử của bạn chỉ nằm trên máy này và sẽ mất khi gỡ ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用不收集任何数据，不发送任何数据，也不进行网络请求。你的等级分和记录只存在这台设备上，删除应用即一并删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 不蒐集任何資料、不傳送任何資料，也不進行網路連線。你的等級分與紀錄只存在這台裝置上，刪除 App 就一併刪除。"
          }
        }
      }
    },
