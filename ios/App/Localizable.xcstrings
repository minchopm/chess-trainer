    "progress.puzzleRatingsRunAFew": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصنيفات الألغاز أعلى بمئات النقاط من تصنيفات البطولات — اعتبرها مقياسًا لتقدّمك أنت."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تصنيفات الألغاز أعلى بمئات النقاط من تصنيفات البطولات — اعتبرها مقياسًا لتقدّمك أنت."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Рейтингите за задачи са с няколкостотин точки над рейтингите от класически партии — приемайте ги като мярка за напредъка ви спрямо самите себе си."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সমস্যার রেটিং বোর্ডের রেটিংয়ের তুলনায় কয়েকশো পয়েন্ট বেশি হয় — এগুলোকে নিজের সঙ্গে অগ্রগতির পরিমাপ হিসেবে ধরুন।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "সমস্যার রেটিং বোর্ডের রেটিংয়ের তুলনায় কয়েকশো পয়েন্ট বেশি হয় — এগুলোকে নিজের সঙ্গে অগ্রগতির পরিমাপ হিসেবে ধরুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La puntuació dels problemes sol estar uns quants centenars de punts per sobre de la puntuació sobre el tauler; pren-la com una mesura del teu progrés contra tu mateix."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ratingy úloh bývají o pár set bodů vyšší než turnajové — ber je jako měřítko vlastního pokroku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgaveratings ligger et par hundrede point over turneringsratings — brug dem som mål for din egen fremgang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgabenwertungen liegen einige hundert Punkte über Turnierwertungen — nimm sie als Maß für deinen eigenen Fortschritt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgabenwertungen liegen einige hundert Punkte über Turnierwertungen — nimm sie als Maß für deinen eigenen Fortschritt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
