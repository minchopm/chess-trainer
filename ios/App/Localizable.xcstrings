    "tactics.stillNotIt": {
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زالت غير صحيحة. خذ تلميحًا، أو اكشف الحل وادرس الفكرة."
