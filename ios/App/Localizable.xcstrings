    "progress.onlineRatingIsKeptApart": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ تصنيف الإنترنت منفصلًا عن تصنيفات التدريب: فهو يقيسك أمام أشخاص تلعب ضدهم، لا أمام مجموعة تمارين."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ تصنيف الإنترنت منفصلًا عن تصنيفات التدريب: فهو يقيسك أمام أشخاص تلعب ضدهم، لا أمام مجموعة تمارين."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Онлайн рейтингът се пази отделно от тренировъчните рейтинги: той ви оценява спрямо хората, с които играете, а не спрямо библиотека. Всеки часовник се оценява поотделно — три минути и тридесет секунди са различни партии."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনলাইন রেটিং প্রশিক্ষণ রেটিং থেকে আলাদা থাকে: এটি লাইব্রেরির সঙ্গে নয়, আপনি যাদের সঙ্গে খেলেন তাদের সঙ্গে আপনার তুলনা করে। প্রতিটি সময়সীমা আলাদাভাবে রেট করা হয় — তিন মিনিট আর ত্রিশ মিনিট আলাদা খেলা।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "অনলাইন রেটিং প্রশিক্ষণ রেটিং থেকে আলাদা থাকে: এটি লাইব্রেরির সঙ্গে নয়, আপনি যাদের সঙ্গে খেলেন তাদের সঙ্গে আপনার তুলনা করে। প্রতিটি সময়সীমা আলাদাভাবে রেট করা হয় — তিন মিনিট আর ত্রিশ মিনিট আলাদা খেলা।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La puntuació en línia es manté separada de les puntuacions d’entrenament: et mesura contra la gent amb qui jugues, no contra una biblioteca. Cada ritme de joc té la seva pròpia puntuació: tres minuts i trenta segons són partides diferents."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Online rating se vede odděleně od tréninkových: měří tě proti lidem, se kterými hraješ, ne proti sbírce úloh."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Onlineratingen holdes adskilt fra træningsratings: den måler dig mod de mennesker, du spiller mod, ikke mod en samling opgaver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Online-Wertung wird getrennt von den Trainingswertungen geführt: Sie misst dich an den Menschen, gegen die du spielst, nicht an einer Aufgabensammlung."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Online-Wertung wird getrennt von den Trainingswertungen geführt: Sie misst dich an den Menschen, gegen die du spielst, nicht an einer Aufgabensammlung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διαδικτυακή βαθμολογία κρατιέται χωριστά από τις προπονητικές: σε μετρά απέναντι σε ανθρώπους, όχι απέναντι σε μια συλλογή ασκήσεων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Online rating is kept apart from the training ratings: it measures you against the people you play, not against a library. Each clock is rated on its own — three minutes and thirty are different games."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Online rating is kept apart from the training ratings: it measures you against the people you play, not against a library. Each clock is rated on its own — three minutes and thirty are different games."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Online rating is kept apart from the training ratings: it measures you against the people you play, not against a library. Each clock is rated on its own — three minutes and thirty are different games."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Online rating is kept apart from the training ratings: it measures you against the people you play, not against a library. Each clock is rated on its own — three minutes and thirty are different games."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Online rating is kept apart from the training ratings: it measures you against the people you play, not against a library. Each clock is rated on its own — three minutes and thirty are different games."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La valoración en línea se mantiene aparte de las de entrenamiento: te mide frente a las personas con las que juegas, no frente a una colección."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La valoración en línea se mantiene aparte de las de entrenamiento: te mide frente a las personas con las que juegas, no frente a una colección."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El rating en línea se mantiene aparte de los ratings de entrenamiento: te mide contra la gente con la que juegas, no contra una biblioteca. Cada control de tiempo se califica por separado: tres minutos y treinta segundos son partidas distintas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkkorating pidetään erillään harjoitusratingeista: se mittaa sinua ihmisiä vastaan, ei tehtäväkokoelmaa vastaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le classement en ligne est tenu à part des classements d'entraînement : il vous mesure face aux joueurs que vous affrontez, pas face à une collection."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le classement en ligne est tenu à part des classements d'entraînement : il vous mesure face aux joueurs que vous affrontez, pas face à une collection."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le classement en ligne est tenu à part des classements d'entraînement : il vous mesure face aux joueurs que vous affrontez, pas face à une collection."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઓનલાઇન રેટિંગ તાલીમના રેટિંગથી અલગ રાખવામાં આવે છે: તે તમને તમે જેમની સાથે રમો છો તેમની સામે માપે છે, પુસ્તકાલય સામે નહીં. દરેક સમય-નિયંત્રણનું રેટિંગ અલગ હોય છે — ત્રણ મિનિટ અને ત્રીસ મિનિટ જુદી જુદી રમતો છે."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ઓનલાઇન રેટિંગ તાલીમના રેટિંગથી અલગ રાખવામાં આવે છે: તે તમને તમે જેમની સાથે રમો છો તેમની સામે માપે છે, પુસ્તકાલય સામે નહીં. દરેક સમય-નિયંત્રણનું રેટિંગ અલગ હોય છે — ત્રણ મિનિટ અને ત્રીસ મિનિટ જુદી જુદી રમતો છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדירוג המקוון נשמר בנפרד מדירוגי האימון: הוא מודד אותך מול אנשים שאתה משחק נגדם, לא מול אוסף תרגילים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑनलाइन रेटिंग अभ्यास रेटिंग से अलग रखी जाती है: यह आपको उन लोगों के मुक़ाबले आँकती है जिनसे आप खेलते हैं, किसी प्रश्न-संग्रह के मुक़ाबले नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Online rejting odvojen je od rejtinga za trening: mjeri te prema ljudima protiv kojih igraš, a ne prema biblioteci. Svaki je tempo zasebno rejtingiran — tri minute i trideset sekundi različite su partije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az online értékszám külön áll az edzésértékszámoktól: emberekhez mér, nem egy feladatgyűjteményhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rating daring dipisahkan dari rating latihan: ia mengukurmu terhadap orang yang kamu lawan, bukan terhadap kumpulan soal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il punteggio online è tenuto separato da quelli di allenamento: misura te contro le persone con cui giochi, non contro una raccolta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンラインのレーティングは練習用とは別に管理されます。問題集ではなく、対戦した相手に対するあなたの強さを測るものだからです。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Онлайн рейтинг жаттығу рейтингтерінен бөлек жүргізіледі: ол сіздің кітапханаға емес, ойнайтын адамдарыңызға қарсы деңгейіңізді өлшейді. Әр уақыт бақылауы өз алдына есептеледі — үш минут пен отыз минут — әртүрлі ойындар."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆನ್‌ಲೈನ್ ರೇಟಿಂಗ್ ತರಬೇತಿ ರೇಟಿಂಗ್‌ಗಳಿಂದ ಬೇರ್ಪಟ್ಟಿದೆ: ಇದು ನೀವು ಆಡಿದವರ ವಿರುದ್ಧ ನಿಮ್ಮ ಮಟ್ಟವನ್ನು ಅಳೆಯುತ್ತದೆ, ಲೈಬ್ರರಿಯ ವಿರುದ್ಧ ಅಲ್ಲ. ಪ್ರತಿ ಕ್ಲಾಕ್ ತನ್ನದೇ ಆದ ರೇಟಿಂಗ್ ಹೊಂದಿದೆ — ಮೂರು ನಿಮಿಷ ಮತ್ತು ಮೂರೂವತ್ತು ಬೇರೆ ಬೇರೆ ಆಟಗಳು."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆನ್‌ಲೈನ್ ರೇಟಿಂಗ್ ತರಬೇತಿ ರೇಟಿಂಗ್‌ಗಳಿಂದ ಬೇರ್ಪಟ್ಟಿದೆ: ಇದು ನೀವು ಆಡಿದವರ ವಿರುದ್ಧ ನಿಮ್ಮ ಮಟ್ಟವನ್ನು ಅಳೆಯುತ್ತದೆ, ಲೈಬ್ರರಿಯ ವಿರುದ್ಧ ಅಲ್ಲ. ಪ್ರತಿ ಕ್ಲಾಕ್ ತನ್ನದೇ ಆದ ರೇಟಿಂಗ್ ಹೊಂದಿದೆ — ಮೂರು ನಿಮಿಷ ಮತ್ತು ಮೂರೂವತ್ತು ಬೇರೆ ಬೇರೆ ಆಟಗಳು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온라인 레이팅은 훈련 레이팅과 따로 관리합니다. 문제집이 아니라 상대한 사람들을 기준으로 당신을 재기 때문입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓൺലൈൻ റേറ്റിംഗ് പരിശീലന റേറ്റിംഗുകളിൽ നിന്ന് വേറെയായാണ് സൂക്ഷിക്കുന്നത്: നിങ്ങൾ ലൈബ്രറിക്കെതിരെയല്ല, നിങ്ങൾ കളിക്കുന്ന ആളുകളെതിരെയാണ് ഇത് അളക്കുന്നത്. ഓരോ സമയനിയന്ത്രണത്തിനും വേറിട്ട റേറ്റിംഗ് ആണ് — മൂന്ന് മിനിറ്റും മുപ്പതും വ്യത്യസ്ത കളികളാണ്."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓൺലൈൻ റേറ്റിംഗ് പരിശീലന റേറ്റിംഗുകളിൽ നിന്ന് വേറെയായാണ് സൂക്ഷിക്കുന്നത്: നിങ്ങൾ ലൈബ്രറിക്കെതിരെയല്ല, നിങ്ങൾ കളിക്കുന്ന ആളുകളെതിരെയാണ് ഇത് അളക്കുന്നത്. ഓരോ സമയനിയന്ത്രണത്തിനും വേറിട്ട റേറ്റിംഗ് ആണ് — മൂന്ന് മിനിറ്റും മുപ്പതും വ്യത്യസ്ത കളികളാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑनलाइन रेटिंग प्रशिक्षण रेटिंगपासून वेगळी ठेवली जाते: ती तुम्ही खेळणाऱ्या लोकांशी तुमची तुलना करते, लायब्ररीशी नाही. प्रत्येक वेळ-नियंत्रण स्वतंत्रपणे रेट केले जाते — तीन मिनिटे आणि तीस मिनिटे हे वेगवेगळे सामने आहेत."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑनलाइन रेटिंग प्रशिक्षण रेटिंगपासून वेगळी ठेवली जाते: ती तुम्ही खेळणाऱ्या लोकांशी तुमची तुलना करते, लायब्ररीशी नाही. प्रत्येक वेळ-नियंत्रण स्वतंत्रपणे रेट केले जाते — तीन मिनिटे आणि तीस मिनिटे हे वेगवेगळे सामने आहेत."
          }
        },
        "ms": {
