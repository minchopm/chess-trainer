    "play.theEnginePlaysAtThe": {
      "extractionState": "manual",
      "localizations": {
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Engine spielt in der Stärke, die du wählst. Der Trainer bewertet jeden deiner Züge, während du spielst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine plays at the strength you choose. Coaching grades each of your moves as you make it."
          }
        },
