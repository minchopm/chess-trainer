    "tactics.tryForcing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هنا نقلة أقوى. انظر أولًا إلى الخيارات الأكثر إجبارًا — الكشوف والأخذ والتهديدات."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "هنا نقلة أقوى. انظر أولًا إلى الخيارات الأكثر إجبارًا — الكشوف والأخذ والتهديدات."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тук има по-силен ход. Първо разгледайте най-натрапващите варианти — шах, взятия, заплахи."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানে আরও শক্তিশালী একটি চাল আছে। আগে সবচেয়ে জোরালো বিকল্পগুলো দেখুন — চেক, ধরা, হুমকি।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানে আরও শক্তিশালী একটি চাল আছে। আগে সবচেয়ে জোরালো বিকল্পগুলো দেখুন — চেক, ধরা, হুমকি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí hi ha un moviment més fort. Mireu primer les opcions més forçades: escacs, captures, amenaces."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tu silnější tah. Podívej se nejdřív na nejforsírovanější možnosti — šachy, braní, hrozby."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er et stærkere træk her. Kig først på det mest tvingende — skak, slag, trusler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier gibt es einen stärkeren Zug. Sieh dir zuerst die forcierenden Möglichkeiten an — Schachs, Schläge, Drohungen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier gibt es einen stärkeren Zug. Sieh dir zuerst die forcierenden Möglichkeiten an — Schachs, Schläge, Drohungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπάρχει ισχυρότερη κίνηση εδώ. Κοίτα πρώτα τις πιο βεβιασμένες επιλογές — σαχ, παρσίματα, απειλές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is a stronger move here. Look at the most forcing options first — checks, captures, threats."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "There is a stronger move here. Look at the most forcing options first — checks, captures, threats."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "There is a stronger move here. Look at the most forcing options first — checks, captures, threats."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "There is a stronger move here. Look at the most forcing options first — checks, captures, threats."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "There is a stronger move here. Look at the most forcing options first — checks, captures, threats."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí hay una jugada más fuerte. Mira primero lo más forzado: jaques, capturas, amenazas."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí hay una jugada más fuerte. Mira primero lo más forzado: jaques, capturas, amenazas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí hay una jugada más fuerte. Primero revisa las opciones más forzadas: jaques, capturas y amenazas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täällä on vahvempi siirto. Katso ensin pakottavimmat vaihtoehdot — shakit, lyönnit, uhkaukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a plus fort ici. Regardez d'abord les coups les plus forçants — échecs, prises, menaces."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a plus fort ici. Regardez d'abord les coups les plus forçants — échecs, prises, menaces."
