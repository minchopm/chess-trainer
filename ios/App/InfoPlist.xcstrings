    "NSGKFriendListUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar-SA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لعرض أصدقائك في Game Center الذين يلعبون Brass Pawn ودعوتهم إلى مباراة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby ukázal tvé přátele z Game Center, kteří hrají Brass Pawn, a mohl je pozvat na partii."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at vise dine Game Center-venner, der spiller Brass Pawn, og invitere dem til et parti."
