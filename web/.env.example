# AWS deployment. Copy to .env and fill it in — .env is gitignored.
# The same credentials as the other arte-soft properties; only the bucket and
# the public hostname differ.
NG_DEPLOY_AWS_ACCESS_KEY_ID=
NG_DEPLOY_AWS_SECRET_ACCESS_KEY=
NG_DEPLOY_AWS_BUCKET=brasspawn.com
NG_DEPLOY_AWS_REGION=eu-central-1

# The hostname CloudFront actually serves. Looked up against distribution
# aliases; without it the invalidation is skipped and the CDN keeps serving the
# previous HTML — the assets update and the pages do not.
SITE_DOMAIN=brasspawn.com

# Optional. Skips the alias lookup on every deploy.
CLOUDFRONT_DISTRIBUTION_ID=
