{
  "name": "brass-pawn-site",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4400 --hmr=false",
    "build": "ng build && node tools/postbuild.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:prod": "ng build --configuration production && node tools/postbuild.mjs",
    "deploy": "./scripts/deploy.sh",
    "deploy:dry": "DRY_RUN=1 ./scripts/deploy.sh",
    "deploy:skip-build": "SKIP_BUILD=1 ./scripts/deploy.sh",
    "deploy:invalidate": "INVALIDATE_ONLY=1 ./scripts/deploy.sh",
    "deploy:media": "SYNC_MEDIA=1 SKIP_BUILD=1 ./scripts/deploy.sh",
    "media": "python3 tools/media.py",
    "provision": "./scripts/provision.sh",
    "fonts": "node tools/fetch-fonts.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.4",
    "rxjs": "~7.8.0",
    "three": "^0.185.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "@types/node": "^20.17.19",
    "@types/three": "^0.185.4",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "description": "The informational website for Brass Pawn \u2014 Angular, prerendered, with a WebGL title sequence."
}
