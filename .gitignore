# Build output
node_modules/
ios/.build/
ios/build/
ios/Tools/*/.build/
DerivedData/
*.xcuserdatad
*.xcuserstate

# Engine networks: ~167 MB for the three, fetched by ios/scripts/fetch-networks.sh
# using the names pinned in the vendored engines. Committing them would bloat
# every clone for no gain — they are build inputs with a canonical source.
ios/Resources/Networks/*.nnue

# Reckless's build tree. Its xcframework is *not* ignored: at 58 MB it is
# committed, so that building the app needs no Rust toolchain. See
# ios/scripts/build-reckless.sh, which is now a maintainer's script.
ios/Vendor/Reckless/networks/*.nnue
ios/Vendor/Reckless/target/

# The Lichess puzzle database dump: ~290 MB, downloaded on demand by
# scripts/import-lichess.mjs. The filtered slice it produces *is* committed.
lichess_db_puzzle.csv.zst
lichess_db_puzzle.csv

.DS_Store

# The website's films and screenshots: ~530 MB, built by web/tools/media.py from
# capture folders that are not in this repository, and served from their own S3
# bucket. web/.gitignore already excludes them; this is here so that anybody
# reading the root ignore file learns they exist.
web/media/
web/exports/
__pycache__/

# The daily feed's build output: the file publish.mjs uploads. The record of
# what went out is feed/published.json, which is committed.
feed/out/
# The review pages review.mjs writes next to each day's drafts.
feed/drafts/*.html
# The website's copy of the feed: written by scripts/feed/site.mjs before every
# build and deploy, from the feed itself. types.ts is the one file kept.
web/src/app/pages/today/feed/index.ts
web/src/app/pages/today/feed/stories.ts
web/src/app/pages/today/feed/sitemap.json
web/src/app/pages/today/feed/stories/
web/src/app/pages/today/feed/i18n/
web/src/app/pages/today/feed/reports.ts
