<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ink">#05060A</color>
    <!-- A dark theatre whatever the system theme: the app has one look, as on iOS. -->
    <style name="Theme.BrassPawn" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
